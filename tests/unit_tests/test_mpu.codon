from sequre.stdlib.numpy.create import array, ones, zeros
from sequre.stdlib.numpy.ndarray import ndarray

from sequre.mpc.env import MPCEnv
from sequre.constants import ENC_ROW
from sequre.lattiseq.ckks import Ciphertext
from sequre.types.ciphertensor import Ciphertensor
from sequre.types.multiparty_aggregate import MPA
from sequre.types.multiparty_partition import MPP
from sequre.types.multiparty_union import MPU
from sequre.utils.testing import assert_eq, assert_eq_approx
from sequre.utils.utils import random_floats

from multiparty_testing import (
    unequal_ratios, ratios_with_empty, own_rows, cohort_matrix, assert_parties_in_step, holders)


def test_mpu_getitem(mpu_a, raw_a):
    mpc = mpu_a.mpc
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim getitem", mpu_a[0].reveal(), raw_a[0], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 1-dim getitem", mpu_a[0][0].reveal(), raw_a[0, 0], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim get slice", mpu_a[:2].reveal(), raw_a[:2], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim get slice-slice tuple", mpu_a[:2, :2].reveal(), raw_a[:2, :2], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim get slice-int tuple", mpu_a[:2, 2].reveal(), raw_a[:2, 2:3], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim get int-slice tuple", mpu_a[2, :2].reveal(), raw_a[2, :2], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim get int-int tuple", mpu_a[2, 2].reveal(), raw_a[2, 2:3], error=0.001)
        

def test_mpu_setitem(_mpu_a, _raw_a):
    mpc = _mpu_a.mpc
    
    mpu_a, raw_a = _mpu_a.copy(), _raw_a.copy()
    mpu_a[0] = mpu_a[1]
    raw_a[0] = raw_a[1]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim setitem", mpu_a.reveal(), raw_a, error=0.001)
    
    mpu_a, raw_a = _mpu_a.copy(), _raw_a.copy()
    mpu_row = mpu_a[0]
    mpu_row[0] = mpu_row[1]
    raw_a[0, 0] = raw_a[0, 1]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 1-dim setitem", mpu_row.reveal(), raw_a[0], error=0.001)
    
    mpu_a, raw_a = _mpu_a.copy(), _raw_a.copy()
    mpu_a[:2] = mpu_a[1:3]
    raw_a[:2] = raw_a[1:3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim set slice", mpu_a.reveal(), raw_a, error=0.001)
    
    mpu_a, raw_a = _mpu_a.copy(), _raw_a.copy()
    mpu_a[:2, :2] = mpu_a[1:3, 1:3]
    raw_a[:2, :2] = raw_a[1:3, 1:3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim set slice-slice tuple", mpu_a.reveal(), raw_a, error=0.001)
    
    mpu_a, raw_a = _mpu_a.copy(), _raw_a.copy()
    mpu_a[:2, 2] = mpu_a[1:3, 3]
    raw_a[:2, 2] = raw_a[1:3, 3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim set slice-int tuple", mpu_a.reveal(), raw_a, error=0.001)
    
    mpu_a, raw_a = _mpu_a.copy(), _raw_a.copy()
    mpu_a[2, :2] = mpu_a[3, 1:3]
    raw_a[2, :2] = raw_a[3, 1:3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim set int-slice tuple", mpu_a.reveal(), raw_a, error=0.001)
    
    mpu_a, raw_a = _mpu_a.copy(), _raw_a.copy()
    mpu_a[2, 2] = mpu_a[3, 3]
    raw_a[2, 2] = raw_a[3, 3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU 2-dim set int-int tuple", mpu_a.reveal(), raw_a, error=0.001)


def test_mpu_transpose(mpu_a, raw_a):
    mpc = mpu_a.mpc
    mhe_t = mpu_a.T.T
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU lazy transpose", mhe_t.reveal(), raw_a, error=0.001)

    mhe_t = mpu_a.T
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU actual transpose", mhe_t.reveal(), raw_a.T, error=0.001)


def test_mpu_mpc_switching(mpu_a, raw_a):
    mpc = mpu_a.mpc
    sharetensor_a = mpu_a.to_sharetensor()
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU -> MPC switch", sharetensor_a.reveal(mpc), raw_a, error=0.001)

    mpu_a = sharetensor_a.to_mpu(mpc, mpu_a._mpp._ratios, dtype=mpu_a.dtype)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPC -> MPU switch", mpu_a.reveal(), raw_a, error=0.001)


def test_mpu_elem_wise_operations(mpu_a, mpu_b, raw_a, raw_b):
    mpc = mpu_a.mpc
    mpu_add = mpu_a + mpu_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU addition", mpu_add.reveal(), raw_a + raw_b, error=0.001)

    _ones = ones(mpu_a.shape)
    mpu_public_add = mpu_a + _ones
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU public addtition", mpu_public_add.reveal(), raw_a + _ones, error=0.001)

    mpu_sub = mpu_a - mpu_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU subtraction", mpu_sub.reveal(), raw_a - raw_b, error=0.001)

    mpu_mul = mpu_a * mpu_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU multiplication", mpu_mul.reveal(), raw_a * raw_b, error=0.005)
    
    mpu_a_row_mat = mpu_a[0].expand_dims(axis=0)
    row_mat_add = mpu_a_row_mat + mpu_a_row_mat
    raw_a_row_mat = raw_a[0].expand_dims(axis=0)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU addition w/ dimension expansion", row_mat_add.reveal(), raw_a_row_mat + raw_a_row_mat, error=0.001)


def test_mpu_matmul_operations(mpu_a, mpu_b, raw_a, raw_b):
    mpc = mpu_a.mpc
    mpu_dot = mpu_a.dot(axis=1)
    raw_dot = (raw_a * raw_a).sum(axis=1)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU dot 2-dim", mpu_dot.reveal(), raw_dot, error=0.005)
    
    mpu_dot_1_dim = mpu_a[0].dot(axis=0)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU dot 1-dim", mpu_dot_1_dim.reveal()[0], raw_dot[0], error=0.005)
    
    mpu_matmul = mpu_a @ mpu_b.T
    raw_matmul = raw_a @ raw_b.T
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU matrix multiplication non-transposed x transposed", mpu_matmul.reveal(), raw_matmul, error=0.02)

    mpu_matmul = mpu_a.T @ mpu_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU matrix multiplication transposed x non-transposed", mpu_matmul.reveal(), raw_a.T @ raw_b, error=0.02)

    _ones = ones(mpu_a.shape).T
    mpu_public_matmul = mpu_a @ _ones
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU matrix public multiplication", mpu_public_matmul.reveal(), raw_a @ _ones, error=0.02)

    mpu_a_row_mat = mpu_a[0].expand_dims(axis=0)
    row_mat_matmul = mpu_a_row_mat.T @ mpu_a_row_mat
    raw_a_row_mat = raw_a[0].expand_dims(axis=0)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU matrix multiplication transposed x non-transposed w/ dim expansion", row_mat_matmul.reveal(), raw_a_row_mat.T @ raw_a_row_mat, error=0.02)
    

def test_mpu_comparisons(mpc):
    """C-05: the documented pattern, a comparison on a partitioned MPU followed by more MPC work, with partitions in the
    clear and encrypted, unequal and empty ones."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in (unequal_ratios(n_cp), ratios_with_empty(n_cp)):
        matrix = cohort_matrix(mpc, ratios.sum(), 4) + 0.25  # at least 0.25 from the threshold
        start, stop = own_rows(mpc, ratios)
        mpu = MPU(mpc, matrix[start:stop] if mpc.pid else matrix, "partition")
        mask = mpu > 0.5
        assert_parties_in_step(mpc, f"MPU > 0.5 in the clear, ratios {ratios}")
        encrypted = mpu.copy()
        encrypted.encrypt()
        mask_encrypted = encrypted > 0.5
        assert_parties_in_step(mpc, f"MPU > 0.5 encrypted, ratios {ratios}")

        revealed = mask.reveal()
        revealed_encrypted = mask_encrypted.reveal()
        if mpc.pid:
            expected = (matrix > 0.5).astype(float)
            assert_eq(f"CP{mpc.pid}:\tMPU > 0.5 in the clear, ratios {ratios}", revealed, expected)
            assert_eq_approx(f"CP{mpc.pid}:\tMPU > 0.5 encrypted, ratios {ratios}", revealed_encrypted, expected, error=1e-2)


def test_mpu_mixed_cohorts(mpc):
    """M-MP-21: the MPU per-partition products with an MPP that some compute parties hold encrypted and the others in the
    clear (unequal and empty partitions): the mixed MPP is encrypted at every party for the product. MPA + MPP and
    MPA - MPP: an MPA that holds its shares encrypted takes a mixed MPP, and one that holds them in the clear, which
    MPA's setitem cannot take an encrypted partition into yet (H-23), raises the same error at every compute party. Every
    party in step after each operation."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in (unequal_ratios(n_cp), ratios_with_empty(n_cp)):
        rows = ratios.sum()
        # Wide partitions (more columns than rows): an MPA encrypts a share in the clear row-wise only when it is wide,
        # and the sum of encryptions in two layouts deadlocks (M-MHE-21)
        a = cohort_matrix(mpc, rows, 8)
        b = cohort_matrix(mpc, rows, 8)
        start, stop = own_rows(mpc, ratios)
        parties = holders(ratios)
        mixed = MPU(mpc, a[start:stop] if mpc.pid else a, "partition")
        if mpc.pid == parties[0]:
            mixed.encrypt()
        other = MPU(mpc, b[start:stop] if mpc.pid else b, "partition")
        # Additive operands that CP1 holds in full and the others as zeros
        w = cohort_matrix(mpc, 8, 2) * 0.25
        bs = cohort_matrix(mpc, rows, 3) * 0.25
        vs = cohort_matrix(mpc, 2, 8) * 0.25
        mpa_w = MPU(mpc, w if mpc.pid == 1 else w.zeros(), "additive")
        mpa_bs = MPU(mpc, bs if mpc.pid == 1 else bs.zeros(), "additive")
        mpa_vs = MPU(mpc, vs if mpc.pid == 1 else vs.zeros(), "additive")
        mpa_a = MPU(mpc, a if mpc.pid == 1 else a.zeros(), "additive")
        label = f"ratios {ratios}"

        product = mixed @ mpa_w
        assert_parties_in_step(mpc, f"MPU mixed @ MPA, {label}")
        product_t = mixed.T @ mpa_bs
        assert_parties_in_step(mpc, f"MPU mixed.T @ MPA, {label}")
        product_mpa = mpa_vs @ mixed.T
        assert_parties_in_step(mpc, f"MPU MPA @ mixed.T, {label}")
        product_mpp = mixed.T @ other
        assert_parties_in_step(mpc, f"MPU mixed.T @ MPP, {label}")
        elem_wise = mixed * mpa_a
        assert_parties_in_step(mpc, f"MPU mixed * MPA, {label}")

        # An MPA holding its shares encrypted only (encrypt() would keep the plain ones beside the encryption, and the sum
        # would leave one of the two stale: M-MP-02), row-wise as MPP.encrypt() encrypts the partitions (a tall share
        # encrypted by default is column-wise, and an element-wise op across layouts deadlocks: M-MHE-21)
        share = a if mpc.pid == 1 else a.zeros()
        encrypted_mpa = MPA[Tuple[int, int], float]._from_parts(
            mpc, share if mpc.pid == 0 else ndarray[Tuple[int, int], float](),
            Ciphertensor[Ciphertext].enc(mpc, share, encoding=ENC_ROW) if mpc.pid else Ciphertensor[Ciphertext](),
            Ciphertensor[Ciphertext]())
        summed = MPU[Tuple[int, int], float](_mpp=MPP[Tuple[int, int], float](mpc), _mpa=encrypted_mpa) + mixed
        assert_parties_in_step(mpc, f"MPU encrypted MPA + mixed, {label}")

        # An MPA with its shares in the clear (a fresh one: mixed * mpa_a above encrypted mpa_a's shares in place): the
        # parties that hold rows each place theirs, and one of those holds its partition encrypted. With a single holder
        # the sum takes no setitem and works; the difference always places rows.
        plain_mpa = MPU(mpc, a if mpc.pid == 1 else a.zeros(), "additive")
        raised_add, raised_sub = False, False
        try:
            plain_mpa + mixed
        except NotImplementedError:
            raised_add = True
        assert_parties_in_step(mpc, f"MPU plain MPA + mixed, {label}")
        try:
            plain_mpa - mixed
        except NotImplementedError:
            raised_sub = True
        assert_parties_in_step(mpc, f"MPU plain MPA - mixed, {label}")

        revealed = [product.reveal(), product_t.reveal(), product_mpa.reveal(), product_mpp.reveal(), elem_wise.reveal(), summed.reveal()]
        if mpc.pid:
            assert_eq_approx(f"CP{mpc.pid}:\tMPU mixed @ MPA, {label}", revealed[0], a @ w, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPU mixed.T @ MPA, {label}", revealed[1], a.T @ bs, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPU MPA @ mixed.T, {label}", revealed[2], vs @ a.T, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPU mixed.T @ MPP, {label}", revealed[3], a.T @ b, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPU mixed * MPA, {label}", revealed[4], a * a, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPU encrypted MPA + mixed, {label}", revealed[5], a + a, error=0.01)
            several = len(parties) > 1
            assert_eq(f"CP{mpc.pid}:\tMPU plain MPA + mixed raises at every compute party, {label}", raised_add, several)
            assert_eq(f"CP{mpc.pid}:\tMPU plain MPA - mixed raises at every compute party, {label}", raised_sub, True)


def test_mpu[TP](mpc: MPCEnv[TP], modulus: TP):
    mpc.comms.sync_parties()
    alg_struct = "ring" if modulus.popcnt() == 1 else "field"
    print(f'CP{mpc.pid}:\tTesting Sequre MHE MPU on {alg_struct}... \n')
    rows, cols = 4, 32
    
    a_partition = array(random_floats((rows, cols)))
    b_share = array(random_floats((rows * (mpc.comms.number_of_parties - 1), cols)))
    
    mpu_a = MPU(mpc, a_partition, "partition")
    mpu_b = MPU(mpc, b_share, "additive")

    raw_a = mpc.comms.collect(a_partition).unfence() if mpc.pid else zeros((rows * (mpc.comms.number_of_parties - 1), cols))
    raw_b = mpc.comms.collect(b_share).sum() if mpc.pid else zeros((rows * (mpc.comms.number_of_parties - 1), cols))

    pid = mpc.pid
    mpc.comms.sequential(lambda p, a: print(f"CP{p}:\tPrinting MPU test data A (MPP) for debugging:", a), False, pid, raw_a)
    mpc.comms.sync_parties()
    mpc.comms.sequential(lambda p, b: print(f"CP{p}:\tPrinting MPU test data B (MPA) for debugging:", b), False, pid, raw_b)

    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPU load/collect/decrypt 1", mpu_a.reveal(), raw_a, error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU load/collect/decrypt 2", mpu_b.reveal(), raw_b, error=0.001)

    test_mpu_getitem(mpu_a, raw_a)
    test_mpu_getitem(mpu_b, raw_b)
    test_mpu_setitem(mpu_a, raw_a)
    test_mpu_setitem(mpu_b, raw_b)
    test_mpu_transpose(mpu_a, raw_a)
    test_mpu_transpose(mpu_b, raw_b)
    test_mpu_mpc_switching(mpu_a, raw_a)
    test_mpu_mpc_switching(mpu_b, raw_b)
    test_mpu_elem_wise_operations(mpu_a, mpu_b, raw_a, raw_b)
    test_mpu_matmul_operations(mpu_a, mpu_b, raw_a, raw_b)
    test_mpu_comparisons(mpc)
    test_mpu_mixed_cohorts(mpc)

    print(f'CP{mpc.pid}:\tSequre MHE MPU tests on {alg_struct} passed.\n')
