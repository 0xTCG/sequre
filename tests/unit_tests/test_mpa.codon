import secure_operator
import sequre.lattiseq.ckks as ckks

from sequre.stdlib.numpy.create import array, ones, zeros, zeros_like
from sequre.stdlib.numpy.ndarray import ndarray

from sequre.mpc.env import MPCEnv
from sequre.types.ciphertensor import Ciphertensor
from sequre.types.multiparty_aggregate import MPA
from sequre.utils.testing import assert_eq, assert_eq_approx, same_at_every_party
from sequre.utils.utils import random_floats, random_ints

from internal.gc import sizeof

from sequre.types.utils import double_to_fp, fp_to_double
from sequre.constants import MPC_MODULUS_BITS, mpc_uint

from multiparty_testing import cohort_matrix, assert_parties_in_step


def test_mpa_getitem(mpa_a, raw_a):
    mpc = mpa_a._mpc
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim getitem", mpa_a[0].reveal(), raw_a[0], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 1-dim getitem", mpa_a[0][0].reveal(), raw_a[0, 0], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim get slice", mpa_a[:2].reveal(), raw_a[:2], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim get slice-slice tuple", mpa_a[:2, :2].reveal(), raw_a[:2, :2], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim get slice-int tuple", mpa_a[:2, 2].reveal(), raw_a[:2, 2:3], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim get int-slice tuple", mpa_a[2, :2].reveal(), raw_a[2, :2], error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim get int-int tuple", mpa_a[2, 2].reveal(), raw_a[2, 2:3], error=0.001)
        

def test_mpa_setitem(_mpa_a, _raw_a):
    mpc = _mpa_a._mpc
    
    mpa_a, raw_a = _mpa_a.copy(), _raw_a.copy()
    mpa_a[0] = mpa_a[1]
    raw_a[0] = raw_a[1]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim setitem", mpa_a.reveal(), raw_a, error=0.001)
    
    mpa_a, raw_a = _mpa_a.copy(), _raw_a.copy()
    mpa_row = mpa_a[0]
    mpa_row[0] = mpa_row[1]
    raw_a[0, 0] = raw_a[0, 1]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 1-dim setitem", mpa_row.reveal(), raw_a[0], error=0.001)
    
    mpa_a, raw_a = _mpa_a.copy(), _raw_a.copy()
    mpa_a[:2] = mpa_a[1:3]
    raw_a[:2] = raw_a[1:3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim set slice", mpa_a.reveal(), raw_a, error=0.001)
    
    mpa_a, raw_a = _mpa_a.copy(), _raw_a.copy()
    mpa_a[:2, :2] = mpa_a[1:3, 1:3]
    raw_a[:2, :2] = raw_a[1:3, 1:3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim set slice-slice tuple", mpa_a.reveal(), raw_a, error=0.001)
    
    mpa_a, raw_a = _mpa_a.copy(), _raw_a.copy()
    mpa_a[:2, 2] = mpa_a[1:3, 3]
    raw_a[:2, 2] = raw_a[1:3, 3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim set slice-int tuple", mpa_a.reveal(), raw_a, error=0.001)
    
    mpa_a, raw_a = _mpa_a.copy(), _raw_a.copy()
    mpa_a[2, :2] = mpa_a[3, 1:3]
    raw_a[2, :2] = raw_a[3, 1:3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim set int-slice tuple", mpa_a.reveal(), raw_a, error=0.001)
    
    mpa_a, raw_a = _mpa_a.copy(), _raw_a.copy()
    mpa_a[2, 2] = mpa_a[3, 3]
    raw_a[2, 2] = raw_a[3, 3]
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA 2-dim set int-int tuple", mpa_a.reveal(), raw_a, error=0.001)


def test_mpa_transpose(mpa_a, raw_a):
    mpc = mpa_a._mpc
    mhe_t = mpa_a.T.T
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA lazy transpose", mhe_t.reveal(), raw_a, error=0.001)

    mhe_t = mpa_a.T
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA actual transpose", mhe_t.reveal(), raw_a.T, error=0.001)


def test_mpa_mpc_switching(mpa_a, raw_a):
    mpc = mpa_a._mpc
    sharetensor_a = mpa_a.to_sharetensor()
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA -> MPC switch", sharetensor_a.reveal(mpc), raw_a, error=0.001)

    mpa_a = sharetensor_a.to_mpa(mpc, dtype=mpa_a.dtype)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPC -> MPA switch", mpa_a.reveal(), raw_a, error=0.001)


def test_mpa_elem_wise_operations(mpa_a, mpa_b, raw_a, raw_b):
    mpc = mpa_a._mpc
    mpa_add = mpa_a + mpa_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA addition", mpa_add.reveal(), raw_a + raw_b, error=0.001)

    _ones = ones(mpa_a.shape)
    mpa_public_add = mpa_a + _ones
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA public addtition", mpa_public_add.reveal(), raw_a + _ones, error=0.001)

    mpa_sub = mpa_a - mpa_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA subtraction", mpa_sub.reveal(), raw_a - raw_b, error=0.001)

    mpa_mul = mpa_a * mpa_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA multiplication", mpa_mul.reveal(), raw_a * raw_b, error=0.01)
    
    mpa_a_row_mat = mpa_a[0].expand_dims(axis=0)
    row_mat_add = mpa_a_row_mat + mpa_a_row_mat
    raw_a_row_mat = raw_a[0].expand_dims(axis=0)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA addition w/ dimension expansion", row_mat_add.reveal(), raw_a_row_mat + raw_a_row_mat, error=0.001)


def test_mpa_matmul_operations(mpa_a, mpa_b, raw_a, raw_b):
    mpc = mpa_a._mpc
    # The dot products (about 1,800 with two compute parties, 3,900 with three: the sums of the parties' shares grow with
    # them) take an HE multiplication and a rotate-and-sum. Their error is relative to their size, about 1.4e-8 per
    # element (rms), measured since Lattiseq's mod-down rounds (L-249; 60 key sets, two and three compute parties, field
    # and ring): at most 5.3e-8 for a row of a 2-dim dot, 3.8e-8 for a 1-dim dot. The bounds, 2^-22.5 and 2^-23, sit 1.7
    # bits above those. On 4 rows and 1 element a loss of 3 bits passes these checks about half the time; the dots of a
    # 32-row MPA below (the same products, one row per ciphertext) catch it in about 99% of runs. (An absolute 0.005,
    # about 2^-20 relative with three compute parties, failed in 9 of 40 runs with the mod-down that floored.)
    mpa_dot = mpa_a.dot(axis=1)
    raw_dot = (raw_a * raw_a).sum(axis=1)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA dot 2-dim", mpa_dot.reveal(), raw_dot, error=1e-6, rel_error=2.0 ** -22.5)
    
    mpa_dot_1_dim = mpa_a[0].dot(axis=0)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA dot 1-dim", mpa_dot_1_dim.reveal()[0], raw_dot[0], error=1e-6, rel_error=2.0 ** -23)

    big_share = array(random_floats((32, 32)))
    mpa_big = MPA(mpc, big_share)
    raw_big = mpc.comms.collect(big_share).sum() if mpc.pid else zeros_like(big_share)
    mpa_big_dot = mpa_big.dot(axis=1)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA dot 2-dim on 32 rows", mpa_big_dot.reveal(), (raw_big * raw_big).sum(axis=1), error=1e-6, rel_error=2.0 ** -22.5)
    
    mpa_matmul = mpa_a @ mpa_b.T
    raw_matmul = raw_a @ raw_b.T
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA matrix multiplication non-transposed x transposed", mpa_matmul.reveal(), raw_matmul, error=0.02)

    mpa_matmul = mpa_a.T @ mpa_b
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA matrix multiplication transposed x non-transposed", mpa_matmul.reveal(), raw_a.T @ raw_b, error=0.05)

    _ones = ones(mpa_a.shape, dtype=int).T
    mpa_public_matmul = mpa_a @ _ones
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA matrix public multiplication", mpa_public_matmul.reveal(), raw_a @ _ones.astype(float), error=0.02)

    mpa_a_row_mat = mpa_a[0].expand_dims(axis=0)
    row_mat_matmul = mpa_a_row_mat.T @ mpa_a_row_mat
    raw_a_row_mat = raw_a[0].expand_dims(axis=0)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA matrix multiplication transposed x non-transposed w/ dim expansion", row_mat_matmul.reveal(), raw_a_row_mat.T @ raw_a_row_mat, error=0.02)


def test_mpa_aggregates_stay_identical(_mpa_a, raw_a):
    """An aggregate is the same ciphertexts at every party and stays so: through a product of aggregates, a public product
    (which accumulates into zero ciphertexts), a refresh (one collective bootstrap per ciphertext), and in MPA.rand. The
    switch to MPC, where every party decrypts with its own copy, depends on it."""
    mpc = _mpa_a._mpc
    mpa_a = _mpa_a.copy()
    with mpc.randomness.global_stream():
        W = array(random_floats((raw_a.shape[1], 3)))

    square = mpa_a * mpa_a
    product = square @ W
    expected = (raw_a * raw_a) @ W
    stensor = product.to_sharetensor()
    random_mpa = MPA[Tuple[int, int], float].rand((3, 8), "uniform", mpc)

    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPA product of aggregates is the same at every party", same_at_every_party(mpc, square._aggregate._data), True)
        assert_eq(f"CP{mpc.pid}:\tMPA aggregate times public matrix is the same at every party", same_at_every_party(mpc, product._aggregate._data), True)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA aggregate times public matrix -> MPC switch", stensor.reveal(mpc), expected, error=0.02, rel_error=2e-5)
        assert_eq(f"CP{mpc.pid}:\tMPA.rand is the same at every party", same_at_every_party(mpc, random_mpa._aggregate._data), True)

        refreshed = product._aggregate.copy()
        refreshed._data = mpc.mhe.drop_level(refreshed._data, mpc.mhe.bootstrap_min_level)
        before = mpc.mhe.stats.secure_bootstrap_count
        mpc.mhe.refresh(refreshed._data, refreshed._is_broadcast)
        assert_eq(f"CP{mpc.pid}:\tMPA aggregate refresh: one bootstrap per ciphertext", mpc.mhe.stats.secure_bootstrap_count - before, len(refreshed._data))
        assert_eq(f"CP{mpc.pid}:\tMPA aggregate refresh: the same at every party", same_at_every_party(mpc, refreshed._data), True)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA aggregate refresh: decryption of the common copy", refreshed.reveal(mpc, source_pid=-1), expected, error=0.02, rel_error=2e-5)


def test_mpa_matmul_operand_order(_mpa_a, _mpa_b, raw_a, raw_b):
    """Products whose left factor is an aggregate keep the factors' order (non-square factors): with a distributed right
    factor, and with an aggregate right factor."""
    mpc = _mpa_a._mpc
    mpa_a = _mpa_a.copy()
    square = mpa_a * mpa_a

    mpa_b_t = _mpa_b.T
    distributed = square @ mpa_b_t
    mpa_b_t_square = mpa_b_t * mpa_b_t
    aggregated = square @ mpa_b_t_square

    raw_square = raw_a * raw_a
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA aggregate x distributed matmul", distributed.reveal(), raw_square @ raw_b.T, error=0.05, rel_error=2e-5)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA aggregate x aggregate matmul", aggregated.reveal(), raw_square @ (raw_b.T * raw_b.T), error=0.05, rel_error=2e-5)


def test_mpa_matmul_cost_agreement(_mpa_a, raw_a):
    """Every party, CP0 included, estimates the same cost for a public product of an aggregate: the matmul reorder pass
    compares such estimates at every party."""
    mpc = _mpa_a._mpc
    mpa_a = _mpa_a.copy()
    square = mpa_a * mpa_a
    costs = mpc.comms.collect(square.get_matmul_cost(ones((raw_a.shape[1], 3))), True)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPA public product cost is the same at every party", all(c == costs[0] for c in costs), True)


def test_mpa_int_to_sharetensor(mpc):
    """An aggregated int MPA switches to fixed-point shares at every party, CP0 included, so the next fixed-point step
    (the truncation after a product) runs at all of them."""
    local = array(random_ints((4, 8), 0, 31))
    raw = mpc.comms.collect(local).sum() if mpc.pid else zeros_like(local)
    mpa = MPA(mpc, local)
    mpa.aggregate()
    stensor = mpa.to_sharetensor()
    flags = mpc.comms.collect(stensor.fp, True)
    squared = secure_operator.mul(mpc, stensor, stensor)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPA int -> MPC switch: the same fixed-point flag at every party", all(f == flags[0] for f in flags), True)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA int -> MPC switch: squared shares", squared.reveal(mpc), (raw * raw).astype(float), error=0.05)


def test_mpa_public_product_via_mpc(mpc):
    """H-53: MPA @ ndarray under allow_mpc_switch, with the switch to MPC chosen: an aggregate and encrypted shares
    convert once, at every party (CP0 joins), and come back as an aggregate; shares in the clear multiply locally.
    Ciphertensor.via_mpc(mirrored=True), the conversion of ciphertexts every compute party holds alike, gives CP0 a
    placeholder with the result's shape. M-MP-19: encrypt() leaves an MPA that holds only an aggregate as it is, and
    encrypts each party's own share of one that also holds its shares in the clear."""
    rows, cols = 4, 64
    public = cohort_matrix(mpc, cols, 3) * 0.25
    share = array(random_floats((rows, cols), scale=1.0))
    raw = mpc.comms.collect(share).sum() if mpc.pid else zeros_like(share)
    expected = raw @ public

    # An MPA that keeps its shares in the clear multiplies them, whatever else it holds: the other two hold only an
    # aggregate, or only encrypted shares
    plain = MPA(mpc, share)
    aggregated = MPA(mpc, share)
    aggregated.aggregate()
    aggregate = MPA[Tuple[int, int], float]._from_parts(mpc, zeros((rows, cols)) if mpc.pid == 0 else ndarray[Tuple[int, int], float](), Ciphertensor[ckks.Ciphertext](), aggregated._aggregate.copy() if mpc.pid else Ciphertensor[ckks.Ciphertext]())
    encrypted = MPA(mpc, Ciphertensor[ckks.Ciphertext].enc(mpc, share)) if mpc.pid else MPA(mpc, zeros((rows, cols)))
    with mpc.allow_mpc_switch():
        switches = [aggregate._public_matmul_via_mpc([cols, 3]), encrypted._public_matmul_via_mpc([cols, 3]), plain._public_matmul_via_mpc([cols, 3])]
        product_aggregate = aggregate @ public
        assert_parties_in_step(mpc, "MPA aggregate @ ndarray via MPC")
        product_encrypted = encrypted @ public
        assert_parties_in_step(mpc, "MPA encrypted shares @ ndarray via MPC")
        product_plain = plain @ public
        assert_parties_in_step(mpc, "MPA shares in the clear @ ndarray under allow_mpc_switch")

    revealed = [product_aggregate.reveal(), product_encrypted.reveal(), product_plain.reveal()]
    assert_eq(f"CP{mpc.pid}:\tMPA @ ndarray under allow_mpc_switch: routes (aggregate, encrypted shares, in the clear)", switches, [True, True, False])
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA aggregate @ ndarray via MPC", revealed[0], expected, error=0.01)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA encrypted shares @ ndarray via MPC", revealed[1], expected, error=0.01)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA shares in the clear @ ndarray under allow_mpc_switch", revealed[2], expected, error=0.01)
        assert_eq(f"CP{mpc.pid}:\tMPA aggregate @ ndarray via MPC: an aggregate, the same at every party", product_aggregate.is_aggregate() and same_at_every_party(mpc, product_aggregate._aggregate._data), True)

    # The mirrored conversion directly: CP0 converts a placeholder of the aggregate's layout
    ciphers = aggregated._aggregate if mpc.pid else Ciphertensor[ckks.Ciphertext].zeros(mpc, [rows, cols])
    mirrored = ciphers.via_mpc(mpc, lambda stensor: secure_operator.matmul(mpc, stensor, public), mirrored=True, S=Tuple[int, int])
    shapes = mpc.comms.collect(mirrored.shape, True)
    assert_eq(f"CP{mpc.pid}:\tCiphertensor via MPC, mirrored: the result's shape at every party, CP0 included", all(sh == [rows, 3] for sh in shapes), True)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tCiphertensor via MPC, mirrored", mirrored.reveal(mpc, source_pid=-1), expected, error=0.01)
    assert_parties_in_step(mpc, "Ciphertensor via MPC, mirrored")

    # M-MP-19: encrypt() leaves an MPA that holds only an aggregate as it is: encrypted already, the same at every party
    aggregate_only = MPA[Tuple[int, int], float]._from_parts(mpc, zeros((rows, cols)) if mpc.pid == 0 else ndarray[Tuple[int, int], float](), Ciphertensor[ckks.Ciphertext](), aggregated._aggregate.copy() if mpc.pid else Ciphertensor[ckks.Ciphertext]())
    aggregate_only.encrypt()
    if mpc.pid:
        same = same_at_every_party(mpc, aggregate_only._aggregate._data)
        assert_eq(f"CP{mpc.pid}:\tMPA encrypt of an aggregate-only MPA: still only an aggregate, the same at every party", aggregate_only.is_aggregate() and same, True)
    revealed_aggregate_only = aggregate_only.reveal()
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA encrypt of an aggregate-only MPA: its value", revealed_aggregate_only, raw, error=1e-3)

    # An MPA that holds its shares in the clear and an aggregate gets each party's own share encrypted, and keeps the
    # aggregate as it was
    all_shares = mpc.comms.collect(share) if mpc.pid else [share]
    aggregated.encrypt()
    if mpc.pid:
        same = same_at_every_party(mpc, aggregated._aggregate._data)
        assert_eq(f"CP{mpc.pid}:\tMPA encrypt with shares in the clear and an aggregate: the aggregate kept, the same at every party", aggregated.has_aggregate() and aggregated.has_encryption() and same, True)
    for p in range(1, mpc.comms.number_of_parties):
        # CP{p}'s encryption alone, zeros (encrypted the same way) at the other parties
        own = MPA(mpc, aggregated._encryption if mpc.pid == p else Ciphertensor[ckks.Ciphertext].enc(mpc, zeros((rows, cols)))) if mpc.pid else MPA(mpc, zeros((rows, cols)))
        revealed_own = own.reveal()
        if mpc.pid:
            assert_eq_approx(f"CP{mpc.pid}:\tMPA encrypt with shares in the clear and an aggregate: CP{p}'s encryption holds its own share", revealed_own, all_shares[p - 1], error=1e-3)


def test_mpa_reveal_sums_only(mpc):
    """MPA.reveal of shares the compute parties hold in the clear reveals their sum and nothing else (M-MP-15): each
    party sends the others its share under pairwise masks that cancel in the sum, so a vector a party receives differs
    from the sender's share (it used to receive the raw share), and reveal sends exactly the branch round and those
    vectors. Float and int shares, a 1-dim MPA, and a party without a share (it adds zeros); CP0 sends nothing."""
    n_cp = mpc.comms.number_of_parties - 1
    rows, cols = 3, 5
    with mpc.randomness.global_stream():
        shares = [array(random_floats((rows, cols))) for _ in range(n_cp)]
        int_shares = [array(random_ints((rows, cols), -50, 50)) for _ in range(n_cp)]
    total = shares[0].copy()
    int_total = int_shares[0].copy()
    for q in range(1, n_cp):
        total = total + shares[q]
        int_total = int_total + int_shares[q]
    mpa = MPA(mpc, shares[mpc.pid - 1] if mpc.pid else zeros((rows, cols)))

    # The vectors the parties send: each differs from its sender's share in every entry, and they add up to the sum
    masked = mpa._masked_plain_share(rows * cols) if mpc.pid else List[mpc_uint]()
    if mpc.pid:
        modulus = mpc.default_mpc_modulus
        k, f = MPA._plain_encoding(n_cp)
        received = mpc.comms.collect(masked)
        summed = received[0]
        for q in range(1, n_cp + 1):
            raw = [double_to_fp(v, modulus, k, f) for v in shares[q - 1].flatten().tolist()]
            equal = sum(int(raw[i] == received[q - 1][i]) for i in range(len(raw)))
            assert_eq(f"CP{mpc.pid}:\tMPA reveal: CP{q} sends its share masked (entries equal to the share: {equal})", equal, 0)
            if q > 1:
                summed = summed.add_mod(received[q - 1], modulus)
        flat_total = total.flatten()
        error = max(abs(fp_to_double(summed[i], modulus, MPC_MODULUS_BITS - 1, f) - flat_total[i]) for i in range(len(summed)))
        assert_eq(f"CP{mpc.pid}:\tMPA reveal: the masked shares add up to the sum (error {error:.2e})", error < 1e-9, True)

    sent = mpc.stats.bytes_sent
    revealed = mpa.reveal()
    sent = mpc.stats.bytes_sent - sent
    expected = (n_cp - 1) * (2 * sizeof(int) + [1, rows, cols]._pickle_size() + masked._pickle_size()) if mpc.pid else 0
    assert_eq(f"CP{mpc.pid}:\tMPA reveal sends the branch round and the masked shares only", sent, expected)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA reveal of shares in the clear: the sum", revealed, total, error=1e-9)
    assert_parties_in_step(mpc, "MPA reveal of shares in the clear")

    revealed_int = MPA(mpc, int_shares[mpc.pid - 1] if mpc.pid else zeros((rows, cols), dtype=int)).reveal()
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPA reveal of int shares in the clear: the exact sum", revealed_int, int_total)
    assert_parties_in_step(mpc, "MPA reveal of int shares in the clear")

    without_last = MPA(mpc, shares[mpc.pid - 1]) if 0 < mpc.pid < n_cp else MPA[Tuple[int, int], float](mpc) if mpc.pid else MPA(mpc, zeros((rows, cols)))
    revealed_partial = without_last.reveal()
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA reveal with a compute party without a share", revealed_partial, total - shares[n_cp - 1], error=1e-9)
    assert_parties_in_step(mpc, "MPA reveal with a compute party without a share")

    vector = MPA(mpc, array([1.5, -2.25, 3.0]) if mpc.pid else zeros((3,)))
    revealed_vector = vector.reveal()
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA reveal of a 1-dim MPA", revealed_vector, array([1.5, -2.25, 3.0]) * float(n_cp), error=1e-9)
    assert_parties_in_step(mpc, "MPA reveal of a 1-dim MPA")


def test_mpa[TP](mpc: MPCEnv[TP], modulus: TP):
    mpc.comms.sync_parties()
    alg_struct = "ring" if modulus.popcnt() == 1 else "field"
    print(f'CP{mpc.pid}:\tTesting Sequre MHE MPA on {alg_struct}... \n')
    rows, cols = 4, 32
    
    a_share = array(random_floats((rows, cols)))
    b_share = array(random_floats((rows, cols)))
    
    mpa_a = MPA(mpc, a_share)
    mpa_b = MPA(mpc, b_share)

    raw_a = mpc.comms.collect(a_share).sum() if mpc.pid else zeros_like(a_share)
    raw_b = mpc.comms.collect(b_share).sum() if mpc.pid else zeros_like(b_share)

    pid = mpc.pid
    mpc.comms.sequential(lambda p, a: print(f"CP{p}:\tPrinting MPA test data A for debugging:", a), False, pid, raw_a)
    mpc.comms.sync_parties()
    mpc.comms.sequential(lambda p, b: print(f"CP{p}:\tPrinting MPA test data B for debugging:", b), False, pid, raw_b)

    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPA load/collect/decrypt 1", mpa_a.reveal(), raw_a, error=0.001)
        assert_eq_approx(f"CP{mpc.pid}:\tMPA load/collect/decrypt 2", mpa_b.reveal(), raw_b, error=0.001)

    test_mpa_getitem(mpa_a, raw_a)
    test_mpa_setitem(mpa_a, raw_a)
    test_mpa_transpose(mpa_a, raw_a)
    test_mpa_mpc_switching(mpa_a, raw_a)
    test_mpa_elem_wise_operations(mpa_a, mpa_b, raw_a, raw_b)
    test_mpa_matmul_operations(mpa_a, mpa_b, raw_a, raw_b)
    test_mpa_aggregates_stay_identical(mpa_a, raw_a)
    test_mpa_matmul_operand_order(mpa_a, mpa_b, raw_a, raw_b)
    test_mpa_matmul_cost_agreement(mpa_a, raw_a)
    test_mpa_int_to_sharetensor(mpc)
    test_mpa_public_product_via_mpc(mpc)
    test_mpa_reveal_sums_only(mpc)

    print(f'CP{mpc.pid}:\tSequre MHE MPA tests on {alg_struct} passed.\n')
