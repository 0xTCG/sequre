from sequre.constants import RUN_TOGGLES


# The run-tests selectors test_unit handles. scripts/invoke.codon rejects any selector that no runner lists, so keep
# this list in step with the branches below.
UNIT_SELECTORS = [
    RUN_TOGGLES.UNIT_TEST_FLAG, RUN_TOGGLES.HELPERS_TEST_FLAG, RUN_TOGGLES.PRIMITIVES_TEST_FLAG,
    RUN_TOGGLES.HE_TEST_FLAG, RUN_TOGGLES.BOOTSTRAPPING_TEST_FLAG, RUN_TOGGLES.MPC_TEST_FLAG, RUN_TOGGLES.MHE_FLAG,
    RUN_TOGGLES.SHARETENSOR_TEST_FLAG, RUN_TOGGLES.CIPHERTENSOR_TEST_FLAG, RUN_TOGGLES.MPP_TEST_FLAG,
    RUN_TOGGLES.MPA_TEST_FLAG, RUN_TOGGLES.MPU_TEST_FLAG, RUN_TOGGLES.IR_PASSES_TEST_FLAG,
    RUN_TOGGLES.STDLIB_BUILTIN_TEST_FLAG, RUN_TOGGLES.BITWISE_TEST_FLAG, RUN_TOGGLES.DECOR_TEST_FLAG,
    RUN_TOGGLES.NONLINEAR_TEST_FLAG, RUN_TOGGLES.ACTIVATIONS_TEST_FLAG]


def test_unit(mpc, tests_toggles, modulus) -> int:
    # Returns the number of test groups selected; the CP0-only groups count at every party. The MPC groups run on the
    # run's modulus (the field, or the ring with --use-ring); bitwise, decor and nonlinear test both moduli inside.
    run_units = tests_toggles[RUN_TOGGLES.UNIT_TEST_FLAG] or tests_toggles[RUN_TOGGLES.RUN_ALL_FLAG]
    selected = 0

    if tests_toggles[RUN_TOGGLES.HELPERS_TEST_FLAG] or run_units:
        selected += 1
        if mpc.pid == 0:
            from test_helpers import test_helpers
            test_helpers()

    if tests_toggles[RUN_TOGGLES.PRIMITIVES_TEST_FLAG] or run_units:
        selected += 1
        if mpc.pid == 0:
            from test_primitives import test_primitives
            with mpc.default_modulus(modulus):
                test_primitives(modulus)

    if tests_toggles[RUN_TOGGLES.HE_TEST_FLAG] or run_units:
        selected += 1
        if mpc.pid == 0:
            from test_he import test_he
            test_he()

    # CKKS bootstrapping: about two minutes, so behind its own toggle (and --all) rather than --unit
    if tests_toggles[RUN_TOGGLES.BOOTSTRAPPING_TEST_FLAG] or tests_toggles[RUN_TOGGLES.RUN_ALL_FLAG]:
        selected += 1
        if mpc.pid == 0:
            from test_bootstrapping import test_bootstrapping
            test_bootstrapping()

    run_mpc = tests_toggles[RUN_TOGGLES.MPC_TEST_FLAG] or run_units
    if run_mpc:
        selected += 1
        from test_mpc import test_mpc
        test_mpc(mpc, modulus)  # includes the MHE tests

    if tests_toggles[RUN_TOGGLES.MHE_FLAG]:
        selected += 1
        if not run_mpc:
            from test_mhe import test_mhe
            test_mhe(mpc, modulus)

    if tests_toggles[RUN_TOGGLES.SHARETENSOR_TEST_FLAG] or run_units:
        selected += 1
        from test_sharetensor import test_sharetensor
        with mpc.default_modulus(modulus):
            test_sharetensor(mpc, modulus)

    if tests_toggles[RUN_TOGGLES.CIPHERTENSOR_TEST_FLAG] or run_units:
        selected += 1
        from test_ciphertensor import test_ciphertensor
        test_ciphertensor(mpc)

    if tests_toggles[RUN_TOGGLES.MPP_TEST_FLAG] or run_units:
        selected += 1
        from test_mpp import test_mpp
        with mpc.default_modulus(modulus):
            test_mpp(mpc, modulus)

    if tests_toggles[RUN_TOGGLES.MPA_TEST_FLAG] or run_units:
        selected += 1
        from test_mpa import test_mpa
        with mpc.default_modulus(modulus):
            test_mpa(mpc, modulus)

    if tests_toggles[RUN_TOGGLES.MPU_TEST_FLAG] or run_units:
        selected += 1
        from test_mpu import test_mpu
        with mpc.default_modulus(modulus):
            test_mpu(mpc, modulus)

    if tests_toggles[RUN_TOGGLES.IR_PASSES_TEST_FLAG] or run_units:
        selected += 1
        from test_ir_passes import test_ir_passes
        test_ir_passes(mpc)

    if tests_toggles[RUN_TOGGLES.STDLIB_BUILTIN_TEST_FLAG] or run_units:
        selected += 1
        from test_stdlib_builtin import test_stdlib_builtin
        with mpc.default_modulus(modulus):
            test_stdlib_builtin(mpc)

    if tests_toggles[RUN_TOGGLES.BITWISE_TEST_FLAG] or run_units:
        selected += 1
        from test_bitwise import test_bitwise
        test_bitwise(mpc)  # ring and field inside, whatever the run's modulus

    if tests_toggles[RUN_TOGGLES.DECOR_TEST_FLAG] or run_units:
        selected += 1
        from test_decor import test_decor
        test_decor(mpc)  # ring and field inside, whatever the run's modulus

    if tests_toggles[RUN_TOGGLES.NONLINEAR_TEST_FLAG] or run_units:
        selected += 1
        from test_nonlinear import test_nonlinear
        test_nonlinear(mpc)  # ring and field inside, whatever the run's modulus

    if tests_toggles[RUN_TOGGLES.ACTIVATIONS_TEST_FLAG] or run_units:
        selected += 1
        from test_activations import test_activations
        with mpc.default_modulus(modulus):
            test_activations(mpc, modulus)

    if run_units:
        print(f'CP{mpc.pid}:\tUnit tests passed.\n')
    return selected
