def test_mpp_getitem(mpp_a, raw_a):
    mpc = mpp_a._mpc
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim getitem", mpp_a[0].reveal(), raw_a[0])
        assert_eq(f"CP{mpc.pid}:\tMPP 1-dim getitem", mpp_a[0][0].reveal(), raw_a[0, 0])
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get slice", mpp_a[:2].reveal(), raw_a[:2])
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get slice-slice tuple", mpp_a[:2, :2].reveal(), raw_a[:2, :2])
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get slice-int tuple", mpp_a[:2, 2].reveal(), raw_a[:2, 2:3])
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get int-slice tuple", mpp_a[2, :2].reveal(), raw_a[2, :2])
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get int-int tuple", mpp_a[2, 2].reveal(), raw_a[2, 2:3])
        
        case_empty_partition_int_idx = mpp_a[:4][0]
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get: case empty second partition int index. Ratios: {case_empty_partition_int_idx._ratios}", case_empty_partition_int_idx.reveal(), raw_a[0])
        case_empty_partition_int_idx = mpp_a[4:6][0]
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get: case empty first partition int index. Ratios: {case_empty_partition_int_idx._ratios}", case_empty_partition_int_idx.reveal(), raw_a[4])
        case_empty_partition_slice_idx = mpp_a[:4][1:]
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get: case empty second partition slice index. Ratios: {case_empty_partition_slice_idx._ratios}", case_empty_partition_slice_idx.reveal(), raw_a[:4][1:])
        case_empty_partition_slice_idx = mpp_a[4:][1:]
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim get: case empty first partition slice index. Ratios: {case_empty_partition_slice_idx._ratios}", case_empty_partition_slice_idx.reveal(), raw_a[4:][1:])


def test_mpp_setitem(_mpp_a, _raw_a):
    mpc = _mpp_a._mpc
    
    mpp_a, raw_a = _mpp_a.copy(), _raw_a.copy()
    mpp_a[0] = mpp_a[1]
    raw_a[0] = raw_a[1]
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim setitem", mpp_a.reveal(), raw_a)
    
    mpp_a, raw_a = _mpp_a.copy(), _raw_a.copy()
    mpp_row = mpp_a[0]
    mpp_row[0] = mpp_row[1]
    raw_a[0, 0] = raw_a[0, 1]
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 1-dim setitem", mpp_row.reveal(), raw_a[0])
    
    mpp_a, raw_a = _mpp_a.copy(), _raw_a.copy()
    mpp_a[:2] = mpp_a[1:3]
    raw_a[:2] = raw_a[1:3]
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim set slice", mpp_a.reveal(), raw_a)
    
    mpp_a, raw_a = _mpp_a.copy(), _raw_a.copy()
    mpp_a[:2, :2] = mpp_a[1:3, 1:3]
    raw_a[:2, :2] = raw_a[1:3, 1:3]
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim set slice-slice tuple", mpp_a.reveal(), raw_a)
    
    mpp_a, raw_a = _mpp_a.copy(), _raw_a.copy()
    mpp_a[:2, 2] = mpp_a[1:3, 3]
    raw_a[:2, 2] = raw_a[1:3, 3]
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim set slice-int tuple", mpp_a.reveal(), raw_a)
    
    mpp_a, raw_a = _mpp_a.copy(), _raw_a.copy()
    mpp_a[2, :2] = mpp_a[3, 1:3]
    raw_a[2, :2] = raw_a[3, 1:3]
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim set int-slice tuple", mpp_a.reveal(), raw_a)
    
    mpp_a, raw_a = _mpp_a.copy(), _raw_a.copy()
    mpp_a[2, 2] = mpp_a[3, 3]
    raw_a[2, 2] = raw_a[3, 3]
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP 2-dim set int-int tuple", mpp_a.reveal(), raw_a)


def test_mpp_transpose(mpp_a, raw_a):
    mpc = mpp_a._mpc
    mhe_t = mpp_a.T.T
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP lazy transpose", mhe_t.reveal(), raw_a)

    mhe_t = mpp_a.T
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP actual transpose", mhe_t.reveal(), raw_a.T)


def test_mpp_mpc_switching(mpp_a, raw_a):
    mpc = mpp_a._mpc
    sharetensor_a = mpp_a.to_sharetensor()
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP -> MPC switch", sharetensor_a.reveal(mpc).astype(int), raw_a)

    mpp_a = sharetensor_a.to_mpp(mpc, mpp_a._ratios, dtype=mpp_a.dtype)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPC -> MPP switch", mpp_a.reveal(), raw_a)


def test_mpp_encrypted_int_to_sharetensor(mpp_a, raw_a):
    """An encrypted int MPP switches to fixed-point shares at every party, CP0 included, so the next fixed-point step (the
    truncation after a product) runs at all of them."""
    mpc = mpp_a._mpc
    encrypted = mpp_a.copy()
    encrypted.encrypt()
    stensor = encrypted.to_sharetensor()
    flags = mpc.comms.collect(stensor.fp, True)
    squared = secure_operator.mul(mpc, stensor, stensor)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP encrypted int -> MPC switch: the same fixed-point flag at every party", all(f == flags[0] for f in flags), True)
        assert_eq_approx(f"CP{mpc.pid}:\tMPP encrypted int -> MPC switch: squared shares", squared.reveal(mpc), (raw_a * raw_a).astype(float), error=0.05)


def test_mpp_elem_wise_operations(mpp_a, mpp_b, raw_a, raw_b):
    mpc = mpp_a._mpc
    mpp_add = mpp_a + mpp_b
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP addition", mpp_add.reveal(), raw_a + raw_b)

    mpp_add = mpp_a.astype(float) + mpp_b
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP autocast addition", mpp_add.reveal().astype(int), raw_a.astype(float) + raw_b)

    _ones = ones((mpp_a._ratios.sum(), raw_a.shape[1]), dtype=int)
    mpp_public_add = mpp_a + _ones
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP public addtition", mpp_public_add.reveal(), raw_a + _ones)

    mpp_sub = mpp_a - mpp_b
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP subtraction", mpp_sub.reveal(), raw_a - raw_b)

    mpp_mul = mpp_a * mpp_b
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP multiplication", mpp_mul.reveal(), raw_a * raw_b)
    
    mpp_mul = mpp_a.astype(float) * mpp_b
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP autocast multiplication", mpp_mul.reveal().astype(int), raw_a.astype(float) * raw_b)
    
    mpp_a_row_mat = mpp_a[0].expand_dims(axis=0)
    row_mat_add = mpp_a_row_mat + mpp_a_row_mat
    raw_a_row_mat = raw_a[0].expand_dims(axis=0)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP addition at CP1 only", row_mat_add.reveal(), raw_a_row_mat + raw_a_row_mat)


def test_mpp_matmul_operations(mpp_a, mpp_b, raw_a, raw_b):
    mpc = mpp_a._mpc
    mpp_dot = mpp_a.dot(axis=1)
    raw_dot = (raw_a * raw_a).sum(axis=1)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP dot 2-dim", mpp_dot.reveal(), raw_dot)
    
    mpp_dot_1_dim = mpp_a[0].dot(axis=0)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP dot 1-dim", mpp_dot_1_dim.reveal()[0], raw_dot[0])
    
    mpp_matmul = mpp_a @ mpp_b.T
    raw_matmul = raw_a @ raw_b.T
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP matrix multiplication non-transposed x transposed", mpp_matmul.reveal(), raw_matmul)

    mpp_matmul = mpp_a.T @ mpp_b
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP matrix multiplication transposed x non-transposed", mpp_matmul.reveal(), raw_a.T @ raw_b)

    _ones = ones((mpp_a._ratios.sum(), raw_a.shape[1]), dtype=int).T
    mpp_public_matmul = mpp_a @ _ones
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP matrix public multiplication", mpp_public_matmul.reveal(), raw_a @ _ones)

    mpp_a_row_mat = mpp_a[0].expand_dims(axis=0)
    row_mat_matmul = mpp_a_row_mat.T @ mpp_a_row_mat
    raw_a_row_mat = raw_a[0].expand_dims(axis=0)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP matrix multiplication transposed x non-transposed at CP1 only", row_mat_matmul.reveal(), raw_a_row_mat.T @ raw_a_row_mat)
    
    mpp_a_row_mat = mpp_a[4].expand_dims(axis=0)
    row_mat_matmul = mpp_a_row_mat.T @ mpp_a_row_mat
    raw_a_row_mat = raw_a[4].expand_dims(axis=0)
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP matrix multiplication transposed x non-transposed at CP2 only", row_mat_matmul.reveal(), raw_a_row_mat.T @ raw_a_row_mat)


def test_mpp_transposed_operations(mpp_a, raw_a):
    mpc = mpp_a._mpc
    mpp_dot = mpp_a @ mpp_a.T
    dot = raw_a @ raw_a.T

    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP self-matmul", mpp_dot.reveal(), dot)

    if mpc.pid:
        mpp_dot_t = mpp_dot.T
        assert_eq(f"CP{mpc.pid}:\tMPP self-matmul transposed", mpp_dot_t.reveal(), dot.T)

    mpp_transposed_add_1 = mpp_dot + mpp_dot.T
    mpp_transposed_add_2 = mpp_dot.T + mpp_dot
    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP transposed addition 1", mpp_transposed_add_1.reveal(), dot + dot.T)
        assert_eq(f"CP{mpc.pid}:\tMPP transposed addition 2", mpp_transposed_add_2.reveal(), dot + dot.T)


def test_mpp_cohort_to_sharetensor(mpc):
    """H-24: conversion to shares with unequal partitions, an empty one, and partitions held in the clear, encrypted, or
    both mixed; and Sharetensor.collective_load of unequal partitions."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in (unequal_ratios(n_cp), ratios_with_empty(n_cp)):
        matrix = cohort_matrix(mpc, ratios.sum(), 4)
        local = partition(mpc, matrix, ratios)
        encrypted = local.copy()
        encrypted.encrypt()
        mixed = local.copy()
        if mpc.pid == 1:
            mixed.encrypt()
        for label, mpp in (("in the clear", local), ("encrypted", encrypted), ("CP1 encrypted, the others in the clear", mixed)):
            revealed = mpp.to_sharetensor().reveal(mpc)
            if mpc.pid:
                assert_eq_approx(f"CP{mpc.pid}:\tMPP -> MPC switch, ratios {ratios}, {label}", revealed, matrix, error=1e-3)
            assert_parties_in_step(mpc, f"MPP -> MPC switch, ratios {ratios}, {label}")

    ratios = unequal_ratios(n_cp)
    cols = 3
    matrix = cohort_matrix(mpc, ratios.sum(), cols)
    start, stop = own_rows(mpc, ratios)
    path = f"tests/data/mhe/cohort_partition_{mpc.pid}.bin"
    if mpc.pid:
        with open(path, "wb") as f: write_ndarray(f, matrix[start:stop], binary=True)
    loaded = Sharetensor.collective_load(mpc, path, rows=stop - start, cols=cols, binary=True, dtype=float)
    revealed = loaded.reveal(mpc)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tSharetensor collective load, ratios {ratios}", revealed, matrix, error=1e-3)
    assert_parties_in_step(mpc, f"Sharetensor collective load, ratios {ratios}")


def test_mpp_tall_encryption(mpc):
    """C-07: tall partitions (more rows than columns) encrypt as themselves, not transposed; also through MPU, for a
    transposed MPP, and in an element-wise operation with the partitions in the clear."""
    n_cp = mpc.comms.number_of_parties - 1
    ratios = unequal_ratios(n_cp)
    matrix = cohort_matrix(mpc, ratios.sum(), 2)
    local = partition(mpc, matrix, ratios)

    encrypted = local.copy()
    encrypted.encrypt()
    transposed = local.T
    transposed.encrypt()
    start, stop = own_rows(mpc, ratios)
    mpu = MPU(mpc, matrix[start:stop] if mpc.pid else matrix, "partition")
    mpu.encrypt()
    added = encrypted + local

    revealed = encrypted.reveal()
    revealed_t = transposed.reveal()
    revealed_mpu = mpu.reveal()
    revealed_added = added.reveal()
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPP encrypt, tall partitions {ratios} x 2", revealed, matrix, error=1e-3)
        assert_eq_approx(f"CP{mpc.pid}:\tMPP encrypt, transposed, tall partitions", revealed_t, matrix.T, error=1e-3)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU encrypt, tall partitions", revealed_mpu, matrix, error=1e-3)
        assert_eq_approx(f"CP{mpc.pid}:\tMPP encrypted + in the clear, tall partitions", revealed_added, matrix * 2.0, error=1e-3)
    assert_parties_in_step(mpc, "MPP encrypt, tall partitions")


def test_mpp_partitioned_vectors(mpc):
    """C-06: one-dimensional MPPs of which every compute party holds a slice of its own length (a column of a
    transposed MPP), in the clear and encrypted, through element-wise operations; the operands keep their slices."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in ([4 for _ in range(n_cp)], unequal_ratios(n_cp)):
        matrix = cohort_matrix(mpc, ratios.sum(), 3)
        expected = column(matrix, 1)
        # What a column of a transposed MPP is (mpp.T[1]), built from each party's slice copied (test_mpp_columns takes
        # mpp.T[j] itself, a strided view of each partition)
        start, stop = own_rows(mpc, ratios)
        vector = MPP[Tuple[int], float](
            _mpc=mpc,
            _ratios=ratios,
            _local_data=expected.zeros() if mpc.pid == 0 else expected[start:stop].copy(),
            _transposed=True)
        encrypted = vector.copy()
        encrypted.encrypt()

        doubled = vector + vector
        squared = vector * vector
        mixed = encrypted + vector
        encrypted_squared = encrypted * encrypted
        # A mixed cohort (M-MP-21): CP1 holds its slice encrypted, the others in the clear
        mixed_vector = vector.copy()
        if mpc.pid == 1:
            mixed_vector.encrypt()
        mixed_squared = mixed_vector * mixed_vector
        assert_parties_in_step(mpc, f"MPP mixed partitioned vector squared, ratios {ratios}")

        revealed = vector.reveal()
        revealed_doubled = doubled.reveal()
        revealed_squared = squared.reveal()
        revealed_mixed = mixed.reveal()
        revealed_encrypted_squared = encrypted_squared.reveal()
        revealed_mixed_squared = mixed_squared.reveal()
        revealed_after = vector.reveal()
        revealed_encrypted_after = encrypted.reveal()
        if mpc.pid:
            label = f"MPP partitioned vector, ratios {ratios}"
            assert_eq(f"CP{mpc.pid}:\t{label}", revealed, expected)
            assert_eq(f"CP{mpc.pid}:\t{label}: v + v", revealed_doubled, expected * 2.0)
            assert_eq(f"CP{mpc.pid}:\t{label}: v * v", revealed_squared, expected * expected)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: encrypted + in the clear", revealed_mixed, expected * 2.0, error=1e-3)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: encrypted * encrypted", revealed_encrypted_squared, expected * expected, error=1e-2)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: mixed * mixed", revealed_mixed_squared, expected * expected, error=1e-2)
            assert_eq(f"CP{mpc.pid}:\t{label}: operand kept", revealed_after, expected)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: encrypted operand kept", revealed_encrypted_after, expected, error=1e-3)
        assert_parties_in_step(mpc, f"MPP partitioned vector, ratios {ratios}")


def test_mpp_cohort_comparisons(mpc):
    """C-05: comparisons with partitions in the clear (each compute party compares its own, CP0 takes no part), encrypted
    (the secure comparison, at every party), and mixed; unequal and empty partitions; MPC work right after each."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in (unequal_ratios(n_cp), ratios_with_empty(n_cp)):
        matrix = cohort_matrix(mpc, ratios.sum(), 4)
        local = partition(mpc, matrix, ratios)
        encrypted = local.copy()
        encrypted.encrypt()
        mixed = local.copy()
        if mpc.pid == 1:
            mixed.encrypt()
        expected_gt = (matrix > 0.0).astype(float)
        expected_lt = (matrix < 1.0).astype(float)

        greater = local > 0.0
        assert_parties_in_step(mpc, f"MPP > 0 in the clear, ratios {ratios}")
        less = local < 1.0
        assert_parties_in_step(mpc, f"MPP < 1 in the clear, ratios {ratios}")
        masked = greater * local
        greater_encrypted = encrypted > 0.0
        assert_parties_in_step(mpc, f"MPP > 0 encrypted, ratios {ratios}")
        less_encrypted = encrypted < 1.0
        assert_parties_in_step(mpc, f"MPP < 1 encrypted, ratios {ratios}")
        greater_mixed = mixed > 0.0
        assert_parties_in_step(mpc, f"MPP > 0 mixed, ratios {ratios}")

        revealed = [greater.reveal(), less.reveal(), masked.reveal(), greater_encrypted.reveal(), less_encrypted.reveal(), greater_mixed.reveal()]
        if mpc.pid:
            label = f"ratios {ratios}"
            assert_eq(f"CP{mpc.pid}:\tMPP > 0 in the clear, {label}", revealed[0], expected_gt)
            assert_eq(f"CP{mpc.pid}:\tMPP < 1 in the clear, {label}", revealed[1], expected_lt)
            assert_eq(f"CP{mpc.pid}:\tMPP (x > 0) * x in the clear, {label}", revealed[2], expected_gt * matrix)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP > 0 encrypted, {label}", revealed[3], expected_gt, error=1e-2)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP < 1 encrypted, {label}", revealed[4], expected_lt, error=1e-2)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP > 0 mixed, {label}", revealed[5], expected_gt, error=1e-2)


def test_mpp_cohort_products(mpc):
    """M-MP-18 (H-33): A @ B.T with every compute party running the same HE products (three or more of them, unequal
    and empty partitions, the first factor in the clear and encrypted). H-53: MPP @ ndarray under allow_mpc_switch with
    the switch to MPC chosen, encrypted and in the clear."""
    n_cp = mpc.comms.number_of_parties - 1
    # The first factor encrypted makes the product one of ciphertexts, which costs about a second per result cell
    # (M1): small partitions for it
    small = [1 for _ in range(n_cp)]
    small[-1] = 2
    small_with_empty = small.copy()
    small_with_empty[0 if n_cp == 2 else 1] = 0
    for ratios, encrypted_ratios in ((unequal_ratios(n_cp), small), (ratios_with_empty(n_cp), small_with_empty)):
        a_matrix = cohort_matrix(mpc, ratios.sum(), 4)
        b_matrix = cohort_matrix(mpc, ratios.sum(), 4)
        product = partition(mpc, a_matrix, ratios) @ partition(mpc, b_matrix, ratios).T
        assert_parties_in_step(mpc, f"MPP A @ B.T in the clear, ratios {ratios}")

        a_small = cohort_matrix(mpc, encrypted_ratios.sum(), 4)
        b_small = cohort_matrix(mpc, encrypted_ratios.sum(), 4)
        a_encrypted = partition(mpc, a_small, encrypted_ratios)
        a_encrypted.encrypt()
        product_encrypted = a_encrypted @ partition(mpc, b_small, encrypted_ratios).T
        assert_parties_in_step(mpc, f"MPP A @ B.T, A encrypted, ratios {encrypted_ratios}")

        revealed = product.reveal()
        revealed_encrypted = product_encrypted.reveal()
        if mpc.pid:
            assert_eq_approx(f"CP{mpc.pid}:\tMPP A @ B.T in the clear, ratios {ratios}", revealed, a_matrix @ b_matrix.T, error=0.01)
            expected_small = a_small @ b_small.T
            assert_eq_approx(f"CP{mpc.pid}:\tMPP A @ B.T, A encrypted, ratios {encrypted_ratios}", revealed_encrypted, expected_small, error=0.01)
            # L-225: each party's own block comes from a product of its own, apart from the others' blocks
            for q in holders(encrypted_ratios):
                start, stop = own_rows_of(q, encrypted_ratios)
                assert_eq_approx(
                    f"CP{mpc.pid}:\tMPP A @ B.T, A encrypted, ratios {encrypted_ratios}: CP{q}'s own block",
                    block(revealed_encrypted, start, stop), block(expected_small, start, stop), error=0.01)

        matrix = cohort_matrix(mpc, ratios.sum(), 64)
        public = cohort_matrix(mpc, 64, 3) * 0.25
        local = partition(mpc, matrix, ratios)
        encrypted = local.copy()
        encrypted.encrypt()
        with mpc.allow_mpc_switch():
            switches = MPP._public_matmul_via_mpc_wins(mpc, ratios, [64, 3])
            product_via_mpc = encrypted @ public
            product_local = local @ public
        assert_parties_in_step(mpc, f"MPP @ ndarray under allow_mpc_switch, ratios {ratios}")

        revealed_via_mpc = product_via_mpc.reveal()
        revealed_local = product_local.reveal()
        assert_eq(f"CP{mpc.pid}:\tMPP @ ndarray under allow_mpc_switch, ratios {ratios}: route via MPC", switches, True)
        if mpc.pid:
            expected = matrix @ public
            assert_eq_approx(f"CP{mpc.pid}:\tMPP @ ndarray via MPC, encrypted, ratios {ratios}", revealed_via_mpc, expected, error=0.01)
            assert_eq(f"CP{mpc.pid}:\tMPP @ ndarray under allow_mpc_switch, in the clear, ratios {ratios}", revealed_local, expected)

def own_rows_of(q: int, ratios: List[int]) -> Tuple[int, int]:
    # The rows compute party q holds
    start = ratios[:q - 1].sum()
    return start, start + ratios[q - 1]


def block(matrix, start: int, stop: int):
    # A copy of matrix[start:stop, start:stop] (a party's own block of an A @ B.T result)
    return array([[matrix[i, j] for j in range(start, stop)] for i in range(start, stop)])


def test_mpp_mixed_cohorts(mpc):
    """M-MP-21: element-wise operations, powers and products with a plaintext matrix on mixed cohorts, where some compute
    parties hold their partition encrypted and the others in the clear: equal partitions, and unequal ones with an empty
    one (element-wise operations pad nothing). M-MP-01: by a small int (additions on an encrypted partition) at every
    party alike. M-MP-05: a transposition mismatch, the operand converted before any padding. The semi-encrypted results
    of A @ B.T in the clear (each party with other blocks, M-MP-03). Every party in step after each operation."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in ([3 for _ in range(n_cp)], ratios_with_empty(n_cp)):
        rows = ratios.sum()
        a = cohort_matrix(mpc, rows, 4)
        b = cohort_matrix(mpc, rows, 4)
        public = cohort_matrix(mpc, 4, 3) * 0.25
        local_a = partition(mpc, a, ratios)
        local_b = partition(mpc, b, ratios)
        parties = holders(ratios)
        # The first party that holds rows encrypts its partition of A; every party but the last encrypts its one of B
        mixed_a = encrypted_at(mpc, local_a, parties[:1])
        mixed_b = encrypted_at(mpc, local_b, parties[:-1])
        label = f"ratios {ratios}"

        names = ["mixed * 0.5", "mixed * ndarray", "mixed * MPP in the clear", "mixed * MPP mixed the other way",
                 "mixed * 3 (additions)", "mixed * -2 (additions)", "in the clear * 3", "mixed + MPP in the clear",
                 "mixed - ndarray", "ndarray - mixed", "mixed ** 2", "mixed @ ndarray"]
        expected = [a * 0.5, a * b, a * b, a * b, a * 3.0, a * -2.0, a * 3.0, a + b, a - b, b - a, a * a, a @ public]
        results = List[MPP[Tuple[int, int], float]]()
        for i in range(len(names)):
            if i == 0: results.append(mixed_a * 0.5)
            elif i == 1: results.append(mixed_a * b)
            elif i == 2: results.append(mixed_a * local_b)
            elif i == 3: results.append(mixed_a * mixed_b)
            elif i == 4: results.append(mixed_a * 3)
            elif i == 5: results.append(mixed_a * -2)
            elif i == 6: results.append(local_a * 3)
            elif i == 7: results.append(mixed_a + local_b)
            elif i == 8: results.append(mixed_a - b)
            elif i == 9: results.append(b - mixed_a)
            elif i == 10: results.append(mixed_a ** 2)
            else: results.append(mixed_a @ public)
            assert_parties_in_step(mpc, f"MPP {names[i]}, {label}")
        revealed = [result.reveal() for result in results]
        if mpc.pid:
            for i in range(len(names)):
                assert_eq_approx(f"CP{mpc.pid}:\tMPP {names[i]}, {label}", revealed[i], expected[i], error=0.01)

        # A transposition mismatch: the operand goes through MPC whole, into this one's orientation
        x = cohort_matrix(mpc, rows, rows)
        local_x = partition(mpc, x, ratios)
        mixed_x = encrypted_at(mpc, local_x, parties[:1])
        summed = mixed_x + mixed_x.T
        assert_parties_in_step(mpc, f"MPP mixed X + X.T, {label}")
        multiplied = mixed_x * local_x.T
        assert_parties_in_step(mpc, f"MPP mixed X * X.T, {label}")

        # A @ B.T in the clear leaves each party a block in the clear between encrypted ones, which differ by party. (K by
        # an encrypted MPP would multiply K's column-wise blocks by a row-wise encryption, which deadlocks: M-MHE-21.)
        k = local_a @ local_b.T
        ab = a @ b.T
        k_scaled = k * 0.5
        assert_parties_in_step(mpc, f"MPP K * 0.5, K = A @ B.T, {label}")
        k_minus = k - ab
        assert_parties_in_step(mpc, f"MPP K - ndarray, {label}")
        k_clear = k * partition(mpc, ab, ratios)
        assert_parties_in_step(mpc, f"MPP K * MPP in the clear, {label}")
        k_squared = k * k
        assert_parties_in_step(mpc, f"MPP K * K, {label}")

        revealed_summed = summed.reveal()
        revealed_multiplied = multiplied.reveal()
        revealed_k_scaled = k_scaled.reveal()
        revealed_k_minus = k_minus.reveal()
        revealed_k_clear = k_clear.reveal()
        revealed_k_squared = k_squared.reveal()
        if mpc.pid:
            assert_eq_approx(f"CP{mpc.pid}:\tMPP mixed X + X.T, {label}", revealed_summed, x + x.T, error=1e-3)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP mixed X * X.T, {label}", revealed_multiplied, x * x.T, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP K * 0.5, K = A @ B.T, {label}", revealed_k_scaled, ab * 0.5, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP K - ndarray, {label}", revealed_k_minus, ab * 0.0, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP K * MPP in the clear, {label}", revealed_k_clear, ab * ab, error=0.1)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP K * K, {label}", revealed_k_squared, ab * ab, error=0.1)


def test_mpp_mixed_products(mpc):
    """M-MP-21: products of two secret factors with a mixed one: A.T @ B (also with every partition encrypted, whose
    result came back in the wrong layout: H-25), and A @ B.T with a mixed first factor (encrypted at every party for the
    product, then each party's own block apart: L-225) or a mixed second one."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in (unequal_ratios(n_cp), ratios_with_empty(n_cp)):
        a = cohort_matrix(mpc, ratios.sum(), 4)
        b = cohort_matrix(mpc, ratios.sum(), 4)
        local_a = partition(mpc, a, ratios)
        local_b = partition(mpc, b, ratios)
        parties = holders(ratios)
        mixed_a = encrypted_at(mpc, local_a, parties[:1])
        encrypted_a = encrypted_at(mpc, local_a, parties)
        label = f"ratios {ratios}"
        mixed_t = mixed_a.T @ local_b
        assert_parties_in_step(mpc, f"MPP mixed.T @ B, {label}")
        t_mixed = local_b.T @ mixed_a
        assert_parties_in_step(mpc, f"MPP B.T @ mixed, {label}")
        encrypted_t = encrypted_a.T @ local_b
        assert_parties_in_step(mpc, f"MPP encrypted.T @ B, {label}")
        revealed = [mixed_t.reveal(), t_mixed.reveal(), encrypted_t.reveal()]
        if mpc.pid:
            assert_eq_approx(f"CP{mpc.pid}:\tMPP mixed.T @ B, {label}", revealed[0], a.T @ b, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP B.T @ mixed, {label}", revealed[1], b.T @ a, error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPP encrypted.T @ B, {label}", revealed[2], a.T @ b, error=0.01)

    # The first factor encrypted makes the product one of ciphertexts, about a second per result cell here (M1): small
    # partitions
    small = [1 for _ in range(n_cp)]
    small[-1] = 2
    a = cohort_matrix(mpc, small.sum(), 4)
    b = cohort_matrix(mpc, small.sum(), 4)
    local_a = partition(mpc, a, small)
    local_b = partition(mpc, b, small)
    parties = holders(small)
    mixed_a = encrypted_at(mpc, local_a, parties[:1])
    mixed_b = encrypted_at(mpc, local_b, parties[1:])
    label = f"ratios {small}"
    product = mixed_a @ local_b.T
    assert_parties_in_step(mpc, f"MPP mixed @ B.T, {label}")
    product_mixed_b = mixed_a @ mixed_b.T
    assert_parties_in_step(mpc, f"MPP mixed @ mixed.T, {label}")
    revealed_product = product.reveal()
    revealed_mixed_b = product_mixed_b.reveal()
    if mpc.pid:
        expected = a @ b.T
        assert_eq_approx(f"CP{mpc.pid}:\tMPP mixed @ B.T, {label}", revealed_product, expected, error=0.01)
        for q in parties:
            start, stop = own_rows_of(q, small)
            assert_eq_approx(
                f"CP{mpc.pid}:\tMPP mixed @ B.T, {label}: CP{q}'s own block",
                block(revealed_product, start, stop), block(expected, start, stop), error=0.01)
        assert_eq_approx(f"CP{mpc.pid}:\tMPP mixed @ mixed.T, {label}", revealed_mixed_b, expected, error=0.01)


def check_sum(mpc, label: str, s, want, within: bool, ratios: List[int], error: float, next_op: int):
    # A sum's metadata at every party, CP0 included (within the partitions a column split with the operand's ratios,
    # across them a row at CP1), its values, and then one next operation: an element-wise one with a compatible MPP (0),
    # the switch to MPC (1), or an MPU around it (2). The element-wise one follows the reveal, which caches an encryption
    # beside a vector held in the clear (M-MP-26: the aligner then left the padding of unequal vectors uncut).
    n_cp = mpc.comms.number_of_parties - 1
    want_ratios = ratios.copy() if within else one_hot_vector(idx=0, size=n_cp, TP=int)
    assert_eq(f"CP{mpc.pid}:\t{label}: ratios", s._ratios, want_ratios)
    assert_eq(f"CP{mpc.pid}:\t{label}: transposed", s._transposed, within)
    assert_eq(f"CP{mpc.pid}:\t{label}: cohort shape", s.cohort_shape[0], len(want))
    revealed = s.reveal()
    if next_op == 0:
        revealed_next = (s + s).reveal()
        want_next = want * 2.0
    elif next_op == 1:
        revealed_next = array(s.to_sharetensor().reveal(mpc))
        want_next = want
    else:
        wrapped = MPU[Tuple[int], float](_mpp=s, _mpa=MPA[Tuple[int], float](mpc))
        assert_eq(f"CP{mpc.pid}:\t{label}: MPU shape", wrapped.shape[0], len(want))
        revealed_next = wrapped.reveal()
        want_next = want
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\t{label}", revealed, want, error=error)
        names = ["s + s", "to_sharetensor", "MPU"]
        assert_eq_approx(f"CP{mpc.pid}:\t{label}: {names[next_op]}", revealed_next, want_next, error=2.0 * error)


def test_mpp_sums(mpc):
    """M-MP-23, H-30, M-MP-13: MPP.sum of cohorts in the clear, encrypted (row-wise, and column-wise: X.T.encrypt()),
    mixed (the first holder encrypted; with two compute parties and an empty partition the only holder is that one), and
    semi-encrypted (K = A @ B.T in the clear); equal, unequal and empty partitions; transposed or not; both axes. Within
    the partitions the sums used to be a held row's metadata, encrypted partitions came back empty when any party held
    its own in the clear, and encrypted ones crashed in the aligner's revert at unequal ratios; across them a transposed
    operand's came back as a column. Each sum runs on a fresh copy (a sum across the partitions unifies a semi-encrypted
    one, which later sums would then take whole): its metadata at every party, its values, one next operation; every
    party in step after each kind. Then row sums held differently at a party in element-wise operations."""
    n_cp = mpc.comms.number_of_parties - 1
    cols = 4
    next_op = 0
    for ratios in sum_ratios(n_cp):
        rows = ratios.sum()
        a = cohort_matrix(mpc, rows, cols)
        b = cohort_matrix(mpc, rows, cols)
        local = partition(mpc, a, ratios)
        parties = holders(ratios)
        encrypted = encrypted_at(mpc, local, parties)
        column_wise = local.T
        column_wise.encrypt()
        mixed = encrypted_at(mpc, local, parties[:1])
        k = local @ partition(mpc, b, ratios).T
        ab = a @ b.T
        cases = [("in the clear", local, a), ("encrypted", encrypted, a), ("encrypted column-wise", column_wise.T, a),
                 ("mixed", mixed, a), ("A @ B.T", k, ab)]
        for kind, mpp, m in cases:
            for transposed in (False, True):
                for axis in (0, 1):
                    x = mpp.T if transposed else mpp.copy()
                    within = (axis ^ int(transposed)) == 1
                    label = f"MPP {kind}{'.T' if transposed else ''}.sum({axis}), ratios {ratios}"
                    error = 0.05 if kind == "A @ B.T" else 0.01
                    check_sum(mpc, label, x.sum(axis), m.sum(axis=1) if within else m.sum(axis=0), within, ratios, error, next_op % 3)
                    next_op += 1
            assert_parties_in_step(mpc, f"MPP {kind} sums, ratios {ratios}")

        # Row sums that a party holds differently (the mixed cohort's against those in the clear, or encrypted) meet at one
        # length in an element-wise operation: padded each to the longest of its own kind, they crashed or refreshed at
        # one party only at unequal ratios
        mixed_rows = mixed.copy().sum(1)
        clear_rows = local.copy().sum(1)
        encrypted_rows = encrypted.copy().sum(1)
        row_sums = a.sum(axis=1)
        pairs = ["mixed + in the clear", "in the clear + mixed", "mixed * in the clear", "mixed + encrypted"]
        wants = [row_sums * 2.0, row_sums * 2.0, row_sums * row_sums, row_sums * 2.0]
        results = List[MPP[Tuple[int], float]]()
        for i in range(len(pairs)):
            if i == 0: results.append(mixed_rows + clear_rows)
            elif i == 1: results.append(clear_rows + mixed_rows)
            elif i == 2: results.append(mixed_rows * clear_rows)
            else: results.append(mixed_rows + encrypted_rows)
            assert_parties_in_step(mpc, f"MPP row sums {pairs[i]}, ratios {ratios}")
        revealed_pairs = [result.reveal() for result in results]
        if mpc.pid:
            for i in range(len(pairs)):
                assert_eq_approx(f"CP{mpc.pid}:\tMPP row sums {pairs[i]}, ratios {ratios}", revealed_pairs[i], wants[i], error=0.05)


def test_mpp_sum_vectors(mpc):
    """H-30: a held row's sum stays with its holder (CP1 or another), a column's sum is a column of length 1 at CP1;
    in the clear, encrypted, and (a column) mixed; equal, unequal and empty partitions. A column minus its sum still
    broadcasts the sum (MPP.broadcast) where the column is encrypted with more than one element in each partition. L-103:
    otherwise, and for a row minus a column sum held elsewhere, every party raises the same error, CP0 included (an
    assertion at the compute parties only)."""
    n_cp = mpc.comms.number_of_parties - 1
    cols = 5
    for ratios in sum_ratios(n_cp):
        rows = ratios.sum()
        a = cohort_matrix(mpc, rows, cols)
        local = partition(mpc, a, ratios)
        parties = holders(ratios)
        encrypted = encrypted_at(mpc, local, parties)
        start, stop = own_rows(mpc, ratios)
        for kind, x in (("in the clear", local), ("encrypted", encrypted)):
            for r in (0, rows - 1):
                holder = 0
                while r >= ratios[:holder + 1].sum():
                    holder += 1
                label = f"MPP held row {r} (CP{holder + 1}) {kind}.sum(0), ratios {ratios}"
                s = x[r].sum(0)
                assert_eq(f"CP{mpc.pid}:\t{label}: ratios", s._ratios, one_hot_vector(idx=holder, size=n_cp, TP=int))
                assert_eq(f"CP{mpc.pid}:\t{label}: not transposed", s._transposed, False)
                assert_eq(f"CP{mpc.pid}:\t{label}: cohort shape", s.cohort_shape[0], 1)
                revealed_mpc = array(s.to_sharetensor().reveal(mpc))
                revealed = s.reveal()
                want = array([a[r].sum()])
                if mpc.pid:
                    assert_eq_approx(f"CP{mpc.pid}:\t{label}", revealed, want, error=0.01)
                    assert_eq_approx(f"CP{mpc.pid}:\t{label}: to_sharetensor", revealed_mpc, want, error=0.01)
            expected = column(a, 1)
            vector = MPP[Tuple[int], float](
                _mpc=mpc,
                _ratios=ratios,
                _local_data=expected.zeros() if mpc.pid == 0 else expected[start:stop].copy(),
                _transposed=True)
            if kind == "encrypted":
                vector.encrypt()
            s = vector.sum(0)
            label = f"MPP column {kind}.sum(0), ratios {ratios}"
            assert_eq(f"CP{mpc.pid}:\t{label}: ratios", s._ratios, one_hot_vector(idx=0, size=n_cp, TP=int))
            assert_eq(f"CP{mpc.pid}:\t{label}: transposed", s._transposed, True)
            assert_eq(f"CP{mpc.pid}:\t{label}: cohort shape", s.cohort_shape[0], 1)
            revealed = s.reveal()
            if mpc.pid:
                assert_eq_approx(f"CP{mpc.pid}:\t{label}", revealed, array([expected.sum()]), error=0.01)
            # A column minus its sum: MPP.broadcast spreads the sum over a column encrypted at every compute party with
            # more than one element in each partition; otherwise (in the clear, a partition of one element or none) every
            # party raises alike (L-103: an assertion at the compute parties only, while CP0 went on)
            if kind == "encrypted" and ratios.same():
                centered = (vector - vector.sum(0)).reveal()
                if mpc.pid:
                    assert_eq_approx(f"CP{mpc.pid}:\tMPP encrypted column minus its sum, ratios {ratios}", centered, expected - expected.sum(), error=0.01)
            else:
                raised = False
                try:
                    vector - vector.sum(0)
                except NotImplementedError:
                    raised = True
                assert_eq(f"CP{mpc.pid}:\tMPP column {kind} minus its sum raises at every party, ratios {ratios}", raised, True)
            assert_parties_in_step(mpc, f"MPP 1-dim sums {kind}, ratios {ratios}")

        mixed_vector = MPP[Tuple[int], float](
            _mpc=mpc,
            _ratios=ratios,
            _local_data=column(a, 2).zeros() if mpc.pid == 0 else column(a, 2)[start:stop].copy(),
            _transposed=True)
        if mpc.pid == parties[0]:
            mixed_vector.encrypt()
        revealed = mixed_vector.sum(0).reveal()
        if mpc.pid:
            assert_eq_approx(f"CP{mpc.pid}:\tMPP column mixed.sum(0), ratios {ratios}", revealed, array([column(a, 2).sum()]), error=0.01)
        assert_parties_in_step(mpc, f"MPP mixed column sum, ratios {ratios}")

        raised = False
        try:
            local[rows - 1] - local.sum(0)
        except NotImplementedError:
            raised = True
        assert_eq(f"CP{mpc.pid}:\tMPP a held row minus a column sum held by another party raises at every party, ratios {ratios}", raised, True)
        assert_parties_in_step(mpc, f"MPP row minus column sum, ratios {ratios}")

    # A column whose first partition's length is a multiple of the slots and the others' not, minus its sum: broadcast's
    # replication would refresh once at the first party and twice at the others (a desync); every party raises
    slots = mpc.mhe.crypto_params.params.slots()
    ratios = [2 for _ in range(n_cp)]
    ratios[0] = slots
    start, stop = own_rows(mpc, ratios)
    expected = column(cohort_matrix(mpc, ratios.sum(), 1), 0)
    vector = MPP[Tuple[int], float](
        _mpc=mpc,
        _ratios=ratios,
        _local_data=expected.zeros() if mpc.pid == 0 else expected[start:stop].copy(),
        _transposed=True)
    vector.encrypt()
    raised = False
    try:
        vector - vector.sum(0)
    except NotImplementedError:
        raised = True
    assert_eq(f"CP{mpc.pid}:\tMPP encrypted column with a partition of {slots} elements minus its sum raises at every party", raised, True)
    assert_parties_in_step(mpc, "MPP column with a partition of slots elements minus its sum")

    # A cohort without rows sums to nothing, at every party alike (the hub raised alone)
    empty = MPP[Tuple[int, int], float](_mpc=mpc, _ratios=[0 for _ in range(n_cp)], _local_data=zeros((0, 3), dtype=float))
    empty_sums = empty.sum(0)
    assert_eq(f"CP{mpc.pid}:\tMPP without rows .sum(0): ratios", empty_sums._ratios, one_hot_vector(idx=0, size=n_cp, TP=int))
    assert_parties_in_step(mpc, "MPP without rows .sum(0)")


def diagonal_partition(mpc, matrix, ratios: List[int]) -> MPP[Tuple[int, int], float]:
    # Each compute party's rows encrypted diagonal-wise, as the switch from MPC leaves them under
    # default_encoding(ENC_DIAG) (CP0 keeps a placeholder)
    start, stop = own_rows(mpc, ratios)
    if mpc.pid == 0:
        return MPP[Tuple[int, int], float](_mpc=mpc, _ratios=ratios, _local_data=matrix.zeros())
    encryption = Ciphertensor[Ciphertext].enc(mpc, matrix[start:stop], encoding=ENC_DIAG)
    return MPP[Tuple[int, int], float](_mpc=mpc, _ratios=ratios, _encryption_unified=encryption)


def test_mpp_sum_encodings(mpc):
    """Sums of diagonal-encoded partitions (what MPC switches return under default_encoding(ENC_DIAG)): column sums of
    wide and skinny storages (a skinny one folds its diagonals with masked products), also at unequal ratios with both
    kinds at once, where the other parties make up the folds' refreshes; row sums of them, and their join, raise at every
    compute party (a diagonal storage cannot be summed along its rows, nor stacked; CP0 returns its placeholder). Partial sums of partitions in the
    clear under default_encoding(ENC_DIAG) are encrypted row-wise (a vector in the ambient encoding asserted). Every party
    in step after each."""
    n_cp = mpc.comms.number_of_parties - 1
    mixed_shapes = [2 * (q + 1) for q in range(n_cp)]  # 2 x 2 (not skinny), 4 x 2, 6 x 2, ... (skinny)
    for label, ratios, cols in (("wide", [2 for _ in range(n_cp)], 4), ("skinny", [4 for _ in range(n_cp)], 2), ("square and skinny", mixed_shapes, 2)):
        a = cohort_matrix(mpc, ratios.sum(), cols)
        x = diagonal_partition(mpc, a, ratios)
        column_sums = x.sum(0).reveal()
        assert_parties_in_step(mpc, f"MPP {label} diagonal partitions .sum(0), ratios {ratios}")
        mpu_sums = MPU[Tuple[int, int], float](_mpp=x, _mpa=MPA[Tuple[int, int], float](mpc)).sum(0).reveal()
        assert_parties_in_step(mpc, f"MPU {label} diagonal partitions .sum(0), ratios {ratios}")
        raised = False
        try:
            x.sum(1)
        except NotImplementedError:
            raised = True
        assert_parties_in_step(mpc, f"MPP {label} diagonal partitions .sum(1), ratios {ratios}")
        assert_eq(f"CP{mpc.pid}:\tMPP {label} diagonal partitions .sum(1) raises at every compute party, ratios {ratios}", raised, mpc.pid > 0)
        # Their join (MPU * MPA takes it) neither: Ciphertensor.extend does not stack diagonal storages (it gave a wrong
        # tensor; with a partition in the clear beside them, a wrong shape or an assertion at one party)
        raised = False
        try:
            x.join()
        except NotImplementedError:
            raised = True
        assert_parties_in_step(mpc, f"MPP {label} diagonal partitions joined, ratios {ratios}")
        assert_eq(f"CP{mpc.pid}:\tMPP {label} diagonal partitions' join raises at every compute party, ratios {ratios}", raised, mpc.pid > 0)
        if mpc.pid:
            assert_eq_approx(f"CP{mpc.pid}:\tMPP {label} diagonal partitions .sum(0), ratios {ratios}", column_sums, a.sum(axis=0), error=0.01)
            assert_eq_approx(f"CP{mpc.pid}:\tMPU {label} diagonal partitions .sum(0), ratios {ratios}", mpu_sums, a.sum(axis=0), error=0.01)

    ratios = [q + 1 for q in range(n_cp)]
    a = cohort_matrix(mpc, ratios.sum(), 4)
    local = partition(mpc, a, ratios)
    mixed = encrypted_at(mpc, local, [1])
    with mpc.default_encoding(ENC_DIAG):
        clear_sums = local.sum(0).reveal()
        assert_parties_in_step(mpc, "MPP in the clear .sum(0) under ENC_DIAG")
        mixed_sums = mixed.sum(0).reveal()
        assert_parties_in_step(mpc, "MPP mixed .sum(0) under ENC_DIAG")
        mpu_sums = MPU[Tuple[int, int], float](_mpp=mixed, _mpa=MPA[Tuple[int, int], float](mpc)).sum(0).reveal()
        assert_parties_in_step(mpc, "MPU mixed .sum(0) under ENC_DIAG")
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPP in the clear .sum(0) under ENC_DIAG, ratios {ratios}", clear_sums, a.sum(axis=0), error=0.01)
        assert_eq_approx(f"CP{mpc.pid}:\tMPP mixed .sum(0) under ENC_DIAG, ratios {ratios}", mixed_sums, a.sum(axis=0), error=0.01)
        assert_eq_approx(f"CP{mpc.pid}:\tMPU mixed .sum(0) under ENC_DIAG, ratios {ratios}", mpu_sums, a.sum(axis=0), error=0.01)


def test_mpp_pad_with_value(mpc):
    """H-16: pad_with_value (LinReg's and LogReg's bias column) on MPPs whose partitions are in the clear (padded with
    ones whatever the value), encrypted and mixed (the appendix came out column-wise and concat asserted), and
    semi-encrypted (A @ A.T: the left block was dropped, and the block in the clear and the right block both padded);
    equal, unequal and empty partitions; a transposed MPP along axis 0. Every party pads its own rows with the value,
    and the operand stays as it was."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in ([2 for _ in range(n_cp)], unequal_ratios(n_cp), ratios_with_empty(n_cp)):
        matrix = cohort_matrix(mpc, ratios.sum(), 3)
        expected = with_columns(matrix, 2, 7.5)
        clear = partition(mpc, matrix, ratios)
        padded = clear.pad_with_value(7.5, 2, 1)
        encrypted = encrypted_at(mpc, clear, holders(ratios))
        padded_encrypted = encrypted.pad_with_value(7.5, 2, 1)
        padded_encrypted_transposed = encrypted.T.pad_with_value(-1.0, 1, 0)
        padded_mixed = encrypted_at(mpc, clear, [1]).pad_with_value(7.5, 2, 1)
        semi = clear @ clear.T
        padded_semi = semi.pad_with_value(1.0, 1, 1)
        padded_transposed = clear.T.pad_with_value(-1.0, 1, 0)
        assert_parties_in_step(mpc, f"MPP pad_with_value, ratios {ratios}")

        revealed = padded.reveal()
        revealed_encrypted = padded_encrypted.reveal()
        revealed_mixed = padded_mixed.reveal()
        revealed_semi = padded_semi.reveal()
        revealed_transposed = padded_transposed.reveal()
        revealed_encrypted_transposed = padded_encrypted_transposed.reveal()
        revealed_operand = clear.reveal()
        revealed_encrypted_operand = encrypted.reveal()
        if mpc.pid:
            label = f"MPP pad_with_value, ratios {ratios}"
            assert_eq(f"CP{mpc.pid}:\t{label}: in the clear", revealed, expected)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: encrypted", revealed_encrypted, expected, error=1e-3)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: mixed", revealed_mixed, expected, error=1e-3)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: semi-encrypted (A @ A.T)", revealed_semi, with_columns(matrix @ matrix.T, 1, 1.0), error=0.05)
            assert_eq(f"CP{mpc.pid}:\t{label}: transposed, along axis 0", revealed_transposed, with_columns(matrix, 1, -1.0).T)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: encrypted and transposed, along axis 0", revealed_encrypted_transposed, with_columns(matrix, 1, -1.0).T, error=1e-3)
            assert_eq(f"CP{mpc.pid}:\t{label}: operand kept", revealed_operand, matrix)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: encrypted operand kept", revealed_encrypted_operand, matrix, error=1e-3)
        assert_parties_in_step(mpc, f"MPP pad_with_value, ratios {ratios}: reveals")


def test_mpp_pad_with_value_copies(mpc):
    """H-16 (review c17-cr1-1, -2): a partition can hold its rows in the clear and a unified encryption of them as a copy,
    which join(), a product's transposed operand and a mixed cohort's reveal leave; pad_with_value pads both (padding
    only the copy lost the column, or left the parties disagreeing on the shape). Rows that end one slot short of a
    ciphertext boundary, padded across it, at unequal ratios: the padding must not rotate or multiply, which could start
    refresh councils at only the parties holding encryptions."""
    n_cp = mpc.comms.number_of_parties - 1
    ratios = unequal_ratios(n_cp)
    matrix = cohort_matrix(mpc, ratios.sum(), 3)
    expected = with_columns(matrix, 1, 1.0)

    joined = partition(mpc, matrix, ratios)
    joined.join()
    padded_joined = joined.pad_with_value(1.0, 1, 1)
    operand = partition(mpc, matrix, ratios)
    transposed = operand.T
    product = operand @ transposed
    padded_operand = transposed.pad_with_value(1.0, 1, 0)
    mixed = encrypted_at(mpc, partition(mpc, matrix, ratios), [1])
    revealed_before = mixed.reveal()
    padded_mixed = mixed.pad_with_value(1.0, 1, 1)
    semi = partition(mpc, matrix, ratios) @ partition(mpc, matrix, ratios).T
    revealed_semi_before = semi.reveal()  # leaves a unified copy beside the blocks
    padded_semi = semi.pad_with_value(1.0, 1, 1)
    assert_parties_in_step(mpc, f"MPP pad_with_value of partitions with copies, ratios {ratios}")

    revealed_joined = padded_joined.reveal()
    revealed_operand = padded_operand.reveal()
    revealed_mixed = padded_mixed.reveal()
    revealed_semi = padded_semi.reveal()
    revealed_semi_operand = semi.reveal()
    if mpc.pid:
        label = f"MPP pad_with_value, ratios {ratios}"
        assert_eq(f"CP{mpc.pid}:\t{label}: after join()", revealed_joined, expected)
        assert_eq(f"CP{mpc.pid}:\t{label}: a product's transposed operand, along axis 0", revealed_operand, expected.T)
        assert_eq_approx(f"CP{mpc.pid}:\t{label}: a mixed cohort after its reveal", revealed_mixed, expected, error=1e-3)
        assert_eq(f"CP{mpc.pid}:\t{label}: a mixed cohort after its reveal, the cohort's shape", padded_mixed.cohort_shape, (ratios.sum(), 4))
        rows = ratios.sum()
        assert_eq_approx(f"CP{mpc.pid}:\t{label}: semi-encrypted (A @ A.T) after its reveal", revealed_semi, with_columns(matrix @ matrix.T, 1, 1.0), error=0.05)
        assert_eq(f"CP{mpc.pid}:\t{label}: semi-encrypted after its reveal, the cohort's shape", padded_semi.cohort_shape, (rows, rows + 1))
        assert_eq_approx(f"CP{mpc.pid}:\t{label}: semi-encrypted operand kept", revealed_semi_operand, matrix @ matrix.T, error=0.05)
    assert_parties_in_step(mpc, f"MPP pad_with_value of partitions with copies, ratios {ratios}: reveals")

    slots = mpc.mhe.crypto_params.params.slots()
    wide = cohort_matrix(mpc, ratios.sum(), slots - 1)
    encrypted = encrypted_at(mpc, partition(mpc, wide, ratios), holders(ratios))
    padded_wide = encrypted.pad_with_value(1.0, 2, 1)
    assert_parties_in_step(mpc, f"MPP pad_with_value across a ciphertext boundary, ratios {ratios}")
    revealed_wide = padded_wide.reveal()
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\tMPP pad_with_value across a ciphertext boundary ({slots - 1} + 2 columns), ratios {ratios}", revealed_wide, with_columns(wide, 2, 1.0), error=1e-3)
    assert_parties_in_step(mpc, f"MPP pad_with_value across a ciphertext boundary, ratios {ratios}: reveal")

def test_mpp_columns(mpc):
    """H-14: a column of a transposed MPP (mpp.T[j]) holds a strided view of each partition, which its reveal and
    nonlinear functions in the clear read as if it were contiguous (the start of the partition's first row). Equal and
    unequal partitions; the column added to itself, encrypted, and through exp in the clear (against the same column
    built from contiguous copies)."""
    n_cp = mpc.comms.number_of_parties - 1
    for ratios in ([3 for _ in range(n_cp)], unequal_ratios(n_cp)):
        matrix = cohort_matrix(mpc, ratios.sum(), 4)
        expected = column(matrix, 2)
        start, stop = own_rows(mpc, ratios)
        mpp = partition(mpc, matrix, ratios)
        col = mpp.T[2]
        copied = MPP[Tuple[int], float](
            _mpc=mpc,
            _ratios=ratios,
            _local_data=expected.zeros() if mpc.pid == 0 else expected[start:stop].copy(),
            _transposed=True)
        doubled = col + col
        encrypted = col.copy()
        encrypted.encrypt()
        exp_col = nl.exp(mpc, col)
        exp_copied = nl.exp(mpc, copied)
        assert_parties_in_step(mpc, f"MPP column, ratios {ratios}")

        revealed = col.reveal()
        revealed_doubled = doubled.reveal()
        revealed_encrypted = encrypted.reveal()
        revealed_exp = exp_col.reveal()
        revealed_exp_copied = exp_copied.reveal()
        if mpc.pid:
            label = f"MPP column of a transposed MPP, ratios {ratios}"
            assert_eq(f"CP{mpc.pid}:\t{label}", revealed, expected)
            assert_eq(f"CP{mpc.pid}:\t{label}: c + c", revealed_doubled, expected * 2.0)
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: encrypted", revealed_encrypted, expected, error=1e-3)
            assert_eq(f"CP{mpc.pid}:\t{label}: exp in the clear, as of contiguous copies", revealed_exp, revealed_exp_copied)
            exact = array([math.exp(v) for v in expected.tolist()])
            assert_eq_approx(f"CP{mpc.pid}:\t{label}: exp in the clear", revealed_exp, exact, error=0.0, rel_error=0.02)
        assert_parties_in_step(mpc, f"MPP column, ratios {ratios}: reveals")

def test_mpp[TP](mpc: MPCEnv[TP], modulus: TP):
    mpc.comms.sync_parties()
    alg_struct = "ring" if modulus.popcnt() == 1 else "field"
    print(f'CP{mpc.pid}:\tTesting Sequre MHE MPP on {alg_struct}... \n')
    rows, cols = 4, 32
    n_cp = mpc.comms.number_of_parties - 1

    # Different data at every compute party: its own rows of matrices drawn from the shared seed (so every party knows
    # the whole), written to a file of its own and loaded collectively
    with mpc.randomness.global_stream():
        raw_a = array(random_ints((rows * n_cp, cols), 0, 99))
        raw_b = array(random_ints((rows * n_cp, cols), 0, 99))
    a_partition_path = f"tests/data/mhe/a_partition_{mpc.pid}.bin"
    b_partition_path = f"tests/data/mhe/b_partition_{mpc.pid}.bin"
    if mpc.pid:
        start = (mpc.pid - 1) * rows
        with open(a_partition_path, "wb") as f: write_ndarray(f, raw_a[start:start + rows], binary=True)
        with open(b_partition_path, "wb") as f: write_ndarray(f, raw_b[start:start + rows], binary=True)
    
    mpc.comms.sync_parties()

    pid = mpc.pid
    mpc.comms.sequential(lambda p, a: print(f"CP{p}:\tPrinting MPP test data A for debugging:", a), False, pid, raw_a)
    mpc.comms.sync_parties()
    mpc.comms.sequential(lambda p, b: print(f"CP{p}:\tPrinting MPP test data B for debugging:", b), False, pid, raw_b)
    
    mpp_a = MPP.collective_load(mpc, a_partition_path, rows=rows, cols=cols, binary=True, dtype=int)
    mpp_b = MPP.collective_load(mpc, b_partition_path, rows=rows, cols=cols, binary=True, dtype=int)

    if mpc.pid:
        assert_eq(f"CP{mpc.pid}:\tMPP load/collect/decrypt 1", mpp_a.reveal(), raw_a)
        assert_eq(f"CP{mpc.pid}:\tMPP load/collect/decrypt 2", mpp_b.reveal(), raw_b)

    test_mpp_getitem(mpp_a, raw_a)
    test_mpp_setitem(mpp_a, raw_a)
    test_mpp_transpose(mpp_a, raw_a)
    test_mpp_transpose(mpp_a.T, raw_a.T)
    test_mpp_mpc_switching(mpp_a, raw_a)
    test_mpp_encrypted_int_to_sharetensor(mpp_a, raw_a)
    test_mpp_elem_wise_operations(mpp_a, mpp_b, raw_a, raw_b)
    test_mpp_matmul_operations(mpp_a, mpp_b, raw_a, raw_b)
    test_mpp_transposed_operations(mpp_a, raw_a)
    test_mpp_cohort_to_sharetensor(mpc)
    test_mpp_tall_encryption(mpc)
    test_mpp_partitioned_vectors(mpc)
    test_mpp_cohort_comparisons(mpc)
    test_mpp_cohort_products(mpc)
    test_mpp_mixed_cohorts(mpc)
    test_mpp_mixed_products(mpc)
    test_mpp_sums(mpc)
    test_mpp_sum_vectors(mpc)
    test_mpp_sum_encodings(mpc)
    test_mpp_pad_with_value(mpc)
    test_mpp_pad_with_value_copies(mpc)
    test_mpp_columns(mpc)

    print(f'CP{mpc.pid}:\tSequre MHE MPP tests on {alg_struct} passed.\n')
