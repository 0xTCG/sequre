import math, prg

import sequre.lattiseq.ckks as ckks
import sequre.lattiseq.rlwe as rlwe
import sequre.lattiseq.dckks as dckks
import sequre.lattiseq.params as ckks_params
import sequre.lattiseq.ring as ring

from sequre.lattiseq.exact_encoder import new_exact_encoder
from sequre.lattiseq.stats import plot_precision_stats
from sequre.utils.testing import assert_eq
from sequre.utils.utils import random_complex
from sequre.constants import LATTISEQ_STANDARD_RING_ENUM, LATTISEQ_EXACT_INT_SIZE, lattiseq_exact_int


def test_encryption_decryption_for_values(values, plaintext, params, encoder, encryptor, decryptor):
    print('Encoding values ...')
    encoder.encode(values, plaintext, params.log_slots)

    print('Encrypting values ...')
    ciphertext = encryptor.encrypt_new(plaintext)

    print('Evaluating precision ...')
    stats = plot_precision_stats(params, ciphertext, values, decryptor, encoder)
    
    assert_eq("Homomorphic encryption/decryption", stats.min_precision.l2 > 15, True)


def test_encrypt_decrypt(params, encoder, encryptor, decryptor):
    print('Initializing HE plaintext ...')
    plaintext = ckks.new_plaintext(params, params.max_level(), params.default_scale / 16)

    test_encryption_decryption_for_values(
        values=[complex(2 * math.pi, 0) for _ in range(params.slots())],
        plaintext=plaintext,
        params=params,
        encoder=encoder,
        encryptor=encryptor,
        decryptor=decryptor)
    
    test_encryption_decryption_for_values(
        values=[complex(2 * math.pi, math.pi) for _ in range(params.slots())],
        plaintext=plaintext,
        params=params,
        encoder=encoder,
        encryptor=encryptor,
        decryptor=decryptor)
    
    test_encryption_decryption_for_values(
        values=[complex(float(i % 10), 0) for i in range(params.slots())],
        plaintext=plaintext,
        params=params,
        encoder=encoder,
        encryptor=encryptor,
        decryptor=decryptor)
    
    test_encryption_decryption_for_values(
        values=random_complex((params.slots(),)),
        plaintext=plaintext,
        params=params,
        encoder=encoder,
        encryptor=encryptor,
        decryptor=decryptor)


def test_negation(params, encoder, encryptor, decryptor, evaluator):
    elem = random_complex((params.slots(),))
    expected_negation = [complex(-e.real, -e.imag) for  e in elem]
    
    print('Initializing HE plaintext for negation ...')
    plaintext = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)

    print('Encoding values for negation ...')
    encoder.encode(elem, plaintext, params.log_slots)

    print('Encrypting values for negation ...')
    ciphertext = encryptor.encrypt_new(plaintext)

    print('Evaluating ciphertext negation ...')
    ciphertext_negation = evaluator.neg_new(ciphertext)

    print('Evaluating precision for negation ...')
    stats = plot_precision_stats(
        params, ciphertext_negation, expected_negation, decryptor, encoder)
    
    assert_eq(
        "Homomorphic negation",
        stats.min_precision.l2 > 15,
        True)


def test_addition(params, encoder, encryptor, decryptor, evaluator):
    addend_1 = random_complex((params.slots(),))
    addend_2 = random_complex((params.slots(),))
    expected_sum = [e_1 + e_2 for e_1, e_2 in zip(addend_1, addend_2)]
    
    print('Initializing HE plaintext for addition ...')
    plaintext_1 = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)
    plaintext_2 = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)

    print('Encoding values for addition ...')
    encoder.encode(addend_1, plaintext_1, params.log_slots)
    encoder.encode(addend_2, plaintext_2, params.log_slots)

    print('Encrypting values for addition ...')
    ciphertext_1 = encryptor.encrypt_new(plaintext_1)
    ciphertext_2 = encryptor.encrypt_new(plaintext_2)

    print('Evaluating ciphertext addition ...')
    cipher_cipher_sum = evaluator.add_new(ciphertext_1, ciphertext_2)
    cipher_plain_sum = evaluator.add_new(ciphertext_1, plaintext_2)

    print('Evaluating precision for addition ...')
    cipher_cipher_stats = plot_precision_stats(
        params, cipher_cipher_sum, expected_sum, decryptor, encoder)
    cipher_plain_stats = plot_precision_stats(
        params, cipher_plain_sum, expected_sum, decryptor, encoder)
    
    assert_eq(
        "Homomorphic cipher-cipher addition",
        cipher_cipher_stats.min_precision.l2 > 15,
        True)
    assert_eq(
        "Homomorphic cipher-plain addition",
        cipher_plain_stats.min_precision.l2 > 15,
        True)


def test_subtraction(params, encoder, encryptor, decryptor, evaluator):
    minuend = random_complex((params.slots(),))
    subtrahend = random_complex((params.slots(),))
    expected_diff = [e_1 - e_2 for e_1, e_2 in zip(minuend, subtrahend)]
    
    print('Initializing HE plaintext for subtraction ...')
    plaintext_minuend = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)
    plaintext_subtrahend = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)

    print('Encoding values for subtraction ...')
    encoder.encode(minuend, plaintext_minuend, params.log_slots)
    encoder.encode(subtrahend, plaintext_subtrahend, params.log_slots)

    print('Encrypting values for subtraction ...')
    ciphertext_minuend = encryptor.encrypt_new(plaintext_minuend)
    ciphertext_subtrahend = encryptor.encrypt_new(plaintext_subtrahend)

    print('Evaluating ciphertext subtraction ...')
    cipher_cipher_diff = evaluator.sub_new(ciphertext_minuend, ciphertext_subtrahend)
    cipher_plain_diff = evaluator.sub_new(ciphertext_minuend, plaintext_subtrahend)

    print('Evaluating precision for subtraction ...')
    cipher_cipher_stats = plot_precision_stats(
        params, cipher_cipher_diff, expected_diff, decryptor, encoder)
    cipher_plain_stats = plot_precision_stats(
        params, cipher_plain_diff, expected_diff, decryptor, encoder)
    
    assert_eq(
        "Homomorphic cipher-cipher subtraction",
        cipher_cipher_stats.min_precision.l2 > 15,
        True)
    assert_eq(
        "Homomorphic cipher-plain subtraction",
        cipher_plain_stats.min_precision.l2 > 15,
        True)


def test_multiplication_by_i(params, encoder, encryptor, decryptor, evaluator):
    factor = random_complex((params.slots(),))
    expected_product = [e * complex(0, 1) for  e in factor]
    
    print('Initializing HE plaintext for multiplication by i ...')
    plaintext = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)

    print('Encoding values for multiplication by i ...')
    encoder.encode(factor, plaintext, params.log_slots)

    print('Encrypting values for multiplication by i ...')
    ciphertext = encryptor.encrypt_new(plaintext)

    print('Evaluating ciphertext multiplication by i ...')
    ciphertext_prod = evaluator.mul_by_i_new(ciphertext)

    print('Evaluating precision for multiplication by i ...')
    stats = plot_precision_stats(
        params, ciphertext_prod, expected_product, decryptor, encoder)
    
    assert_eq(
        "Homomorphic multiplication by i",
        stats.min_precision.l2 > 15,
        True)


def test_ciphertext_multiplication(params, encoder, encryptor, decryptor, evaluator):
    factor_1 = random_complex((params.slots(),))
    factor_2 = random_complex((params.slots(),))
    expected_prod = [e_1 * e_2 for e_1, e_2 in zip(factor_1, factor_2)]
    
    print('Initializing HE plaintext for ciphertext multiplication ...')
    plaintext_1 = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)
    plaintext_2 = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)

    print('Encoding values for ciphertext multiplication ...')
    encoder.encode(factor_1, plaintext_1, params.log_slots)
    encoder.encode(factor_2, plaintext_2, params.log_slots)

    print('Encrypting values for ciphertext multiplication ...')
    ciphertext_1 = encryptor.encrypt_new(plaintext_1)
    ciphertext_2 = encryptor.encrypt_new(plaintext_2)

    print('Evaluating ciphertext ciphertext multiplication w/o relinearization ...')
    cipher_cipher_prod = evaluator.mul_new(ciphertext_1, ciphertext_2)
    cipher_plain_prod = evaluator.mul_new(ciphertext_1, plaintext_2)
    print('Evaluating ciphertext ciphertext multiplication w/ relinearization ...')
    cipher_cipher_prod_relin = evaluator.mul_relin_new(ciphertext_1, ciphertext_2)
    cipher_plain_prod_relin = evaluator.mul_relin_new(ciphertext_1, plaintext_2)

    print('Evaluating precision for ciphertext multiplication w/o relinearization ...')
    cipher_cipher_stats = plot_precision_stats(
        params, cipher_cipher_prod, expected_prod, decryptor, encoder)
    cipher_plain_stats = plot_precision_stats(
        params, cipher_plain_prod, expected_prod, decryptor, encoder)
    print('Evaluating precision for ciphertext multiplication w/ relinearization ...')
    cipher_cipher_stats_relin = plot_precision_stats(
        params, cipher_cipher_prod_relin, expected_prod, decryptor, encoder)
    cipher_plain_stats_relin = plot_precision_stats(
        params, cipher_plain_prod_relin, expected_prod, decryptor, encoder)
    
    assert_eq(
        "Homomorphic cipher-cipher multiplication w/o relinearization",
        cipher_cipher_stats.min_precision.l2 > 15,
        True)
    assert_eq(
        "Homomorphic cipher-plain multiplication w/o relinearization",
        cipher_plain_stats.min_precision.l2 > 15,
        True)
    assert_eq(
        "Homomorphic cipher-cipher multiplication w/ relinearization",
        cipher_cipher_stats_relin.min_precision.l2 > 15,
        True)
    assert_eq(
        "Homomorphic cipher-plain multiplication w/ relinearization",
        cipher_plain_stats_relin.min_precision.l2 > 15,
        True)


def test_multiplication(params, encoder, encryptor, decryptor, evaluator):
    test_multiplication_by_i(params, encoder, encryptor, decryptor, evaluator)
    test_ciphertext_multiplication(params, encoder, encryptor, decryptor, evaluator)


def test_rotation(params, encoder, encryptor, decryptor, evaluator, shifts):
    elem = random_complex((params.slots(),))
    k = prg.choice(shifts)
    expected_rotation = elem[k:]
    expected_rotation.extend(elem[:k])
    
    print('Initializing HE plaintext for rotation ...')
    plaintext = ckks.new_plaintext(
        params, params.max_level(), params.default_scale / 16)

    print('Encoding values for rotation ...')
    encoder.encode(elem, plaintext, params.log_slots)

    print('Encrypting values for rotation ...')
    ciphertext = encryptor.encrypt_new(plaintext)

    print('Evaluating ciphertext rotation ...')
    ciphertext_rotation = evaluator.rotate_new(ciphertext, k)

    print('Evaluating precision for rotation ...')
    stats = plot_precision_stats(
        params, ciphertext_rotation, expected_rotation, decryptor, encoder)
    
    assert_eq(
        f"Homomorphic rotation by {k}",
        stats.mean_precision.l2 > 15,
        True)


def test_evaluator(params, encoder, encryptor, decryptor, evaluator, shifts):
    test_negation(params, encoder, encryptor, decryptor, evaluator)
    test_addition(params, encoder, encryptor, decryptor, evaluator)
    test_subtraction(params, encoder, encryptor, decryptor, evaluator)
    test_multiplication(params, encoder, encryptor, decryptor, evaluator)
    test_rotation(params, encoder, encryptor, decryptor, evaluator, shifts)


def lattiseq_test_setup():
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    
    print('Initializing HE encoder ...')
    encoder = ckks.new_encoder_complex(params)
    
    print('Initializing HE keygen ...')
    kgen = ckks.new_key_generator(params)
    
    print('Generating secret ...')
    sk = kgen.gen_secret_key()

    print('Initializing HE encryptor ...')
    encryptor = ckks.new_encryptor(params, sk)
    
    print('Initializing HE decryptor ...')
    decryptor = ckks.new_decryptor(params, sk)

    print('Generating relinearization key ...')
    rlk = kgen.gen_relinearization_key(sk, 1)

    print('Generating rotation key set ...')
    shifts = [i for i in range(1, 20)]
    rtks = kgen.gen_rotation_keys_for_rotations(shifts, params.ring_type == LATTISEQ_STANDARD_RING_ENUM, sk)
    
    print('Initializing evaluator ...')
    evaluator = ckks.new_evaluator(params, rlwe.EvaluationKey(rlk=rlk, rtks=rtks))

    print('Lattiseq test setup done.')
    return params, encoder, encryptor, decryptor, evaluator, shifts


def test_lattiseq():
    print('Testing Lattiseq ...')
    params, encoder, encryptor, decryptor, evaluator, shifts = lattiseq_test_setup()

    test_encrypt_decrypt(params, encoder, encryptor, decryptor)
    test_evaluator(params, encoder, encryptor, decryptor, evaluator, shifts)
    

def measured_decryption_share_noise(params, encoder, encryptor, sk, sigma: float) -> float:
    # With a zero target key, a collective-decryption (PCKS) share minus s * c1 is exactly the noise the party added.
    pcks = dckks.new_pcks_protocol(params, sigma)
    pt = ckks.new_plaintext(params, params.max_level(), params.default_scale)
    encoder.encode([complex(1.0, 0.0) for _ in range(params.slots())], pt, params.log_slots)
    ct = encryptor.encrypt_new(pt)
    level = ct.level()
    share = pcks.allocate_share(level)
    pcks._mm_gen_share(sk, rlwe.new_public_key(params.get_rlwe_params()), ct.value[1], share)
    ring_q = params.ring_q
    noise = ring_q.new_poly_lvl(level)
    ring_q._mm_mul_coeffs_montgomery_lvl(level, ct.value[1], sk.value.q, noise)
    ring_q._mm_sub_lvl(level, share.value[0], noise, noise)
    ring_q._mm_inv_ntt_lvl(level, noise, noise)
    q0 = ring_q.modulus[0]
    total = 0.0
    for c in noise._buf_coeffs[0]:
        v = float(c) if c < (q0 >> u64(1)) else -float(q0 - c)
        total += v * v
    return math.sqrt(total / float(len(noise._buf_coeffs[0])))


def test_decryption_share_smudging():
    # A decryption share without noise is s_i * c1, from which the party collecting the shares computes s_i = share / c1.
    # The noise used to be added before a division by the special primes P and vanished (measured std 0).
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    encoder = ckks.new_encoder_complex(params)
    sk = ckks.new_key_generator(params).gen_secret_key()
    encryptor = ckks.new_encryptor(params, sk)
    for sigma in (3.2, 1024.0):
        std = measured_decryption_share_noise(params, encoder, encryptor, sk, sigma)
        assert_eq(f"Collective decryption share carries its noise (sigma {sigma}, measured {std:.2f})", 0.5 * sigma < std < 1.5 * sigma, True)


def random_fixed_point(bits: int) -> lattiseq_exact_int:
    # A random integer of magnitude below 2^bits, either sign.
    x = lattiseq_exact_int(0)
    while bits > 0:
        take = min(bits, 60)
        x = (x << lattiseq_exact_int(take)) | lattiseq_exact_int(prg.getrandbits(take))
        bits -= take
    return -x if prg.getrandbits(1) else x


def max_abs_difference(a: List[lattiseq_exact_int], b: List[lattiseq_exact_int]) -> float:
    return max(abs((a[i] - b[i]).to_float()) for i in range(len(a)))


def test_exact_encoder():
    # The float encoder's error grows with the values (about |v| * 2^-52 per slot); the exact encoder's must not, for
    # protocols that hide values under large random masks.
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    exact = new_exact_encoder(params)
    encoder = ckks.new_encoder_complex(params)
    sk = ckks.new_key_generator(params).gen_secret_key()
    encryptor = ckks.new_encryptor(params, sk)
    decryptor = ckks.new_decryptor(params, sk)
    n, log_slots, scale, top = params.slots(), params.log_slots, params.default_scale, params.max_level()
    frac = 32
    unit = 2.0 ** frac
    bound = params.n() / (2 * scale)  # CKKS's own error per slot: at most 1/2 per rounded coefficient
    no_values = List[lattiseq_exact_int]()

    # The float encoder's conventions (slot order, imaginary parts, rounding).
    values = [complex(2 * prg.random() - 1, 2 * prg.random() - 1) for _ in range(n)]
    pt_exact = ckks.new_plaintext(params, top, scale)
    exact.encode(values, pt_exact, log_slots)
    pt_float = ckks.new_plaintext(params, top, scale)
    encoder.encode(values, pt_float, log_slots)
    coeffs_exact = exact.poly_to_coeffs(pt_exact.value, log_slots)
    coeffs_float = exact.poly_to_coeffs(pt_float.value, log_slots)
    assert_eq("Exact encoder: same coefficients as the float encoder, up to rounding", max_abs_difference(coeffs_exact, coeffs_float) <= 1, True)
    decoded = encoder.decode(pt_exact, log_slots)
    assert_eq("Exact encoder: the float decoder decodes its plaintexts", max(abs(decoded[i] - values[i]) for i in range(n)) < bound, True)
    decoded = exact.decode(pt_float, log_slots)
    assert_eq("Exact encoder: decodes the float encoder's plaintexts", max(abs(decoded[i] - values[i]) for i in range(n)) < bound, True)

    # Integer slots at scale 2^40 come back unchanged: the FFTs stay within half a unit, up to 2^185.
    for bits in (64, 185):
        real = [random_fixed_point(bits) for _ in range(n)]
        imag = [random_fixed_point(bits) for _ in range(n)]
        back_real, back_imag = exact.decode_coeffs(exact.encode_coeffs(real, imag, 0, 2.0 ** 40, log_slots), 2.0 ** 40, log_slots, 0)
        assert_eq(f"Exact encoder: 2^{bits} integers round-trip unchanged", back_real == real and back_imag == imag, True)

    # Through a plaintext, 2^150 values come back within CKKS's own error, like small ones.
    real = [random_fixed_point(150 + frac) for _ in range(n)]
    imag = [random_fixed_point(150 + frac) for _ in range(n)]
    pt = ckks.new_plaintext(params, top, scale)
    exact.encode_fixed_point(real, imag, frac, pt, log_slots)
    back_real, back_imag = exact.decode_fixed_point(pt, log_slots, frac)
    error = max(max_abs_difference(back_real, real), max_abs_difference(back_imag, imag)) / unit
    assert_eq(f"Exact encoder: 2^150 values round-trip within N / (2 scale) (error {error:.2e})", error < bound, True)

    # Enc(x - R) + Enc(R) decrypts to x, with R ~ 2^150 (the float encoder loses x entirely).
    x = [random_fixed_point(frac + 4) for _ in range(n)]
    r = [random_fixed_point(150 + frac) for _ in range(n)]
    pt_masked = ckks.new_plaintext(params, top, scale)
    exact.encode_fixed_point([x[i] - r[i] for i in range(n)], no_values, frac, pt_masked, log_slots)
    pt_mask = ckks.new_plaintext(params, top, scale)
    exact.encode_fixed_point(r, no_values, frac, pt_mask, log_slots)
    ct = encryptor.encrypt_new(pt_masked)
    ct_mask = encryptor.encrypt_new(pt_mask)
    for i in range(2): params.ring_q._mm_add_lvl(ct.level(), ct.value[i], ct_mask.value[i], ct.value[i])
    back_real, back_imag = exact.decode_fixed_point(decryptor.decrypt_new(ct), log_slots, frac)
    error = max(max_abs_difference(back_real, x), max(abs(v.to_float()) for v in back_imag)) / unit
    assert_eq(f"Exact encoder: Enc(x - R) + Enc(R) decrypts to x with R ~ 2^150 (error {error:.2e})", error < 1e-6, True)

    # Residues and CRT reconstruction are exact.
    for level, bits in ((top, 240), (3, 140)):
        coeffs = [random_fixed_point(bits) for _ in range(2 * n)]
        pt = ckks.new_plaintext(params, level, scale)
        exact.coeffs_to_poly(coeffs, log_slots, pt.value)
        assert_eq(f"Exact encoder: 2^{bits} coefficients at level {level} come back from their residues", exact.poly_to_coeffs(pt.value, log_slots) == coeffs, True)

    # Decoding is linear on additive coefficient shares: decode(m + M) - decode(M) = decode(m) up to rounding.
    m = [random_fixed_point(60) for _ in range(2 * n)]
    mask = [random_fixed_point(190) for _ in range(2 * n)]
    sum_real, sum_imag = exact.decode_coeffs([m[i] + mask[i] for i in range(2 * n)], scale, log_slots, frac)
    mask_real, mask_imag = exact.decode_coeffs(mask, scale, log_slots, frac)
    m_real, m_imag = exact.decode_coeffs(m, scale, log_slots, frac)
    deviation = max(max(abs((sum_real[i] - mask_real[i] - m_real[i]).to_float()), abs((sum_imag[i] - mask_imag[i] - m_imag[i]).to_float())) for i in range(n))
    assert_eq("Exact encoder: decoding shares with 2^190 masks is linear up to one unit", deviation <= 1, True)

    # Sparse slots, lower levels and a scale that is not a power of two.
    sparse = [random_fixed_point(80 + frac) for _ in range(32)]
    pt = ckks.new_plaintext(params, top, scale)
    exact.encode_fixed_point(sparse, sparse, frac, pt, 5)
    back_real, back_imag = exact.decode_fixed_point(pt, 5, frac)
    assert_eq("Exact encoder: 32 sparse slots round-trip", max(max_abs_difference(back_real, sparse), max_abs_difference(back_imag, sparse)) / unit < bound, True)
    for level, pt_scale in ((0, scale), (3, scale * 1.3719)):
        small = [random_fixed_point(frac + 3) for _ in range(n)]
        pt = ckks.new_plaintext(params, level, pt_scale)
        exact.encode_fixed_point(small, no_values, frac, pt, log_slots)
        back_real, back_imag = exact.decode_fixed_point(pt, log_slots, frac)
        error = max(max_abs_difference(back_real, small), max(abs(v.to_float()) for v in back_imag)) / unit
        assert_eq(f"Exact encoder: round trip at level {level}, scale {pt_scale:.4g}", error < bound, True)

    # Values that do not fit its integers raise instead of losing precision.
    raised = False
    try:
        exact.encode_fixed_point([random_fixed_point(LATTISEQ_EXACT_INT_SIZE - 10)], no_values, frac, ckks.new_plaintext(params, top, scale), log_slots)
    except ValueError:
        raised = True
    assert_eq("Exact encoder: too large values raise ValueError", raised, True)


def test_multi_modulus_rescale():
    # Dividing by the last two moduli at once (the coefficient-domain path rescale takes for two or more) must match two
    # single divisions. Its parallel loop used to capture a SIMD vector, which Codon miscompiles: it crashed.
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    ring_q = params.ring_q
    encoder = ckks.new_encoder_complex(params)
    encryptor = ckks.new_encryptor(params, ckks.new_key_generator(params).gen_secret_key())
    pt = ckks.new_plaintext(params, params.max_level(), params.default_scale)
    encoder.encode([complex(0.5, 0.25) for _ in range(params.slots())], pt, params.log_slots)
    ct = encryptor.encrypt_new(pt)
    level = ct.level()

    both = ring_q.new_poly_lvl(level - 2)
    ring_q._mm_div_round_by_last_modulus_many_ntt_lvl(level, 2, ct.value[0], ring_q.new_poly_lvl(level), both)
    one = ring_q.new_poly_lvl(level - 1)
    ring_q._mm_div_round_by_last_modulus_ntt_lvl(level, ct.value[0], ring_q.new_poly_lvl(level), one)
    two = ring_q.new_poly_lvl(level - 2)
    ring_q._mm_div_round_by_last_modulus_ntt_lvl(level - 1, one, ring_q.new_poly_lvl(level - 1), two)

    differ = sum(1 for k in range(level - 1) for j in range(params.n()) if both._buf_coeffs[k][j] != two._buf_coeffs[k][j])
    assert_eq("Rescale by two moduli at once matches two single rescales", differ, 0)


def max_decryption_error(params, encoder, sk, ct, values) -> float:
    # The largest difference between values and ct decrypted with sk
    decoded = encoder.decode(ckks.new_decryptor(params, sk).decrypt_new(ct), params.log_slots)
    return max(abs(decoded[i] - values[i]) for i in range(len(values)))


def test_public_key_generation():
    # A public key is an encryption of zero under a secret key. A key generator stores the all-zero key until
    # gen_secret_key(store_key=True) replaces it, and the public key of the all-zero key would let anyone decrypt: c0
    # alone is the message plus noise. gen_public_key() used to encrypt under the stored key whatever it was.
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    encoder = ckks.new_encoder_complex(params)
    values = [complex(0.125 * float(i % 16) - 1.0, 0.0) for i in range(params.slots())]
    pt = ckks.new_plaintext(params, params.max_level(), params.default_scale)
    encoder.encode(values, pt, params.log_slots)
    zero_sk = ckks.new_secret_key(params)

    kgen = ckks.new_key_generator(params)
    raised = False
    try:
        kgen.gen_public_key()
    except ValueError:
        raised = True
    assert_eq("gen_public_key() raises when the generator stores no key", raised, True)

    sk = kgen.gen_secret_key()
    ct = ckks.new_encryptor(params, kgen.gen_public_key(sk)).encrypt_new(pt)
    assert_eq("gen_public_key(sk): its encryptions decrypt with sk",
              max_decryption_error(params, encoder, sk, ct, values) < 1e-3, True)
    assert_eq("gen_public_key(sk): its encryptions do not decrypt with the all-zero key",
              max_decryption_error(params, encoder, zero_sk, ct, values) > 1.0, True)

    raised = False
    try:
        kgen.gen_public_key()
    except ValueError:
        raised = True
    assert_eq("gen_secret_key() does not store its key: gen_public_key() still raises", raised, True)

    raised = False
    try:
        kgen.gen_public_key(zero_sk)
    except ValueError:
        raised = True
    assert_eq("gen_public_key(sk) raises for the all-zero key", raised, True)

    raised = False
    try:
        rlwe.new_key_generator(params.get_rlwe_params()).gen_public_key()
    except ValueError:
        raised = True
    assert_eq("rlwe.KeyGenerator: gen_public_key() raises when the generator stores no key", raised, True)

    # The stored-key sequence, also through the CKKS wrapper's copy of its generator
    kgen_stored = ckks.new_key_generator(params)
    sk_stored = kgen_stored.gen_secret_key(store_key=True)
    for via_rlwe in (False, True):
        pk = kgen_stored.get_rlwe_keygen().gen_public_key() if via_rlwe else kgen_stored.gen_public_key()
        ct = ckks.new_encryptor(params, pk).encrypt_new(pt)
        tag = "the RLWE generator of a CKKS generator" if via_rlwe else "a CKKS generator"
        assert_eq(f"gen_public_key() of {tag} after gen_secret_key(store_key=True): decrypts with the stored key",
                  max_decryption_error(params, encoder, sk_stored, ct, values) < 1e-3, True)
        assert_eq(f"gen_public_key() of {tag} after gen_secret_key(store_key=True): not with the all-zero key",
                  max_decryption_error(params, encoder, zero_sk, ct, values) > 1.0, True)


def test_mod_down_rounding():
    """The mod-down after a key switch or a public-key encryption (division by the special modulus P, both variants)
    rounds: x * P + r goes to x for r below P / 2 and to x + 1 above it. It used to floor (x for every r below P), which
    left every pk encryption and key switch with e0 + e1 * s, E[e1] = -1/2 on every coefficient: a fixed error pattern
    per secret key, up to about 4e-5 in the first slots at the default scale. Every level of P (the public-key encryption
    uses level 0, the key switches the top one) and two levels of Q. The offsets stay P / 1000 away from P / 2 and from
    P: the basis extension counts its overflow in floating point, so residues within about 2^-53 * P of the boundary may
    come out either way (a tie, to 1e-16)."""
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    ring_q, ring_p = params.ring_q, params.ring_p
    extender = ring.new_basis_extender(ring_q, ring_p)
    n = params.n()
    for level_p in range(params.p_count()):
        big_p = u128(1)
        for j in range(level_p + 1): big_p *= u128(ring_p.modulus[j])
        half = (big_p - u128(1)) >> u128(1)
        away = big_p // u128(1000)
        offsets = [u128(0), u128(1), half - away, half + away, big_p - away]
        carries = [0, 0, 0, 1, 1]  # round(r / P); a floor gives 0 for all
        for level_q in (params.max_level(), 0):
            for ntt in (False, True):
                p1_q = ring_q.new_poly_lvl(level_q)
                p1_p = ring_p.new_poly_lvl(level_p)
                out = ring_q.new_poly_lvl(level_q)
                for x in range(n):
                    quotient = u128(x % 5)
                    r = offsets[x % len(offsets)]
                    for i in range(level_q + 1):
                        qi = u128(ring_q.modulus[i])
                        p1_q._buf_coeffs[i][x] = u64((quotient * (big_p % qi) + r % qi) % qi)
                    for j in range(level_p + 1):
                        p1_p._buf_coeffs[j][x] = u64(r % u128(ring_p.modulus[j]))
                if ntt:
                    ring_q._mm_ntt_lvl(level_q, p1_q, p1_q)
                    ring_p._mm_ntt_lvl(level_p, p1_p, p1_p)
                    extender._mm_mod_down_qp_to_q_ntt(level_q, level_p, p1_q, p1_p, out)
                    ring_q._mm_inv_ntt_lvl(level_q, out, out)
                else:
                    extender._mm_mod_down_qp_to_q(level_q, level_p, p1_q, p1_p, out)
                wrong = 0
                for x in range(n):
                    want = u64(x % 5 + carries[x % len(offsets)])
                    for i in range(level_q + 1):
                        if out._buf_coeffs[i][x] != want: wrong += 1
                variant = "NTT" if ntt else "coefficient"
                assert_eq(f"Lattiseq mod-down ({variant} domain, P level {level_p}, Q level {level_q}) rounds x * P + r to the nearest integer ({wrong} wrong residues)", wrong, 0)

def test_pk_encryption_bias():
    """Public-key encryptions of zero, 40 per key for three keys: in each of the first three slots the mean error is
    within 7 standard errors of zero (a t statistic; one encryption's slot error is 0.5e-7 to 4e-7 here, depending on
    the key and the slot, measured). A mod-down that floors leaves E[e1] * s (see test_mod_down_rounding): 1e-6 to 4e-5
    in slot 0 for four keys measured, 30 standard errors or more."""
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    encoder = ckks.new_encoder_complex(params)
    pt = ckks.new_plaintext(params, params.max_level(), params.default_scale)
    encoder.encode([complex(0.0, 0.0) for _ in range(params.slots())], pt, params.log_slots)
    count, slots = 40, 3
    worst = 0.0
    for _ in range(3):
        kgen = ckks.new_key_generator(params)
        sk = kgen.gen_secret_key()
        encryptor = ckks.new_encryptor(params, kgen.gen_public_key(sk))
        decryptor = ckks.new_decryptor(params, sk)
        errors = [[complex(0.0, 0.0) for _ in range(count)] for _ in range(slots)]
        for t in range(count):
            decoded = encoder.decode(decryptor.decrypt_new(encryptor.encrypt_new(pt)), params.log_slots)
            for k in range(slots): errors[k][t] = decoded[k]
        for k in range(slots):
            mean = sum(errors[k]) / float(count)
            spread = math.sqrt(sum(abs(e - mean) ** 2 for e in errors[k]) / float(count - 1))
            worst = max(worst, abs(mean) / (spread / math.sqrt(float(count))))
    assert_eq(f"Lattiseq pk encryptions carry no per-key bias in the first slots (largest mean error {worst:.1f} standard errors)", worst < 7.0, True)

def test_he():
    print('Testing HE ... \n')

    test_lattiseq()
    test_decryption_share_smudging()
    test_exact_encoder()
    test_multi_modulus_rescale()
    test_public_key_generation()
    test_mod_down_rounding()
    test_pk_encryption_bias()

    print('HE tests passed.\n')
