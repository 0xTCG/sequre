# A digest of the exact encoder's roots of unity for m = 2^14 at 256- and 512-bit fixed point (test_root_table_digest;
# the same as the tables of the earlier, library-backed floats)
ROOT_DIGEST_256 = "ccfe6636a113faba"
ROOT_DIGEST_512 = "918f5b6e49cb5ab6"


def _hexval(c: str) -> int:
    o = ord(c)
    if 48 <= o <= 57: return o - 48
    if 97 <= o <= 102: return o - 87
    return o - 55


def _from_p(prec: int, t: str) -> BigFloat:
    # Go's Text('p', 0) form -> a BigFloat of that precision (exact: the text has at most prec significant bits)
    x = BigFloat(prec)
    neg = t.startswith('-')
    if neg: t = t[1:]
    if t == '0':
        x._set_zero(neg)
        return x
    pp = t.index('p')
    digits = t[3:pp]
    e = int(t[pp + 1:])
    nl = (4 * len(digits) + 63) // 64 + 1
    h = Ptr[u64](nl)
    limbs.zero(h, nl)
    for c in digits:
        limbs.lshift(h, h, nl, 4)
        h[0] |= u64(_hexval(c))
    x._round_from(h, nl, e - 4 * len(digits), False, neg)
    return x


def _to_p(x: BigFloat) -> str:
    if x._zero:
        return '-0' if x._neg else '0'
    s = ''
    for i in range(x._n - 1, -1, -1):
        w = x._mant[i]
        for k in range(15, -1, -1):
            s += '0123456789abcdef'[int((w >> u64(4 * k)) & u64(15))]
    e = x._exp
    return ('-' if x._neg else '') + '0x.' + s.rstrip('0') + 'p' + ('+' if e >= 0 else '') + str(e)


def _hex64(b: u64) -> str:
    s = ''
    for k in range(15, -1, -1):
        s += '0123456789abcdef'[int((b >> u64(4 * k)) & u64(15))]
    return s


def _bits_hex(f: float) -> str:
    return _hex64(Ptr[u64](__ptr__(f).as_byte())[0])


def _hex_float(h: str) -> float:
    b = u64(0)
    for c in h:
        b = (b << u64(4)) | u64(_hexval(c))
    return Ptr[float](__ptr__(b).as_byte())[0]


def _binop(op: str, z: BigFloat, x: BigFloat, y: BigFloat):
    if op == 'add': z.add(x, y)
    elif op == 'sub': z.sub(x, y)
    elif op == 'mul': z.mul(x, y)
    else: z.quo(x, y)


def _check(line: str) -> bool:
    # one known answer; a binary operation also aliased (z.op(z, y), z.op(x, z)) where the precisions allow
    lhs, want = line.split(' -> ')
    w = lhs.split(' ')
    op = w[0]
    if op in ('add', 'sub', 'mul', 'quo'):
        zp, xp, yp = int(w[1]), int(w[2]), int(w[4])
        x, y = _from_p(xp, w[3]), _from_p(yp, w[5])
        z = BigFloat(zp)
        _binop(op, z, x, y)
        ok = _to_p(z) == want
        if zp == xp:
            z2 = _from_p(xp, w[3])
            _binop(op, z2, z2, y)
            ok = ok and _to_p(z2) == want
        if zp == yp:
            z3 = _from_p(yp, w[5])
            _binop(op, z3, x, z3)
            ok = ok and _to_p(z3) == want
        return ok
    if op in ('set', 'abs', 'neg'):
        zp, xp = int(w[1]), int(w[2])
        x = _from_p(xp, w[3])
        z = BigFloat(zp)
        if op == 'set': z.set(x)
        elif op == 'abs': z.abs(x)
        else: z.neg(x)
        ok = _to_p(z) == want
        if zp == xp:
            if op == 'set': x.set(x)
            elif op == 'abs': x.abs(x)
            else: x.neg(x)
            ok = ok and _to_p(x) == want
        return ok
    if op == 'cmp':
        return str(_from_p(int(w[2]), w[3]).cmp(_from_p(int(w[4]), w[5]))) == want
    if op == 'sign':
        return str(_from_p(int(w[2]), w[3]).sign()) == want
    if op == 'setstr':
        return _to_p(BigFloat(int(w[1])).set_string(PI_STR)) == want
    if op == 'tofixed':
        x = _from_p(int(w[2]), w[3])
        bits = int(w[4])
        return (str(x.to_fixed(bits, 256)) if bits <= 254 else str(x.to_fixed(bits, 512))) == want
    if op == 'float64':
        return _bits_hex(_from_p(int(w[2]), w[3]).float64()) == want
    if op == 'setf64':
        return _to_p(BigFloat(int(w[1])).set_float64(_hex_float(w[2]))) == want
    return False


def test_bigfloat_known_answers():
    counts = Dict[str, Tuple[int, int]]()
    for line in VECTORS:
        op = line[:line.index(' ')]
        n, bad = counts.get(op, (0, 0))
        counts[op] = (n + 1, bad + (0 if _check(line) else 1))
    for op in sorted(counts.keys()):
        n, bad = counts[op]
        aliased = ', aliased forms included' if op in ('add', 'sub', 'mul', 'quo', 'set', 'abs', 'neg') else ''
        assert_eq(f"BigFloat {op} agrees with Go's math/big.Float ({n} known answers{aliased})", bad, 0)


def test_bigfloat_refusals():
    refused = 0
    for s in ['', '.', '-', '1e5', '1.2.3', '0x10', ' 1', '1_000', 'inf']:
        try:
            BigFloat(64).set_string(s)
        except ValueError:
            refused += 1
    assert_eq("BigFloat.set_string refuses what is not [+-]digits[.[digits]] or [+-].digits", refused, 9)
    parsed = (BigFloat(64).set_string('-.5').float64(), BigFloat(64).set_string('+12.').float64(), BigFloat(64).set_string('007').float64())
    assert_eq("BigFloat.set_string takes signs, a leading or trailing point and leading zeros", parsed, (-0.5, 12.0, 7.0))
    refused = 0
    for f in [math.nan, math.inf, -math.inf]:
        try:
            BigFloat(64).set_float64(f)
        except ValueError:
            refused += 1
    try:
        BigFloat(64).quo(BigFloat(64).set_float64(1.0), BigFloat(64))
    except ValueError:
        refused += 1
    assert_eq("BigFloat refuses NaN and infinities, and a division by zero", refused, 4)


def test_cosine_coefficients():
    # bootstrapping's sine polynomial for K = 16, degree 30, message ratio 256 and 3 double angles (the default
    # bootstrapping parameters'): the doubles Lattigo v4.0.0's ApproximateCos gives, bit for bit
    coeffs = approximate_cos(16, 30, 256.0, 3)
    assert_eq("Cosine approximation (K 16, degree 30, ratio 256, 3 double angles): Lattigo's coefficients, bit for bit", [_bits_hex(c.real) for c in coeffs], COSINE_K16_DEG30_R256_D3)


def _low64(x) -> u64:
    # the low 64 bits of a fixed-point integer (two's complement)
    return u64(int(x & type(x)(0xFFFFFFFF))) | (u64(int((x >> type(x)(32)) & type(x)(0xFFFFFFFF))) << u64(32))


def root_table_digest(m: int) -> str:
    # a non-linear mix of the low 64 bits of every entry, real and imaginary parts in order (a linear sum would let the
    # table's symmetries cancel)
    re, im = _exact_roots(m)
    acc = u64(0)
    for i in range(len(re)):
        for v in (_low64(re[i]), _low64(im[i])):
            acc = (acc ^ v) * u64(0x9E3779B97F4A7C15)
            acc ^= acc >> u64(31)
    return _hex64(acc)


def test_root_table_digest():
    # The exact encoder's roots of unity for m = 2^14 at this build's fixed-point width (equal, entry for entry, to the
    # tables the earlier, library-backed floats gave)
    want = ROOT_DIGEST_256 if LATTISEQ_EXACT_INT_SIZE == 256 else ROOT_DIGEST_512
    assert_eq(f"Exact encoder roots of unity (m = 2^14, {LATTISEQ_EXACT_INT_SIZE}-bit fixed point): the pinned digest", root_table_digest(1 << 14), want)


def test_bigfloat():
    test_bigfloat_known_answers()
    test_bigfloat_refusals()
    test_cosine_coefficients()
    test_root_table_digest()
