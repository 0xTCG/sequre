# Lattigo v4.0.0's ApproximateCos(16, 30, 256, 3) (the default bootstrapping parameters' sine polynomial): the bits of
# each float64 coefficient
COSINE_K16_DEG30_R256_D3 = [
    "3fc428eb5cbe1eb7",
    "bee25bf0f8fae09b",
    "3fd74ed59539192a",
    "bee133cfa49d7b34",
