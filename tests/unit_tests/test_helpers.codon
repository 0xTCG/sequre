from sequre.utils.testing import assert_eq, assert_eq_approx, assert_geq, assert_leq
from sequre.utils.utils import __rand_mat
from sequre.constants import MPC_FIELD_SIZE
from sequre.utils.io import write_matrix, read_matrix
from sequre.stdlib.numpy.create import array


def test_io():
    print(f'Testing I/O ... \n')
    
    data_path = 'tests/data/temp.bin'
    rows, cols = 10, 10
    random_matrix = __rand_mat([rows, cols], MPC_FIELD_SIZE)
    
    with open(data_path, 'wb') as f:
        write_matrix(f, random_matrix, binary=True, TP=type(MPC_FIELD_SIZE))
    with open(data_path) as f:
        assert_eq('Binary file i/o', read_matrix(f, rows, cols, True, TP=type(MPC_FIELD_SIZE)), random_matrix)
    

def _fails(check) -> bool:
    try:
        check()
    except AssertionError:
        return True
    return False


def test_assertion_helpers():
    print(f'Testing assertion helpers ... \n')
    empty = List[float]()

    # Checks that must pass
    assert_eq_approx('Approx: equal vectors', [1.0, 2.0], [1.0, 2.01], silent_pass=True)
    assert_eq_approx('Approx: nested lists', [[1.0, 2.0], [3.0, 4.0]], [[1.0, 2.0], [3.0, 4.01]], silent_pass=True)
    assert_eq_approx('Approx: ndarrays', array([1.0, 2.0, 3.0]), array([1.0, 2.0, 3.01]), silent_pass=True)
    assert_eq_approx('Approx: scalar against a vector', array([1.0, 1.01]), 1.0, silent_pass=True)
    assert_eq_approx('Approx: exact match with zero tolerance', [1.5], [1.5], error=0.0, silent_pass=True)
    assert_eq_approx('Approx: within the relative tolerance', 1000.5, 1000.0, error=0.0, rel_error=0.001, silent_pass=True)
    assert_eq('Eq: empty lists are equal', empty, empty, silent_pass=True)
    assert_geq('Geq: element-wise', [2.0, 3.0], [1.0, 3.0], silent_pass=True)
    assert_leq('Leq: element-wise', [1.0, 3.0], [2.0, 3.0], silent_pass=True)

    # Checks that must fail; each of these passed before the shape and emptiness checks
    assert _fails(lambda: assert_eq_approx('', [1.0], [1.0, 2.0], silent_pass=True)), 'assert_eq_approx passed a shorter result'
    assert _fails(lambda: assert_eq_approx('', [1.0, 2.0], [1.0], silent_pass=True)), 'assert_eq_approx passed a longer result'
    assert _fails(lambda: assert_eq_approx('', empty, empty, silent_pass=True)), 'assert_eq_approx passed empty values'
    assert _fails(lambda: assert_eq_approx('', [[1.0], [2.0]], [[1.0, 5.0], [2.0, 5.0]], silent_pass=True)), \
        'assert_eq_approx passed a narrower nested result'
    assert _fails(lambda: assert_eq_approx('', array([1.0]), array([1.0, 1.0, 1.0]), silent_pass=True)), \
        'assert_eq_approx passed a broadcast ndarray'
    assert _fails(lambda: assert_eq('', array([1.0]), array([1.0, 1.0]), silent_pass=True)), 'assert_eq passed a broadcast ndarray'
    assert _fails(lambda: assert_geq('', [2.0], [1.0, 5.0], silent_pass=True)), 'assert_geq passed a shorter result'
    assert _fails(lambda: assert_leq('', empty, empty, silent_pass=True)), 'assert_leq passed empty values'

    # Checks that must still fail
    assert _fails(lambda: assert_eq_approx('', 1002.0, 1000.0, error=0.0, rel_error=0.001, silent_pass=True)), \
        'assert_eq_approx passed a value outside the relative tolerance'
    assert _fails(lambda: assert_eq_approx('', float('nan'), 0.0, silent_pass=True)), 'assert_eq_approx passed NaN'
    assert _fails(lambda: assert_eq_approx('', 1.1, 1.0, silent_pass=True)), 'assert_eq_approx passed a value out of tolerance'

    # List comparisons refuse lists of different lengths instead of comparing a prefix
    raised = False
    try:
        _ = [1.0] < [2.0, 3.0]
    except ValueError:
        raised = True
    assert raised, 'Comparing lists of different lengths did not raise'

    print(f'Assertion helpers tests passed.\n')


def test_helpers():
    print(f'Testing helpers ... \n')

    test_io()
    test_assertion_helpers()

    print(f'Helpers tests passed.\n')
