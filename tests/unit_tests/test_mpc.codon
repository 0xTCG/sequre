def test_share_from_round_trip[TP](mpc: MPCEnv[TP], modulus: TP, alg_struct: str):
    # Every party in turn shares values near 0 and near the modulus (small negatives); each must reveal unchanged. With
    # four or more parties (SEQURE_CP_COUNT) a source sums two or more masks, which must be added mod the modulus.
    n = 500
    data = [TP(i) for i in range(n // 2)]
    data.extend([modulus - TP(i + 1) for i in range(n // 2)])
    for source in range(mpc.comms.number_of_parties):
        share = mpc.comms.share_from(data if mpc.pid == source else data.zeros(), source, modulus)
        revealed = mpc.comms.reveal(share, modulus)
        if mpc.pid != 0:
            assert_eq(f'CP{mpc.pid}:\tShare from CP{source} and reveal on {alg_struct} ({mpc.comms.number_of_parties} parties)',
                      revealed, data)


def _ne_plain[TP](values: List[TP]) -> List[TP]:
    return [TP(0) if v == TP(0) else TP(1) for v in values]


def test_ring_equality[TP](mpc: MPCEnv[TP], modulus: TP, wide_values: List[TP]):
    # [a != 0] by the ring's equality test (MPCBoolean.is_nonzero on ring shares): exact for every |a| < 2^nbits, zero
    # and both signs, at the widths InternalMPC.ne gives it (K for a difference of two fixed-point values, K + F + 1
    # inside delayed_truncation(), L for integers and wide differences), against plaintext and, where the sign test is
    # exact, against the ring's earlier != (InternalMPC.__ne_ring: [d > 0] + [-d > 0])
    for nbits in (MPC_NBIT_K, MPC_NBIT_K + MPC_NBIT_F + 1, MPC_MODULUS_BITS):
        top = (TP(1) << TP(nbits)) - TP(1)  # the largest admissible magnitude
        values = [TP(0), TP(1), modulus - TP(1), TP(2), modulus - TP(2), top, modulus - top, TP(0)]
        for k in (MPC_NBIT_F - 1, MPC_NBIT_F, MPC_NBIT_F + 1, MPC_NBIT_K - 1, MPC_NBIT_K, nbits - 2, nbits - 1):
            if k < nbits:
                values.append(TP(1) << TP(k))
                values.append(modulus - (TP(1) << TP(k)))
        with mpc.randomness.global_stream():
            drawn = [TP(0) for _ in range(40)].rand_bits(nbits)
        for i in range(len(drawn)):
            values.append(drawn[i] if i % 2 == 0 else (modulus - drawn[i]) % modulus)
            if i % 8 == 0:
                values.append(TP(0))
        shared = mpc.comms.share_from_trusted_dealer(values, modulus)
        got = mpc.comms.reveal(mpc.boolean.is_nonzero(shared, modulus, nbits=nbits), modulus)
        if mpc.pid != 0:
            assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) over {nbits} bits: zero, both signs, the edge 2^{nbits} - 1, random', got, _ne_plain(values))

    # The sign-test reference, where the sign test is exact: a fixed-point difference (|d| < 2^K: K + 1 bits) and the
    # integers below 2^(L - 1) (L bits)
    narrow = [TP(0), TP(1), modulus - TP(1), (TP(1) << TP(MPC_NBIT_K)) - TP(1), modulus - ((TP(1) << TP(MPC_NBIT_K)) - TP(1)), TP(1) << TP(MPC_NBIT_F), TP(0), modulus - (TP(1) << TP(MPC_NBIT_K - 1))]
    shared = mpc.comms.share_from_trusted_dealer(narrow, modulus)
    new_ne = mpc.comms.reveal(mpc.boolean.is_nonzero(shared, modulus, nbits=MPC_NBIT_K), modulus)
    old_ne = mpc.comms.reveal(InternalMPC.__ne_ring(mpc, shared, True, False, modulus), modulus)
    wide = [v for v in wide_values if v < (TP(1) << TP(MPC_MODULUS_BITS - 1)) - TP(1) or v > (TP(1) << TP(MPC_MODULUS_BITS - 1)) + TP(1)]
    wide_shared = mpc.comms.share_from_trusted_dealer(wide, modulus)
    new_wide = mpc.comms.reveal(mpc.boolean.is_nonzero(wide_shared, modulus), modulus)
    old_wide = mpc.comms.reveal(InternalMPC.__ne_ring(mpc, wide_shared, False, True, modulus), modulus)
    # Shapes: a scalar, a matrix and an empty vector (every party returns at once, before any draw or message)
    scalar = mpc.comms.reveal(mpc.boolean.is_nonzero(mpc.comms.share_from_trusted_dealer(modulus - TP(7), modulus), modulus, nbits=MPC_NBIT_K), modulus)
    matrix = mpc.comms.reveal(mpc.boolean.is_nonzero(mpc.comms.share_from_trusted_dealer([[TP(0), TP(5)], [modulus - TP(5), TP(0)]], modulus), modulus, nbits=MPC_NBIT_K), modulus)
    before = mpc.stats.bytes_sent
    empty = mpc.boolean.is_nonzero(List[TP](), modulus, nbits=MPC_NBIT_K)
    if mpc.pid != 0:
        assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) over K bits equals the sign test of (d, -d)', new_ne, old_ne)
        assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) over K bits against plaintext', new_ne, _ne_plain(narrow))
        assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) far beyond the fixed-point range equals the sign test of (d, -d)', new_wide, old_wide)
        assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) far beyond the fixed-point range against plaintext', new_wide, _ne_plain(wide))
        assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) of a scalar', scalar, TP(1))
        assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) on a matrix', matrix, [[TP(0), TP(1)], [TP(1), TP(0)]])
        assert_eq(f'CP{mpc.pid}:\tIs nonzero (ring) of an empty vector: empty, nothing sent', (len(empty), mpc.stats.bytes_sent - before), (0, 0))


def test_equality_cost[TP](mpc: MPCEnv[TP], modulus: TP):
    # The rounds and the bytes of one equality test of n values at the width of a fixed-point difference (InternalMPC.ne:
    # K bits on the ring, K + F on the field), at every compute party. Ring: 3 openings (c, the shifted count, the bit
    # conversion); field: 4 (the opening, two fan-in ORs, the table lookup). Each message is send_as_jar's size field
    # and the pickled list (its length and its elements); the hub sends each opening to every other compute party, the
    # others send theirs to the hub.
    n = 100
    ring = modulus.popcnt() == 1
    nbits = MPC_NBIT_K if ring else MPC_NBIT_K + MPC_NBIT_F
    shared = mpc.comms.share_from_trusted_dealer([TP(i % 3) for i in range(n)], modulus)
    mpc.comms.sync_parties()
    rounds, sent = mpc.stats.rounds, mpc.stats.bytes_sent
    res = mpc.boolean.is_nonzero(shared, modulus, nbits=nbits)
    rounds, sent = mpc.stats.rounds - rounds, mpc.stats.bytes_sent - sent
    word = MPC_INT_SIZE // 8
    if ring:
        per_peer = 3 * 2 * sizeof(int) + n * (word + sizeof(int) + PACKING_SIZE // 8)
        want_rounds = 3
    else:
        blocks = (nbits + MPC_THIRD_FIELD_SIZE - 2) // (MPC_THIRD_FIELD_SIZE - 1)
        per_peer = 4 * 2 * sizeof(int) + n * (2 * word + sizeof(int) * (blocks + 1))
        want_rounds = 4
    want_sent = per_peer * (mpc.comms.number_of_parties - 2) if mpc.pid == mpc.comms.hub_pid else per_peer
    got = mpc.comms.reveal(res, modulus)
    if mpc.pid != 0:
        assert_eq(f'CP{mpc.pid}:\tIs nonzero ({"ring" if ring else "field"}) of {n} values: right', got, [TP(int(i % 3 != 0)) for i in range(n)])
        assert_eq(f'CP{mpc.pid}:\tIs nonzero ({"ring" if ring else "field"}) of {n} values over {nbits} bits: {want_rounds} rounds', rounds, want_rounds)
        assert_eq(f'CP{mpc.pid}:\tIs nonzero ({"ring" if ring else "field"}) of {n} values over {nbits} bits: bytes sent', sent, want_sent)


def _streams(mpc) -> List[int]:
    # The bytes this party sent and where each of its streams is (private, pairwise, global): unchanged by a call that
    # refused before any draw or message
    state = [mpc.stats.bytes_sent, mpc.randomness.stream_digest(-1)]
    for p in range(mpc.comms.number_of_parties):
        state.append(mpc.randomness.stream_digest(p))
    return state


def test_field_only_guards(mpc):
    # Field-only primitives refuse a power-of-two modulus (the ring's, or a small one) with a ValueError, at every party at
    # the same call, before any draw or message; on a prime modulus they compute as before. Whatever the run's modulus:
    # every call names its modulus.
    ring = MPC_RING_SIZE
    small_ring = MPC_SECOND_RING_SIZE
    bits = mpc.comms.share_from_trusted_dealer([[mpc_uint(1), mpc_uint(0), mpc_uint(1)], [mpc_uint(0), mpc_uint(0), mpc_uint(0)]], ring)
    small_bits = mpc.comms.share_from_trusted_dealer([[1, 0, 1], [0, 0, 0]], MPC_SECOND_FIELD_SIZE)
    values = mpc.comms.share_from_trusted_dealer([mpc_uint(5), mpc_uint(1) << mpc_uint(MPC_NBIT_F)], ring)
    mpc.comms.sync_parties()
    names = List[str]()
    refused = List[bool]()
    intact = List[bool]()
    for case in range(14):
        before = _streams(mpc)
        raised = False
        try:
            if case == 0:
                names.append("mod_inv on the ring")
                mod_inv(mpc_uint(3), ring)
            elif case == 1:
                names.append("mod_inv modulo 16")
                mod_inv(3, small_ring)
            elif case == 2:
                names.append("lagrange_interp on the ring")
                mpc.polynomial.lagrange_interp([1, 2, 3], [mpc_uint(0), mpc_uint(1), mpc_uint(1)], ring)
            elif case == 3:
                names.append("lagrange_interp_simple on the ring")
                mpc.polynomial.lagrange_interp_simple([mpc_uint(0), mpc_uint(1), mpc_uint(1)], ring)
            elif case == 4:
                names.append("fan_in_or on the ring")
                mpc.boolean.fan_in_or(bits, ring)
            elif case == 5:
                names.append("fan_in_or modulo 16")
                mpc.boolean.fan_in_or(small_bits, small_ring)
            elif case == 6:
                names.append("prefix_or on the ring")
                mpc.boolean.prefix_or(bits, ring)
            elif case == 7:
                names.append("fan_in_and on the ring")
                mpc.boolean.fan_in_and(bits, ring)
            elif case == 8:
                names.append("prefix_and on the ring")
                mpc.boolean.prefix_and(bits, ring)
            elif case == 9:
                names.append("less_than_bits on the ring")
                mpc.boolean.less_than_bits(bits, bits, ring)
            elif case == 10:
                names.append("less_than_bits_public on the ring")
                mpc.boolean.less_than_bits_public(bits, bits, ring)
            elif case == 11:
                names.append("demultiplexer modulo 16")
                mpc.boolean.demultiplexer(small_bits, small_ring)
            elif case == 12:
                names.append("the field normalizer on the ring")
                mpc.fp.__normalizer_even_exp(values, ring)
            else:
                names.append("table_lookup on the ring")
                mpc.polynomial.table_lookup(values, 0, ring)
        except ValueError:
            raised = True
        refused.append(raised)
        intact.append(_streams(mpc) == before)
    mpc.comms.sync_parties()  # the parties stayed in step (it checks the global stream)
    # On a prime modulus the same calls compute (the fan-in OR of each row)
    ors = mpc.comms.reveal(mpc.boolean.fan_in_or(small_bits, MPC_SECOND_FIELD_SIZE), MPC_SECOND_FIELD_SIZE)
    inverse = mod_inv(mpc_uint(3), MPC_FIELD_SIZE).mul_mod(mpc_uint(3), MPC_FIELD_SIZE)
    for i in range(len(names)):
        assert_eq(f'CP{mpc.pid}:\t{names[i]} refused before any draw or message', (refused[i], intact[i]), (True, True))
    if mpc.pid != 0:
        assert_eq(f'CP{mpc.pid}:\tfan_in_or on a prime modulus computes', ors, [1, 0])
    assert_eq(f'CP{mpc.pid}:\tmod_inv on the field computes', inverse, mpc_uint(1))


def test_settings_digest(mpc):
    # The settings the parties compare at start (MPCEnv; a run with differing settings stops there, tests/network), and
    # the messages that name both sides
    ring = _settings(MPC_RING_SIZE)
    field = _settings(MPC_FIELD_SIZE)
    # Another width's field settings, as a build at that width sends them: L and c, K, F and V follow from the width
    widths = {128: (127, 1, 64, 32, 28), 192: (174, 3, 64, 32, 64), 256: (251, 9, 128, 64, 56)}
    other = 256 if MPC_INT_SIZE == 128 else 128
    wider = field.copy()
    wider[2] = other
    w = widths[other]
    wider[4] = w[0]
    wider[5] = w[1]
    wider[6] = w[2]
    wider[7] = w[3]
    wider[8] = w[4]
    debug = field.copy()
    debug[10] = 1 - debug[10]
    foreign = [0 for _ in range(len(field))]
    on_ring = f"the ring 2^{MPC_MODULUS_BITS}"
    on_field = f"the field 2^{MPC_MODULUS_BITS} - {MPC_MERSENNE_OFFSET}"
    assert_eq(f'CP{mpc.pid}:\tSettings: the ring and the field differ', ring != field, True)
    assert_eq(f'CP{mpc.pid}:\tSettings: the run agrees with itself', _settings(mpc.default_mpc_modulus) == _settings(mpc.default_mpc_modulus), True)
    assert_eq(f'CP{mpc.pid}:\tSettings message names both moduli', f"CP1 runs on {on_ring}, CP2 on {on_field}" in _settings_difference(1, ring, 2, field), True)
    assert_eq(f'CP{mpc.pid}:\tSettings message names both share widths', f"CP1 has {MPC_INT_SIZE}-bit shares, CP2 {other}-bit ones" in _settings_difference(1, field, 2, wider), True)
    width_only = _settings_difference(1, field, 2, wider)
    assert_eq(f'CP{mpc.pid}:\tSettings message: another width alone (no modulus flag, no fixed point)', "modulus flag" not in width_only and "fixed point" not in width_only and "runs on" not in width_only, True)
    both = _settings_difference(1, ring, 2, wider)
    assert_eq(f'CP{mpc.pid}:\tSettings message: another width and the other modulus', "-bit shares" in both and f"CP1 runs on {on_ring}" in both and "modulus flag" in both, True)
    assert_eq(f'CP{mpc.pid}:\tSettings message names DEBUG', "DEBUG is" in _settings_difference(0, field, 1, debug), True)
    assert_eq(f'CP{mpc.pid}:\tSettings of another layout name the version', "another version of Sequre" in _settings_difference(2, field, 0, foreign), True)


def test_share_records(mpc):
    # The record share_data writes beside a party's share files (applications/utils/data_sharing.codon), checked before
    # the files are read: matched, refused under the other modulus or share width or when share_data did not finish, and
    # files without a record (an older Sequre's) read on the field with a warning and refused on the ring. Each party its
    # own record, as share_data writes.
    directory = 'tests/data'
    protocol = 'record-test'
    path = share_record_path(directory, protocol, mpc.pid)
    files = [(f'__x_shares_{mpc.pid}.bin', 4, 3, True), (f'__y_r_{mpc.pid}.bin', 2, 5, False)]
    verdicts = List[str]()
    for written in (MPC_FIELD_SIZE, MPC_RING_SIZE):
        write_share_record(directory, protocol, mpc.pid, files, written)
        for read in (MPC_FIELD_SIZE, MPC_RING_SIZE):
            try:
                verdicts.append("loaded" if check_share_record(directory, protocol, mpc.pid, read) else "warned")
            except ValueError:
                verdicts.append("refused")
    # The record of an interrupted share_data
    mark_share_record_incomplete(directory, protocol, mpc.pid)
    for read in (MPC_FIELD_SIZE, MPC_RING_SIZE):
        try:
            verdicts.append("loaded" if check_share_record(directory, protocol, mpc.pid, read) else "warned")
        except ValueError as e:
            verdicts.append("refused" if "incomplete" in e.message else "refused, not as incomplete")
    # Another share width in the record
    write_share_record(directory, protocol, mpc.pid, files, MPC_FIELD_SIZE)
    with open(path) as f:
        lines = [line for line in f]
    with open(path, 'w') as f:
        for line in lines:
            f.write(f"mpc_int_size={2 * MPC_INT_SIZE}\n" if line.startswith("mpc_int_size=") else line.rstrip("\n") + "\n")
    try:
        verdicts.append("loaded" if check_share_record(directory, protocol, mpc.pid, MPC_FIELD_SIZE) else "warned")
    except ValueError:
        verdicts.append("refused")
    # No record
    os.remove(path)
    for read in (MPC_FIELD_SIZE, MPC_RING_SIZE):
        try:
            verdicts.append("loaded" if check_share_record(directory, protocol, mpc.pid, read) else "warned")
        except ValueError:
            verdicts.append("refused")
    assert_eq(f'CP{mpc.pid}:\tShare records: field and ring records read under each modulus, incomplete, another width, none',
              verdicts, ["loaded", "refused", "refused", "loaded", "refused", "refused", "refused", "warned", "refused"])
    mpc.comms.sync_parties()


def test_security_parameters(mpc):
    # The numbers docs/crypto-corner/security-assumptions.md quotes, per MPC_INT_SIZE: a change of the constants that
    # lowers one fails here. (L, K, F, V); the truncation's mask bits K + F + V and its statistical hiding 2^-V; the
    # MPC->MHE switch masks (MPCMHE._mpc_to_mhe_mask_bits) with 3 compute parties' worth of headroom, the same for both
    # moduli; the MHE->MPC switch's lambda
    expected = {128: (127, 64, 32, 28, 124), 192: (174, 64, 32, 64, 160), 256: (251, 128, 64, 56, 248)}
    L, K, F, V, trunc_bits = expected[MPC_INT_SIZE]
    assert_eq(f'CP{mpc.pid}:\tSecurity parameters: L, K, F, V at {MPC_INT_SIZE}-bit shares', (MPC_MODULUS_BITS, MPC_NBIT_K, MPC_NBIT_F, MPC_NBIT_V), (L, K, F, V))
    assert_eq(f'CP{mpc.pid}:\tSecurity parameters: the truncation mask has K + F + V bits, below L', (MPC_NBIT_K + MPC_NBIT_F + MPC_NBIT_V, MPC_NBIT_K + MPC_NBIT_F + MPC_NBIT_V < MPC_MODULUS_BITS), (trunc_bits, True))
    n_cp = mpc.comms.number_of_parties - 1
    switch_bits = L - 2 - (n_cp - 1).bitlen()
    for m in (MPC_FIELD_SIZE, MPC_RING_SIZE):
        assert_eq(f'CP{mpc.pid}:\tSecurity parameters: MPC->MHE mask bits on {modulus_name(m)} with {n_cp} compute parties', mpc.mhe._mpc_to_mhe_mask_bits(m), switch_bits)
    assert_eq(f'CP{mpc.pid}:\tSecurity parameters: the MPC->MHE opening hides x to 2^-{switch_bits - (K - 1)}', switch_bits - (K - 1) >= 60, True)
    assert_eq(f'CP{mpc.pid}:\tSecurity parameters: MHE->MPC lambda', MHE_MPC_SWITCH_LAMBDA, 128)


def test_mpc_core[TP](mpc: MPCEnv[TP], modulus: TP):
    alg_struct = "ring" if modulus.popcnt() == 1 else "field"
    print(f'CP{mpc.pid}:\tTesting MPC on {alg_struct}...\n')

    vector_length = 10
    mat_rows_no, mat_cols_no = 10, 15

    # Test inputs
    elem = TP(17)
    elem_int = 17
    vector = [TP(17), TP(19), TP(21)]
    vector_int = [17, 19, 21]
    matrix = [[TP(11), TP(13), TP(15)], [TP(17), TP(19), TP(21)], [TP(7), TP(8), TP(9)]]
    matrix_int = [[11, 13, 15], [17, 19, 21], [7, 8, 9]]
    float_elem = 3.14
    float_pub = 5.07
    fp_elem = double_to_fp(float_elem, modulus)
    fp_pub = double_to_fp(float_pub, modulus)
    a_bits = [TP(1), TP(0), TP(1), TP(0), TP(1), TP(0), TP(0)]
    b_bits = [TP(0), TP(0), TP(1), TP(0), TP(1), TP(0), TP(0)]
    
    shared_elem = mpc.comms.share_from_trusted_dealer(elem, modulus)
    shared_elem_int = mpc.comms.share_from_trusted_dealer(elem_int, MPC_SECOND_FIELD_SIZE)
    shared_vector = mpc.comms.share_from_trusted_dealer(vector, modulus)
    shared_vector_int = mpc.comms.share_from_trusted_dealer(vector_int, MPC_SECOND_FIELD_SIZE)
    shared_matrix = mpc.comms.share_from_trusted_dealer(matrix, modulus)
    shared_matrix_int = mpc.comms.share_from_trusted_dealer(matrix_int, MPC_SECOND_FIELD_SIZE)
    shared_fp_elem = mpc.comms.share_from_trusted_dealer(fp_elem, modulus)

    mpc.comms.sync_parties()

    with mpc.randomness.global_stream():
        elem_to_send = elem.rand(modulus, "uniform")
    if mpc.pid == 1:
        mpc.comms.send(elem_to_send, 2)
        mpc.comms.send(modulus - elem_to_send, 2)
    elif mpc.pid == 2:
        received_elem = mpc.comms.receive(1, T=type(elem))
        assert_eq('Sending-receiving elem 1', received_elem, elem_to_send)
        received_elem = mpc.comms.receive(1, T=type(elem))
        assert_eq('Sending-receiving elem 2', received_elem, modulus - elem_to_send)
    
    with mpc.randomness.global_stream():
        vector_to_send = [elem.rand(modulus, "uniform") for _ in range(vector_length)]
    if mpc.pid == 1:
        mpc.comms.send(vector_to_send, 2)
    elif mpc.pid == 2:
        received_vector = mpc.comms.receive(1, T=type(vector_to_send))
        assert_eq('Sending-receiving vector', received_vector, vector_to_send)
    
    with mpc.randomness.global_stream():
        mat_to_send = [[elem.rand(modulus, "uniform") for _ in range(mat_cols_no)] for _ in range(mat_rows_no)]
    if mpc.pid == 1:
        mpc.comms.send(mat_to_send, 2)
    elif mpc.pid == 2:
        received_mat = mpc.comms.receive(1, T=type(mat_to_send))
        assert_eq('Sending-receiving matrix', received_mat, mat_to_send)
    
    with mpc.randomness.global_stream():
        elem_to_send_int = elem_int.rand(MPC_SECOND_FIELD_SIZE, "uniform")
    if mpc.pid == 1:
        mpc.comms.send(elem_to_send_int, 2)
    elif mpc.pid == 2:
        received_elem = mpc.comms.receive(1, T=type(elem_to_send_int))
        assert_eq('Sending-receiving elem of ints', received_elem, elem_to_send_int)
    
    with mpc.randomness.global_stream():
        vector_to_send_int = [elem_int.rand(MPC_SECOND_FIELD_SIZE, "uniform") for _ in range(vector_length)]
    if mpc.pid == 1:
        mpc.comms.send(vector_to_send_int, 2)
    elif mpc.pid == 2:
        received_vector = mpc.comms.receive(1, T=type(vector_to_send_int))
        assert_eq('Sending-receiving vector of ints', received_vector, vector_to_send_int)
    
    with mpc.randomness.global_stream():
        mat_to_send_int = [[elem_int.rand(MPC_SECOND_FIELD_SIZE, "uniform") for _ in range(mat_cols_no)] for _ in range(mat_rows_no)]
    if mpc.pid == 1:
        mpc.comms.send(mat_to_send_int, 2)
    elif mpc.pid == 2:
        received_mat = mpc.comms.receive(1, T=type(mat_to_send_int))
        assert_eq('Sending-receiving matrix of ints', received_mat, mat_to_send_int)

    revealed_elem = mpc.comms.reveal(shared_elem, modulus)
    if mpc.pid != 0:
        assert_eq('Revealing elem', revealed_elem, elem)
    
    revealed_vector = mpc.comms.reveal(shared_vector, modulus)
    if mpc.pid != 0:
        assert_eq('Revealing vector', revealed_vector, vector)
    
    revealed_matrix = mpc.comms.reveal(shared_matrix, modulus)
    if mpc.pid != 0:
        assert_eq('Revealing matrix', revealed_matrix, matrix)

    revealed_elem_int = mpc.comms.reveal(shared_elem_int, MPC_SECOND_FIELD_SIZE)
    if mpc.pid != 0:
        assert_eq('Revealing elem of ints', revealed_elem_int, elem_int)
    
    revealed_vector_int = mpc.comms.reveal(shared_vector_int, MPC_SECOND_FIELD_SIZE)
    if mpc.pid != 0:
        assert_eq('Revealing vector of ints', revealed_vector_int, vector_int)
    
    revealed_matrix_int = mpc.comms.reveal(shared_matrix_int, MPC_SECOND_FIELD_SIZE)
    if mpc.pid != 0:
        assert_eq('Revealing matrix of ints', revealed_matrix_int, matrix_int)
    
    if mpc.pid != 0:
        mpc.randomness.switch_seed(0)
    random_number = elem.rand(modulus, "uniform")
    if mpc.pid != 0:
        mpc.comms.send(random_number, 0)
        mpc.randomness.restore_seed(0)
    
    if mpc.pid == 0:
        for p in range(1, mpc.comms.number_of_parties):
            mpc.randomness.switch_seed(p)
            random_number = elem.rand(modulus, "uniform")
            mpc.randomness.restore_seed(p)
            received_random_number = mpc.comms.receive(p, T=type(random_number))
            assert_eq(f'PRG {p}', random_number, received_random_number)

    x_r, r = mpc.arithmetic.__beaver_partition(shared_elem, modulus)
    if mpc.pid == 0:
        for p in range(1, mpc.comms.number_of_parties):
            mpc.comms.send(r, p)
    else:
        r_0 = mpc.comms.receive(0, T=type(r))
        assert_eq('Beaver partition elem 1', r_0, mpc.comms.reveal(r, modulus))
        assert_eq('Beaver partition elem 2', x_r.add_mod(mpc.comms.reveal(r, modulus), modulus), elem)
    
    x_r_vec, r_vec = mpc.arithmetic.__beaver_partition(shared_vector, modulus)
    if mpc.pid == 0:
        for p in range(1, mpc.comms.number_of_parties):
            mpc.comms.send(r_vec, p)
    else:
        r_0 = mpc.comms.receive(0, T=type(r_vec))
        assert_eq('Beaver partition vector 1', r_0, mpc.comms.reveal(r_vec, modulus))
        assert_eq('Beaver partition vector 2', x_r_vec.add_mod(mpc.comms.reveal(r_vec, modulus), modulus), vector)
        
    x_r_mat, r_mat = mpc.arithmetic.__beaver_partition(shared_matrix, modulus)
    if mpc.pid == 0:
        for p in range(1, mpc.comms.number_of_parties):
            mpc.comms.send(r_mat, p)
    else:
        r_0 = mpc.comms.receive(0, T=type(r_mat))
        assert_eq('Beaver partition matrix 1', r_0, mpc.comms.reveal(r_mat, modulus))
        assert_eq('Beaver partition matrix 2', x_r_mat.add_mod(mpc.comms.reveal(r_mat, modulus), modulus), matrix)
    
    x_r_int, r_int = mpc.arithmetic.__beaver_partition(shared_elem_int, MPC_SECOND_FIELD_SIZE)
    if mpc.pid == 0:
        for p in range(1, mpc.comms.number_of_parties):
            mpc.comms.send(r_int, p)
    else:
        r_0_int = mpc.comms.receive(0, T=type(r_int))
        assert_eq('Beaver partition elem 1 int', r_0_int, mpc.comms.reveal(r_int, MPC_SECOND_FIELD_SIZE))
        assert_eq('Beaver partition elem 2 int',
                  x_r_int.add_mod(mpc.comms.reveal(r_int, MPC_SECOND_FIELD_SIZE), MPC_SECOND_FIELD_SIZE),
                  elem_int)
    
    x_r_vec_int, r_vec_int = mpc.arithmetic.__beaver_partition(shared_vector_int, MPC_SECOND_FIELD_SIZE)
    if mpc.pid == 0:
        for p in range(1, mpc.comms.number_of_parties):
            mpc.comms.send(r_vec_int, p)
    else:
        r_0_int = mpc.comms.receive(0, T=type(r_vec_int))
        assert_eq('Beaver partition vector 1 int', r_0_int, mpc.comms.reveal(r_vec_int, MPC_SECOND_FIELD_SIZE))
        assert_eq('Beaver partition vector 2 int',
                   x_r_vec_int.add_mod(mpc.comms.reveal(r_vec_int, MPC_SECOND_FIELD_SIZE), MPC_SECOND_FIELD_SIZE),
                   vector_int)
        
    x_r_mat_int, r_mat_int = mpc.arithmetic.__beaver_partition(shared_matrix_int, MPC_SECOND_FIELD_SIZE)
    if mpc.pid == 0:
        for p in range(1, mpc.comms.number_of_parties):
            mpc.comms.send(r_mat_int, p)
    else:
        r_0_int = mpc.comms.receive(0, T=type(r_mat_int))
        assert_eq('Beaver partition matrix 1 int', r_0_int, mpc.comms.reveal(r_mat_int, MPC_SECOND_FIELD_SIZE))
        assert_eq('Beaver partition matrix 2 int',
                  x_r_mat_int.add_mod(mpc.comms.reveal(r_mat_int, MPC_SECOND_FIELD_SIZE), MPC_SECOND_FIELD_SIZE),
                  matrix_int)

    p_elem = mpc.arithmetic.multiply(shared_elem, shared_elem, modulus)
    revealed_p_elem = mpc.comms.reveal(p_elem, modulus)
    if mpc.pid != 0:
        assert_eq('Multiply elem', revealed_p_elem, elem.mul_mod(elem, modulus))

    p_vec = mpc.arithmetic.multiply(shared_vector, shared_vector, modulus)
    revealed_p_vec = mpc.comms.reveal(p_vec, modulus)
    if mpc.pid != 0:
        assert_eq('Multiply vector', revealed_p_vec, vector.mul_mod(vector, modulus))

    p_mat = mpc.arithmetic.multiply(shared_matrix, shared_matrix, modulus)
    revealed_p_mat = mpc.comms.reveal(p_mat, modulus)
    if mpc.pid != 0:
        assert_eq('Multiply matrix', revealed_p_mat, matrix.mul_mod(matrix, modulus))

    p_mat_bulk = mpc.arithmetic.multiply_bulk([shared_matrix], [shared_matrix], modulus)
    revealed_p_mat = mpc.comms.reveal(p_mat_bulk[0], modulus)
    if mpc.pid != 0:
        assert_eq('Multiply bulk', revealed_p_mat, matrix.mul_mod(matrix, modulus))
    
    p_mat_bulk = mpc.arithmetic.multiply_mat_bulk([shared_matrix], [shared_matrix], modulus)
    revealed_p_mat = mpc.comms.reveal(p_mat_bulk[0], modulus)
    if mpc.pid != 0:
        assert_eq('Multiply matrix bulk', revealed_p_mat, matrix.matmul_mod(matrix, modulus))

    shared_base = mpc.comms.share_from_trusted_dealer(TP(4), modulus)
    p_vec = mpc.polynomial.powers(shared_base, 10, modulus)
    revealed_p_vec = mpc.comms.reveal(p_vec, modulus)
    if mpc.pid != 0:
        assert_eq('Powers elem', revealed_p_vec[10], TP(1048576))
    
    shared_base_vector = mpc.comms.share_from_trusted_dealer([TP(4), TP(1), TP(6)], modulus)
    p_mat = mpc.polynomial.powers(shared_base_vector, 10, modulus)
    revealed_p_mat = mpc.comms.reveal(p_mat, modulus)
    if mpc.pid != 0:
        assert_eq('Powers vector', revealed_p_mat[10], [TP(1048576), TP(1), TP(60466176)])
    
    shared_x = mpc.comms.share_from_trusted_dealer([TP(2), TP(4), TP(6)], modulus)
    coeff = [
        [TP(1) for _ in range(3)],
        [TP(2) for _ in range(3)],
        [TP(3) for _ in range(3)]]
    p = mpc.polynomial.evaluate_poly(shared_x, coeff, modulus)
    revealed_p = mpc.comms.reveal(p, modulus)
    if mpc.pid != 0:
        expected_mat = [
            [TP(7), TP(21), TP(43)],
            [TP(14), TP(42), TP(86)],
            [TP(21), TP(63), TP(129)]]
        assert_eq('Evaluate polynomial', revealed_p, expected_mat)
    
    size = 10
    # Fan-in and prefix OR and AND interpolate a polynomial over the modulus (Lagrange: field-only, as even numbers
    # have no inverse modulo a power of two): field shares only. On the ring they refuse (test_field_only_guards).
    if modulus.popcnt() != 1:
        input_bits = [
            [(TP(0) if i != (size - 1) else e) for i in range(size)] for e in a_bits]
        shared_input_bits = mpc.comms.share_from_trusted_dealer(input_bits, modulus)
        or_results = mpc.boolean.fan_in_or(shared_input_bits, modulus)
        revealed_or_results = mpc.comms.reveal(or_results, modulus)
        if mpc.pid != 0:
            assert_eq('Fan in or', revealed_or_results, a_bits)
    
        input_bits = [
            [(TP(0) if i != (size - 1) else e) for i in range(size)] for e in a_bits]
        shared_input_bits = mpc.comms.share_from_trusted_dealer(input_bits, modulus)
        prefix_or_results = mpc.boolean.prefix_or(shared_input_bits, modulus)
        revealed_prefix_or_results = mpc.comms.reveal(prefix_or_results, modulus)
        if mpc.pid != 0:
            assert_eq('Prefix or', revealed_prefix_or_results, input_bits)

        input_bits = [
            [(TP(1) if i != (size - 1) else e) for i in range(size)] for e in a_bits]
        shared_input_bits = mpc.comms.share_from_trusted_dealer(input_bits, modulus)
        and_results = mpc.boolean.fan_in_and(shared_input_bits, modulus)
        revealed_and_results = mpc.comms.reveal(and_results, modulus)
        if mpc.pid != 0:
            assert_eq('Fan in and', revealed_and_results, a_bits)
        
        input_bits = [
            [(TP(1) if i != (size - 1) else e) for i in range(size)] for e in a_bits]
        shared_input_bits = mpc.comms.share_from_trusted_dealer(input_bits, modulus)
        prefix_and_results = mpc.boolean.prefix_and(shared_input_bits, modulus)
        revealed_prefix_and_results = mpc.comms.reveal(prefix_and_results, modulus)
        if mpc.pid != 0:
            assert_eq('Prefix and', revealed_prefix_and_results, input_bits)
    
    shared_a_bits = mpc.comms.share_from_trusted_dealer([a_bits], modulus)
    shared_b_bits = mpc.comms.share_from_trusted_dealer([b_bits], modulus)
    # The bit comparison builds on prefix OR (an interpolation over the modulus): field-only, as the fan-in ORs above.
    # On the ring it refuses (test_field_only_guards); its "Not less than bits" passed there only by chance.
    if modulus.popcnt() != 1:
        not_less_results = mpc.boolean.less_than_bits(shared_a_bits, shared_b_bits, modulus)
        less_results = mpc.boolean.less_than_bits(shared_b_bits, shared_a_bits, modulus)
        revealed_not_less_results = mpc.comms.reveal(not_less_results, modulus)
        revealed_less_results = mpc.comms.reveal(less_results, modulus)
        if mpc.pid != 0:
            assert_eq('Not less than bits', revealed_not_less_results, [TP(0)])
            assert_eq('Less than bits', revealed_less_results, [TP(1)])
    
    pos_neg = [
        double_to_fp(5.07, modulus),
        double_to_fp(-5.07, modulus),
        double_to_fp(0.0, modulus)]
    pos_neg_revealed = mpc.comms.reveal(mpc.boolean.is_positive(mpc.comms.share_from_trusted_dealer(pos_neg, modulus), modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Is positive', pos_neg_revealed, [TP(1), TP(0), TP(0)])

    # Far beyond the fixed-point range: exact over the modulus' bits by default on both moduli (the field's sign test
    # looked at K + F bits: wrong with probability about 2|a| / 2^(K + F), M-MPC-17)
    wide_values = [TP(0), TP(1), modulus - TP(1)]
    wide_signs = [TP(0), TP(1), TP(0)]
    for k in (60, 64, 95, 96, 120, MPC_MODULUS_BITS - 3, MPC_MODULUS_BITS - 2):
        wide_values.append(TP(1) << TP(k))
        wide_signs.append(TP(1))
        wide_values.append(modulus - (TP(1) << TP(k)))
        wide_signs.append(TP(0))
    wide_shared = mpc.comms.share_from_trusted_dealer(wide_values, modulus)
    wide_positive = mpc.comms.reveal(mpc.boolean.is_positive(wide_shared, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Is positive far beyond the fixed-point range', wide_positive, wide_signs)
    if modulus.popcnt() == 1:
        test_ring_equality(mpc, modulus, wide_values)
    else:
        # [a != 0] by the field's equality test: exact over the modulus' bits, and over K + F bits below 2^(K + F) - c
        # (p = 2^L - c): the largest such value included
        nonzero = mpc.comms.reveal(mpc.boolean.is_nonzero(wide_shared, modulus), modulus)
        narrow_values = [TP(0), TP(1), modulus - TP(1), TP(1) << TP(MPC_NBIT_K + MPC_NBIT_F - 3), modulus - (TP(1) << TP(MPC_NBIT_K + MPC_NBIT_F - 3)), (TP(1) << TP(MPC_NBIT_K + MPC_NBIT_F)) - TP(MPC_MERSENNE_OFFSET + 1), TP(1) << TP(MPC_NBIT_F)]
        nonzero_narrow = mpc.comms.reveal(mpc.boolean.is_nonzero(mpc.comms.share_from_trusted_dealer(narrow_values, modulus), modulus, nbits=MPC_NBIT_K + MPC_NBIT_F), modulus)
        matrix_nonzero = mpc.comms.reveal(mpc.boolean.is_nonzero(mpc.comms.share_from_trusted_dealer([[TP(0), TP(5)], [modulus - TP(5), TP(0)]], modulus), modulus), modulus)
        if mpc.pid != 0:
            assert_eq('Is nonzero (field) far beyond the fixed-point range', nonzero, [TP(0) if i == 0 else TP(1) for i in range(len(wide_values))])
            assert_eq('Is nonzero (field) over K + F bits', nonzero_narrow, [TP(0), TP(1), TP(1), TP(1), TP(1), TP(1), TP(1)])
            assert_eq('Is nonzero (field) on a matrix', matrix_nonzero, [[TP(0), TP(1)], [TP(1), TP(0)]])

    shared_a = mpc.comms.share_from_trusted_dealer([
        double_to_fp(1.0, modulus),
        double_to_fp(4.0, modulus),
        double_to_fp(5.0, modulus),
        double_to_fp(-3.0, modulus)], modulus)
    shared_b = mpc.comms.share_from_trusted_dealer([
        double_to_fp(3.0, modulus),
        double_to_fp(4.0, modulus),
        double_to_fp(3.0, modulus),
        double_to_fp(-7.0, modulus)], modulus)
    revealed_less_results = mpc.comms.reveal(mpc.boolean.less_than(shared_a, shared_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Less than fixed-point', revealed_less_results, [TP(1), TP(0), TP(0), TP(0)])
    revealed_greater_results = mpc.comms.reveal(mpc.boolean.greater_than(shared_a, shared_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Greater than fixed-point', revealed_greater_results, [TP(0), TP(0), TP(1), TP(1)])

    public_b = double_to_fp(3.0, modulus)
    revealed_less_results = mpc.comms.reveal(mpc.boolean.less_than_public(shared_a, public_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Less than public fixed-point', revealed_less_results, [TP(1), TP(0), TP(0), TP(1)])
    revealed_greater_results = mpc.comms.reveal(mpc.boolean.greater_than_public(shared_a, public_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Greater than public fixed-point', revealed_greater_results, [TP(0), TP(1), TP(1), TP(0)])

    # A negative public operand (greater_than_public negated it in N-bit two's complement: off by 2^N mod p raw units on
    # the field, 786432 with 192-bit shares; M-MPC-10)
    shared_near = mpc.comms.share_from_trusted_dealer([
        double_to_fp(-5.0001, modulus),
        double_to_fp(-5.0, modulus),
        double_to_fp(-4.9999, modulus),
        double_to_fp(3.0, modulus)], modulus)
    public_negative = double_to_fp(-5.0, modulus)
    revealed_gt_negative = mpc.comms.reveal(mpc.boolean.greater_than_public(shared_near, public_negative, modulus), modulus)
    revealed_ngt_negative = mpc.comms.reveal(mpc.boolean.not_greater_than_public(shared_near, public_negative, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Greater than a negative public fixed-point', revealed_gt_negative, [TP(0), TP(0), TP(1), TP(1)])
        assert_eq('Not greater than a negative public fixed-point', revealed_ngt_negative, [TP(1), TP(1), TP(0), TP(0)])
    
    shared_a = mpc.comms.share_from_trusted_dealer([TP(1), TP(4), TP(5), modulus - 3], modulus)
    shared_b = mpc.comms.share_from_trusted_dealer([TP(3), TP(4), TP(3), modulus - 7], modulus)
    revealed_less_results = mpc.comms.reveal(mpc.boolean.less_than(shared_a, shared_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Less than', revealed_less_results, [TP(1), TP(0), TP(0), TP(0)])
    revealed_greater_results = mpc.comms.reveal(mpc.boolean.greater_than(shared_a, shared_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Greater than', revealed_greater_results, [TP(0), TP(0), TP(1), TP(1)])

    public_b = TP(3)
    revealed_less_results = mpc.comms.reveal(mpc.boolean.less_than_public(shared_a, public_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Less than public', revealed_less_results, [TP(1), TP(0), TP(0), TP(1)])
    revealed_greater_results = mpc.comms.reveal(mpc.boolean.greater_than_public(shared_a, public_b, modulus), modulus)
    if mpc.pid != 0:
        assert_eq('Greater than public', revealed_greater_results, [TP(0), TP(1), TP(1), TP(0)])
    
    carries = mpc.boolean.carries(shared_a_bits, shared_b_bits, False, modulus)
    revealed_carry_results = mpc.comms.reveal(carries, modulus)
    if mpc.pid != 0:
        assert_eq('Carries', revealed_carry_results, [a_bits] * [b_bits])
    
    bit_add = mpc.boolean.bit_add(shared_a_bits, shared_b_bits, False, modulus)
    revealed_bit_add_results = mpc.comms.reveal(bit_add, modulus)
    if mpc.pid != 0:
        assert_eq(
            'Bit add',
            revealed_bit_add_results,
            [[TP(1), TP(0), TP(0), TP(1), TP(0), TP(1), TP(0), TP(0)]])
    
    small_modulus = MPC_SECOND_RING_SIZE if modulus.popcnt() == 1 else MPC_SECOND_FIELD_SIZE
    bit_decomposition = mpc.boolean.bit_decomposition(mpc.comms.share_from_trusted_dealer([TP(0)], modulus), bitlen=MPC_MODULUS_BITS, small_modulus=small_modulus, modulus=modulus)
    revealed_bit_decomposition = mpc.comms.reveal(bit_decomposition, small_modulus)
    expected_decomposition_1 = [zeros_vec(MPC_MODULUS_BITS, TP=int)]
    if mpc.pid != 0:
        assert_eq(
            'Bit decomposition 1',
            revealed_bit_decomposition,
            expected_decomposition_1)
    
    bit_decomposition = mpc.boolean.bit_decomposition(mpc.comms.share_from_trusted_dealer([TP(1)], modulus), bitlen=MPC_MODULUS_BITS, small_modulus=small_modulus, modulus=modulus)
    revealed_bit_decomposition = mpc.comms.reveal(bit_decomposition, small_modulus)
    expected_decomposition_2 = [zeros_vec(MPC_MODULUS_BITS, TP=int)]
    expected_decomposition_2[0][0] = 1
    if mpc.pid != 0:
        assert_eq(
            'Bit decomposition 2',
            revealed_bit_decomposition,
            expected_decomposition_2)
    
    bit_decomposition = mpc.boolean.bit_decomposition(mpc.comms.share_from_trusted_dealer([TP(7)], modulus), bitlen=MPC_MODULUS_BITS, small_modulus=small_modulus, modulus=modulus)
    revealed_bit_decomposition = mpc.comms.reveal(bit_decomposition, small_modulus)
    expected_decomposition_3 = [zeros_vec(MPC_MODULUS_BITS, TP=int)]
    for i in range(3): expected_decomposition_3[0][i] = 1
    if mpc.pid != 0:
        assert_eq(
            'Bit decomposition 3',
            revealed_bit_decomposition,
            expected_decomposition_3)

    bit_decomposition = mpc.boolean.bit_decomposition(mpc.comms.share_from_trusted_dealer([TP(0), TP(1), TP(7)], modulus), bitlen=MPC_MODULUS_BITS, small_modulus=small_modulus, modulus=modulus)
    revealed_bit_decomposition = mpc.comms.reveal(bit_decomposition, small_modulus)
    expected_decomposition = [expected_decomposition_1[0], expected_decomposition_2[0], expected_decomposition_3[0]]
    if mpc.pid != 0:
        assert_eq(
            'Bit decomposition 4',
            revealed_bit_decomposition,
            expected_decomposition)
    
    public_vector = [7, 45, 114]
    delimiter_prime = 127
    key_bit_len = 2
    shared_keys = mpc.comms.share_from_trusted_dealer([TP(0), TP(1), TP(2)], modulus)
    elements = oblivious_get(mpc, shared_keys, key_bit_len, public_vector, delimiter_prime, modulus)
    revealed_elements = mpc.comms.reveal(elements, delimiter_prime)
    if mpc.pid != 0:
        assert_eq(
            'Oblivious get',
            [e[0] for e in revealed_elements],
            public_vector)
    
    shared_b_bits_small = mpc.comms.share_from_trusted_dealer([[0, 0, 1, 0, 1, 0, 0]], MPC_SECOND_FIELD_SIZE)
    demux = mpc.boolean.demultiplexer(shared_b_bits_small, MPC_SECOND_FIELD_SIZE)
    revealed_demux = mpc.comms.reveal(demux, MPC_SECOND_FIELD_SIZE)
    expected_demux = [zeros_vec(128, TP=int)]
    expected_demux[0][20] = 1
    if mpc.pid != 0:
        assert_eq(
            'Demultiplexer',
            revealed_demux,
            expected_demux) 

    shared_fp_sum = mpc.arithmetic.add_public(shared_fp_elem, fp_pub, modulus)
    float_sum = mpc.comms.print_fp(shared_fp_sum, modulus)
    if mpc.pid != 0:
        assert_eq_approx('Add public', float_sum, float_elem + float_pub)

    rev_fp_sum = mpc.comms.print_fp(shared_fp_sum, modulus)
    if mpc.pid != 0:
        assert_eq_approx('Print FP', rev_fp_sum, float_elem + float_pub)
    
    result_elem = mpc.fp.trunc(
            mpc.arithmetic.multiply(shared_fp_sum, shared_fp_elem, modulus),
            modulus)
    if mpc.pid != 0:
        assert_eq_approx(
            'Fixed-point multiplication / truncation',
            mpc.comms.print_fp(result_elem, modulus),
            (float_elem + float_pub) * float_elem)

    nee_input = [
        double_to_fp(256.2354325, modulus),
        double_to_fp(128.0, modulus),
        double_to_fp(32.0, modulus),
        double_to_fp(50.0, modulus)]
    # The field's normalizer: bit comparisons over a small field and table 1 (field-only). The ring's is
    # MPCBitwise.normalizer (test_bitwise); on ring shares this one refuses (test_field_only_guards)
    if modulus.popcnt() != 1:
        nee, nee_sqrt = mpc.fp.__normalizer_even_exp(nee_input, modulus)
        if mpc.pid != 0:
            revealed_nee = mpc.comms.reveal(nee, modulus)
            revealed_nee_sqrt = mpc.comms.reveal(nee_sqrt, modulus)
            assert_eq('Normalizer Even Exponent 1', revealed_nee, revealed_nee_sqrt.mul_mod(revealed_nee_sqrt, modulus))
            assert_eq(f'Normalizer Even Exponent 2', revealed_nee.mul_mod(nee_input, modulus) < [TP(1) << MPC_NBIT_K for _ in range(len(nee_input))], True)
            # TODO: #188 revealed_nee * nee_input should be greater or equal than 2 ** (MPC_NBIT_K - 2) and not 2 ** (MPC_NBIT_K - 3) like in the test case
            assert_eq(f'Normalizer Even Exponent 3 {revealed_nee}, {nee_input}, {revealed_nee.mul_mod(nee_input, modulus)}', revealed_nee.mul_mod(nee_input, modulus) >= [TP(1) << (MPC_NBIT_K - 3) for _ in range(len(nee_input))], True)

    vec = [TP(4), TP(5), TP(6)]
    coefs = [TP(3), TP(2)]
    exps = [[3, 2, 1], [1, 2, 3]]
    poly_eval = mpc.polynomial._beaver_evaluate_poly(vec, vec.zeros(), coefs, exps, modulus)
    expected_poly_eval = offline_evaluate_poly(vec, coefs, exps, modulus)
    if mpc.pid != 0:
        assert_eq(f'Polynomial optimization on {alg_struct} 1', mpc.comms.reveal(poly_eval, modulus), expected_poly_eval)
    
    shared_vec_x_r, shared_vec_r = mpc.arithmetic.__beaver_partition(mpc.comms.share_from_trusted_dealer(vec, modulus), modulus)
    poly_eval = mpc.polynomial._beaver_evaluate_poly(shared_vec_x_r, shared_vec_r, coefs, exps, modulus)
    if mpc.pid != 0:
        assert_eq(f'Polynomial optimization on {alg_struct} 2', mpc.comms.reveal(poly_eval, modulus), expected_poly_eval)

    test_share_from_round_trip(mpc, modulus, alg_struct)
    test_equality_cost(mpc, modulus)

    print(f'CP{mpc.pid}:\tMPC tests passed on {alg_struct}.\n')


def _words(pid: int) -> List[str]:
    # One string of each kind (ASCII, Latin-1, UCS-2, UCS-4), and the empty string
    return [f'cp{pid}', f'caf\u00e9 {pid}', f'\u65e5\u672c {pid}', f'\U0001F600 {pid}', '']


def test_pickle_comms(mpc):
    # Values in the parties' wire format (unpasteurized): every party, CP0 included, collects each value from every
    # party, and each party's value carries its pid
    print(f'CP{mpc.pid}:\tTesting pickled values between the parties ... \n')
    n = mpc.comms.number_of_parties
    mine = _words(mpc.pid)
    for k in range(len(mine)):
        assert_eq(f'CP{mpc.pid}:\tComms: a string of kind {mine[k]._kind()} from every party',
                  mpc.comms.collect(mine[k], True), [_words(q)[k] for q in range(n)])
    assert_eq(f'CP{mpc.pid}:\tComms: nested lists from every party',
              mpc.comms.collect([[mpc.pid, 1], List[int](), [2]], True), [[[q, 1], List[int](), [2]] for q in range(n)])
    assert_eq(f'CP{mpc.pid}:\tComms: UInt[174] from every party',
              mpc.comms.collect(~UInt[174](0) - UInt[174](mpc.pid), True),
              [~UInt[174](0) - UInt[174](q) for q in range(n)])
    assert_eq(f'CP{mpc.pid}:\tComms: Int[512] from every party', mpc.comms.collect(-Int[512](mpc.pid + 1), True),
              [-Int[512](q + 1) for q in range(n)])
    # ndarrays: a transposed view (its elements go in C order) and a 3-dim array, compared as nested lists (the list
    # of arrays' == would compare arrays element-wise)
    base = arange(12).reshape((3, 4))
    assert_eq(f'CP{mpc.pid}:\tComms: a transposed ndarray view from every party',
              [a.tolist() for a in mpc.comms.collect((base + mpc.pid).T, True)],
              [(base + q).T.tolist() for q in range(n)])
    cube = arange(24).reshape((2, 3, 4)).astype(float)
    assert_eq(f'CP{mpc.pid}:\tComms: a 3-dim ndarray from every party',
              [a.tolist() for a in mpc.comms.collect(cube * float(mpc.pid), True)],
              [(cube * float(q)).tolist() for q in range(n)])
    print(f'CP{mpc.pid}:\tPickled values between the parties passed.\n')


def test_mpc(mpc, modulus):
    # On the run's modulus (the field, or the ring with --use-ring)
    print(f'CP{mpc.pid}:\tTesting the MPC ... \n')

    test_pickle_comms(mpc)
    with mpc.default_modulus(modulus):
        test_mpc_core(mpc, modulus)
    test_field_only_guards(mpc)
    test_settings_digest(mpc)
    test_share_records(mpc)
    test_security_parameters(mpc)
    test_mhe(mpc, modulus)
    test_randomness(mpc, modulus)

    print(f'CP{mpc.pid}:\tMPC tests passed.\n')
