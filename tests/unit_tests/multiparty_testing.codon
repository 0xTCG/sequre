"""Helpers for the multiparty-type tests (MPP, MPA, MPU): partitions of different sizes, held by any number of compute
parties, with different data at each, and a check that every party is still in step."""

import secure_operator

from sequre.stdlib.numpy.create import array
from sequre.types.multiparty_partition import MPP
from sequre.types.sharetensor import Sharetensor
from sequre.utils.testing import assert_eq_approx
from sequre.utils.utils import random_ints


def unequal_ratios(n_cp: int) -> List[int]:
    # Row counts that differ between the compute parties: [3, 5] with two, [2, 3, 5] with three, one more row for each
    # further party
    if n_cp == 1:
        return [5]
    if n_cp == 2:
        return [3, 5]
    ratios = [2, 3, 5]
    for i in range(3, n_cp):
        ratios.append(i + 3)
    return ratios


def ratios_with_empty(n_cp: int) -> List[int]:
    # One compute party holds no rows: the first of two, the second of three or more
    if n_cp == 2:
        return [0, 5]
    ratios = unequal_ratios(n_cp)
    ratios[1] = 0
    return ratios


def own_rows(mpc, ratios: List[int]) -> Tuple[int, int]:
    # The rows this compute party holds; all of them at CP0
    if mpc.pid == 0:
        return 0, ratios.sum()
    start = ratios[:mpc.pid - 1].sum()
    return start, start + ratios[mpc.pid - 1]


def cohort_matrix(mpc, rows: int, cols: int):
    # A matrix drawn from the shared seed, so every party knows all of it while each compute party holds only its own
    # rows. Its entries are the halves in [-3.5, 3.5]: none lies within 0.5 of an integer, which leaves comparisons
    # with an integer a margin against the encryption noise.
    with mpc.randomness.seed_switch(-1):
        ints = array(random_ints((rows, cols), 0, 7))
    return ints.astype(float) - 3.5


def partition(mpc, matrix, ratios: List[int]) -> MPP:
    # Each compute party's rows of matrix as an MPP held in the clear (CP0 keeps a placeholder)
    start, stop = own_rows(mpc, ratios)
    return MPP(mpc, matrix[start:stop] if mpc.pid else matrix)


def column(matrix, j: int):
    # A copy of column j (a strided view would not do: H-14)
    return array([matrix[i, j] for i in range(matrix.shape[0])])


def assert_parties_in_step(mpc, name: str):
    # A product of shared values, whose Beaver triple CP0 deals, and its reveal, checked against plaintext. Call it at
    # every party after an operation that could leave the parties out of step: a party a message behind or ahead then
    # reads the wrong bytes, so the check fails or hangs instead of the slip going unnoticed.
    x = Sharetensor.enc(mpc, [1.5, -2.0, 3.25])
    product = secure_operator.mul(mpc, x, x).reveal(mpc)
    if mpc.pid:
        assert_eq_approx(f"CP{mpc.pid}:\t{name}: parties in step", product, array([2.25, 4.0, 10.5625]), error=1e-3)
