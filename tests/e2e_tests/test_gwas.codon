import time
import toml

from sequre.stdlib.numpy.create import zeros, zeros_like, array, loadtxt

from sequre.types.sharetensor import Sharetensor
from sequre.types.multiparty_union import MPU
from sequre.utils.testing import assert_eq, assert_eq_approx
from sequre.utils.utils import random_ints, random_floats
from sequre.stdlib.lin_alg import orthonormalize

from .. import \
    cochran_armitage, \
    gwas_protocol, \
    gwas_without_norm, \
    MAF_LB, MAF_UB


def _qc_genotypes(inds: int, snps: int) -> List[List[int]]:
    # inds x snps random 0/1/2 genotypes that pass the QC the GWAS pipeline applies before association: a SNP outside
    # hwe_filter's allele-frequency bounds (MAF_LB < maf < MAF_UB; by default a monomorphic one) is drawn again, and so
    # is one without variance (all heterozygous), whose statistic is 0 / 0 too. Call it inside
    # randomness.global_stream(), at every party.
    genotypes = random_ints((inds, snps), upper_limit=2)
    for s in range(snps):
        while True:
            column = [genotypes[i][s] for i in range(inds)]
            maf = float(sum(column)) / float(2 * inds)
            if MAF_LB < maf < MAF_UB and any(g != column[0] for g in column):
                break
            redrawn = random_ints((inds,), upper_limit=2)
            for i in range(inds):
                genotypes[i][s] = redrawn[i]
    return genotypes


def _binary_phenotypes(inds: int) -> List[int]:
    # 0/1 phenotypes with cases and controls both present (a cohort of one class has no association to test)
    pheno = random_ints((inds,), upper_limit=1)
    while not (any(p == 0 for p in pheno) and any(p == 1 for p in pheno)):
        pheno = random_ints((inds,), upper_limit=1)
    return pheno


def test_cochran_armitage(mpc, modulus):
    alg_struct = "ring" if modulus.popcnt() == 1 else "field"
    print(f'CP{mpc.pid}:\tTesting Sequre Cochran-Armitage on {alg_struct} ... \n')

    inds_per_party = 8
    inds_count = inds_per_party * (mpc.comms.number_of_parties - 1)
    snps_count = 32
    pca_components_count = 4
    
    # The data cochran_armitage gets in the pipeline (gwas_protocol, gwas_without_norm): components with orthonormal
    # rows (both PCA steps end in orthonormalize) and SNPs that passed QC. Components drawn uniformly, not
    # orthonormal, gave 10 to 18 of the 32 SNPs a negative denominator (NaN in the reference) and statistics up to
    # |25|, some with a positive denominator close to 0 that the fixed point cannot divide by: the MPU check failed on
    # about 12.5% of draws. Orthonormal components keep every denominator positive and every |statistic| below 1.
    with mpc.randomness.global_stream():
        raw_pca_components = array(random_floats((pca_components_count, inds_count), scale=1))
        raw_pheno = array(_binary_phenotypes(inds_count), dtype=float)
        raw_dosage = array(_qc_genotypes(inds_count, snps_count), dtype=float)
        raw_dosage -= raw_dosage.mean(axis=0)
    raw_pca_components = orthonormalize(mpc, raw_pca_components)
    
    mpc_pca_components = Sharetensor.enc(mpc, raw_pca_components, 1, modulus)
    mpc_pheno = Sharetensor.enc(mpc, raw_pheno, 1, modulus)
    mpc_dosage = Sharetensor.enc(mpc, raw_dosage, 1, modulus)

    partition_pca_components = raw_pca_components.T[(mpc.pid - 1) * inds_per_party: mpc.pid * inds_per_party] if mpc.pid else zeros_like(raw_pca_components).T
    partition_pheno = raw_pheno[(mpc.pid - 1) * inds_per_party: mpc.pid * inds_per_party] if mpc.pid else zeros_like(raw_pheno)
    partition_dosage = raw_dosage[(mpc.pid - 1) * inds_per_party: mpc.pid * inds_per_party] if mpc.pid else zeros_like(raw_dosage)
    
    mpu_pca_components = MPU[Tuple[int, int], float](mpc, partition_pca_components, "partition").T
    mpu_pheno = MPU[Tuple[int], float](mpc, partition_pheno, "partition").T
    mpu_dosage = MPU[Tuple[int, int], float](mpc, partition_dosage, "partition")

    mpc.comms.sequential(lambda p, s, d: print(f"CP{p}:\tCochran-Armitage test data for debugging on {s}: components", d), False, mpc.pid, alg_struct, raw_pca_components.tolist())
    if mpc.pid == 0:
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading shapes (MPC) on {alg_struct}: components", mpc_pca_components.shape, list(raw_pca_components.shape))
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading shapes (MPU) on {alg_struct}: components", mpu_pca_components.shape, raw_pca_components.shape)
    else:
        assert_eq_approx(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading (MPC) on {alg_struct}: components", mpc_pca_components.reveal(mpc).tolist(), raw_pca_components.tolist())
        assert_eq_approx(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading (MPU) on {alg_struct}: components", mpu_pca_components.reveal(mpc).tolist(), raw_pca_components.tolist())
    
    mpc.comms.sequential(lambda p, s, d: print(f"CP{p}:\tCochran-Armitage test data for debugging on {s}: pheno", d), False, mpc.pid, alg_struct, raw_pheno.tolist())
    if mpc.pid == 0:
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading shapes (MPC) on {alg_struct}: pheno", mpc_pheno.shape, list(raw_pheno.shape))
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading shapes (MPU) on {alg_struct}: pheno", mpu_pheno.shape, raw_pheno.shape)
    else:
        assert_eq_approx(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading (MPC) on {alg_struct}: pheno", mpc_pheno.reveal(mpc).tolist(), raw_pheno.tolist())
        assert_eq_approx(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading (MPU) on {alg_struct}: pheno", mpu_pheno.reveal(mpc).tolist(), raw_pheno.tolist())
    
    mpc.comms.sequential(lambda p, s, d: print(f"CP{p}:\tCochran-Armitage test data for debugging on {s}: geno", d), False, mpc.pid, alg_struct, raw_dosage.tolist())
    if mpc.pid == 0:
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading shapes (MPC) on {alg_struct}: geno", mpc_dosage.shape, list(raw_dosage.shape))
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading shapes (MPU) on {alg_struct}: geno", mpu_dosage.shape, raw_dosage.shape)
    else:
        assert_eq_approx(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading (MPC) on {alg_struct}: geno", mpc_dosage.reveal(mpc).tolist(), raw_dosage.tolist())
        assert_eq_approx(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage data loading (MPU) on {alg_struct}: geno", mpu_dosage.reveal(mpc).tolist(), raw_dosage.tolist())

    # Every statistic is defined on these data, so the checks compare them directly (the reference used to be NaN for the
    # SNPs whose denominators came out negative, and the checks weighted each SNP by the reference to skip them)
    raw_assoc = cochran_armitage(mpc, raw_pca_components, raw_pheno, raw_dosage)
    mpc_assoc = cochran_armitage(mpc, mpc_pca_components, mpc_pheno, mpc_dosage)

    if mpc.pid == 0:
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage result shape (MPC) on {alg_struct}", mpc_assoc.shape, list(raw_assoc.shape))
    else:
        assert_eq_approx(f"CP{mpc.pid}:\tSequre Cochran-Armitage (MPC) on {alg_struct}", mpc_assoc.reveal(mpc).tolist(), raw_assoc.tolist())
    
    mpu_assoc = cochran_armitage(mpc, mpu_pca_components, mpu_pheno, mpu_dosage)

    if mpc.pid == 0:
        assert_eq(f"CP{mpc.pid}:\tSafe-checking Cochran-Armitage result shape (MPU) on {alg_struct}", mpu_assoc.shape, raw_assoc.shape)
    else:
        # The MPU path (HE partitions, switched to shares for the divisions) on these statistics (|statistic| < 1),
        # the largest error of each draw over its 32 SNPs, 3 parties, measured: field 3.2e-5 to 1.16e-4 (median 5.5e-5,
        # 200 draws), ring 3.3e-5 to 1.35e-4 (median 5.7e-5, 75 draws). 3e-4 is 1.15 bits above the worst; the median
        # times 8 (a loss of 3 bits) fails it. (The old check asked for a mean precision above 1 bit of the statistics
        # weighted by the reference.)
        assert_eq_approx(f"CP{mpc.pid}:\tSequre Cochran-Armitage (MPU) on {alg_struct}", mpu_assoc.reveal(mpc).tolist(), raw_assoc.tolist(), error=3e-4)
    
    print(f'CP{mpc.pid}:\tSequre Cochran-Armitage on {"ring" if modulus.popcnt() == 1 else "field"} tests passed.\n')


def test_gwas_sections(mpc, modulus):
    print(f'CP{mpc.pid}:\tTesting Sequre GWAS sections on {"ring" if modulus.popcnt() == 1 else "field"} ... \n')
    
    test_cochran_armitage(mpc, modulus)

    print(f'CP{mpc.pid}:\tSequre GWAS sections on {"ring" if modulus.popcnt() == 1 else "field"} tests passed.\n')


def test_gwas_mpc(mpc, modulus):
    print(f'CP{mpc.pid}:\tTesting Sequre GWAS-MPC on {"ring" if modulus.popcnt() == 1 else "field"} ... \n')

    with open('tests/data/output/gwas.txt') as f:
        expected_output = [float(e.strip()) for e in next(f).split(',')]
        gwas_result = mpc.comms.print_fp(gwas_protocol(mpc, modulus).share, modulus)
        if mpc.pid:
            assert_eq_approx(f'CP{mpc.pid}:\tSequre GWAS-MPC ({"ring" if modulus.popcnt() == 1 else "field"})', gwas_result, expected_output, error=0.05)

    print(f'CP{mpc.pid}:\tSequre GWAS-MPC on {"ring" if modulus.popcnt() == 1 else "field"} tests passed.\n')


def test_gwas_mhe(mpc, modulus):
    alg_struct = "ring" if modulus.popcnt() == 1 else "field"
    print(f'CP{mpc.pid}:\tTesting Sequre GWAS-MHE on {alg_struct} ... \n')
    config = toml.read("tests/config/gwas.toml")
    
    indv_per_party = config.get("individuals_per_party", T=int)
    indv_count = indv_per_party * (mpc.comms.number_of_parties - 1)
    snps_count = config.get("number_of_snps", T=int)
    cov_count = config.get("number_of_covariates", T=int)
    pca_top_components_count = config.get("pca_components", T=int)
    pca_oversampling_count = config.get("pca_oversampling", T=int)
    pca_power_iterations_count = config.get("pca_power_iterations", T=int)

    path = config.get("data_dir", T=str)
    raw_pheno = loadtxt(f"{path}/pheno.txt", shape=(indv_count,), dtype=float)
    raw_cov = loadtxt(f"{path}/cov.txt", shape=(indv_count, cov_count), dtype=float)
    raw_dosage = loadtxt(f"{path}/dosage.txt", shape=(indv_count, snps_count), dtype=float)
    raw_dosage -= raw_dosage.mean(axis=0)
    raw_dosage /= len(raw_dosage)

    def _get_partition(mpc, data, rows, cols):
        dealer_data = zeros(((mpc.comms.number_of_parties - 1) * rows, cols))
        return data[(mpc.pid - 1) * rows: mpc.pid * rows, :cols] if mpc.pid else dealer_data

    def _get_partition_1_dim(mpc, data, rows):
        dealer_data = zeros(((mpc.comms.number_of_parties - 1) * rows,))
        return data[(mpc.pid - 1) * rows: mpc.pid * rows] if mpc.pid else dealer_data

    partition_dosage = _get_partition(mpc, raw_dosage, indv_per_party, snps_count)
    partition_cov = _get_partition(mpc, raw_cov, indv_per_party, cov_count)
    partition_pheno = _get_partition_1_dim(mpc, raw_pheno, indv_per_party)
    
    mhe_dosage = MPU(mpc, partition_dosage, "partition")
    mhe_cov = MPU(mpc, partition_cov, "partition")
    mhe_pheno = MPU(mpc, partition_pheno, "partition").T

    mpc.randomness.reset_global_seed()
    with time.timing(f"CP{mpc.pid}:\tRaw GWAS without normalization"):
        bs = mpc.stats.bytes_sent
        raw_ca = gwas_without_norm(
            mpc, raw_dosage, raw_pheno, raw_cov, pca_top_components_count,
            pca_oversampling_count, pca_power_iterations_count)
        be = mpc.stats.bytes_sent
    print(f"CP{mpc.pid}:\tRaw GWAS without normalization bytes sent: {be - bs}")

    mpc.randomness.reset_global_seed()
    with time.timing(f"CP{mpc.pid}:\tMHE GWAS without normalization"):
        bs = mpc.stats.bytes_sent
        mhe_ca = gwas_without_norm(
            mpc, mhe_dosage, mhe_pheno, mhe_cov, pca_top_components_count,
            pca_oversampling_count, pca_power_iterations_count)
        be = mpc.stats.bytes_sent
    print(f"CP{mpc.pid}:\tMHE GWAS without normalization bytes sent: {be - bs}")
    
    if mpc.pid:
        assert_eq_approx(f'CP{mpc.pid}:\tSequre GWAS-MHE ({alg_struct}) test', mhe_ca.reveal(mpc), raw_ca.nan_to_num())


def test_gwas(mpc, modulus):
    test_gwas_sections(mpc, modulus)
    test_gwas_mpc(mpc, modulus)
    test_gwas_mhe(mpc, modulus)
