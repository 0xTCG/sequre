from sequre.utils.testing import assert_geq
from sequre.constants import *
from sequre.mpc.env import MPCEnv
from .. import dti_mpc_protocol


def _read_rows(path: str) -> List[List[float]]:
    with open(path) as f:
        return [[float(e) for e in line.split()] for line in f if line.strip()]


def test_dti[TP](mpc: MPCEnv[TP], modulus: TP):
    """
    The DTI protocol (applications/dti.codon: the shared data loaded, one hidden ReLU layer trained with the hinge loss
    and Nesterov momentum for MAX_EPOCHS mini-batch steps, the weights revealed, the predictions), then its accuracy on
    the 50 test rows in the clear.

    The training rows use 685 of the 6903 feature columns (the others are zero in every training row). The test trains
    on those 685 only (dti_mpc_protocol's public column list): a zero column gets no gradient, so training is the same,
    at a tenth of the cost (the full model took 47 min in a debug build: 50 steps of 56 s, measured). The test rows
    lose only the unused columns' initial weights (146 of their 2856 ones fall there).

    The accuracy bound separates a trained model from an untrained one. In a plaintext replica of the training (300
    trainings, fresh initial weights and shuffles each, as here), the accuracy is 0.90 +- 0.037 after the 50 steps
    (lowest 0.78) and 0.50 +- 0.035 untrained (highest 0.60): 0.7 is about 5.5 standard deviations from each. (The old
    bound, 0.8, failed about one training in 300.)
    """
    alg_struct = "ring" if modulus.popcnt() == 1 else "field"
    print(f'CP{mpc.pid}:\tTesting Sequre DTI on {alg_struct} ... \n')

    path = 'tests/data/dti/input'
    features = _read_rows(f'{path}/features.txt')
    test_labels = _read_rows(f'{path}/test_labels.txt')
    used = [j for j in range(len(features[0])) if any(row[j] != 0.0 for row in features)]

    predictions = mpc.comms.print_fp(dti_mpc_protocol(mpc, modulus, True, used).share, modulus)

    labeled_predictions = [(1.0 if e[0] > 0 else 0.0) for e in predictions]
    accuracy = [int(l == t[0]) for l, t in zip(labeled_predictions, test_labels)].mean()
    if mpc.pid:
        assert_geq(f'CP{mpc.pid}:\tSequre DTI accuracy on {alg_struct} ({accuracy:.2f}, {len(used)} feature columns)', accuracy, 0.7)

    print(f'CP{mpc.pid}:\tSequre DTI on {alg_struct} tests passed.\n')
