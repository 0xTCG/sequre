def fresh[TP](x: Sharetensor[TP]) -> Sharetensor[TP]:
    # Same shares, no cached Beaver partitions / sqrt: what an operand looks like the first time it is used.
    y = Sharetensor(x.share, x.modulus)
    y.fp = x.fp
    return y


def fp_vec(mpc, n: int, lo: float, hi: float) -> Tuple[List[float], Sharetensor[List[mpc_uint]]]:
    xs = shared_floats(mpc, n, lo, hi)
    return xs, Sharetensor.enc(mpc, xs)


def fp_mat(mpc, rows: int, cols: int, lo: float, hi: float) -> Tuple[List[List[float]], Sharetensor[List[List[mpc_uint]]]]:
    xs = shared_float_matrix(mpc, rows, cols, lo, hi)
    return xs, Sharetensor.enc(mpc, xs)


def mismatches(have, want: List[float]) -> float:
    bad = 0
    for i in range(len(want)):
        if abs(float(have[i]) - want[i]) > 0.5:
            bad += 1
    return float(bad)


def low16(x: mpc_uint) -> float:
    return float(int(x & mpc_uint(0xffff)))


# Witness of the field sampler: the fraction of draws with the modulus' top bit set (bit 173 for the 174-bit field).
# 0 while masks cover only half the field; about 0.5 once they are uniform over the field.
TOP_BIT = mpc_uint(1) << mpc_uint(MPC_MODULUS_BITS - 1)


def frac_at_least(xs: List[mpc_uint], bound: mpc_uint) -> float:
    cnt = 0
    for e in xs:
        if e >= bound:
            cnt += 1
    return float(cnt) / float(len(xs)) if len(xs) else 0.0


def count_at_least(xs: List[mpc_uint], bound: mpc_uint) -> float:
    cnt = 0
    for e in xs:
        if e >= bound:
            cnt += 1
    return float(cnt)


########################## prim: CPU primitives (solo, CP1) ##########################


def bench_prim(mpc, b: Bench):
    modulus = MPC_FIELD_SIZE

    if b.want(mpc, "prim.rand.uint_scalar"):
        if mpc.pid == 1:
            n = 100000
            acc = mpc_uint(0)
            t = Timer(b.reps(9), sync=False, batch=5)
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    for _ in range(n):
                        acc ^= mpc_uint.rand(modulus, "uniform")
                t.end(mpc)
            sample = [mpc_uint.rand(modulus, "uniform") for _ in range(4096)]
            b.report(f"n={n};check=frac>=2^{MPC_MODULUS_BITS - 1}", t, frac_at_least(sample, TOP_BIT))

    if b.want(mpc, "prim.rand.vec_1e5"):
        if mpc.pid == 1:
            n = 100000
            tmpl = zeros_vec(n)
            r = tmpl
            t = Timer(b.reps(9), sync=False, batch=8)
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    r = tmpl.rand(modulus, "uniform")
                t.end(mpc)
            b.report(f"n={n};check=frac>=2^{MPC_MODULUS_BITS - 1}", t, frac_at_least(r, TOP_BIT))

    if b.want(mpc, "prim.rand.mat_256"):
        if mpc.pid == 1:
            tmpl = zeros_mat(256, 256)
            r = tmpl
            t = Timer(b.reps(9), sync=False, batch=8)
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    r = tmpl.rand(modulus, "uniform")
                t.end(mpc)
            b.report(f"256x256;check=frac>=2^{MPC_MODULUS_BITS - 1}", t, frac_at_least(r.flatten(), TOP_BIT))

    if b.want(mpc, "prim.rand.bits_vec_1e5"):
        if mpc.pid == 1:
            n = 100000
            bits = MPC_NBIT_K + MPC_NBIT_F + MPC_NBIT_V
            tmpl = zeros_vec(n)
            r = tmpl
            t = Timer(b.reps(9), sync=False, batch=5)
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    r = tmpl.rand_bits(bits)
                t.end(mpc)
            b.report(f"n={n};bits={bits};check=frac>=2^{bits - 1}", t, frac_at_least(r, mpc_uint(1) << mpc_uint(bits - 1)))

    if b.want(mpc, "prim.rand.seed_switch_1e4"):
        if mpc.pid == 1:
            # Own stream only: switching to a stream shared with another party would desync it.
            n = 10000
            acc = mpc_uint(0)
            t = Timer(b.reps(9), sync=False)
            while t.next():
                t.begin(mpc)
                for _ in range(n):
                    with mpc.randomness.seed_switch(mpc.pid):
                        acc ^= mpc_uint.rand(modulus, "uniform")
                t.end(mpc)
            b.report(f"n={n};check=draws_ok", t, 1.0 if acc != mpc_uint(0) else 0.0)

    if b.any_selected("prim.modarith."):
        n = 100000
        va = zeros_vec(n)
        vb = zeros_vec(n)
        if mpc.pid == 1:
            va = va.rand(modulus, "uniform")
            vb = vb.rand(modulus, "uniform")

        if b.want(mpc, "prim.modarith.mul_mod_vec_1e5"):
            if mpc.pid == 1:
                r = va
                t = Timer(b.reps(9), sync=False, batch=20)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = va.mul_mod(vb, modulus)
                    t.end(mpc)
                b.report(f"n={n};check=unreduced", t, count_at_least(r, modulus))

        if b.want(mpc, "prim.modarith.mul_mod_int_vec_1e5"):
            if mpc.pid == 1:
                r = va
                t = Timer(b.reps(9), sync=False, batch=20)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = va.mul_mod(12345, modulus)
                    t.end(mpc)
                b.report(f"n={n};check=unreduced", t, count_at_least(r, modulus))

        if b.want(mpc, "prim.modarith.add_mod_vec_1e5"):
            if mpc.pid == 1:
                r = va
                t = Timer(b.reps(9), sync=False, batch=20)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = va.add_mod(vb, modulus)
                    t.end(mpc)
                b.report(f"n={n};check=unreduced", t, count_at_least(r, modulus))

        if b.want(mpc, "prim.modarith.sub_mod_vec_1e5"):
            if mpc.pid == 1:
                r = va
                t = Timer(b.reps(9), sync=False, batch=20)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = va.sub_mod(vb, modulus)
                    t.end(mpc)
                b.report(f"n={n};check=unreduced", t, count_at_least(r, modulus))

        if b.want(mpc, "prim.modarith.lsh_mod_vec_1e5"):
            if mpc.pid == 1:
                r = va
                t = Timer(b.reps(9), sync=False, batch=20)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = va.lsh_mod(32, modulus)
                    t.end(mpc)
                b.report(f"n={n};shift=32;check=unreduced", t, count_at_least(r, modulus))

    if b.any_selected("prim.matmul."):
        ma = zeros_mat(64, 64)
        mb = zeros_mat(64, 64)
        if mpc.pid == 1:
            ma = ma.rand(modulus, "uniform")
            mb = mb.rand(modulus, "uniform")

        if b.want(mpc, "prim.matmul.list_matmul_64"):
            if mpc.pid == 1:
                r = ma
                t = Timer(b.reps(9), sync=False, batch=30)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = ma.matmul(mb)
                    t.end(mpc)
                ref = mpc_uint(0)
                for k in range(64):
                    ref = ref + ma[5][k] * mb[k][7]
                b.report("64x64;check=spot_mismatch", t, 0.0 if r[5][7] == ref else 1.0)

        if b.want(mpc, "prim.matmul.matmul_mod_64"):
            if mpc.pid == 1:
                r = ma
                t = Timer(b.reps(9), sync=False, batch=4)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = ma.matmul_mod(mb, modulus)
                    t.end(mpc)
                ref = mpc_uint(0)
                for k in range(64):
                    ref = ref.add_mod(ma[5][k].mul_mod(mb[k][7], modulus), modulus)
                b.report("64x64;check=spot_mismatch", t, 0.0 if r[5][7] == ref else 1.0)

    for size in (64, 256):
        if b.want(mpc, f"prim.ndarray.matmul_{size}"):
            if mpc.pid == 1:
                na = array(private_floats(size * size, -1.0, 1.0)).reshape((size, size))
                nb = array(private_floats(size * size, -1.0, 1.0)).reshape((size, size))
                r = na
                t = Timer(b.reps(9 if size == 64 else 5), sync=False, batch=(20 if size == 64 else 1))
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = na @ nb
                    t.end(mpc)
                ref = 0.0
                for k in range(size):
                    ref += na[0, k] * nb[k, 0]
                b.report(f"{size}x{size}", t, abs(r[0, 0] - ref))

    if b.any_selected("prim.fp."):
        n = 100000
        fs = private_floats(n, -100.0, 100.0)
        enc = double_to_fp(fs, modulus)

        if b.want(mpc, "prim.fp.double_to_fp_vec_1e5"):
            if mpc.pid == 1:
                r = enc
                t = Timer(b.reps(9), sync=False, batch=8)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = double_to_fp(fs, modulus)
                    t.end(mpc)
                b.report(f"n={n};check=roundtrip_err", t, max_abs_err_1d(fp_to_double(r, modulus), fs))

        if b.want(mpc, "prim.fp.fp_to_double_vec_1e5"):
            if mpc.pid == 1:
                r = fs
                t = Timer(b.reps(9), sync=False, batch=50)
                while t.next():
                    t.begin(mpc)
                    for _ in range(t.batch):
                        r = fp_to_double(enc, modulus)
                    t.end(mpc)
                b.report(f"n={n};check=roundtrip_err", t, max_abs_err_1d(r, fs))


########################## net: communication ##########################

def bench_net(mpc, b: Bench):
    modulus = MPC_FIELD_SIZE

    if b.want(mpc, "net.roundtrip.int_x1000"):
        n = 1000
        acc = 0
        t = Timer(b.reps(9))
        while t.next():
            t.begin(mpc)
            if mpc.pid == 1:
                for k in range(n):
                    mpc.comms.send_as_jar(k, 2)
                    acc += mpc.comms.receive_as_jar(2, int)
            elif mpc.pid == 2:
                for k in range(n):
                    v = mpc.comms.receive_as_jar(1, int)
                    mpc.comms.send_as_jar(v, 1)
            t.end(mpc)
        if mpc.pid:
            b.report(f"n={n}", t, float(acc))

    if b.want(mpc, "net.send.share_mat_256"):
        m = zeros_mat(256, 256)
        if mpc.pid:
            m = m.rand(modulus, "uniform")
        back = m
        t = Timer(b.reps(9), batch=5)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                if mpc.pid == 1:
                    mpc.comms.send_as_jar(m, 2)
                    back = mpc.comms.receive_as_jar(2, List[List[mpc_uint]])
                elif mpc.pid == 2:
                    got = mpc.comms.receive_as_jar(1, List[List[mpc_uint]])
                    mpc.comms.send_as_jar(got, 1)
            t.end(mpc)
        if mpc.pid:
            ok = 1.0 if (mpc.pid != 1 or (back[17][31] == m[17][31] and back[255][255] == m[255][255])) else 0.0
            b.report("256x256;roundtrip", t, ok)

    if b.any_selected("net.") :
        n = 100000
        v = zeros_vec(n)
        if mpc.pid:
            v = v.rand(modulus, "uniform")

        if b.want(mpc, "net.collect.vec_1e5"):
            got = List[List[mpc_uint]]()
            t = Timer(b.reps(9), batch=5)
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    got = mpc.comms.collect(v)
                t.end(mpc)
            if mpc.pid:
                b.report(f"n={n}", t, float(len(got)))

        if b.want(mpc, "net.broadcast_from.vec_1e5"):
            got = v
            t = Timer(b.reps(9), batch=10)
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    got = mpc.comms.broadcast_from(v, 1)
                t.end(mpc)
            if mpc.pid:
                b.report(f"n={n}", t, float(len(got)))

        if b.want(mpc, "net.reveal.vec_1e5"):
            got = v
            t = Timer(b.reps(9), batch=4)
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    got = mpc.comms.reveal(v, modulus)
                t.end(mpc)
            if mpc.pid:
                b.report(f"n={n}", t, float(len(got)))


########################## mpc: Sharetensor protocols ##########################

def bench_share(mpc, b: Bench):
    modulus = MPC_FIELD_SIZE

    if b.want(mpc, "mpc.share.enc_vec_1e5"):
        n = 100000
        xs = shared_floats(mpc, n, -8.0, 8.0)
        st = Sharetensor.enc(mpc, xs)
        t = Timer(b.reps(9), batch=3)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                st = Sharetensor.enc(mpc, xs)
            t.end(mpc)
        rv = st.reveal(mpc)
        b.report(f"n={n};source=0", t, max_abs_err_1d(rv, xs) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.share.enc_cp1_vec_1e5"):
        n = 100000
        xs = shared_floats(mpc, n, -8.0, 8.0)
        st = Sharetensor.enc(mpc, xs, 1, modulus)
        t = Timer(b.reps(9), batch=3)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                st = Sharetensor.enc(mpc, xs, 1, modulus)
            t.end(mpc)
        rv = st.reveal(mpc)
        b.report(f"n={n};source=1", t, max_abs_err_1d(rv, xs) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.share.enc_mat_256"):
        xs = shared_float_matrix(mpc, 256, 256, -8.0, 8.0)
        st = Sharetensor.enc(mpc, xs)
        t = Timer(b.reps(9), batch=3)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                st = Sharetensor.enc(mpc, xs)
            t.end(mpc)
        rv = st.reveal(mpc)
        b.report("256x256;source=0", t, max_abs_err_2d(rv, xs) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.share.reveal_vec_1e5"):
        n = 100000
        xs, st = fp_vec(mpc, n, -8.0, 8.0)
        rv = st.reveal(mpc)
        t = Timer(b.reps(9), batch=2)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                rv = st.reveal(mpc)
            t.end(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, xs) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.share.reveal_mat_256"):
        xs, st = fp_mat(mpc, 256, 256, -8.0, 8.0)
        rv = st.reveal(mpc)
        t = Timer(b.reps(9), batch=2)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                rv = st.reveal(mpc)
            t.end(mpc)
        b.report("256x256", t, max_abs_err_2d(rv, xs) if mpc.pid else 0.0)


def bench_arith(mpc, b: Bench):
    modulus = MPC_FIELD_SIZE

    if b.want(mpc, "mpc.arith.add_vec_1e5"):
        n = 100000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        ys, y = fp_vec(mpc, n, -4.0, 4.0)
        r = x
        t = Timer(b.reps(9), batch=10)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.add(mpc, x, y)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [xs[i] + ys[i] for i in range(n)]) if mpc.pid else 0.0)

    for n in (10000, 100000):
        name = "mpc.beaver.mul_vec_1e4" if n == 10000 else "mpc.beaver.mul_vec_1e5"
        if b.want(mpc, name):
            xs, x = fp_vec(mpc, n, -4.0, 4.0)
            ys, y = fp_vec(mpc, n, -4.0, 4.0)
            r = x
            t = Timer(b.reps(11), batch=(3 if n == 10000 else 1))
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    r = secure_operator.mul(mpc, fresh(x), fresh(y))
                t.end(mpc)
            rv = r.reveal(mpc)
            b.report(f"n={n};fresh", t, max_abs_err_1d(rv, [xs[i] * ys[i] for i in range(n)]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.beaver.mul_cached_vec_1e5"):
        n = 100000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        ys, y = fp_vec(mpc, n, -4.0, 4.0)
        x.get_partitions(mpc)
        y.get_partitions(mpc)
        r = x
        t = Timer(b.reps(11))
        while t.next():
            t.begin(mpc)
            r = secure_operator.mul(mpc, x, y)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n};cached_partitions", t, max_abs_err_1d(rv, [xs[i] * ys[i] for i in range(n)]) if mpc.pid else 0.0)

    for size in (64, 256):
        if b.want(mpc, f"mpc.beaver.matmul_{size}"):
            xs, x = fp_mat(mpc, size, size, -1.0, 1.0)
            ys, y = fp_mat(mpc, size, size, -1.0, 1.0)
            r = x
            t = Timer(b.reps(9 if size == 64 else 3), batch=(2 if size == 64 else 1))
            while t.next():
                t.begin(mpc)
                for _ in range(t.batch):
                    r = secure_operator.matmul(mpc, fresh(x), fresh(y))
                t.end(mpc)
            rv = r.reveal(mpc)
            err = 0.0
            if mpc.pid:
                ref = array(xs) @ array(ys)
                err = max_abs_err_2d(rv, ref)
            b.report(f"{size}x{size};fresh", t, err)

    if b.want(mpc, "mpc.beaver.dot_vec_1e5"):
        n = 100000
        xs, x = fp_vec(mpc, n, -1.0, 1.0)
        ys, y = fp_vec(mpc, n, -1.0, 1.0)
        r = sq.dot(mpc, fresh(x), fresh(y), 0)
        t = Timer(b.reps(9))
        while t.next():
            t.begin(mpc)
            r = sq.dot(mpc, fresh(x), fresh(y), 0)
            t.end(mpc)
        rv = r.reveal(mpc)
        ref = 0.0
        for i in range(n): ref += xs[i] * ys[i]
        b.report(f"n={n};fresh", t, abs(rv - ref) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.fp.trunc_vec_1e5"):
        n = 100000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        prod = x.share.mul_mod(double_to_fp(1.5, modulus), modulus)  # 2^(2f)-scaled shares of 1.5 x
        tr = prod
        t = Timer(b.reps(9))
        while t.next():
            t.begin(mpc)
            tr = mpc.fp.trunc(prod, modulus)
            t.end(mpc)
        res = Sharetensor(tr, modulus)
        res.fp = True
        rv = res.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [1.5 * xs[i] for i in range(n)]) if mpc.pid else 0.0)


def bench_cmp(mpc, b: Bench):
    for n in (1000, 10000):
        name = "mpc.cmp.gt_zero_vec_1e3" if n == 1000 else "mpc.cmp.gt_zero_vec_1e4"
        if b.want(mpc, name):
            xs, x = fp_vec(mpc, n, -4.0, 4.0)
            r = x
            t = Timer(b.reps(7 if n == 1000 else 3))
            while t.next():
                t.begin(mpc)
                r = secure_operator.gt(mpc, fresh(x), 0)
                t.end(mpc)
            rv = r.reveal(mpc)
            b.report(f"n={n}", t, mismatches(rv, [1.0 if v > 0.0 else 0.0 for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.cmp.gt_float_vec_1e3"):
        n = 1000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        r = x
        t = Timer(b.reps(7))
        while t.next():
            t.begin(mpc)
            r = secure_operator.gt(mpc, fresh(x), 0.5)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, mismatches(rv, [1.0 if v > 0.5 else 0.0 for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.cmp.gt_int_vec_1e3"):
        n = 1000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        r = x
        t = Timer(b.reps(7))
        while t.next():
            t.begin(mpc)
            r = secure_operator.gt(mpc, fresh(x), 1)
            t.end(mpc)
        rv = r.reveal(mpc)
        # check = mismatches against the true x > 1 (0 when the int constant is put in fixed point; H-10 compared it raw).
        b.report(f"n={n}", t, mismatches(rv, [1.0 if v > 1.0 else 0.0 for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.cmp.gt_secret_vec_1e3"):
        n = 1000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        ys, y = fp_vec(mpc, n, -4.0, 4.0)
        r = x
        t = Timer(b.reps(7))
        while t.next():
            t.begin(mpc)
            r = secure_operator.gt(mpc, fresh(x), fresh(y))
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, mismatches(rv, [1.0 if xs[i] > ys[i] else 0.0 for i in range(n)]) if mpc.pid else 0.0)


def bench_ring_cmp_fp(mpc, b: Bench):
    # The ring twins of mpc.cmp.* and mpc.fp.div/sqrt: ring shares built explicitly, whatever the binary's modulus
    ring = MPC_RING_SIZE
    n = 1000
    for case, c in (("mpc.cmp.gt_zero_ring_vec_1e3", 0.0), ("mpc.cmp.gt_float_ring_vec_1e3", 0.5)):
        if b.want(mpc, case):
            xs = shared_floats(mpc, n, -4.0, 4.0)
            x = Sharetensor.enc(mpc, xs, 0, ring)
            r = x
            t = Timer(b.reps(7))
            while t.next():
                t.begin(mpc)
                r = secure_operator.gt(mpc, fresh(x), c) if c != 0.0 else secure_operator.gt(mpc, fresh(x), 0)
                t.end(mpc)
            rv = r.reveal(mpc)
            b.report(f"n={n}", t, mismatches(rv, [1.0 if v > c else 0.0 for v in xs]) if mpc.pid else 0.0)
    if b.want(mpc, "mpc.cmp.gt_int_ring_vec_1e3"):
        xs = shared_floats(mpc, n, -4.0, 4.0)
        x = Sharetensor.enc(mpc, xs, 0, ring)
        r = x
        t = Timer(b.reps(7))
        while t.next():
            t.begin(mpc)
            r = secure_operator.gt(mpc, fresh(x), 1)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, mismatches(rv, [1.0 if v > 1.0 else 0.0 for v in xs]) if mpc.pid else 0.0)
    for case in ("mpc.cmp.gt_secret_ring_vec_1e3", "mpc.cmp.ne_ring_vec_1e3"):
        if b.want(mpc, case):
            xs = shared_floats(mpc, n, -4.0, 4.0)
            ys = shared_floats(mpc, n, -4.0, 4.0)
            for i in range(0, n, 4):
                ys[i] = xs[i]  # equal pairs for !=
            x = Sharetensor.enc(mpc, xs, 0, ring)
            y = Sharetensor.enc(mpc, ys, 0, ring)
            r = x
            t = Timer(b.reps(7))
            while t.next():
                t.begin(mpc)
                r = secure_operator.gt(mpc, fresh(x), fresh(y)) if case == "mpc.cmp.gt_secret_ring_vec_1e3" else sq.secure_ne(mpc, fresh(x), fresh(y))
                t.end(mpc)
            rv = r.reveal(mpc)
            if case == "mpc.cmp.gt_secret_ring_vec_1e3":
                want = [1.0 if xs[i] > ys[i] else 0.0 for i in range(n)]
            else:
                want = [1.0 if xs[i] != ys[i] else 0.0 for i in range(n)]
            b.report(f"n={n}", t, mismatches(rv, want) if mpc.pid else 0.0)
    if b.want(mpc, "mpc.fp.div_ring_vec_1e3"):
        xs = shared_floats(mpc, n, -4.0, 4.0)
        ys = shared_floats(mpc, n, 1.0, 8.0)
        x = Sharetensor.enc(mpc, xs, 0, ring)
        y = Sharetensor.enc(mpc, ys, 0, ring)
        r = x
        t = Timer(b.reps(5))
        while t.next():
            t.begin(mpc)
            r = secure_operator.truediv(mpc, fresh(x), fresh(y))
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [xs[i] / ys[i] for i in range(n)]) if mpc.pid else 0.0)
    if b.want(mpc, "mpc.fp.sqrt_ring_vec_1e3"):
        xs = shared_floats(mpc, n, 1.0, 8.0)
        x = Sharetensor.enc(mpc, xs, 0, ring)
        r = x
        t = Timer(b.reps(5))
        while t.next():
            xf = fresh(x)
            t.begin(mpc)
            r = sq.sqrt(mpc, xf)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [math.sqrt(v) for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "e2e.linreg.sharetensor_ring_1024x31"):
        ring = MPC_RING_SIZE
        rows, cols = 1024, 31
        X = array(shared_float_matrix(mpc, rows, cols, 0.0, 1.0))
        target_w = array(shared_float_matrix(mpc, cols, 1, 0.0, 1.0))
        y = X @ target_w + 1.0
        raw_w0 = ones((cols + 1, 1))
        step, epochs = 0.0001, 10
        wv = array([[0.0]])
        t = Timer(b.reps(5))
        while t.next():
            t.begin(mpc)
            mX = Sharetensor.enc(mpc, X, 0, ring)
            my = Sharetensor.enc(mpc, y, 0, ring)
            mw = Sharetensor.enc(mpc, raw_w0, 0, ring)
            model = LinReg(mw).fit(mpc, X=mX, y=my, step=step, epochs=epochs)
            wv = model.coef_.reveal(mpc)
            t.end(mpc)
        err = 0.0
        if mpc.pid:
            ref = LinReg(raw_w0).fit(mpc, X=X, y=y, step=step, epochs=epochs).coef_
            err = max_abs_err_2d(wv, ref)
        b.report(f"{rows}x{cols};epochs={epochs}", t, err)


def bench_fp(mpc, b: Bench):
    if b.want(mpc, "mpc.fp.div_vec_1e3"):
        n = 1000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        ys, y = fp_vec(mpc, n, 1.0, 8.0)
        r = x
        t = Timer(b.reps(5))
        while t.next():
            t.begin(mpc)
            r = secure_operator.truediv(mpc, fresh(x), fresh(y))
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [xs[i] / ys[i] for i in range(n)]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.fp.sqrt_vec_1e3"):
        n = 1000
        xs, x = fp_vec(mpc, n, 1.0, 8.0)
        r = x
        t = Timer(b.reps(5))
        while t.next():
            xf = fresh(x)
            t.begin(mpc)
            r = sq.sqrt(mpc, xf)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [math.sqrt(v) for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.pow.fp_cube_vec_1e4"):
        n = 10000
        xs, x = fp_vec(mpc, n, -2.0, 2.0)
        r = x
        t = Timer(b.reps(9), batch=2)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.pow(mpc, fresh(x), 3)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n};p=3", t, max_abs_err_1d(rv, [v * v * v for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.pow.int_cube_vec_1e4"):
        n = 10000
        with mpc.randomness.global_stream():
            ints = [prg.randint(0, 15) for _ in range(n)]
        x = Sharetensor.enc(mpc, ints)
        r = x
        t = Timer(b.reps(9), batch=3)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.pow(mpc, fresh(x), 3)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n};p=3", t, max_abs_err_1d(rv, [float(v * v * v) for v in ints]) if mpc.pid else 0.0)


def bench_public(mpc, b: Bench):
    if not b.any_selected("mpc.public."):
        return
    n = 100000
    xs, x = fp_vec(mpc, n, -4.0, 4.0)

    if b.want(mpc, "mpc.public.add_int_vec_1e5"):
        r = x
        t = Timer(b.reps(9), batch=10)
