"""
MPC performance-regression cases: randomness, modular arithmetic, communication, Sharetensor protocols and
MPC-only end-to-end workloads. No HE: run with --skip-mhe-setup (scripts/bench.sh does).

    sequre build -release tests/bench/bench_mpc.codon -o bench_mpc
    ./bench_mpc --local --skip-mhe-setup [--cases=...] [--skip=...] [--out=DIR] [--reps-scale=F]
    ./bench_mpc --list

See tests/bench/harness.codon for the output format and scripts/bench.sh for the workflow.
"""
import math
import prg
import secure_operator

