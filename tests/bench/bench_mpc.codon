    if b.want(mpc, "mpc.public.mul_int_vec_1e5"):
        r = x
        t = Timer(b.reps(9), batch=10)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.mul(mpc, x, 3)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [v * 3.0 for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.public.mul_float_vec_1e5"):
        r = x
        t = Timer(b.reps(9))
        while t.next():
            t.begin(mpc)
            r = secure_operator.mul(mpc, x, 0.5)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [v * 0.5 for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.public.div_float_vec_1e5"):
        r = x
        t = Timer(b.reps(9))
        while t.next():
            t.begin(mpc)
            r = secure_operator.truediv(mpc, x, 4.0)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [v / 4.0 for v in xs]) if mpc.pid else 0.0)


def bench_mixed(mpc, b: Bench):
    if b.want(mpc, "mpc.ndarray.matmul_float_128"):
        size = 128
        ps = shared_float_matrix(mpc, size, size, -1.0, 1.0)
        xs, x = fp_mat(mpc, size, size, -1.0, 1.0)
        nd = array(ps)
        r = x
        t = Timer(b.reps(9), batch=2)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.matmul(mpc, nd, x)
            t.end(mpc)
        rv = r.reveal(mpc)
        err = 0.0
        if mpc.pid:
            err = max_abs_err_2d(rv, nd @ array(xs))
        b.report(f"{size}x{size}", t, err)

    if b.want(mpc, "mpc.bcast.add_vec_mat_256"):
        size = 256
        ms, m = fp_mat(mpc, size, size, -4.0, 4.0)
        vs, v = fp_vec(mpc, size, -4.0, 4.0)
        r = m
        t = Timer(b.reps(9), batch=20)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.add(mpc, fresh(m), fresh(v))
            t.end(mpc)
        rv = r.reveal(mpc)
        err = 0.0
        if mpc.pid:
            err = max_abs_err_2d(rv, [[ms[i][j] + vs[j] for j in range(size)] for i in range(size)])
        b.report(f"{size}x{size}+{size}", t, err)


########################## e2e: small end-to-end workloads ##########################

def plain_l2(rows: List[List[float]]) -> List[List[float]]:
    m = len(rows)
    out = [[0.0 for _ in range(m)] for _ in range(m)]
    for i in range(m):
        for j in range(m):
            s = 0.0
            for k in range(len(rows[i])):
                d = rows[i][k] - rows[j][k]
                s += d * d
            out[i][j] = math.sqrt(s)
    return out


def off_diagonal_err(have, want: List[List[float]]) -> float:
    err = 0.0
    for i in range(len(want)):
        for j in range(len(want)):
            if i != j:
                d = abs(float(have[i][j]) - want[i][j])
                if d > err: err = d
    return err


def bench_e2e(mpc, b: Bench):
    modulus = MPC_FIELD_SIZE

    if b.want(mpc, "e2e.l2.sharetensor_16x512"):
        rows, cols = 16, 512
        raw = shared_float_matrix(mpc, rows, cols, -1.0, 1.0)
        dv = array([[0.0]])
        t = Timer(b.reps(5))
        while t.next():
            t.begin(mpc)
            st = Sharetensor.enc(mpc, raw)
            d = l2(mpc, st)
            dv = d.reveal(mpc)
            t.end(mpc)
        b.report(f"{rows}x{cols}", t, off_diagonal_err(dv, plain_l2(raw)) if mpc.pid else 0.0)

    if b.want(mpc, "e2e.king.sharetensor_16x2048"):
        per_party, cols = 8, 2048
        rows = per_party * (mpc.comms.number_of_parties - 1)
        with mpc.randomness.global_stream():
            geno = random_ints((rows, cols), 0, 2)
        raw_data = array(geno, dtype=float)
        het_scale = float(cols // 100)
        raw_het_inv = array([[(1.0 / float(row.count(1))) * het_scale for _ in range(rows)] for row in geno], dtype=float)
        kv = array([[0.0]])
        t = Timer(b.reps(5))
        while t.next():
            t.begin(mpc)
            sd = Sharetensor.enc(mpc, raw_data)
            sh = Sharetensor.enc(mpc, raw_het_inv)
            k = king(mpc, sd, sh)
            kv = k.reveal(mpc)
            t.end(mpc)
        err = 0.0
        if mpc.pid:
            ref = king(mpc, raw_data, raw_het_inv)
            err = off_diagonal_err(kv, ref.tolist())
        b.report(f"{rows}x{cols}", t, err)

    if b.want(mpc, "e2e.linreg.sharetensor_1024x31"):
        rows, cols = 1024, 31
        X = array(shared_float_matrix(mpc, rows, cols, 0.0, 1.0))
        target_w = array(shared_float_matrix(mpc, cols, 1, 0.0, 1.0))
        y = X @ target_w + 1.0
        raw_w0 = ones((cols + 1, 1))
        step, epochs = 0.0001, 10
        wv = array([[0.0]])
        t = Timer(b.reps(5))
        while t.next():
            t.begin(mpc)
            mX = Sharetensor.enc(mpc, X, 0, modulus)
            my = Sharetensor.enc(mpc, y, 0, modulus)
            mw = Sharetensor.enc(mpc, raw_w0, 0, modulus)
            model = LinReg(mw).fit(mpc, X=mX, y=my, step=step, epochs=epochs)
            wv = model.coef_.reveal(mpc)
            t.end(mpc)
        err = 0.0
        if mpc.pid:
            ref = LinReg(raw_w0).fit(mpc, X=X, y=y, step=step, epochs=epochs).coef_
            err = max_abs_err_2d(wv, ref)
        b.report(f"{rows}x{cols};epochs={epochs}", t, err)


def _nn_layers(ctype: type, method: str):
    return (Input[ctype](8), Dense[ctype]("tanh", 16, "normal", "zeros", method=method),
            Dense[ctype]("sigmoid", 1, "normal", "zeros", method=method))


def _copy_initial_weights(mpc, src, dst):
    # dst (a plaintext model) takes src's (a Sharetensor model's) initial weights and biases, revealed (CP0 gets zeros).
    # Every party drew them in the clear under the shared seed (Sharetensor.rand), so the reveal discloses nothing new;
    # it keeps the plaintext reference on the same start without rewinding the global stream (see the module
    # docstring of harness.codon).
    for i in static.range(1, static.len(src.layers)):
        dst.layers[i].weights = src.layers[i].weights.reveal(mpc)
        dst.layers[i].bias = src.layers[i].bias.reveal(mpc)


def _bench_nn(mpc, b: Bench, case: str, mod, method: str):
    # Training with the new activations; check = the max difference of the trained weights from the plaintext path's
    # (from the same initial weights)
    if b.want(mpc, case):
        rows = 64
        X = array(shared_float_matrix(mpc, rows, 8, -1.0, 1.0))
        y = array([[1.0 if X[i, 0] + X[i, 1] > 0.0 else 0.0] for i in range(rows)])
        wv = array([[0.0]])
        ref = Sequential(_nn_layers(type(X), method)).compile(mpc, loss="binary_crossentropy", optimizer="bgd")
        t = Timer(b.reps(3))
        while t.next():
            with mpc.randomness.global_stream():
                model = Sequential(_nn_layers(Sharetensor[List[List[mpc_uint]]], method)).compile(
                    mpc, loss="binary_crossentropy", optimizer="bgd", modulus=mod)
            _copy_initial_weights(mpc, model, ref)
            t.begin(mpc)
            mX = Sharetensor.enc(mpc, X, 0, mod)
            my = Sharetensor.enc(mpc, y, 0, mod)
            model.fit(mpc, X=mX, y=my, step=0.5, epochs=2, momentum=0.9)
            wv = model.layers[1].weights.reveal(mpc)
            t.end(mpc)
        # The reference from the last repetition's initial weights
        ref.fit(mpc, X=X, y=y, step=0.5, epochs=2, momentum=0.9)
        err = max_abs_err_2d(wv, ref.layers[1].weights.tolist()) if mpc.pid else 0.0
        b.report(f"{rows}x8;epochs=2", t, err)


def _bench_multinomial(mpc, b: Bench, case: str, mod, method: str):
    # The softmax LogReg; check = the max difference of the trained weights from the plaintext path's
    if b.want(mpc, case):
        rows, cols, classes = 256, 8, 3
        X = array(shared_float_matrix(mpc, rows, cols, -1.0, 1.0))
        Wt = array(shared_float_matrix(mpc, cols, classes, -1.0, 1.0))
        scores = X @ Wt
        y = array([[1.0 if scores[i, k] >= max(scores[i, 0], scores[i, 1], scores[i, 2]) else 0.0 for k in range(classes)] for i in range(rows)])
        w0 = array([[0.0 for _ in range(classes)] for _ in range(cols + 1)])
        step, epochs = 0.01, 5
        wv = array([[0.0]])
        t = Timer(b.reps(3))
        while t.next():
            t.begin(mpc)
            mX = Sharetensor.enc(mpc, X, 0, mod)
            my = Sharetensor.enc(mpc, y, 0, mod)
            mw = Sharetensor.enc(mpc, w0, 0, mod)
            model = LogReg(mw, variant="multinomial", method=method).fit(mpc, X=mX, y=my, step=step, epochs=epochs)
            wv = model.coef_.reveal(mpc)
            t.end(mpc)
        err = 0.0
        if mpc.pid:
            ref = LogReg(w0, variant="multinomial", method=method).fit(mpc, X=X, y=y, step=step, epochs=epochs).coef_
            err = max_abs_err_2d(wv, ref)
        b.report(f"{rows}x{cols}x{classes};epochs={epochs}", t, err)


def bench_ml(mpc, b: Bench):
    # Training with the new activations and the softmax LogReg
    for case, mod, method in (("e2e.nn.decor_sharetensor_64x8", MPC_FIELD_SIZE, "decor"),
                              ("e2e.nn.decor_sharetensor_ring_64x8", MPC_RING_SIZE, "decor"),
                              ("e2e.nn.chebyshev_sharetensor_64x8", MPC_FIELD_SIZE, "chebyshev")):
        _bench_nn(mpc, b, case, mod, method)

    for case, mod, method in (("e2e.logreg.multinomial_sharetensor_256x8x3", MPC_FIELD_SIZE, "decor"),
                              ("e2e.logreg.multinomial_sharetensor_ring_256x8x3", MPC_RING_SIZE, "decor"),
                              ("e2e.logreg.multinomial_chebyshev_sharetensor_256x8x3", MPC_FIELD_SIZE, "chebyshev")):
        _bench_multinomial(mpc, b, case, mod, method)


def bench_apps(mpc, b: Bench):
    # The applications themselves (applications/siren.codon, applications/gwas_logreg.codon); check = the max
    # difference of the secure path's result (first-layer weights, SNP coefficients) from the plaintext path's
    for case, mod in (("e2e.siren.sharetensor_8x8", MPC_FIELD_SIZE), ("e2e.siren.sharetensor_ring_8x8", MPC_RING_SIZE)):
        if b.want(mpc, case):
            side, neurons, omega, step, epochs = 8, 16, 30.0, 0.01, 2
            X, y = synthetic_image(side)
            wv = array([[0.0]])
            ref = siren_model(mpc, type(X), 2, neurons, omega)
            # About 0.06 s a repetition: 9 of them for a stable median
            t = Timer(b.reps(9))
            while t.next():
                with mpc.randomness.global_stream():
                    model = siren_model(mpc, Sharetensor[List[List[mpc_uint]]], 2, neurons, omega, modulus=mod)
                _copy_initial_weights(mpc, model, ref)
                t.begin(mpc)
                mX = Sharetensor.enc(mpc, X, 0, mod)
                my = Sharetensor.enc(mpc, y, 0, mod)
                model.fit(mpc, X=mX, y=my, step=step, epochs=epochs, momentum=0.9)
                wv = model.layers[1].weights.reveal(mpc)
                t.end(mpc)
            # The reference from the last repetition's initial weights
            ref.fit(mpc, X=X, y=y, step=step, epochs=epochs, momentum=0.9)
            err = max_abs_err_2d(wv, ref.layers[1].weights.tolist()) if mpc.pid else 0.0
            b.report(f"{side}x{side};neurons={neurons};epochs={epochs}", t, err)

    for case, mod, method in (("e2e.gwas_logreg.sharetensor_64x3", MPC_FIELD_SIZE, "decor"),
                              ("e2e.gwas_logreg.sharetensor_ring_64x3", MPC_RING_SIZE, "decor"),
                              ("e2e.gwas_logreg.chebyshev_sharetensor_64x3", MPC_FIELD_SIZE, "chebyshev"),
                              ("e2e.gwas_logreg.chebyshev_sharetensor_ring_64x3", MPC_RING_SIZE, "chebyshev")):
        if b.want(mpc, case):
            n, snps, covs, step, epochs = 64, 3, 2, 1.0, 10  # step per individual (gwas_logreg divides by n)
            interval = (-10.0, 10.0)
            with mpc.randomness.global_stream():
                geno = array(random_ints((n, snps), upper_limit=2)).astype(float)
                betas, pheno, cov = simulate_gwas_data(geno, covs)
            w0 = array([[0.0] for _ in range(covs + 2)])
            got = List[float]()
            t = Timer(b.reps(3))
            while t.next():
                t.begin(mpc)
                sg = Sharetensor.enc(mpc, geno, 0, mod)
                sp = Sharetensor.enc(mpc, pheno, 0, mod)
                sc = Sharetensor.enc(mpc, cov, 0, mod)
                sw = Sharetensor.enc(mpc, w0, 0, mod)
                got, _ = gwas_logreg(mpc, sg, sp, sc, sw, method, step, epochs, interval=interval)
                t.end(mpc)
            ref, _ = gwas_logreg(mpc, geno, pheno, cov, w0, method, step, epochs, interval=interval)
            b.report(f"{n}x{snps};covs={covs};epochs={epochs}", t, max_abs_err_1d(got, ref) if mpc.pid else 0.0)


########################## decor.prim: bitwise protocols and Decor division (ring shares) ##########################


def bench_decor_prim(mpc, b: Bench):
    # Ring shares built explicitly (MPC_RING_SIZE), so the binary's default modulus does not matter. The params
    # record each operation's rounds, counted once at the end.
    ring = MPC_RING_SIZE

    if b.want(mpc, "decor.prim.xor_add_vec_1e4"):
        n = 10000
        with mpc.randomness.global_stream():
            xs = [prg.getrandbits_intn(PACKING_SIZE, TP=size_t) for _ in range(n)]
            ys = [prg.getrandbits_intn(PACKING_SIZE, TP=size_t) for _ in range(n)]
        x = mpc.bitwise.share_from_trusted_dealer(xs)
        s = x
        t = Timer(b.reps(5))
        while t.next():
            t.begin(mpc)
            s = mpc.bitwise.add_public(x, ys, bitlen=PACKING_SIZE, dtype=size_t)
            t.end(mpc)
        r0 = mpc.stats.rounds
        s = mpc.bitwise.add_public(x, ys, bitlen=PACKING_SIZE, dtype=size_t)
        rounds = mpc.stats.rounds - r0
        rv = mpc.bitwise.reveal(s)
        bad = 0.0
        if mpc.pid:
            for i in range(n):
                if rv[i] != xs[i].wrapping_add(ys[i]):
                    bad += 1.0
        b.report(f"n={n};rounds={rounds};check=mismatches", t, bad)

    for case, n, lo, hi in (("decor.prim.sign_f1_vec_1e4", 10000, -0.999, 0.999),
                            ("decor.prim.sign_k1_vec_1e4", 10000, -4.0, 4.0),
                            ("decor.prim.sign_l_vec_1e3", 1000, -4.0, 4.0)):
        if b.want(mpc, case):
            xs = shared_floats(mpc, n, lo, hi)
            xr = Sharetensor.enc(mpc, xs, 0, ring)
            g = xr.share
            t = Timer(b.reps(5))
            r0 = mpc.stats.rounds
            while t.next():
                t.begin(mpc)
                if case == "decor.prim.sign_f1_vec_1e4":
                    g = mpc.bitwise.sign_ring(xr.share, ring, bits=MPC_NBIT_F + 1)
                elif case == "decor.prim.sign_k1_vec_1e4":
                    g = mpc.bitwise.sign_ring(xr.share, ring, bits=MPC_NBIT_K + 1)
                else:
                    g = mpc.bitwise.is_positive_ring(xr.share, ring, ring, op_mod_bitlen=MPC_MODULUS_BITS)
                t.end(mpc)
            rounds = (mpc.stats.rounds - r0) // (t.warmup + t.reps)
            rv = Sharetensor(g, ring).reveal(mpc)
            b.report(f"n={n};rounds={rounds};check=mismatches", t,
                     mismatches(rv, [1.0 if v > 0.0 else 0.0 for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "decor.prim.normalizer_vec_1e3"):
        n = 1000
        xs = shared_floats(mpc, n, 0.001, 1000.0)
        xr = Sharetensor.enc(mpc, xs, 0, ring)
        sv, _ = mpc.bitwise.normalizer(xr.share, ring)
        t = Timer(b.reps(5))
        r0 = mpc.stats.rounds
        while t.next():
            t.begin(mpc)
            sv, _ = mpc.bitwise.normalizer(xr.share, ring)
            t.end(mpc)
        rounds = (mpc.stats.rounds - r0) // (t.warmup + t.reps)
        rs = mpc.comms.reveal(sv, ring)
        bad = 0.0
        if mpc.pid:
            lo_b, hi_b = mpc_uint(1) << mpc_uint(MPC_NBIT_K - 2), mpc_uint(1) << mpc_uint(MPC_NBIT_K)
            raw = double_to_fp(xs, ring)
            for i in range(n):
                if not (lo_b <= raw[i] * rs[i] < hi_b):
                    bad += 1.0
        b.report(f"n={n};rounds={rounds};check=out_of_range", t, bad)

    if b.want(mpc, "decor.prim.div_vec_1e3"):
        n = 1000
        xs = shared_floats(mpc, n, -4.0, 4.0)
        ys = shared_floats(mpc, n, 1.0, 8.0)
        x = Sharetensor.enc(mpc, xs, 0, ring)
        y = Sharetensor.enc(mpc, ys, 0, ring)
        r = x
        t = Timer(b.reps(5))
        r0 = mpc.stats.rounds
        while t.next():
            t.begin(mpc)
            r = decor_div(mpc, fresh(x), fresh(y))
            t.end(mpc)
        rounds = (mpc.stats.rounds - r0) // (t.warmup + t.reps)
        rv = r.reveal(mpc)
        b.report(f"n={n};rounds={rounds}", t, max_abs_err_1d(rv, [xs[i] / ys[i] for i in range(n)]) if mpc.pid else 0.0)


########################## decor.fn / fourier / taylor, cheby: nonlinear functions (ring and field) ##########################


def _sigmoid(v: float) -> float:
    return 1.0 / (1.0 + math.exp(-v)) if v >= 0.0 else math.exp(v) / (1.0 + math.exp(v))


def _poly3(v: float) -> float:
    return 1.0 - 2.0 * v + 0.5 * v * v + 0.25 * v * v * v


def _decor_fn(mpc, x, fn: str):
    if fn == "sin": return via_decor(mpc, x, func="sin")
    if fn == "cos": return via_decor(mpc, x, func="cos")
    if fn == "exp": return via_decor(mpc, x, func="exp", interval=(-8.0, 8.0))
    if fn == "sigmoid": return via_decor(mpc, x, func="sigmoid", interval=(-10.0, 10.0))
    if fn == "tanh": return via_decor(mpc, x, func="tanh", interval=(-5.0, 5.0))
    if fn == "sinh": return via_decor(mpc, x, func="sinh", interval=(-5.0, 5.0))
    if fn == "cosh": return via_decor(mpc, x, func="cosh", interval=(-5.0, 5.0))
    if fn == "tan": return via_decor(mpc, x, func="tan")
    if fn == "cot": return via_decor(mpc, x, func="cot")
    return via_decor(mpc, x, func="polynomial", interval=(-3.0, 3.0), coeffs=[1.0, -2.0, 0.5, 0.25])


def _plain_fn(fn: str, v: float) -> float:
    if fn == "sin": return math.sin(v)
    if fn == "cos": return math.cos(v)
    if fn == "exp": return math.exp(v)
    if fn == "sigmoid": return _sigmoid(v)
    if fn == "tanh": return math.tanh(v)
    if fn == "sinh": return math.sinh(v)
    if fn == "cosh": return math.cosh(v)
    if fn == "tan": return math.tan(v)
    if fn == "cot": return 1.0 / math.tan(v)
    return _poly3(v)


def _fn_range(fn: str) -> Tuple[float, float]:
    if fn == "exp": return (-8.0, 8.0)
    if fn == "sigmoid": return (-10.0, 10.0)
    if fn == "tanh" or fn == "sinh" or fn == "cosh": return (-5.0, 5.0)
    if fn == "poly3": return (-3.0, 3.0)
    if fn == "tan": return (-1.2, 1.2)
    if fn == "cot": return (0.4, 2.7)
    return (-10.0, 10.0)


def _max_err(a: List[float], b: List[float]) -> float:
    m = 0.0
    for i in range(len(a)):
        m = max(m, abs(a[i] - b[i]))
    return m


def _timed_fn(mpc, b: Bench, case: str, n: int, xs: List[float], x, op, want: List[float], extra: str = ""):
    r = op(mpc, x)
    t = Timer(b.reps(5))
    r0 = mpc.stats.rounds
    while t.next():
        t.begin(mpc)
        r = op(mpc, x)
        t.end(mpc)
    rounds = (mpc.stats.rounds - r0) // (t.warmup + t.reps)
    rv = r.reveal(mpc)
    b.report(f"n={n};rounds={rounds}{extra}", t, max_abs_err_1d(rv, want) if mpc.pid else 0.0)


def bench_decor_fn(mpc, b: Bench):
    n = 1000
    for fn in ("sin", "cos", "exp", "sigmoid", "tanh", "sinh", "cosh", "poly3"):
        for mod in ("ring", "field"):
            case = f"decor.fn.{fn}_{mod}_vec_1e3"
            if b.want(mpc, case):
                modulus = MPC_RING_SIZE if mod == "ring" else MPC_FIELD_SIZE
                lo, hi = _fn_range(fn)
                xs = shared_floats(mpc, n, lo, hi)
                x = Sharetensor.enc(mpc, xs, 0, modulus)
                want = [_plain_fn(fn, fp_to_double(double_to_fp(v, modulus), modulus)) for v in xs]
                _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: _decor_fn(mpc, x, fn), want)

    for mod in ("ring", "field"):
        case = f"decor.fourier.expsin_deg8_{mod}_vec_1e3"
        if b.want(mpc, case):
            # A smooth periodic target: its series converges fast (a non-periodic one rings at the ends, Gibbs)
            modulus = MPC_RING_SIZE if mod == "ring" else MPC_FIELD_SIZE
            xs = shared_floats(mpc, n, -math.pi, math.pi)
            x = Sharetensor.enc(mpc, xs, 0, modulus)
            # check: against the series itself in double (at the encoded inputs); its error against exp(sin x) goes to
            # params
            enc = [fp_to_double(double_to_fp(v, modulus), modulus) for v in xs]
            want = nl_approx(mpc, enc, lambda v: math.exp(math.sin(v)), (-math.pi, math.pi), method="fourier", degree=8)
            extra = f";approx_err={_max_err(want, [math.exp(math.sin(v)) for v in enc]):.2e}"
            _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: via_fourier(mpc, x, lambda v: math.exp(math.sin(v)), (-math.pi, math.pi), 8),
                      want, extra)

    for ev in ("decor", "naive"):
        for mod in ("ring", "field"):
            case = f"decor.taylor.exp_deg8_{ev}_{mod}_vec_1e3"
            if b.want(mpc, case):
                modulus = MPC_RING_SIZE if mod == "ring" else MPC_FIELD_SIZE
                xs = shared_floats(mpc, n, -1.0, 1.0)
                x = Sharetensor.enc(mpc, xs, 0, modulus)
                # check: against the Taylor polynomial itself in double (at the encoded inputs); its error against exp
                # goes to params
                enc = [fp_to_double(double_to_fp(v, modulus), modulus) for v in xs]
                want = nl_exp(mpc, enc, method="taylor", interval=(-1.0, 1.0), degree=8)
                extra = f";approx_err={_max_err(want, [math.exp(v) for v in enc]):.2e}"
                if ev == "decor":
                    _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: via_taylor(mpc, x, func="exp", interval=(-1.0, 1.0), degree=8), want, extra)
                else:
                    _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: via_taylor(mpc, x, func="exp", interval=(-1.0, 1.0), degree=8, evaluation="naive"), want, extra)

    for ev in ("clenshaw", "decor"):
        for mod in ("ring", "field"):
            case = f"cheby.sigmoid_deg10_{ev}_{mod}_vec_1e3"
            if b.want(mpc, case):
                modulus = MPC_RING_SIZE if mod == "ring" else MPC_FIELD_SIZE
                xs = shared_floats(mpc, n, -8.0, 8.0)
                x = Sharetensor.enc(mpc, xs, 0, modulus)
                # check: against the degree-10 interpolant itself in double (at the encoded inputs); its error against
                # sigmoid goes to params
                enc = [fp_to_double(double_to_fp(v, modulus), modulus) for v in xs]
                want = nl_approx(mpc, enc, _sigmoid, (-8.0, 8.0), method="chebyshev", degree=10)
                extra = f";approx_err={_max_err(want, [_sigmoid(v) for v in enc]):.2e}"
                if ev == "clenshaw":
                    _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: via_chebyshev(mpc, x, _sigmoid, (-8.0, 8.0), 10), want, extra)
                else:
                    _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: via_chebyshev(mpc, x, _sigmoid, (-8.0, 8.0), 10, evaluation="decor"), want, extra)


def bench_twins(mpc, b: Bench):
    # Like-for-like twins for the default-method decisions (Chebyshev on the ring for the NN and the softmax LogReg,
    # Decor's dividing tan and cot, Chebyshev sigmoid and tanh at Decor's accuracy), and the Fourier coefficients' share
    # of their case. After every earlier section: the earlier cases' shared data stay as they were.
    _bench_nn(mpc, b, "e2e.nn.chebyshev_sharetensor_ring_64x8", MPC_RING_SIZE, "chebyshev")
    _bench_multinomial(mpc, b, "e2e.logreg.multinomial_chebyshev_sharetensor_ring_256x8x3", MPC_RING_SIZE, "chebyshev")

    n = 1000
    for fn in ("tan", "cot"):
        for mod in ("ring", "field"):
            case = f"decor.fn.{fn}_{mod}_vec_1e3"
            if b.want(mpc, case):
                modulus = MPC_RING_SIZE if mod == "ring" else MPC_FIELD_SIZE
                lo, hi = _fn_range(fn)
                xs = shared_floats(mpc, n, lo, hi)
                x = Sharetensor.enc(mpc, xs, 0, modulus)
                want = [_plain_fn(fn, fp_to_double(double_to_fp(v, modulus), modulus)) for v in xs]
                _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: _decor_fn(mpc, x, fn), want)

    for fn, degree in (("sigmoid", 40), ("tanh", 44)):
        for mod in ("ring", "field"):
            case = f"cheby.{fn}_deg{degree}_clenshaw_{mod}_vec_1e3"
            if b.want(mpc, case):
                modulus = MPC_RING_SIZE if mod == "ring" else MPC_FIELD_SIZE
                lo, hi = _fn_range(fn)
                xs = shared_floats(mpc, n, lo, hi)
                x = Sharetensor.enc(mpc, xs, 0, modulus)
                # check: against the interpolant itself in double (at the encoded inputs); its error against the
                # function goes to params (Decor's own error is decor.fn.{sigmoid,tanh}_*'s check)
                enc = [fp_to_double(double_to_fp(v, modulus), modulus) for v in xs]
                want = nl_approx(mpc, enc, lambda v: _plain_fn(fn, v), (lo, hi), method="chebyshev", degree=degree)
                extra = f";approx_err={_max_err(want, [_plain_fn(fn, v) for v in enc]):.2e}"
                _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: via_chebyshev(mpc, x, lambda v: _plain_fn(fn, v), (lo, hi), degree), want, extra)

    if b.want(mpc, "decor.fourier.coeffs_expsin_deg8"):
        # check: the series against exp(sin x) on a fixed grid (no draw from the shared stream)
        target = lambda v: math.exp(math.sin(v))
        series = fourier_coeffs(target, (-math.pi, math.pi), 8)
        t = Timer(b.reps(9))
        while t.next():
            t.begin(mpc)
            series = fourier_coeffs(target, (-math.pi, math.pi), 8)
            t.end(mpc)
        grid = [-math.pi + 2.0 * math.pi * float(i) / float(n) for i in range(n)]
        b.report("degree=8;nodes=1000", t, _max_err([series(v) for v in grid], [target(v) for v in grid]))

    # sigmoid's and tanh's default, auto: Decor on ring shares, a Chebyshev interpolant within Decor's error bound on
    # field shares. check: against the function itself (at the encoded inputs), within Decor's bound on either modulus
    for fn in ("sigmoid", "tanh"):
        for mod in ("ring", "field"):
            case = f"nl.{fn}_auto_{mod}_vec_1e3"
            if b.want(mpc, case):
                modulus = MPC_RING_SIZE if mod == "ring" else MPC_FIELD_SIZE
                lo, hi = _fn_range(fn)
                xs = shared_floats(mpc, n, lo, hi)
                x = Sharetensor.enc(mpc, xs, 0, modulus)
                want = [_plain_fn(fn, fp_to_double(double_to_fp(v, modulus), modulus)) for v in xs]
                degree = nl_auto_degree("sigmoid") if fn == "sigmoid" else nl_auto_degree("tanh")
                extra = f";method={'decor' if mod == 'ring' else 'chebyshev'};field_degree={degree}"
                _timed_fn(mpc, b, case, n, xs, x, lambda mpc, x: nl_sigmoid(mpc, x) if fn == "sigmoid" else nl_tanh(mpc, x), want, extra)


def bench_streams(mpc, b: Bench):
    # After every other section: its draws from the shared stream move no other case's data
    if b.want(mpc, "prim.rand.seed_switch_global_1e4"):
        # Every party switches from its private stream to the global one and back, and draws the same values from the
        # global stream, which stays in step. prim.rand.seed_switch_1e4 switches to the stream already live.
        modulus = MPC_FIELD_SIZE
        n = 10000
        acc = mpc_uint(0)
        t = Timer(b.reps(9))
        while t.next():
            t.begin(mpc)
            for _ in range(n):
                with mpc.randomness.global_stream():
                    acc ^= mpc_uint.rand(modulus, "uniform")
            t.end(mpc)
        b.report(f"n={n};check=draws_ok", t, 1.0 if acc != mpc_uint(0) else 0.0)


def bench_late_mpc(mpc, b: Bench):
    # Cases added after bench_streams: their draws from the shared stream move no other case's data
    if b.want(mpc, "mpc.cmp.ne_vec_1e3"):
        field = MPC_FIELD_SIZE
        n = 1000
        xs = shared_floats(mpc, n, -4.0, 4.0)
        ys = shared_floats(mpc, n, -4.0, 4.0)
        for i in range(0, n, 4):
            ys[i] = xs[i]  # equal pairs
        x = Sharetensor.enc(mpc, xs, 0, field)
        y = Sharetensor.enc(mpc, ys, 0, field)
        r = x
        t = Timer(b.reps(7))
        while t.next():
            t.begin(mpc)
            r = sq.secure_ne(mpc, fresh(x), fresh(y))
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, mismatches(rv, [1.0 if xs[i] != ys[i] else 0.0 for i in range(n)]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.bcast.sub_scalar_sq_vec_1e4"):
        # x has cached Beaver partitions (as after an earlier product); m has none. The difference's square must not
        # reuse x's partitions (the value would come out as x^2).
        n = 10000
        xs, x = fp_vec(mpc, n, -4.0, 4.0)
        m = Sharetensor.enc(mpc, [0.75])[0]
        r = x
        t = Timer(b.reps(9), batch=3)
        while t.next():
            xp = fresh(x)
            xp.get_partitions(mpc, force=False)
            t.begin(mpc)
            for _ in range(t.batch):
                d = secure_operator.sub(mpc, xp, m)
                r = secure_operator.mul(mpc, d, d)
            t.end(mpc)
        rv = r.reveal(mpc)
        b.report(f"n={n}", t, max_abs_err_1d(rv, [(v - 0.75) * (v - 0.75) for v in xs]) if mpc.pid else 0.0)

    if b.want(mpc, "mpc.ndarray.rmatmul_float_128"):
        size = 128
        ps = shared_float_matrix(mpc, size, size, -1.0, 1.0)
        xs, x = fp_mat(mpc, size, size, -1.0, 1.0)
        nd = array(ps)
        r = x
        t = Timer(b.reps(9), batch=2)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.matmul(mpc, x, nd)
            t.end(mpc)
        rv = r.reveal(mpc)
        err = 0.0
        if mpc.pid:
            err = max_abs_err_2d(rv, array(xs) @ nd)
        b.report(f"{size}x{size}", t, err)

    if b.want(mpc, "mpc.public.add_identity_mat_256"):
        size = 256
        ms, a = fp_mat(mpc, size, size, -4.0, 4.0)
        ident = a.I
        r = a
        t = Timer(b.reps(9), batch=4)
        while t.next():
            t.begin(mpc)
            for _ in range(t.batch):
                r = secure_operator.add(mpc, a, ident)
            t.end(mpc)
        rv = r.reveal(mpc)
        err = 0.0
        if mpc.pid:
            err = max_abs_err_2d(rv, [[ms[i][j] + (1.0 if i == j else 0.0) for j in range(size)] for i in range(size)])
        b.report(f"{size}x{size}", t, err)


@main
def bench_mpc_main(mpc):
    b = Bench("mpc", mpc.pid, CASES)
    b.start(mpc)
    bench_prim(mpc, b)
    bench_net(mpc, b)
    bench_share(mpc, b)
    bench_arith(mpc, b)
    bench_cmp(mpc, b)
    bench_fp(mpc, b)
    bench_public(mpc, b)
    bench_mixed(mpc, b)
    bench_e2e(mpc, b)
    bench_decor_prim(mpc, b)
    bench_decor_fn(mpc, b)
    # New sections run after every earlier one (each selected case draws from the shared stream: the earlier cases'
    # data stay as they were): the ring comparisons and division, then training, then the applications
    bench_ring_cmp_fp(mpc, b)
    bench_ml(mpc, b)
    bench_apps(mpc, b)
    bench_twins(mpc, b)
    bench_streams(mpc, b)
    bench_late_mpc(mpc, b)
    b.finish(mpc)


bench_mpc_main()
