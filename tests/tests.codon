from sequre.mpc.env import MPCEnv
from sequre.constants import RUN_TOGGLES

from unit_tests import test_unit, UNIT_SELECTORS
from e2e_tests import test_e2e, E2E_SELECTORS


# Every run-tests selector; scripts/invoke.codon rejects the others.
TEST_SELECTORS = [RUN_TOGGLES.RUN_ALL_FLAG]
TEST_SELECTORS.extend(UNIT_SELECTORS)  # not `+`: Sequre's list `+` adds element-wise
TEST_SELECTORS.extend(E2E_SELECTORS)


def tests[TP](mpc: MPCEnv[TP], tests_toggles: dict, modulus: TP):
    # Every group runs on the run's modulus: the field, or the ring with --use-ring (a full check runs both)
    print(f'CP{mpc.pid}:\tTesting Sequre ... \n')

    selected = test_unit(mpc, tests_toggles, modulus)
    with mpc.default_modulus(modulus):
        selected += test_e2e(mpc, tests_toggles, modulus)

    if not selected:
        raise ValueError(f'CP{mpc.pid}: no test group was selected (see: sequre run scripts/invoke.codon --help)')
    print(f'CP{mpc.pid}:\tTests passed.\n\n')
