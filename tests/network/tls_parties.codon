"""Party program of the distributed-mode TLS tests (tests/network/test_tls.sh).

Each party runs it as a process of its own, connected to the others over TCP: SEQURE_CP_IPS lists the parties, the
first argument is the party's ID, and the channels use TLS unless SEQURE_USE_TLS=0. The MHE setup (on unless
--skip-mhe-setup) sends megabyte-sized key shares, which TLS carries in many records. Then CP1 shares a vector, the
parties square it (a Beaver multiplication and a truncation) and reveal the result. Each compute party prints
"ok <check>" or "FAIL <check>", and every party prints "TLS-CHECK DONE" when it gets to the end.

With TLS_CHECK_DEAD_PEER=1 it runs dead_peer instead.
"""
import os
import sys

from sequre import main, sequre, Sharetensor

from C import _exit(i32)


def check(mpc, name: str, ok: bool):
    print(f"CP{mpc.pid}: {'ok' if ok else 'FAIL'} {name}")
    sys.stdout.flush()


@sequre
def square(mpc, x):
    return x * x


def dead_peer(mpc):
    # CP2 exits at once, without closing its connections (the kernel closes them), while CP0 sends it 100 messages of
    # 800 KB. A send must fail as a broken connection: a failed SSL_write used to read as a success, so all 100 "went
    # through". CP1 waits for the end of the run, which fails.
    if mpc.pid == 2:
        print("CP2: exiting without closing its connections")
        sys.stdout.flush()
        _exit(i32(0))
    elif mpc.pid == 0:
        data = [u64(i) for i in range(100000)]
        for _ in range(100):
            mpc.comms.send_as_jar(data, 2)
        print("CP0: sent 100 messages of 800 KB to CP2, which had exited")
        sys.stdout.flush()


@main
def run(mpc):
    if os.getenv("TLS_CHECK_DEAD_PEER", default="") == "1":
        dead_peer(mpc)
        return
    values = [1.5, -2.25, 3.0, 0.125]
    x = Sharetensor.enc(mpc, values, 1, mpc.default_mpc_modulus)
    product = square(mpc, x).reveal(mpc)
    if mpc.pid:
        check(mpc, "share from CP1, multiplication and reveal over the network",
              all(abs(product[i] - values[i] * values[i]) < 1e-6 for i in range(len(values))))
    print(f"CP{mpc.pid}: TLS-CHECK DONE")
    sys.stdout.flush()


run()
