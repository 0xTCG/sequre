import internal.static as static
import math

""" This module contains temorary patches that native Codon does not support yet """

from pickler import pickle, unpickle
from simd import Vec


# Conversions to float of integers wider than 128 bits. Codon 0.20's UInt.__float__ and Int.__float__ are one uitofp or
# sitofp at every width, and LLVM's AArch64 backend has no conversion from an integer wider than 128 bits ("LLVM ERROR:
# Unsupported library call operation!"). Codon's formatter makes any program that formats a UInt[192] in an f-string
# (sequre.constants does) compile one: its % directive converts integers to float. Above 128 bits these take the top
# 64 bits, the last of them ORed with whether any bit below is set, scaled by a power of two: the double the
# instruction gives (correctly rounded, halves to even). Here, in a module sequre.constants imports first, so that they
# are in place before anything formats an integer.
@extend
class UInt:
    def __float__(self) -> float:
        if N <= 128:
            return self._uitofp()
        else:
            b = N - self._clz()
            if b <= 64:
                return self._top64(0)._uitofp()
            shift = b - 64
            top = self._top64(shift)
            if self._any_below(shift):
                top |= u64(1)
            return math.ldexp(top._uitofp(), shift)

    @pure
    @llvm
    def _uitofp(self) -> float:
        %0 = uitofp i{=N} %self to double
        ret double %0

    @pure
    @llvm
    def _clz(self) -> int:
        declare i{=N} @llvm.ctlz.i{=N}(i{=N}, i1)
        %0 = call i{=N} @llvm.ctlz.i{=N}(i{=N} %self, i1 false)
        %1 = trunc i{=N} %0 to i64
        ret i64 %1

    @pure
    @llvm
    def _top64(self, s: int) -> u64:
        %0 = zext i64 %s to i{=N}
        %1 = lshr i{=N} %self, %0
        %2 = trunc i{=N} %1 to i64
        ret i64 %2

    @pure
    @llvm
    def _any_below(self, s: int) -> bool:
        %0 = zext i64 %s to i{=N}
        %1 = shl i{=N} 1, %0
        %2 = sub i{=N} %1, 1
        %3 = and i{=N} %self, %2
        %4 = icmp ne i{=N} %3, 0
        %5 = zext i1 %4 to i8
        ret i8 %5


@extend
class Int:
    def __float__(self) -> float:
        # The magnitude's, negated (rounding to nearest is symmetric); the most negative value's magnitude fits the UInt
        if N <= 128:
            return self._sitofp()
        else:
            if self._is_negative():
                return -self._negated_uint().__float__()
            return self._as_uint().__float__()

    @pure
    @llvm
    def _sitofp(self) -> float:
        %0 = sitofp i{=N} %self to double
        ret double %0

    @pure
    @llvm
    def _is_negative(self) -> bool:
        %0 = icmp slt i{=N} %self, 0
        %1 = zext i1 %0 to i8
        ret i8 %1

    @pure
    @llvm
    def _as_uint(self) -> UInt[N]:
        ret i{=N} %self

    @pure
    @llvm
    def _negated_uint(self) -> UInt[N]:
        %0 = sub i{=N} 0, %self
        ret i{=N} %0



def permutations(
    pool: Generator[T], r: Optional[int] = None, T: type
) -> Generator[List[T]]:
    """
    (Patch for the original permutations method)
    Return successive r-length permutations of elements in the iterable.
    """

    def permutations_helper(
        pool: List[T], r: Optional[int], T: type
    ) -> Generator[List[T]]:
        n = len(pool)
        r: int = r if r is not None else n
        if r > n:
            return

        indices = list(range(n))
        cycles = list(range(n, n - r, -1))
        yield [pool[i] for i in indices[:r]]
        while n:
            b = -1
            for i in reversed(range(r)):
                cycles[i] -= 1
                if cycles[i] == 0:
                    _indices = indices[:i]
                    _indices.extend(indices[i + 1 :])
                    _indices.extend(indices[i : i + 1])
                    indices = _indices
                    cycles[i] = n - i
                else:
                    b = i
                    j = cycles[i]
                    indices[i], indices[-j] = indices[-j], indices[i]
                    yield [pool[i] for i in indices[:r]]
                    break
            if b == -1:
                return

    if r is not None and r.__val__() < 0:
        raise ValueError("r must be non-negative")
    if hasattr(pool, "__getitem__") and hasattr(pool, "__len__"):
        return permutations_helper(pool, r)
    else:
        return permutations_helper([a for a in pool], r)


# Tuples cannot be overriden. Thus the custom pickling methods cannot be added to it.
def pickle_tuple_unpasteurized(tup, jar):
    for e in tup:
        pickle(e, jar, False)
        jar += e._pickle_size()


def unpickle_tuple_unpasteurized[S](jar) -> S:
    assert static.len(S) <= 2, "Unpickling ndarrays cannot be done on larger than 2-dimensional arrays until __pickle__ method of Tuple class can be overriden."
    if static.len(S) == 0: return S()
    _shape_0 = unpickle(jar, False, S.T1)
    jar += S.T1._pickle_size()
    if static.len(S) == 1: return S(_shape_0,)
    _shape_1 = unpickle(jar, False, S.T2)
    jar += S.T2._pickle_size()
    return S(_shape_0, _shape_1)


def tuple_pickle_size[S]() -> int:
    return static.len(S) * S.T1._pickle_size()


def argmin(arr):
    """    Return the index of smallest element in the array
    """
    if len(arr) == 0:
        raise ValueError("empty sequence")
    else:
        m = arr[0]
        m_idx = 0
        for idx, i in enumerate(arr):
            if i < m:
                m = i
                m_idx = idx
        return m_idx


def argmax(arr):
    """    Return the index of largest element in the array
    """
    if len(arr) == 0:
        raise ValueError("empty sequence")
    else:
        m = arr[0]
        m_idx = 0
        for idx, i in enumerate(arr):
            if i > m:
                m = i
                m_idx = idx
        return m_idx


def min_by_key(iterable, key):
    x = iterable.__iter__()
    if not x.done():
        s = x.next()
        k = key(s)
        while not x.done():
            i = x.next()
            ki = key(i)
            if ki < k:
                s = i
                k = ki
        x.destroy()
        return s
    else:
        x.destroy()
    raise ValueError("empty sequence")


def max_by_key(iterable, key):
    x = iterable.__iter__()
    if not x.done():
        s = x.next()
        k = key(s)
        while not x.done():
            i = x.next()
            ki = key(i)
            if ki > k:
                s = i
                k = ki
        x.destroy()
        return s
    else:
        x.destroy()
    raise ValueError("empty sequence")


@extend
class Vec:
    def __new__(other: int):
        return Vec[T, N](T(other))

    @llvm
    def fdiv(self: Vec[u64, N], other: Vec[u64, N]) -> Vec[float, N]:
        %0 = uitofp <{=N} x i64> %self to <{=N} x double>
        %1 = uitofp <{=N} x i64> %other to <{=N} x double>
        %2 = fdiv <{=N} x double> %0, %1
        ret <{=N} x double> %2

    @llvm
    def zext_double(self: Vec[u64, N]) -> Vec[u128, N]:
        %0 = zext <{=N} x i64> %self to <{=N} x i128>
        ret <{=N} x i128> %0

    @llvm
    def zext_mul(self: Vec[u64, N], other: Vec[u64, N]) -> Vec[u128, N]:
        %0 = zext <{=N} x i64> %self to <{=N} x i128>
        %1 = zext <{=N} x i64> %other to <{=N} x i128>
        %2 = mul nuw <{=N} x i128> %0, %1
        ret <{=N} x i128> %2

    @llvm
    def zext_mul(self: Vec[u64, N], other: u64) -> Vec[u128, N]:
        %0 = zext <{=N} x i64> %self to <{=N} x i128>
        %1 = insertelement <{=N} x i64> undef, i64 %other, i32 0
        %2 = shufflevector <{=N} x i64> %1, <{=N} x i64> undef, <{=N} x i32> zeroinitializer
        %3 = zext <{=N} x i64> %2 to <{=N} x i128>
        %4 = mul nuw <{=N} x i128> %0, %3
        ret <{=N} x i128> %4

    @llvm
    def trunc_half(self: Vec[u128, N]) -> Vec[u64, N]:
        %0 = trunc <{=N} x i128> %self to <{=N} x i64>
        ret <{=N} x i64> %0

    @llvm
    def shift_trunc_half(self: Vec[u128, N]) -> Vec[u64, N]:
        %0 = insertelement <{=N} x i128> undef, i128 64, i32 0
        %1 = shufflevector <{=N} x i128> %0, <{=N} x i128> undef, <{=N} x i32> zeroinitializer
        %2 = lshr <{=N} x i128> %self, %1
        %3 = trunc <{=N} x i128> %2 to <{=N} x i64>
        ret <{=N} x i64> %3

    @nocapture
    @llvm
    def mulx(self: Vec[u64, N], other: Vec[u64, N], hi: Ptr[Vec[u64, N]]) -> Vec[u64, N]:
        %0 = zext <{=N} x i64> %self to <{=N} x i128>
        %1 = zext <{=N} x i64> %other to <{=N} x i128>
        %2 = mul nuw <{=N} x i128> %0, %1
        %3 = insertelement <{=N} x i128> undef, i128 64, i32 0
        %4 = shufflevector <{=N} x i128> %3, <{=N} x i128> undef, <{=N} x i32> zeroinitializer
        %5 = lshr <{=N} x i128> %2, %4
        %6 = trunc <{=N} x i128> %5 to <{=N} x i64>
        store <{=N} x i64> %6, <{=N} x i64>* %hi, align 8
        %7 = trunc <{=N} x i128> %2 to <{=N} x i64>
        ret <{=N} x i64> %7

    @llvm
    def sub_if(self: Vec[T, N], other: Vec[T, N], mask: Vec[u1, N]) -> Vec[T, N]:
        %0 = sub <{=N} x {=T}> %self, %other
        %1 = select <{=N} x i1> %mask, <{=N} x {=T}> %0, <{=N} x {=T}> %self
        ret <{=N} x {=T}> %1

    @llvm
    def sub_if(self: Vec[T, N], other: T, mask: Vec[u1, N]) -> Vec[T, N]:
        %0 = insertelement <{=N} x {=T}> undef, {=T} %other, i32 0
        %1 = shufflevector <{=N} x {=T}> %0, <{=N} x {=T}> undef, <{=N} x i32> zeroinitializer
        %2 = sub <{=N} x {=T}> %self, %1
        %3 = select <{=N} x i1> %mask, <{=N} x {=T}> %2, <{=N} x {=T}> %self
        ret <{=N} x {=T}> %3

    def mulhi(self: Vec[u64, N], other: Vec[u64, N]) -> Vec[u64, N]:
        hi = Ptr[Vec[u64, N]](1)
        self.mulx(other, hi)
        return hi[0]

    @llvm
    def to_u64(self: Vec[float, N]) -> Vec[u64, N]:
        %0 = fptoui <{=N} x double> %self to <{=N} x i64>
        ret <{=N} x i64> %0

    @llvm
    def to_u64(self: Vec[u1, N]) -> Vec[u64, N]:
        %0 = zext <{=N} x i1> %self to <{=N} x i64>
        ret <{=N} x i64> %0

    @llvm
    def to_float(self: Vec[T, N]) -> Vec[float, N]:
        %0 = uitofp <{=N} x {=T}> %self to <{=N} x double>
        ret <{=N} x double> %0

    @llvm
    @pure
    @inline
    def mask_no_trunc(self: Vec[T, N], mask: Vec[u1, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = select <{=N} x i1> %mask, <{=N} x {=T}> %self, <{=N} x {=T}> %other
        ret <{=N} x {=T}> %0

    @llvm
    def fabs(self: Vec[float, N]) -> Vec[float, N]:
        declare <{=N} x double> @llvm.fabs.v{=N}f64(<{=N} x double>)
        %0 = call <{=N} x double> @llvm.fabs.v{=N}f64(<{=N} x double> %self)
        ret <{=N} x double> %0

    @llvm
    def bit_flip(self: Vec[u1, N]) -> Vec[u1, N]:
        %0 = insertelement <{=N} x i1> undef, i1 1, i32 0
        %1 = shufflevector <{=N} x i1> %0, <{=N} x i1> undef, <{=N} x i32> zeroinitializer
        %2 = xor <{=N} x i1> %self, %1
        ret <{=N} x i1> %2

    @llvm
    def add_overflow(self: Vec[u64, N], other: Vec[u64, N]) -> Tuple[Vec[u64, N], Vec[u1, N]]:
        declare {<{=N} x i64>, <{=N} x i1>} @llvm.uadd.with.overflow.v{=N}i64(<{=N} x i64>, <{=N} x i64>)
        %0 = call {<{=N} x i64>, <{=N} x i1>} @llvm.uadd.with.overflow.v{=N}i64(<{=N} x i64> %self, <{=N} x i64> %other)
        ret {<{=N} x i64>, <{=N} x i1>} %0

    @llvm
    def add_overflow(self: Vec[u64, N], other: u64) -> Tuple[Vec[u64, N], Vec[u1, N]]:
        declare {<{=N} x i64>, <{=N} x i1>} @llvm.uadd.with.overflow.v{=N}i64(<{=N} x i64>, <{=N} x i64>)
        %0 = insertelement <{=N} x i64> undef, i64 %other, i32 0
        %1 = shufflevector <{=N} x i64> %0, <{=N} x i64> undef, <{=N} x i32> zeroinitializer
        %2 = call {<{=N} x i64>, <{=N} x i1>} @llvm.uadd.with.overflow.v{=N}i64(<{=N} x i64> %self, <{=N} x i64> %1)
        ret {<{=N} x i64>, <{=N} x i1>} %2

    def sub_overflow_commutative(self: Vec[u64, N], other: u64) -> Tuple[Vec[u64, N], Vec[u1, N]]:
        return Vec[u64, N](other).sub_overflow(self)

    @llvm
    def sub_overflow(self: Vec[u64, N], other: Vec[u64, N]) -> Tuple[Vec[u64, N], Vec[u1, N]]:
        declare {<{=N} x i64>, <{=N} x i1>} @llvm.usub.with.overflow.v{=N}i64(<{=N} x i64>, <{=N} x i64>)
        %0 = call {<{=N} x i64>, <{=N} x i1>} @llvm.usub.with.overflow.v{=N}i64(<{=N} x i64> %self, <{=N} x i64> %other)
        ret {<{=N} x i64>, <{=N} x i1>} %0

    @llvm
    def sub_overflow(self: Vec[u64, N], other: u64) -> Tuple[Vec[u64, N], Vec[u1, N]]:
        declare {<{=N} x i64>, <{=N} x i1>} @llvm.usub.with.overflow.v{=N}i64(<{=N} x i64>, <{=N} x i64>)
        %0 = insertelement <{=N} x i64> undef, i64 %other, i32 0
        %1 = shufflevector <{=N} x i64> %0, <{=N} x i64> undef, <{=N} x i32> zeroinitializer
        %2 = call {<{=N} x i64>, <{=N} x i1>} @llvm.usub.with.overflow.v{=N}i64(<{=N} x i64> %self, <{=N} x i64> %1)
        ret {<{=N} x i64>, <{=N} x i1>} %2


@llvm
def bitcast_scatter[N: Literal[int]](ptr_in: Ptr[Vec[u64, N]]) -> Ptr[u64]:
    %0 = bitcast <{=N} x i64>* %ptr_in to i64*
    ret i64* %0


@llvm
def bitcast_vectorize[N: Literal[int]](ptr_in: Ptr[u64]) -> Ptr[Vec[u64, N]]:
    %0 = bitcast i64* %ptr_in to <{=N} x i64>*
    ret <{=N} x i64>* %0
