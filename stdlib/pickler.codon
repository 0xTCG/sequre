from internal.file import _gz_errcheck
from internal.gc import sizeof, atomic

from C import memcpy(Jar, cobj, int)
from C import perror(cobj)


def pickle[T](x: T, jar: Jar, pasteurized: bool = True):
    x.__pickle__(jar, pasteurized)

def unpickle[T](jar: Jar, pasteurized: bool = True):
    return T.__unpickle__(jar, pasteurized)

# A file's gz handle: since Codon 0.20 a File keeps it in the internal _state._fp, the only handle there is (Codon's
# own pickle.dump and load use it too)
def dump[T](x: T, f):
    x.__pickle__(f._state._fp, True)

def load[T](f) -> T:
    return T.__unpickle__(f._state._fp, True)

def _write_raw(jar: Jar, p: cobj, n: int, pasteurized: bool = True):
    if not pasteurized:
        memcpy(jar, p, n)
        return

    LIMIT = 0x7fffffff
    while n > 0:
        b = n if n < LIMIT else LIMIT
        status = int(_C.gzwrite(jar, p, u32(b)))
        if status != b:
            _gz_errcheck(jar)
            perror("pickle write error".c_str())
            raise IOError("pickle error: gzwrite returned " + str(status))
        p += b
        n -= b

def _read_raw(jar: Jar, p: cobj, n: int, pasteurized: bool = True):
    if not pasteurized:
        memcpy(p, jar, n)
        return
    
    LIMIT = 0x7fffffff
    while n > 0:
        b = n if n < LIMIT else LIMIT
        status = int(_C.gzread(jar, p, u32(b)))
        if status != b:
            _gz_errcheck(jar)
            perror("pickle read error".c_str())
            raise IOError("pickle error: gzread returned " + str(status))
        p += b
        n -= b

def _write[T](jar: Jar, x: T, pasteurized: bool = True):
    y = __ptr__(x)
    _write_raw(jar, y.as_byte(), sizeof(T), pasteurized)

def _read[T](jar: Jar, pasteurized: bool = True):
    x = T()
    y = __ptr__(x)
    _read_raw(jar, y.as_byte(), sizeof(T), pasteurized)
    return x

# Extend core types to allow pickling

# int is Int[64] and byte is UInt[8] since Codon 0.20, so these cover them (8 and 1 bytes, as before).
# Int[N]/UInt[N] pickle the exact (N+7)//8 bytes (matching nbytes()/
# _pickle_size()) instead of going through _write/_read's sizeof(T), which is
# the LLVM-ABI-padded allocation size and can exceed nbytes() for non-power-
# -of-2 widths (e.g. sizeof(UInt[174]) is 32 bytes vs nbytes() of 22). Buffers
# for pasteurized=False pickling (e.g. MPC party-to-party sends in
# sequre/mpc/comms.codon) are sized via _pickle_size(), so writing sizeof(T)
# bytes there overflows the buffer.
@extend
class Int:
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        _write_raw(jar, __ptr__(self).as_byte(), Int[N].nbytes(), pasteurized)

    def __unpickle__(jar: Jar, pasteurized: bool = True) -> Int[N]:
        x = Int[N](0)
        _read_raw(jar, __ptr__(x).as_byte(), Int[N].nbytes(), pasteurized)
        return x
    
    def _pickle_size(self) -> int:
        return Int[N].nbytes()

@extend
class UInt:
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        _write_raw(jar, __ptr__(self).as_byte(), UInt[N].nbytes(), pasteurized)

    def __unpickle__(jar: Jar, pasteurized: bool = True) -> UInt[N]:
        x = UInt[N](0)
        _read_raw(jar, __ptr__(x).as_byte(), UInt[N].nbytes(), pasteurized)
        return x

    def _pickle_size(self) -> int:
        return UInt[N].nbytes()

@extend
class float:
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        _write(jar, self, pasteurized)

    def __unpickle__(jar: Jar, pasteurized: bool = True):
        return _read(jar, pasteurized, float)

    def _pickle_size(self) -> int:
        return sizeof(float)

@extend
class bool:
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        _write(jar, self, pasteurized)

    def __unpickle__(jar: Jar, pasteurized: bool = True):
        return _read(jar, pasteurized, bool)

    def _pickle_size(self) -> int:
        return sizeof(bool)

@extend
class str:
    # A str is its meta word (length and kind: ASCII, Latin-1, UCS-2 or UCS-4) and its code units (1, 2 or 4 bytes
    # each), so any text round-trips; nbytes() (types/builtin.codon) is the code units' size
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        _write(jar, self._meta, pasteurized)
        if not pasteurized: jar += sizeof(int)
        _write_raw(jar, self._ptr, len(self) * self._width(), pasteurized)

    def __unpickle__(jar: Jar, pasteurized: bool = True):
        meta = _read(jar, pasteurized, int)
        if not pasteurized: jar += sizeof(int)
        shape = str(Ptr[u8](), meta)  # no data: reads the length and the kind's width from meta
        n = len(shape) * shape._width()
        p = Ptr[u8](n)
        _read_raw(jar, p, n, pasteurized)
        return str(p, meta)

    def _pickle_size(self) -> int:
        return sizeof(int) + len(self) * self._width()

@extend
class List:
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        n = len(self)
        pickle(n, jar, pasteurized)
        if not pasteurized: jar += sizeof(int)
        for i in range(n):
            pickle(self._ptr[i], jar, pasteurized)
            if not pasteurized:
                jar += self._ptr[i]._pickle_size()

    def __unpickle__(jar: Jar, pasteurized: bool = True):
        n = unpickle(jar, pasteurized, int)
        if not pasteurized: jar += sizeof(int)
        arr = Ptr[T](n)
        for i in range(n):
            arr[i] = unpickle(jar, pasteurized, T)
            if not pasteurized:
                jar += arr[i]._pickle_size()
        return List[T](arr, n)
    
    def _pickle_size(self) -> int:
        n = len(self)
        total = sizeof(int)
        for i in range(n):
            total += self._ptr[i]._pickle_size()
        return total

@extend
class Dict:
    # Item by item, in iteration order: Codon 0.20's Dict is ordered (its entries hold the insertion order and the
    # deleted slots), and unpickling inserts the items in the order they were written, so the order survives. The same
    # code serves the khash Dict of --unordered-dict.
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        if not pasteurized:
            raise NotImplementedError("pickling Dict in non-pasteurized mode is not implemented yet")

        pickle(len(self), jar, pasteurized)
        for k, v in self.items():
            pickle(k, jar, pasteurized)
            pickle(v, jar, pasteurized)

    def __unpickle__(jar: Jar, pasteurized: bool = True):
        if not pasteurized:
            raise NotImplementedError("unpickling Dict in non-pasteurized mode is not implemented yet")

        size = unpickle(jar, pasteurized, int)
        d = Dict[K, V](capacity=size)
        i = 0
        while i < size:
            k = unpickle(jar, pasteurized, K)
            v = unpickle(jar, pasteurized, V)
            d[k] = v
            i += 1
        return d

    def _pickle_size(self) -> int:
        raise NotImplementedError("Dict._pickle_size is not implemented yet")

@extend
class Set:
    def __pickle__(self, jar: Jar, pasteurized: bool = True):
        import internal.khash as khash
        if atomic(K):
            pickle(self._n_buckets, jar, pasteurized)
            if not pasteurized: jar += sizeof(int)
            pickle(self._size, jar, pasteurized)
            if not pasteurized: jar += sizeof(int)
            pickle(self._n_occupied, jar, pasteurized)
            if not pasteurized: jar += sizeof(int)
            pickle(self._upper_bound, jar, pasteurized)
            if not pasteurized: jar += sizeof(int)
            fsize = khash.__ac_fsize(self._n_buckets) if self._n_buckets > 0 else 0
            _write_raw(jar, self._flags.as_byte(), fsize * sizeof(u32), pasteurized)
            if not pasteurized: jar += fsize * sizeof(u32)
            _write_raw(jar, self._keys.as_byte(), self._n_buckets * sizeof(K), pasteurized)
            if not pasteurized: jar += self._n_buckets * sizeof(K)
        else:
            pickle(self._n_buckets, jar, pasteurized)
            if not pasteurized: jar += sizeof(int)
            size = len(self)
            pickle(size, jar, pasteurized)
            if not pasteurized: jar += sizeof(int)

            # Each element takes its own _pickle_size() bytes (a str or a list: not sizeof(K)), as in List
            for k in self:
                pickle(k, jar, pasteurized)
                if not pasteurized: jar += k._pickle_size()

    def __unpickle__(jar: Jar, pasteurized: bool = True):
        import internal.khash as khash
        s = Set[K]()
        if atomic(K):
            n_buckets = unpickle(jar, pasteurized, int)
            if not pasteurized: jar += sizeof(int)
            size = unpickle(jar, pasteurized, int)
            if not pasteurized: jar += sizeof(int)
            n_occupied = unpickle(jar, pasteurized, int)
            if not pasteurized: jar += sizeof(int)
            upper_bound = unpickle(jar, pasteurized, int)
            if not pasteurized: jar += sizeof(int)
            fsize = khash.__ac_fsize(n_buckets) if n_buckets > 0 else 0
            flags = Ptr[u32](fsize)
            keys = Ptr[K](n_buckets)
            _read_raw(jar, flags.as_byte(), fsize * sizeof(u32), pasteurized)
            if not pasteurized: jar += fsize * sizeof(u32)
            _read_raw(jar, keys.as_byte(), n_buckets * sizeof(K), pasteurized)
            if not pasteurized: jar += n_buckets * sizeof(K)

            s._n_buckets = n_buckets
            s._size = size
            s._n_occupied = n_occupied
            s._upper_bound = upper_bound
            s._flags = flags
            s._keys = keys
        else:
            n_buckets = unpickle(jar, pasteurized, int)
            if not pasteurized: jar += sizeof(int)
            size = unpickle(jar, pasteurized, int)
            if not pasteurized: jar += sizeof(int)
            s.resize(n_buckets)
            i = 0
            while i < size:
                k = unpickle(jar, pasteurized, K)
                if not pasteurized: jar += k._pickle_size()
                s.add(k)
                i += 1
        return s

    def _pickle_size(self) -> int:
        import internal.khash as khash
        if atomic(K):
            fsize = khash.__ac_fsize(self._n_buckets) if self._n_buckets > 0 else 0
            return 4 * sizeof(int) + fsize * sizeof(u32) + self._n_buckets * sizeof(K)
        else:
            total = 2 * sizeof(int)
            for k in self:
                total += k._pickle_size()
            return total
    