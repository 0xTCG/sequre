from sequre.constants import (
    SHUT_RDWR, AF_INET, OPENSSL_PATH, LIBCRYPTO_PATH,
    CERT_DIR, CA_CERT_FILE, PARTY_CERT_FILE, PARTY_KEY_FILE,
    PARTY_CERT_NAME, ENV_PARTY_CERT_NAME)
from sequre.types.utils import core_type_size

# C declarations at the C types' real widths: a C int is an i32, while ssize_t, size_t and long are 64 bits (int) and
# unsigned long is a u64. An int return declared as a 64-bit int reads -1 as 4294967295 whenever the callee leaves the
# upper half of the register zero, as OpenSSL and glibc's accept, connect and close do (measured), so every failure
# would read as success.
from C import listen(i32, i32) -> i32
from C import accept(i32, cobj, cobj) -> i32
from C import shutdown(i32, i32) -> i32
from C import perror(cobj)
from C import recv(i32, cobj, int, i32) -> int
from C import send(i32, cobj, int, i32) -> int
from C import close(i32) -> i32
from C import getpeername(i32, cobj, Ptr[u32]) -> i32
from C import strerror(i32) -> cobj
from C import memcpy(cobj, cobj, int)
# The handler argument and the result are function pointers; they are passed as 64-bit integers (same registers
# in the x86-64 and arm64 calling conventions), so that SIG_IGN and SIG_ERR can be written as numbers.
from C import signal(i32, int) -> int

# OpenSSL TLS imports (libssl; all of them exist in OpenSSL 1.1 and 3)
from C import OPENSSL_PATH.OPENSSL_init_ssl(u64, cobj) -> i32 as OPENSSL_init_ssl
from C import OPENSSL_PATH.TLS_server_method() -> cobj as TLS_server_method
from C import OPENSSL_PATH.TLS_client_method() -> cobj as TLS_client_method
from C import OPENSSL_PATH.SSL_CTX_new(cobj) -> cobj as SSL_CTX_new
from C import OPENSSL_PATH.SSL_CTX_free(cobj) as SSL_CTX_free
from C import OPENSSL_PATH.SSL_CTX_use_certificate_file(cobj, cobj, i32) -> i32 as SSL_CTX_use_certificate_file
from C import OPENSSL_PATH.SSL_CTX_use_PrivateKey_file(cobj, cobj, i32) -> i32 as SSL_CTX_use_PrivateKey_file
from C import OPENSSL_PATH.SSL_CTX_load_verify_locations(cobj, cobj, cobj) -> i32 as SSL_CTX_load_verify_locations
from C import OPENSSL_PATH.SSL_CTX_set_verify(cobj, i32, cobj) as SSL_CTX_set_verify
from C import OPENSSL_PATH.SSL_new(cobj) -> cobj as SSL_new
from C import OPENSSL_PATH.SSL_free(cobj) as SSL_free
from C import OPENSSL_PATH.SSL_set_fd(cobj, i32) -> i32 as SSL_set_fd
from C import OPENSSL_PATH.SSL_set1_host(cobj, cobj) -> i32 as SSL_set1_host
from C import OPENSSL_PATH.SSL_set_hostflags(cobj, u32) as SSL_set_hostflags
from C import OPENSSL_PATH.SSL_accept(cobj) -> i32 as SSL_accept_handshake
from C import OPENSSL_PATH.SSL_connect(cobj) -> i32 as SSL_connect_handshake
from C import OPENSSL_PATH.SSL_write(cobj, cobj, i32) -> i32 as SSL_write
from C import OPENSSL_PATH.SSL_read(cobj, cobj, i32) -> i32 as SSL_read
from C import OPENSSL_PATH.SSL_shutdown(cobj) -> i32 as SSL_shutdown
from C import OPENSSL_PATH.SSL_get_error(cobj, i32) -> i32 as SSL_get_error
from C import OPENSSL_PATH.SSL_get_verify_result(cobj) -> int as SSL_get_verify_result  # returns a long

# OpenSSL crypto imports (libcrypto)
from C import LIBCRYPTO_PATH.RAND_bytes(cobj, i32) -> i32 as RAND_bytes
from C import LIBCRYPTO_PATH.ERR_get_error() -> u64 as ERR_get_error
from C import LIBCRYPTO_PATH.ERR_clear_error() as ERR_clear_error
from C import LIBCRYPTO_PATH.ERR_error_string_n(u64, cobj, int) as ERR_error_string_n
from C import LIBCRYPTO_PATH.X509_verify_cert_error_string(int) -> cobj as X509_verify_cert_error_string

# OpenSSL constants
SSL_FILETYPE_PEM = 1
SSL_VERIFY_PEER = 1
SSL_VERIFY_FAIL_IF_NO_PEER_CERT = 2
OPENSSL_INIT_SSL_DEFAULT = u64(0x00200002)  # OPENSSL_INIT_LOAD_SSL_STRINGS | OPENSSL_INIT_LOAD_CRYPTO_STRINGS
X509_CHECK_FLAG_NO_WILDCARDS = u32(0x2)
X509_V_OK = 0
X509_V_ERR_HOSTNAME_MISMATCH = 62
SSL_ERROR_SSL = 1
SSL_ERROR_WANT_READ = 2
SSL_ERROR_WANT_WRITE = 3
SSL_ERROR_SYSCALL = 5
SSL_ERROR_ZERO_RETURN = 6
# SSL_read and SSL_write take an int length, so a message of 2 GiB or more goes in chunks (send and recv take a size_t)
TLS_IO_CHUNK = 1 << 30
# The byte a TLS server sends once it has accepted a client's certificate (tls_handshake)
TLS_HANDSHAKE_CONFIRMATION = byte(1)

# signal() constants (same values on Linux and macOS)
_SIGPIPE = i32(13)
_SIG_IGN = 1
_SIG_ERR = -1
# errno values (same on Linux and macOS)
_EINTR = 4

_ssl_initialized = False


def errno() -> int:
    if __apple__:
        from C import __error() -> Ptr[i32]
        return int(__error()[0])
    else:
        from C import __errno_location() -> Ptr[i32]
        return int(__errno_location()[0])


def errno_text(err_no: int) -> str:
    return f'{str.from_ptr(strerror(i32(err_no)))} (errno {err_no})'


def ignore_sigpipe():
    # By default, writing to a connection whose peer has closed kills the process with SIGPIPE, silently and before any
    # error handling runs (the party just exits with status 141). With SIGPIPE ignored, send/SSL_write fail with EPIPE
    # instead and snd_jar raises, as for any other broken connection. The setting is process-wide (there is no portable
    # per-socket option), so a write to a closed stdout pipe also fails with EPIPE instead of killing the process.
    if signal(_SIGPIPE, _SIG_IGN) == _SIG_ERR:
        perror('Could not ignore SIGPIPE'.c_str())


def init_openssl():
    global _ssl_initialized
    if not _ssl_initialized:
        if int(OPENSSL_init_ssl(OPENSSL_INIT_SSL_DEFAULT, cobj())) != 1:
            raise ValueError(f'OpenSSL could not be initialized [{ssl_error_queue()}]')
        _ssl_initialized = True


def _is_dns_name(name: str) -> bool:
    # Letters, digits, "-" and ".", starting and ending with a letter or digit (as scripts/generate_certs.sh requires)
    if not name:
        return False
    for i in range(len(name)):
        c = name[i]
        if not (('a' <= c <= 'z') or ('A' <= c <= 'Z') or ('0' <= c <= '9')
                or ((c == '.' or c == '-') and 0 < i < len(name) - 1)):
            return False
    return True


def party_cert_name(pid: int) -> str:
    # The name party pid's certificate must carry, as a subjectAltName DNS entry or, in a certificate without any, as
    # its subject CN: SEQURE_PARTY_CERT_NAME with "{pid}" replaced by pid (default "cp{pid}", the names
    # scripts/generate_certs.sh writes). It must be a plain DNS name: OpenSSL would read a leading "." as "any
    # subdomain of" and match wildcards that the handshake does not allow anyway.
    if "{pid}" not in PARTY_CERT_NAME:
        raise ValueError(
            f'{ENV_PARTY_CERT_NAME} ("{PARTY_CERT_NAME}") must contain ' + '{pid}' +
            ': each party needs a certificate name of its own, or any party could pose as any other')
    name = PARTY_CERT_NAME.replace("{pid}", str(pid))
    if not _is_dns_name(name):
        raise ValueError(
            f'{ENV_PARTY_CERT_NAME} ("{PARTY_CERT_NAME}") names CP{pid} "{name}", which is not a DNS name (letters, '
            f'digits, "-" and ".", starting and ending with a letter or digit)')
    return name


def ssl_error_queue() -> str:
    # OpenSSL's queued error messages, oldest first, joined with "; " ("" if none). Empties the queue.
    messages = List[str]()
    buf = Ptr[byte](256)
    while True:
        e = ERR_get_error()
        if e == u64(0):
            break
        ERR_error_string_n(e, buf.as_byte(), 256)
        messages.append(str.from_ptr(buf))
    return "; ".join(messages)


def ssl_failure_text(ssl: cobj, rc: int, err_no: int) -> str:
    # Why the SSL_* call that just returned rc on ssl failed: OpenSSL's error class, its queued messages (the queue is
    # emptied) and, for a failed system call, errno (read right after the call, passed in as err_no)
    err = int(SSL_get_error(ssl, i32(rc)))
    queue = ssl_error_queue()
    if err == SSL_ERROR_ZERO_RETURN:
        what = 'the peer closed the TLS connection'
    elif err == SSL_ERROR_SYSCALL:
        what = f'system call failed: {errno_text(err_no)}' if err_no != 0 else 'the connection closed unexpectedly'
    elif err == SSL_ERROR_SSL:
        what = 'TLS protocol error'
    else:
        what = f'SSL_get_error {err}'
    return f'{what}; OpenSSL: {queue}' if queue else what


def create_ssl_context(pid: int, is_server: bool) -> cobj:
    init_openssl()

    method = TLS_server_method() if is_server else TLS_client_method()
    ctx = SSL_CTX_new(method)
    if not ctx:
        raise ValueError(f'Failed to create SSL context [{ssl_error_queue()}]')

    cert_file = PARTY_CERT_FILE.replace("{pid}", str(pid))
    key_file = PARTY_KEY_FILE.replace("{pid}", str(pid))
    ca_path = CERT_DIR + "/" + CA_CERT_FILE
    cert_path = CERT_DIR + "/" + cert_file
    key_path = CERT_DIR + "/" + key_file

    if int(SSL_CTX_load_verify_locations(ctx, ca_path.c_str(), cobj())) != 1:
        SSL_CTX_free(ctx)
        raise ValueError(f'Failed to load CA certificate from {ca_path} [{ssl_error_queue()}]')

    if int(SSL_CTX_use_certificate_file(ctx, cert_path.c_str(), i32(SSL_FILETYPE_PEM))) != 1:
        SSL_CTX_free(ctx)
        raise ValueError(f'Failed to load party certificate from {cert_path} [{ssl_error_queue()}]')

    if int(SSL_CTX_use_PrivateKey_file(ctx, key_path.c_str(), i32(SSL_FILETYPE_PEM))) != 1:
        SSL_CTX_free(ctx)
        raise ValueError(f'Failed to load party key from {key_path} [{ssl_error_queue()}]')

    # Mutual TLS: each side requires the other's certificate, from the CA. Which party it must name is set per
    # connection (tls_handshake).
    SSL_CTX_set_verify(ctx, i32(SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT), cobj())

    return ctx


def _handshake_failure_text(ssl: cobj, rc: int, err_no: int, peer: str, peer_name: str) -> str:
    # Why a handshake failed: a certificate this side rejected (OpenSSL's verification result: wrong CA, wrong name,
    # expired, ...), or OpenSSL's error (an alert means the other side rejected this side)
    verify_result = SSL_get_verify_result(ssl)
    failure = ssl_failure_text(ssl, rc, err_no)
    if verify_result != X509_V_OK:
        reason = str.from_ptr(X509_verify_cert_error_string(verify_result))
        expected = f'from the CA in {CERT_DIR}/{CA_CERT_FILE}'
        if peer_name:
            expected += f' that names "{peer_name}"'
            if verify_result == X509_V_ERR_HOSTNAME_MISMATCH:
                expected += f' ({ENV_PARTY_CERT_NAME} sets the names the parties expect)'
        return f"{peer}'s certificate was rejected: {reason}; expected a certificate {expected} [{failure}]"
    if 'alert' in failure:
        return f"{peer} rejected the handshake (with an alert, as for a certificate it does not accept) [{failure}]"
    return failure


def tls_handshake(ctx: cobj, sock_fd: int, is_server: bool, peer_name: str = '', peer: str = 'the peer',
                  context: str = 'TLS handshake') -> cobj:
    # Runs the TLS handshake on the connected socket sock_fd and returns the session. Both sides present a certificate
    # from the CA (create_ssl_context) and verify the other's. With a peer_name, the peer's certificate must also name
    # it (a subjectAltName DNS entry or, in a certificate without any, the subject CN; no wildcards): OpenSSL checks it
    # on both sides, the server's check of the client's certificate included. Any failure raises a ValueError
    # starting with context (who connects to whom), naming peer and the reason.
    ssl = SSL_new(ctx)
    if not ssl:
        raise ValueError(f'{context} failed: could not create a TLS session [{ssl_error_queue()}]')
    if int(SSL_set_fd(ssl, i32(sock_fd))) != 1:
        message = f'{context} failed: could not attach the socket to the TLS session [{ssl_error_queue()}]'
        SSL_free(ssl)
        raise ValueError(message)
    if peer_name:
        SSL_set_hostflags(ssl, X509_CHECK_FLAG_NO_WILDCARDS)
        if int(SSL_set1_host(ssl, peer_name.c_str())) != 1:
            message = f'{context} failed: could not set the expected name "{peer_name}" [{ssl_error_queue()}]'
            SSL_free(ssl)
            raise ValueError(message)

    ERR_clear_error()  # SSL_get_error reads the thread's whole error queue: it must start empty
    rc = int(SSL_accept_handshake(ssl)) if is_server else int(SSL_connect_handshake(ssl))
    if rc != 1:
        err_no = errno()
        message = f'{context} failed: {_handshake_failure_text(ssl, rc, err_no, peer, peer_name)}'
        SSL_free(ssl)
        raise ValueError(message)

    # In TLS 1.3 the client's handshake completes before the server has checked the client's certificate, so a client
    # the server rejects would learn it only at its first read, possibly much later (after setting up its other
    # channels). The server confirms with one byte once it has accepted the client, and the client waits for it.
    buf = Ptr[byte](1)
    buf[0] = TLS_HANDSHAKE_CONFIRMATION
    if is_server:
        rc = _tls_io(ssl, buf, 1, True)
        if rc != 1:
            err_no = errno()
            message = f'{context} failed: could not confirm the handshake [{ssl_failure_text(ssl, rc, err_no)}]'
            SSL_free(ssl)
            raise ValueError(message)
    else:
        buf[0] = byte(0)
        rc = _tls_io(ssl, buf, 1, False)
        if rc != 1 or buf[0] != TLS_HANDSHAKE_CONFIRMATION:
            err_no = errno()
            reason = ssl_failure_text(ssl, rc, err_no) if rc <= 0 else f'unexpected byte {int(buf[0])}'
            message = (f'{context} failed: {peer} did not confirm the handshake, so it rejected this party '
                       f'(e.g. its certificate) [{reason}]')
            SSL_free(ssl)
            raise ValueError(message)
    return ssl


def ssl_wrap_accept(ctx: cobj, sock_fd: int, peer_name: str = '') -> cobj:
    return tls_handshake(ctx, sock_fd, True, peer_name)


def ssl_wrap_connect(ctx: cobj, sock_fd: int, peer_name: str = '') -> cobj:
    return tls_handshake(ctx, sock_fd, False, peer_name)


def close_socket(sock_fd: int, ssl: cobj = cobj()):
    if ssl:
        SSL_shutdown(ssl)
        SSL_free(ssl)
    if sock_fd >= 0:
        shutdown(i32(sock_fd), i32(SHUT_RDWR))
        close(i32(sock_fd))


def listen_socket(sock_fd):
    if int(listen(i32(sock_fd), i32(3))) != 0:
        perror(f'Server not listening'.c_str())
        raise ValueError('Server not listening.')


def accept_socket(sock_fd):
    while True:
        accepted_fd = int(accept(i32(sock_fd), cobj(), cobj()))
        if accepted_fd >= 0:
            break
        if errno() != _EINTR:
            perror(f'Socket could not accept connection'.c_str())
            raise ValueError('Socket could not accept connection.')

    close_socket(sock_fd)
    return accepted_fd


def peer_address(sock_fd: int) -> str:
    # "a.b.c.d:port" of the other end of a connected IPv4 socket ("" for another family, or if getpeername fails).
    # sockaddr_in: the family (a u16 on Linux; on macOS a length byte, then the family byte), the port (big-endian) at
    # offset 2 and the address at 4.
    addr = Ptr[byte](128)
    length = u32(128)
    if int(getpeername(i32(sock_fd), addr.as_byte(), __ptr__(length))) != 0 or int(length) < 8:
        return ''
    family = int(addr[1]) if __apple__ else int(addr[0]) | (int(addr[1]) << 8)
    if family != AF_INET:
        return ''
    port = (int(addr[2]) << 8) | int(addr[3])
    return f'{int(addr[4])}.{int(addr[5])}.{int(addr[6])}.{int(addr[7])}:{port}'


def _tls_io(ssl: cobj, buf: Ptr[byte], n: int, write: bool) -> int:
    # One SSL_write (or SSL_read) of at most n bytes, retried while OpenSSL asks for a retry (a signal interrupted the
    # system call). Returns its result: the byte count, or <= 0 on failure. The error queue is emptied before each call,
    # since SSL_get_error would report any error queued earlier in the thread as this call's.
    while True:
        ERR_clear_error()
        rc = int(SSL_write(ssl, buf.as_byte(), i32(n))) if write else int(SSL_read(ssl, buf.as_byte(), i32(n)))
        if rc > 0:
            return rc
        err = int(SSL_get_error(ssl, i32(rc)))
        if err != SSL_ERROR_WANT_READ and err != SSL_ERROR_WANT_WRITE:
            return rc


def snd_jar(sock_fd, jar: Jar, msg_len: int, ssl: cobj = cobj()) -> int:
    totalsent = 0

    while totalsent < msg_len:
        n = min(msg_len - totalsent, TLS_IO_CHUNK)
        if ssl:
            sent = _tls_io(ssl, jar + totalsent, n, True)
            if sent <= 0:
                err_no = errno()
                raise ValueError(
                    f'TLS connection broken: sent {totalsent} of {msg_len} bytes '
                    f'[{ssl_failure_text(ssl, sent, err_no)}]')
        else:
            sent = send(i32(sock_fd), (jar + totalsent).as_byte(), n, i32(0))
            if sent < 0:
                err_no = errno()
                if err_no == _EINTR:
                    continue
                raise ValueError(
                    f'Socket connection broken: sent {totalsent} of {msg_len} bytes [{errno_text(err_no)}]')
            if sent == 0:
                raise ValueError(f'Socket connection broken: sent {totalsent} of {msg_len} bytes [send sent nothing]')
        totalsent += sent

    return totalsent


def receive_jar(sock_fd, msg_len: int, ssl: cobj = cobj()) -> Jar:
    bytes_recd = 0
    buffer = Ptr[byte](msg_len)

    while bytes_recd < msg_len:
        n = min(msg_len - bytes_recd, TLS_IO_CHUNK)
        if ssl:
            received = _tls_io(ssl, buffer + bytes_recd, n, False)
            if received <= 0:
                err_no = errno()
                raise ValueError(
                    f'TLS connection broken: received {bytes_recd} of {msg_len} bytes '
                    f'[{ssl_failure_text(ssl, received, err_no)}]')
        else:
            received = recv(i32(sock_fd), (buffer + bytes_recd).as_byte(), n, i32(0))
            if received < 0:
                err_no = errno()
                if err_no == _EINTR:
                    continue
                raise ValueError(
                    f'Socket connection broken: received {bytes_recd} of {msg_len} bytes [{errno_text(err_no)}]')
            if received == 0:
                raise ValueError(
                    f'Socket connection broken: received {bytes_recd} of {msg_len} bytes [the peer closed the '
                    f'connection]')
        bytes_recd += received

    return buffer


def generate_random_bytes(n: int) -> Ptr[byte]:
    buf = Ptr[byte](n)
    if int(RAND_bytes(buf.as_byte(), i32(n))) != 1:
        raise ValueError(f'Failed to generate random bytes via RAND_bytes [{ssl_error_queue()}]')
    return buf


# Wrappers
def send_to_socket(socket, data):
    fs = core_type_size(data)
    msg_len = data.size() * fs
    buffer = Ptr[byte](msg_len)

    # TODO: Avoid memcpy by accessing ptr within data directly
    for i, value in enumerate(data.iter()):
        p = Ptr[byte](__ptr__(value).as_byte())
        memcpy(buffer + i * fs, p, fs)

    return snd_jar(socket.sock_fd, buffer, msg_len, socket.ssl)
