import time

from C import GC_start_mark_threads() as _gc_start_mark_threads

from stats import MPCStats
from randomness import MPCRandomness
from comms import MPCComms
from arithmetic import MPCArithmetic
from polynomial import MPCPolynomial
from bitwise import MPCBitwise
from boolean import MPCBoolean
from fp import MPCFP
from mhe import MPCMHE
from sequre.utils.blas import init_blas_threads
from sequre.settings import DEBUG
from sequre.constants import (
    MPC_INT_SIZE, MPC_MODULUS_BITS, MPC_NBIT_K, MPC_NBIT_F, MPC_NBIT_V, MPC_FIELD_SIZE, MPC_RING_SIZE,
    NUMBER_OF_PARTIES, RUN_TOGGLES, modulus_name)


# The settings every party must share, exchanged at start (MPCEnv's constructor, before any protocol message): a marker,
# the layout's version, then the values. A party whose list differs stops the run.
_SETTINGS_MARKER: int = 0x5345515552455354  # "SEQUREST"
_SETTINGS_FORMAT: int = 1


def _settings[TP](modulus: TP) -> List[int]:
    # [marker, format, MPC_INT_SIZE, the modulus as (kind, bits, offset), K, F, V, parties, DEBUG]. The modulus: kind 0
    # the field 2^bits - offset, kind 1 the ring 2^bits, kind 2 another (bits 0, offset its low 62 bits).
    if modulus == MPC_FIELD_SIZE:
        kind, bits, offset = 0, MPC_MODULUS_BITS, int(MPC_RING_SIZE - MPC_FIELD_SIZE)
    elif modulus == MPC_RING_SIZE:
        kind, bits, offset = 1, MPC_MODULUS_BITS, 0
    else:
        kind, bits, offset = 2, 0, int(modulus & ((TP(1) << TP(62)) - TP(1)))
    return [_SETTINGS_MARKER, _SETTINGS_FORMAT, MPC_INT_SIZE, kind, bits, offset, MPC_NBIT_K, MPC_NBIT_F, MPC_NBIT_V,
            NUMBER_OF_PARTIES, int(DEBUG)]


def _settings_modulus_name(settings: List[int]) -> str:
    kind, bits, offset = settings[3], settings[4], settings[5]
    if kind == 0:
        return f"the field 2^{bits} - {offset}"
    if kind == 1:
        return f"the ring 2^{bits}"
    return f"another modulus (its low bits {offset})"


def _settings_difference(pid: int, mine: List[int], p: int, theirs: List[int]) -> str:
    # What differs between this party's settings and CP{p}'s, and what to do about it. The modulus' bits and offset and
    # V follow from the share width: another width is reported alone, with the moduli when their kinds differ too.
    if len(theirs) != len(mine) or theirs[0] != _SETTINGS_MARKER or theirs[1] != _SETTINGS_FORMAT:
        return (f"CP{p} sent settings of another layout: it runs another version of Sequre (every party must run the "
                f"same version)")
    found = List[str]()
    same_width = theirs[2] == mine[2]
    if not same_width:
        found.append(f"CP{pid} has {mine[2]}-bit shares, CP{p} {theirs[2]}-bit ones: build every party's program "
                     f"with the same MPC_INT_SIZE")
    if theirs[3] != mine[3] or (same_width and theirs[4:6] != mine[4:6]):
        if theirs[3] != mine[3] and theirs[3] < 2 and mine[3] < 2:
            remedy = (f"start every party with the same modulus flag ({RUN_TOGGLES.USE_FIELD_FLAG} at every party or "
                      f"at none), from programs built with the same Sequre (an older build may run on the field "
                      f"without a flag)")
        else:
            remedy = "start every party on the same modulus, from programs built with the same Sequre"
        found.append(f"CP{pid} runs on {_settings_modulus_name(mine)}, CP{p} on {_settings_modulus_name(theirs)}: "
                     f"{remedy}")
    if same_width and theirs[6:9] != mine[6:9]:
        found.append(f"CP{pid} has fixed point K={mine[6]} F={mine[7]} V={mine[8]}, CP{p} K={theirs[6]} F={theirs[7]} "
                     f"V={theirs[8]}: build every party's program with the same Sequre settings")
    if theirs[9] != mine[9]:
        found.append(f"CP{pid} expects {mine[9]} parties, CP{p} {theirs[9]}: give every party the same SEQURE_CP_IPS "
                     f"(or SEQURE_CP_COUNT)")
    if theirs[10] != mine[10]:
        here = "on" if mine[10] else "off"
        there = "on" if theirs[10] else "off"
        found.append(f"DEBUG is {here} at CP{pid} and {there} at CP{p}: build every party's program with the same "
                     f"DEBUG setting")
    return "; ".join(found)


class MPCEnv[TP]:
    # Defaults
    default_mpc_modulus: TP
    default_ciphertensor_encoding: str
    
    # Party ID
    pid: int
    
    # Libs
    stats: MPCStats
    randomness: MPCRandomness
    comms: MPCComms[TP]
    arithmetic: MPCArithmetic[TP]
    polynomial: MPCPolynomial[TP]
    bitwise: MPCBitwise[TP]
    boolean: MPCBoolean[TP]
    fp: MPCFP[TP]
    mhe: MPCMHE[TP]

    # Other params
    local: bool
    default_allow_mpc_switch: bool
    # Whether a matrix product may give a diagonal-encoded result (the TNT kernel's, for a column-wise first factor). MP
    # operations clear it around per-partition products by a plaintext operand, which MPPAligner cuts back by rows, as
    # diagonal storage cannot be (H-60); products of two ciphertext operands set it and convert TNT's result through MPC.
    default_allow_diagonal_results: bool

    def __init__(
            self: MPCEnv[TP], pid: int,
            local: bool, default_mpc_modulus: TP,
            expect_data_sharing: bool = False,
            default_ciphertensor_encoding: str = ""):
        # Every party collects with parallel marking, whatever started it (a forked local party, a distributed one,
        # a program building its own MPCEnv). A process starts without the collector's (bdwgc) marker threads since
        # Codon 0.20 (Codon 0.19 started them at initialization), and a forked party has lost the ones it had (fork()
        # copies only the calling thread): without them every full collection runs on one thread, about 10x slower. A
        # no-op where they run.
        _gc_start_mark_threads()
        # OpenBLAS's threads (float products of plain arrays): NUM_THREADS per party, not one per core in each party
        # (sequre/utils/blas.codon)
        init_blas_threads()

        # Defaults and params
        self.default_mpc_modulus = default_mpc_modulus
        self.default_ciphertensor_encoding = default_ciphertensor_encoding
        self.default_allow_mpc_switch = False
        self.default_allow_diagonal_results = True
        self.pid = pid
        self.local = local

        # Stats
        self.stats = MPCStats(self.pid)

        # PRGs & Network
        self.randomness = MPCRandomness(self.stats)
        self.comms = MPCComms[TP](
            self.randomness,
            self.local,
            expect_data_sharing)
        # Before any protocol message: every party runs on the same modulus and settings, or every party stops
        self.__check_settings()
        
        # MPC
        self.arithmetic = MPCArithmetic[TP](self.comms)
        self.polynomial = MPCPolynomial[TP](self.arithmetic)
        self.bitwise = MPCBitwise[TP](self.arithmetic)
        self.boolean = MPCBoolean[TP](self.polynomial, self.bitwise)
        self.fp = MPCFP[TP](self.boolean)
        
        # HE
        self.mhe = MPCMHE(comms=self.comms)
        
        print(f'CP{self.pid}:\tMPC initialized on {modulus_name(default_mpc_modulus)}')

    def __check_settings(self):
        # The parties exchange their settings (_settings) once, and each compares every other party's with its own. All
        # parties hold every list, so when they differ every party finds a difference and stops, naming its values and
        # the other party's. The exchange is not counted in the statistics.
        mine = _settings(self.default_mpc_modulus)
        everyone = self.comms.exchange_settings(mine)
        self.comms.reset_stats()
        problems = List[str]()
        for p in range(len(everyone)):
            if p != self.pid and everyone[p] != mine:
                problems.append(_settings_difference(self.pid, mine, p, everyone[p]))
        if problems:
            raise ValueError(f"CP{self.pid}: the parties' MPC settings differ: " + "; ".join(problems))
    
    def council(self, value) -> List[bool]:
        return self.comms.collect(bool(value))
    
    def done(self):
        self.comms.sync_parties()
        self.comms.clean_up()
        print(f'CP{self.pid}:\tDone')


class AllowMPCSwitch[TP]:
    mpc: MPCEnv[TP]

    def __init__(self, mpc: MPCEnv[TP]):
        self.mpc = mpc

    def __enter__(self):
        self.mpc.default_allow_mpc_switch = True

    def __exit__(self):
        self.mpc.default_allow_mpc_switch = False


class ModulusSwitch[TP]:
    mpc: MPCEnv[TP]
    old_modulus: TP
    new_modulus: TP

    def __init__(self, mpc: MPCEnv[TP], modulus: TP):
        self.mpc = mpc
        self.old_modulus = mpc.default_mpc_modulus
        self.new_modulus = modulus

    def __enter__(self):
        self.mpc.default_mpc_modulus = self.new_modulus

    def __exit__(self):
        self.mpc.default_mpc_modulus = self.old_modulus


class DelayedTruncation[TP]:
    """
    Suspends fixed-point truncation (MPCFP.trunc returns its input) until the block exits; the caller truncates the
    result once afterwards (Sharetensor.itrunc, MPCFP.trunc). For linear combinations of single fixed-point products
    (sum_i a_i * b_i): it saves an opening per product, and is valid while the untruncated sum stays below the
    truncation bound (2^(K + F) by default). Protocols whose own truncations cannot be deferred (division, square
    root, Decor's nonlinear functions) raise inside the block. Scopes nest: truncation resumes when the outermost one
    exits. Nothing is truncated on exit.
    """
    mpc: MPCEnv[TP]

    def __init__(self, mpc: MPCEnv[TP]):
        self.mpc = mpc

    def __enter__(self):
        self.mpc.fp.truncation_scopes += 1

    def __exit__(self):
        assert self.mpc.fp.truncation_scopes > 0, "delayed_truncation: exit without a matching enter"
        self.mpc.fp.truncation_scopes -= 1


class DetachDealer[TP]:
    """
    Buffers the trusted dealer's (CP0's) sends while the block runs and flushes them when the outermost block exits,
    so that a benchmark can time the online phase without the dealer's traffic. A measurement aid only: the dealer must
    not receive inside the block (MPCComms raises if it does), and the buffer holds the whole block's traffic in
    memory. Blocks nest.
    """
    mpc: MPCEnv[TP]

    def __init__(self, mpc: MPCEnv[TP]):
        self.mpc = mpc

    def __enter__(self):
        comms = self.mpc.comms
        comms.detach_depth += 1
        comms.detach_dealer = self.mpc.pid == 0

    def __exit__(self):
        comms = self.mpc.comms
        assert comms.detach_depth > 0, "detach_dealer: exit without a matching enter"
        comms.detach_depth -= 1
        if comms.detach_depth == 0:
            comms.detach_dealer = False
            comms.flush_dealer_buffers()


class EncodingSwitch[TP]:
    mpc: MPCEnv[TP]
    old_encoding: str
    new_encoding: str

    def __init__(self, mpc: MPCEnv[TP], encoding: str):
        self.mpc = mpc
        self.old_encoding = mpc.default_ciphertensor_encoding
        self.new_encoding = encoding

    def __enter__(self):
        self.mpc.default_ciphertensor_encoding = self.new_encoding

    def __exit__(self):
        self.mpc.default_ciphertensor_encoding = self.old_encoding


class StatsLog[TP]:
    mpc: MPCEnv[TP]
    start: float
    msg: str
    file_path: str
    mode: str
    file_only: bool

    def __init__(self, mpc: MPCEnv[TP], msg: str ="", file_path: str = "", mode: str = "a+", file_only: bool = False):
        self.mpc = mpc
        self.msg = msg
        self.file_path = file_path
        self.mode = mode
        self.file_only = file_only
        self.start = 0.0  # set by __enter__ (Codon 0.20 rejects an __init__ that leaves a field unset)

    def __enter__(self):
        self.start = time.time()
        self.mpc.stats.reset_stats()

    def __exit__(self):
        print(f"\n{self.msg} took {time.time() - self.start}s")
        if self.file_path:
            with open(self.file_path, self.mode) as f:
                self.mpc.comms.sequential(self.mpc.stats.print_stats, False, self.msg, f, self.file_only)
        else:
            self.mpc.comms.sequential(self.mpc.stats.print_stats, False, self.msg)
        

@extend
class MPCEnv:
    def allow_mpc_switch(self):
        return AllowMPCSwitch(self)
    
    def default_modulus(self, modulus: TP):
        return ModulusSwitch(self, modulus)
    
    def default_encoding(self, encoding: str):
        return EncodingSwitch(self, encoding)

    def delayed_truncation(self):
        """ Suspends fixed-point truncation inside the block; truncate the result once after it (see DelayedTruncation). """
        return DelayedTruncation(self)

    def detach_dealer(self):
        """ Buffers CP0's sends until the block exits: an online-phase measurement aid (see DetachDealer). """
        return DetachDealer(self)
    
    def stats_log(self, msg: str = "", file_path: str = "", mode: str = "a+", file_only: bool = False):
        return StatsLog(self, msg, file_path, mode, file_only)
