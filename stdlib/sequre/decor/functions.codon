""" Plaintext helpers backing the Decor protocols.

The trusted dealer and the online parties both evaluate the target function in
the clear -- the dealer on its random mask, the parties on the revealed masked
input -- so Decor needs ordinary elementwise math over the same containers the
protocols carry.
"""

import math

from sequre.constants import FBITS_MASK
from sequre.attributes import sequre
from sequre.types.utils import double_to_fp, fp_to_double


def recursive_reduce(func, iterable):
    if isinstance(iterable, ByVal):
        return func(iterable)

    if isinstance(iterable, list):
        return [recursive_reduce(func, v) for v in iterable]

    compile_error("recursive_reduce: invalid type")


def sin(value):
    return recursive_reduce(math.sin, value)


def cos(value):
    return recursive_reduce(math.cos, value)


def tan(value):
    return recursive_reduce(math.tan, value)


def cot(value):
    return recursive_reduce(lambda x: 1 / math.tan(x), value)


def sinh(value):
    return recursive_reduce(math.sinh, value)


def cosh(value):
    return recursive_reduce(math.cosh, value)


def tanh(value):
    return recursive_reduce(math.tanh, value)


def sech(value):
    t = tanh(value)
    return -(t * t - 1)


def exp(value):
    return recursive_reduce(lambda x: x.exp(), value)


def sigmoid(value):
    return recursive_reduce(lambda x: 1 / (1 + (-x).exp()), value)


def log(value):
    return recursive_reduce(math.log, value)


def sqrt(value):
    return recursive_reduce(math.sqrt, value)


def mul_inv(value):
    return recursive_reduce(lambda x: 1 / x, value)


def sgn(value):
    return recursive_reduce(lambda x: 1.0 if x > 0 else (-1.0 if x < 0 else 0.0), value)


def floor(value):
    return recursive_reduce(math.floor, value)


def ceil(value):
    return recursive_reduce(math.ceil, value)


def square_wave(value, period=math.pi):
    return sgn(cos(value * (2 * math.pi / period)))


def sawtooth_wave(value, period=math.pi):
    return recursive_reduce(lambda x: (x / period) - math.floor((x / period) + 0.5), value)


def softmax(value):
    if isinstance(value, list[list]):
        return [softmax(v) for v in value]

    if isinstance(value, list):
        exps = exp(value)
        sum_exps = sum(exps)
        return [v / sum_exps for v in exps]

    compile_error("softmax: invalid type")


def powers(value: List[float], degree: int) -> List[List[float]]:
    """ [x^0, x^1, ..., x^degree], elementwise over value. """
    if degree < 0:
        raise ValueError("powers: invalid degree")

    pows = [[1.0 for _ in range(len(value))] for _ in range(degree + 1)]
    for i in range(1, degree + 1):
        pows[i] = pows[i - 1] * value

    return pows


def linspace(a, b, count):
    step = (b - a) / (count - 1)
    return [(a + step * i) for i in range(count)]



# Deliberately local rather than numpy.trapz: that one goes through asarray and
# would pull Codon's ndarray into a module that already works with Sequre's.
def trapz(y: list[float], x: list[float]) -> float:
    """ Trapezoidal integral of y over the sample points x. """
    total = 0.0
    for i in range(1, len(x)):
        total += (x[i] - x[i - 1]) * (y[i] + y[i - 1])
    return total * 0.5


# Fixed-point conversions relative to an interval or period.
#
# Decor confines its input to a known interval so that the masked value x - r
# cannot overflow the function's safe domain; these move between the real
# interval and the [0, 1) fixed-point representation the protocols work in.

def interval_double_to_fp(value, interval, modulus):
    a, b = interval
    return double_to_fp((value - a) * (1 / (b - a)), modulus)


def interval_fp_to_double(value, interval, modulus):
    a, b = interval
    return fp_to_double(value, modulus) * (b - a) + a


def period_double_to_fp(value, period, modulus):
    return double_to_fp(value * (1 / period), modulus)


def period_fp_to_double(value, period, modulus):
    return fp_to_double(value, modulus) * period


def trig_double_to_fp(value, modulus):
    return period_double_to_fp(value, math.pi * 2, modulus)


def trig_fp_to_double(value, modulus):
    return period_fp_to_double(value, math.pi * 2, modulus)


@sequre
def secure_powers(mpc, value, degree: int):
    if degree < 0:
        raise ValueError("secure_powers: invalid degree")

    pows = value.zeros().expand_dims() + 1.0
    for i in range(1, degree + 1):
        pows.append(pows[i - 1] * value)

    return pows


@sequre
def modulo_float(mpc, value, period: float):
    """ Reduces a secret-shared value modulo period, by masking off the integer part. """
    value_cp = value.copy()

    value_p = (value / period)
    value_cp.share = (value_p.share & FBITS_MASK)

    if value_p.r:
        value_cp.x_r = value_p.x_r & FBITS_MASK
        value_cp.r = value_p.r & FBITS_MASK

    value_cp = value_cp * period
    return value_cp
