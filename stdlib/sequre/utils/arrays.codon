"""
Array helpers that Codon's NumPy does not provide, for Sequre's own code.
"""
import prg
import internal.static as static

import numpy as np
from numpy import ndarray


def empty_ndarray(dtype: type, ndim: Literal[int]) -> ndarray[dtype, ndim]:
    # An array with no elements and no buffer: a placeholder that a later step replaces
    return ndarray((0,) * ndim, Ptr[dtype]())


def empty_of(A: type) -> A:
    # An empty array of the ndarray type A (A() for an ndarray type)
    return empty_ndarray(A.dtype, A.ndim)


def default_of(T: type) -> T:
    # T(), where T may be an ndarray type: an empty array then (Codon's ndarray has no zero-argument constructor)
    if isinstance(T, ndarray):
        return empty_of(T)
    else:
        return T()


def shape_count(shape) -> int:
    # The number of elements of a shape, where an empty shape has none (a 0-dim array holds one element in NumPy):
    # Sequre's callers count a 0-dim array as empty
    if static.len(shape) == 0:
        return 0
    total = 1
    for i in range(static.len(shape)):
        total *= shape[i]
    return total


def _extract_shape(t):
    # The shape of nested lists, read from their first elements
    if isinstance(t, List):
        rest = _extract_shape(t[0])
        return (len(t), *rest)
    else:
        return ()


def rand_uniform(shape):
    # Floats drawn uniformly from [0, 1) from Sequre's PRG (its live stream: a caller that needs the same values at
    # every party draws inside mpc.randomness.global_stream()). Never NumPy's random module, which ignores the streams.
    new_arr = np.zeros(shape)
    for i in range(new_arr.size):
        new_arr._data[i] = prg.random()
    return new_arr


def rand_normal(shape, mu: float = 0.0, sigma: float = 1.0):
    # Floats drawn from N(mu, sigma^2) from Sequre's PRG, as rand_uniform
    new_arr = np.zeros(shape)
    for i in range(new_arr.size):
        new_arr._data[i] = prg.gauss(mu=mu, sigma=sigma)
    return new_arr


def rand(shape, distribution: str):
    # A float array of the given distribution: "uniform", "normal", "zeros" or "ones"
    if distribution == "uniform":
        return rand_uniform(shape)

    if distribution == "normal":
        return rand_normal(shape)

    if distribution == "zeros":
        return np.zeros(shape)

    if distribution == "ones":
        return np.ones(shape)

    raise ValueError(f"Non-supported distribution: {distribution}")


def loadtxt(path: str, shape, dtype: type = float):
    # Reads whitespace-separated numbers: shape[0] lines (one for a 1-dim shape), the first shape[-1] numbers of each.
    # NumPy's loadtxt reads every line and column, with another signature.
    rows = 1 if static.len(shape) < 2 else shape[0]
    buff = List[dtype]()
    cols = 0

    with open(path) as f:
        for _ in range(rows):
            line = next(f)
            line_split = line.split()
            cols = min(shape[-1], len(line_split))
            buff.extend([dtype(line_split[i].strip()) for i in range(cols)])

    arr = np.array(buff)

    if static.len(shape) < 2:
        return arr

    return arr.reshape((rows, cols))
