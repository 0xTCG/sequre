""" A placeholder for a field that a later setup step assigns """

from internal.gc import sizeof


@pure
@llvm
def _null_ref(T: type) -> T:
    ret ptr null


def unset(T: type) -> T:
    """
    The zero value of T, for a field that a later step assigns (a key that collective_init generates, a layer's weights
    that compile draws): a null reference for a class, zero bytes for a value type. Codon 0.20 rejects an __init__
    that leaves a field unset, and Codon 0.19 left such a field zero: this keeps that. Use it only where nothing reads
    the field before it is set, bool() included; give a list, a scalar or an object that code tests for emptiness a
    real empty value instead.
    """
    if isinstance(T, ByVal):
        p = Ptr[T](1)
        str.memset(p.as_byte(), byte(0), sizeof(T))
        return p[0]
    else:
        return _null_ref(T)
