"""
Threads of the BLAS library behind float products of plain arrays (`a @ b`, `np.dot` on float ndarrays). Codon's NumPy
calls OpenBLAS, linked into Codon's runtime, on Linux; on macOS it calls Apple's Accelerate, which manages its own
threads, and these functions do nothing there.

OpenBLAS runs one thread per core in every process: its pool starts at load, and in a forked party at the party's
first product (OpenBLAS stops it at fork). Several parties on one machine then run that many each, and a product of
two 1000x1000 arrays at three parties takes 4-7x as long as with four threads each, while the spinning threads slow the
parties' other work too. So every party sets OpenBLAS to NUM_THREADS threads (sequre/constants.codon) as it starts
(MPCEnv.__init__), the count Sequre's own parallel loops use, unless the user exported OPENBLAS_NUM_THREADS (or
GOTO_NUM_THREADS). An exported OMP_NUM_THREADS, which OpenBLAS would otherwise follow, does not count: it often sizes
OpenMP for the whole machine. An application that runs a few large products and little else in parallel may raise
the count with set_blas_threads; set it between products.
"""
import os

from internal.dlopen import c_dlopen, c_dlsym, RTLD_NOW
from sequre.constants import NUM_THREADS


def _openblas_function(name: str) -> cobj:
    # Looked up at run time: macOS's runtime has no OpenBLAS, so a direct reference would not link there
    program = c_dlopen(cobj(), RTLD_NOW)
    if program == cobj():
        return cobj()
    return c_dlsym(program, name.c_str())


def blas_threads() -> int:
    # OpenBLAS's thread count in this process, or 0 without OpenBLAS (macOS)
    fn = _openblas_function("openblas_get_num_threads")
    if fn == cobj():
        return 0
    return int(Function[[], i32](fn)())


def set_blas_threads(n: int) -> bool:
    # Sets OpenBLAS's thread count in this process (a party); False without OpenBLAS (macOS)
    assert n >= 1, f"set_blas_threads: {n} threads"
    fn = _openblas_function("openblas_set_num_threads")
    if fn == cobj():
        return False
    Function[[i32], NoneType](fn)(i32(n))
    return True


def init_blas_threads():
    # A party's default (see above): NUM_THREADS, unless the user chose a count for OpenBLAS
    if os.getenv("OPENBLAS_NUM_THREADS", default="") or os.getenv("GOTO_NUM_THREADS", default=""):
        return
    set_blas_threads(NUM_THREADS)
