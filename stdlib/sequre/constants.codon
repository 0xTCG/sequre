PARTY_KEY_FILE: str = os.getenv(ENV_PARTY_KEY_FILE, default="cp{pid}-key.pem")

# Debugging toggles (DO NOT set these to False in production use)
# These are only meant for debugging purposes.
USE_TLS: bool = os.getenv(ENV_USE_TLS, default="1") != "0"
USE_SECURE_PRG: Static[bool] = True

# Data sharing protocol
DS_RUNTIME_PID: int = int(os.getenv(ENV_PID, default="-1"))

# Types
mpc_uint = UInt[MPC_INT_SIZE]  # Can be either UInt[128] or UInt[192] at the moment

lattiseq_uint = UInt[LATTISEQ_INT_SIZE]
lattiseq_int = Int[LATTISEQ_INT_SIZE]

# Integers of the exact (fixed-point) CKKS encoder, lattiseq/exact_encoder.codon, and of its products. Its inputs must
# leave 25-40 bits of room below this width. Masked MPC values reach about 2^195 (in plaintext coefficient units) with
# 192-bit shares and about 2^230 with 256-bit shares, which then need 512 bits.
LATTISEQ_EXACT_INT_SIZE: Static[int] = 256 if MPC_INT_SIZE < 256 else 512
LATTISEQ_EXACT_WIDE_SIZE: Static[int] = 2 * LATTISEQ_EXACT_INT_SIZE
lattiseq_exact_int = Int[LATTISEQ_EXACT_INT_SIZE]
lattiseq_exact_wide_int = Int[LATTISEQ_EXACT_WIDE_SIZE]

gmp_limb_t = UInt[GMP_LIMB_SIZE]

# MPC
if MPC_INT_SIZE != 128 and MPC_INT_SIZE != 192 and MPC_INT_SIZE != 256:
    compile_error("Unsupported integer size selected. Should be either 128, 192, or 256.")

MPC_MODULUS_BITS: Static[int] = 127 if MPC_INT_SIZE == 128 else 174 if MPC_INT_SIZE == 192 else 251
MPC_MERSENNE_OFFSET: Static[int] = 1 if MPC_INT_SIZE == 128 else 3 if MPC_INT_SIZE == 192 else 9
MPC_NBIT_K: Static[int] = 64 if MPC_INT_SIZE == 128 else 64 if MPC_INT_SIZE == 192 else 128
MPC_NBIT_F: Static[int] = 32 if MPC_INT_SIZE == 128 else 32 if MPC_INT_SIZE == 192 else 64
MPC_NBIT_V: Static[int] = 28 if MPC_INT_SIZE == 128 else 64 if MPC_INT_SIZE == 192 else 56
MPC_SECOND_FIELD_SIZE: Static[int] = 23 if MPC_INT_SIZE == 128 else 37 if MPC_INT_SIZE == 192 else 67
MPC_THIRD_FIELD_SIZE: Static[int] = 13 if MPC_INT_SIZE == 128 else 17
MPC_SECOND_RING_SIZE: Static[int] = 16

MPC_MODULUS_BYTES: Static[int] = (MPC_MODULUS_BITS + 7) // 8
MPC_RING_SIZE = mpc_uint(1) << mpc_uint(MPC_MODULUS_BITS)
MPC_FIELD_SIZE = MPC_RING_SIZE - mpc_uint(MPC_MERSENNE_OFFSET)
MPC_RING_MASK = MPC_RING_SIZE - mpc_uint(1)

assert MPC_FIELD_SIZE < MPC_RING_SIZE, f"Ring size should be larger than field size. Ring size: {MPC_RING_SIZE}. Field size: {MPC_FIELD_SIZE}."
assert MPC_RING_SIZE.popcnt() == 1, "Ring size not a power of 2."
assert MPC_SECOND_FIELD_SIZE < 128, "Second field size must be less than 128"
assert MPC_THIRD_FIELD_SIZE < 128, "Third field size must be less than 128"
assert MPC_NBIT_K + MPC_NBIT_F + MPC_NBIT_V + 2 < MPC_MODULUS_BITS, "FP config overflows the size of modulus."

# Bitwise (XOR) shared MPC (mpc/bitwise.codon). The bits of a shared value are packed into registers of PACKING_SIZE
# bits, so one bitwise operation on a size_t covers PACKING_SIZE secret bits. PACKING_SIZE equals MPC_NBIT_K, so a
# fixed-point value's K bits fit one register (64 bits in the 128- and 192-bit builds, 128 in the 256-bit build).
PACKING_SIZE: Static[int] = MPC_NBIT_K
size_t = UInt[PACKING_SIZE]

# Decor
# Mask selecting the fractional bits of a fixed-point value.
FBITS_MASK = (mpc_uint(1) << mpc_uint(MPC_NBIT_F)) - mpc_uint(1)
# Decor compares values in [0, 1) over a reduced ring of MPC_NBIT_F + 1 bits: the fractional bits plus a sign bit.
MPC_DECOR_MODULUS_BITS: Static[int] = MPC_NBIT_F + 1
MPC_DECOR_RING_SIZE = mpc_uint(1) << mpc_uint(MPC_DECOR_MODULUS_BITS)
# Decor division: methods and default iteration counts. The initial estimate 5b^2 - 10b + 5.943 of 1/b on [0.25, 1)
# has a relative error of at most 0.107, and each iteration squares it: 0.107^(2^n) < 2^-(F + 1) needs n = 4 at F = 32
# and n = 5 at F = 64. Goldschmidt's two products per iteration are independent and share their rounds (2 per
# iteration, Newton's dependent pair 4): 49 rounds per inverse at the defaults (a division x / y adds the product with
# x and its truncation: 51), Newton 55, both within a few units of 2^-F.
DECOR_NEWTON_METHOD: Static[str] = "newton"
DECOR_GOLDSCHMIDT_METHOD: Static[str] = "goldschmidt"
DECOR_DIV_DEFAULT_METHOD: Static[str] = DECOR_GOLDSCHMIDT_METHOD
DECOR_DIV_DEFAULT_NITER: Static[int] = 4 if MPC_NBIT_F <= 32 else 5
# Combiner of Decor's sigmoid and tanh: "select" (the logistic / tanh addition theorems: select the opened branch, one
# product, a division by a positive denominator) or "exp" (Decor exp, then the inverse of 1 + e^-x).
DECOR_SIGMOID_COMBINER: Static[str] = "select"
# Fourier terms whose two coefficients are both below one unit of the fixed-point encoding are dropped (no dealer
# randomness, no local work).
DECOR_FOURIER_EPSILON: float = 2.0 ** -float(MPC_NBIT_F)
# Decor's admissibility check raises when the estimated worst-case error of a bounded function on its interval exceeds
# DECOR_TOLERANCE times max(1, max |f| on the interval): at least F/2 - 4 correct bits relative to the function's scale
# (2.4e-4 at F = 32, 3.7e-9 at F = 64). via_decor takes a per-call tolerance.
DECOR_TOLERANCE: float = 2.0 ** -float(MPC_NBIT_F // 2 - 4)

# Default Decor intervals per function. F = 32 (a numerics study, 400 points, ring and field alike): max abs error
# on these (typical runs) exp 3e-5 (relative 1e-8 at e^8), sigmoid 4e-6, tanh 3e-6, sinh/cosh 2e-6; decor_error_bound
# gives 4.9e-5, 2.6e-5, 1.3e-5 and 5.3e-6. Wider intervals lose precision; the check admits at F = 32 symmetric widths
# up to |b| ~ 14 for exp and ~ 11 for sinh/cosh (fixed-point range), ~ 12.3 for sigmoid and ~ 6.5 for tanh (tolerance).
# F = 64 (256-bit build): from the error bound, which a plaintext simulation of the protocol's arithmetic confirms;
# the plaintext evaluations in double precision (2^-52) cap the precision there. The 256-bit build passes the decor,
# bitwise, activations and nonlinear tests on both moduli, whose tolerances come from these bounds.
DECOR_INTERVAL_EXP = (-8.0, 8.0) if MPC_NBIT_F <= 32 else (-20.0, 20.0)
DECOR_INTERVAL_SIGMOID = (-10.0, 10.0) if MPC_NBIT_F <= 32 else (-15.0, 15.0)
DECOR_INTERVAL_TANH = (-5.0, 5.0) if MPC_NBIT_F <= 32 else (-8.0, 8.0)
DECOR_INTERVAL_SINH = (-5.0, 5.0) if MPC_NBIT_F <= 32 else (-8.0, 8.0)

# Nonlinear-function methods, and the evaluation of a polynomial (Chebyshev, Taylor)
METHOD_DECOR: Static[str] = "decor"
METHOD_CHEBYSHEV: Static[str] = "chebyshev"
METHOD_FOURIER: Static[str] = "fourier"
METHOD_TAYLOR: Static[str] = "taylor"
# sigmoid's and tanh's default: Decor on ring shares, a Chebyshev interpolant within Decor's error bound (at least
# NONLINEAR_AUTO_FLOOR) on field shares
METHOD_AUTO: Static[str] = "auto"
POLY_EVAL_CLENSHAW: Static[str] = "clenshaw"
POLY_EVAL_DECOR: Static[str] = "decor"
POLY_EVAL_NAIVE: Static[str] = "naive"
# sequre.stdlib.nonlinear: default degrees of the Fourier and Taylor methods (Chebyshev's is CHEBYSHEV_DEGREE), and the
# width W of softmax's exponent interval (-W, 0] (below -W it saturates at e^-W; e^-16 = 1.1e-7)
NONLINEAR_FOURIER_DEGREE: int = 16
NONLINEAR_TAYLOR_DEGREE: int = 8
NONLINEAR_SOFTMAX_WIDTH: float = 16.0
# The highest Chebyshev degree the auto method may pick on field shares (it refuses an interval that needs more), and
# the floor of its truncation target: half of max(decor_error_bound, NONLINEAR_AUTO_FLOOR). Double-precision
# coefficients carry about 1e-15 each, so a target far below 2^-44 is out of reach (F = 64 on narrow intervals, where
# Decor's bound falls below 1e-15)
NONLINEAR_AUTO_MAX_DEGREE: int = 512
NONLINEAR_AUTO_FLOOR: float = 2.0 ** -44

# Echo MPC config
print(f"MPC config:\n\tMPC Galois field / Z_(2^k) ring size: {MPC_MODULUS_BITS} bits")

_tls_status = "ON" if USE_TLS else "OFF"
_prg_status = "ON" if USE_SECURE_PRG else "OFF"
print(f"\tTLS={_tls_status}\n\tSecure PRG={_prg_status}")

if not USE_TLS or not USE_SECURE_PRG:
    print("\nWARNING! RUNTIME IS NOT SECURE!\n")

