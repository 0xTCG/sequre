import os

from simd import Vec
from settings import *

from C import access(cobj, i32) -> i32 as _c_access

def _find_lib(env_var: str, candidates: List[str]) -> str:
    val = os.getenv(env_var, default="")
    if val:
        return val
    for path in candidates:
        if _c_access(path.ptr, 0i32) == 0i32:
            return path
    raise RuntimeError(
        f"Could not find library for {env_var}. "
        f"Set the {env_var} environment variable to the correct path."
    )


