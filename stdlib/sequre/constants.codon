    print(f"Note:\n\t\tThe list of parties IPs is provided (env var {ENV_CP_IPS} is non-empty).\n\t\tSetting the number of parties to the size of env var {ENV_CP_IPS}: {NUMBER_OF_PARTIES}.")

assert NUMBER_OF_PARTIES > 2, "Sequre requires at least 3 computing parties (including trusted dealer) for secure execution."
assert COMMUNICATION_PORT + (NUMBER_OF_PARTIES - 1) * NUMBER_OF_PARTIES < DATA_SHARING_PORT, f"Not enough ports left between communication port ({COMMUNICATION_PORT}) and data-sharing port ({DATA_SHARING_PORT}) to support all connections between parties."

AF_UNIX = 1
AF_INET = 2
SOCK_STREAM = 1
SHUT_RDWR = 2

AF_UNIX_PREFIX = "./sock."

# Algorithms
MATMUL_LEAF_SIZE: Static[int] = 64
CHEBYSHEV_DEGREE: Static[int] = 20

# Access patterns
ENC_ROW: str = "row-wise"
ENC_COL: str = "col-wise"
ENC_DIAG: str = "diag-wise"

# SIMD
SIMD_LANE_SIZE: Static[int] = 8
_MM_0F_u128xN: Vec[u128, SIMD_LANE_SIZE] = Vec[u64, SIMD_LANE_SIZE](u64(0xffffffffffffffff)).cast(u128)

# Masks
MASK32: Static[int] = 0xffffffff

# IEEE 754 2008 FP standardization
IEEE_754_MANTISSA_SIZE: Static[int] = 52
IEEE_754_EXPONENT_SIZE: Static[int] = 64 - IEEE_754_MANTISSA_SIZE - 1
IEEE_754_EXPONENT_HALF_RANGE: int = (1 << (IEEE_754_EXPONENT_SIZE - 1)) - 1

# Parallelism
NUM_THREADS: Static[int] = 4

# Lattiseq
LATTISEQ_MAX_LOGN: Static[int] = 17
LATTISEQ_MIN_LOGN: Static[int] = 4
LATTISEQ_MAX_MODULI_COUNT: Static[int] = 34
LATTISEQ_DEFAULT_SIGMA: float = 3.2
# Standard deviation of the noise each party adds to its share of a collective decryption (smudging; env var
# SEQURE_SIGMA_SMUDGE). Any value of at least LATTISEQ_DEFAULT_SIGMA keeps the parties from solving for the collective
# secret key from a decryption (D - c0 = c1 * s + noise is then a ring-LWE instance). It does not flood the ciphertext
# noise statistically, which needs about 2^20 or more and a larger scale: the decryption error grows in proportion to
# it (max error measured at the default scale 2^34: ~5e-5 at 2^10, ~5e-4 at 2^14, ~3e-2 at 2^20).
LATTISEQ_SIGMA_SMUDGE: float = float(os.getenv(ENV_SIGMA_SMUDGE, default="1024"))
assert LATTISEQ_SIGMA_SMUDGE >= LATTISEQ_DEFAULT_SIGMA, \
    f"{ENV_SIGMA_SMUDGE} ({LATTISEQ_SIGMA_SMUDGE}) must be at least {LATTISEQ_DEFAULT_SIGMA}: smaller smudging noise exposes the collective secret key"
# Statistical security parameter of the masks in the HE->MPC switch (MPCMHE._mhe_to_mpc): the hub's view of a
# plaintext is within statistical distance 2^-MHE_MPC_SWITCH_LAMBDA of one independent of it. The MPC->HE switch uses
# masks as large as the MPC modulus allows instead (MPCMHE._mpc_to_mhe_mask_bits).
MHE_MPC_SWITCH_LAMBDA: int = 128
LATTISEQ_MAX_MODULI_SIZE: Static[int] = 60
LATTISEQ_GALOIS_GEN: Static[int] = 5
LATTISEQ_MIN_LOG_SLOTS: Static[int] = 0
LATTISEQ_STANDARD_RING_ENUM = 0
LATTISEQ_CONJUGATE_INVARIANT_RING_ENUM = 1
LATTISEQ_ROTATION_KEYS_COUNT: Static[int] = 64

# HE
# Per-op cost estimates from release-mode measurements (tests/perf.codon, 2026-07):
#   add ~2e-5, ct-pt mul ~5e-4, ct-ct mul+relin ~1.1e-2, rotate ~1.0e-2,
#   encode ~1.4e-3, pk-encrypt ~8e-3 (rescale ~2.5e-3 has no stored constant).
# Decode/decrypt below are left at their prior values (no fresh measurement).
# WARNING: these values change the matmul-reorder IR pass decision for
# `a @ b.T @ c` on MPPs and can expose a latent correctness bug in the newly
# chosen ordering path (test_ir_passes: "MHE matmul reorder ... correctness
# failed"), tracked separately.
HE_ADD_COST_ESTIMATE: float = 0.00002
HE_MUL_COST_ESTIMATE: float = 0.0005
HE_MUL_RELIN_COST_ESTIMATE: float = 0.011
HE_ROT_COST_ESTIMATE: float = 0.010
HE_ENCODING_COST_ESTIMATE: float = 0.0014
HE_ENCRYPTION_COST_ESTIMATE: float = 0.008
HE_DECODING_COST_ESTIMATE: float = 0.0385771
HE_DECRYPTION_COST_ESTIMATE: float = 0.0006543
HE_ENC_COST_ESTIMATE: float = HE_ENCODING_COST_ESTIMATE + HE_ENCRYPTION_COST_ESTIMATE
HE_DEC_COST_ESTIMATE: float = HE_DECODING_COST_ESTIMATE + HE_DECRYPTION_COST_ESTIMATE

# MPC
MPC_BIG_INT_MUL_COST: float = 2.9805e-05

# MHE
MHE_MUL_TO_ADD_THRESHOLD: Static[int] = 7
MHE_MPC_SWITCH_COST_ESTIMATE: float = HE_ENC_COST_ESTIMATE + HE_DEC_COST_ESTIMATE

# Instruction cost estimates
SMALL_CYCLES_INSTR_COST_ESTIMATE: float = 1e-09

