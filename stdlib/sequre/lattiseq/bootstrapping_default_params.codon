"""
Ported from https://github.com/tuneinsight/lattigo/blob/v4.0.0/ckks/bootstrapping/default_params.go

The parameters provided hereunder are the parameters used in the paper
Bootstrapping for Approximate Homomorphic Encryption with Negligible
Failure-Probability by Using Sparse-Secret Encapsulation,
https://eprint.iacr.org/2022/024

The literals below were generated from the Go source (moduli, levels and scaling factors are copied,
not retyped). They are shared objects: take a copy() before changing one, as Lattigo's own test does
when it shrinks a set to logN = 13.

What a set can carry through a bootstrapping, in the terms of bootstrapping.Bootstrapper:
  - bootstrap returns a ciphertext at level "StC level_start - number of StC levels": the residual levels.
  - the coefficients of the plaintext polynomial, divided by the scale, must lie in [-1, 1], for every
    set. bootstrap_with_range extends that at the price of precision, by at most
    log2((Q0 / message ratio) / default scale) bits for a ciphertext at level 0: 12 for N16QP1546H192H32
    and N16QP1767H32768H32, 13 for N16QP1547H192H32 and N16QP1788H32768H32, 17 for N16QP1553H192H32 and
    N16QP1793H32768H32, 0 for N15QP768H192H32 and 1 for N15QP880H16384H32.
"""
from params import CKKSParametersLiteral
from advanced import EncodingMatrixLiteral, EvalModLiteral, COEFFS_TO_SLOTS, SLOTS_TO_COEFFS, SIN, COS1, COS2
from bootstrapping import Parameters


class DefaultParametersLiteral:
    scheme_params: CKKSParametersLiteral
    bootstrapping_params: Parameters

    # copy returns a copy of the literal that shares nothing with the receiver.
    def copy(self) -> DefaultParametersLiteral:
        return DefaultParametersLiteral(
            scheme_params=_scheme_params(
                logn=self.scheme_params.logn,
                h=self.scheme_params.h,
                q=[e for e in self.scheme_params.q],
                p=[e for e in self.scheme_params.p],
                log_slots=self.scheme_params.log_slots,
                default_scale=self.scheme_params.default_scale),
            bootstrapping_params=self.bootstrapping_params.copy())

    # insecure_copy returns a copy of the literal in a ring of degree 2^logn with 2^log_slots slots: the
    # same moduli and the same circuit in a smaller ring. This is what Lattigo's tests run on (logn = 13).
    # It offers no security whatsoever and is only good for testing.
    def insecure_copy(self, logn: int, log_slots: int) -> DefaultParametersLiteral:
        literal = self.copy()
        literal.scheme_params.logn = logn
        literal.scheme_params.log_slots = log_slots
        # The Hamming weight of the secret cannot exceed the degree of the ring
        literal.scheme_params.h = min(literal.scheme_params.h, 1 << (logn - 1))
        return literal


def _scheme_params(logn: int, h: int, q: list[u64], p: list[u64], log_slots: int, default_scale: float) -> CKKSParametersLiteral:
    literal = CKKSParametersLiteral(logn=logn, q=q, p=p, log_slots=log_slots, default_scale=default_scale)
    literal.h = h
    literal.sigma = 3.2  # rlwe.DefaultSigma
    return literal


# N16QP1546H192H32 is a default bootstrapping parameters for a main secret with H=192 and an ephemeral secret with H=32.
# Residual Q : 420 bits.
# Precision : 26.6 bits for 2^{15} slots.
# Failure : 2^{-138.7} for 2^{15} slots.
N16QP1546H192H32 = DefaultParametersLiteral(
    scheme_params=_scheme_params(
        logn=16,
        h=192,
        q=[
            u64(0x10000000006e0001),  # 60 Q0
            u64(0x10000140001),  # 40
            u64(0xffffe80001),  # 40
            u64(0xffffc40001),  # 40
            u64(0x100003e0001),  # 40
            u64(0xffffb20001),  # 40
            u64(0x10000500001),  # 40
            u64(0xffff940001),  # 40
            u64(0xffff8a0001),  # 40
            u64(0xffff820001),  # 40
            u64(0x7fffe60001),  # 39 StC
            u64(0x7fffe40001),  # 39 StC
            u64(0x7fffe00001),  # 39 StC
            u64(0xfffffffff840001),  # 60 Sine (double angle)
            u64(0x1000000000860001),  # 60 Sine (double angle)
            u64(0xfffffffff6a0001),  # 60 Sine
            u64(0x1000000000980001),  # 60 Sine
            u64(0xfffffffff5a0001),  # 60 Sine
            u64(0x1000000000b00001),  # 60 Sine
            u64(0x1000000000ce0001),  # 60 Sine
            u64(0xfffffffff2a0001),  # 60 Sine
            u64(0x100000000060001),  # 56 CtS
            u64(0xfffffffff00001),  # 56 CtS
            u64(0xffffffffd80001),  # 56 CtS
            u64(0x1000000002a0001)],  # 56 CtS
        p=[
            u64(0x1fffffffffe00001),  # Pi 61
            u64(0x1fffffffffc80001),  # Pi 61
            u64(0x1fffffffffb40001),  # Pi 61
            u64(0x1fffffffff500001),  # Pi 61
            u64(0x1fffffffff420001)],  # Pi 61
        log_slots=15,
        default_scale=float(1 << 40)),
    bootstrapping_params=Parameters(
        ephemeral_secret_weight=32,
        slots_to_coeffs_parameters=EncodingMatrixLiteral(
            linear_transform_type=SLOTS_TO_COEFFS,
            repack_imag_2_real=True,
            level_start=12,
            bsgs_ratio=2.0,
            bit_reversed=False,
            scaling_factor=[
                [float(0x7fffe60001)],
                [float(0x7fffe40001)],
                [float(0x7fffe00001)]]),
        eval_mod_parameters=EvalModLiteral(
            q=u64(0x10000000006e0001),
            level_start=20,
            sine_type=COS1,
            message_ratio=256.0,
            k=16,
            sine_deg=30,
            double_angle=3,
            arcsine_deg=0,
            scaling_factor=float(1 << 60)),
        coeffs_to_slots_parameters=EncodingMatrixLiteral(
            linear_transform_type=COEFFS_TO_SLOTS,
            repack_imag_2_real=True,
            level_start=24,
            bsgs_ratio=2.0,
            bit_reversed=False,
            scaling_factor=[
                [float(0x100000000060001)],
                [float(0xfffffffff00001)],
                [float(0xffffffffd80001)],
                [float(0x1000000002a0001)]])))


