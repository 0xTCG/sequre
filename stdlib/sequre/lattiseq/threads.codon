"""
Number of threads the parallel loops of Lattiseq use (its @par loops over RNS limbs and coefficient blocks).

It starts at NUM_THREADS (sequre/constants.codon), which used to be fixed at compile time. An application that
runs several homomorphic operations concurrently, each with an evaluator of its own (Evaluator.shallow_copy,
Bootstrapper.shallow_copy), lowers it so that workers x threads matches the cores, and enables nested OpenMP
regions (openmp.set_max_active_levels(2)); one that runs a single long chain of operations raises it. On a
24-core machine a N16QP1546H192H32 bootstrap takes 8.5 s at 4 threads and 3.8 s at 24 (48 is slower again), and
six concurrent bootstraps at 4 threads each finish one every 2.1 s.

Set it between operations, not while one runs: every parallel loop reads it as it starts.
"""
from sequre.constants import NUM_THREADS

_lattiseq_threads: int = NUM_THREADS


def lattiseq_threads() -> int:
    return _lattiseq_threads


def set_lattiseq_threads(n: int):
    global _lattiseq_threads
    assert n >= 1, f"set_lattiseq_threads: {n} threads"
    _lattiseq_threads = n
