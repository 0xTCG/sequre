"""
Ported from https://github.com/tuneinsight/lattigo/blob/v4.0.0/ckks/advanced/cosine_approx.go

This is the Codon implementation of the approximation polynomial algorithm from Han and Ki in
   "Better Bootstrapping for Approximate Homomorphic Encryption", <https://eprint.iacr.org/2019/688>.
The algorithm was originally implemented in C++, available at
   https://github.com/DohyeongKi/better-homomorphic-sine-evaluation

Lattigo runs it on math/big.Float with 1000 bits of precision. Here it runs on bigfloat.BigFloat
(GMP mpf) at the same precision. float64 is not an option: the divided differences below are taken
on nodes that sit as close as 1/(2 * message ratio) to each other.
"""
import math

from bigfloat import BigFloat


COSINE_APPROX_PRECISION: int = 1000

PI_STR = "3."
M_PI = 3.141592653589793238462643383279502884


# new_float creates a new BigFloat element with 1000 bits of precision
def new_float(x: float) -> BigFloat:
    return BigFloat(COSINE_APPROX_PRECISION).set_float64(x)


# bigint_cos is an iterative arbitrary precision computation of Cos(x)
# Iterative process with an error of ~10^{-0.60206*k} after k iterations.
# ref : Johansson, B. Tomas, An elementary algorithm to evaluate trigonometric functions to high precision, 2018
def bigint_cos(x: BigFloat) -> BigFloat:
    tmp = new_float(0.0)

    k = 1000  # number of iterations
    t = new_float(0.5)
    half = t.copy()

    for _ in range(1, k - 1):
        t.mul(t, half)

    s = new_float(0.0).mul(x, t)
    s.mul(s, x)
    s.mul(s, t)

    four = new_float(4.0)

    for _ in range(1, k):
        tmp.sub(four, s)
        s.mul(s, tmp)

    cosx = new_float(0.0).quo(s, new_float(2.0))
    cosx.sub(new_float(1.0), cosx)
    return cosx


def max_index(array: list[float]) -> int:
    maxind = 0
    max_val = array[0]
    for i in range(1, len(array)):
        if array[i] > max_val:
            maxind = i
            max_val = array[i]

    return maxind


def gen_degrees(degree: int, K: int, dev: float) -> Tuple[list[int], int]:
    degbdd = degree + 1
    totdeg = 2 * K - 1
    err = 1.0 / dev

    deg = [1 for _ in range(K)]

    bdd = [0.0 for _ in range(K)]
    temp = 0.0
    for i in range(1, 2 * K):
        temp -= math.log2(float(i))
    temp += (2 * float(K) - 1) * math.log2(2 * M_PI)
    temp += math.log2(err)

    for i in range(K):
        bdd[i] = temp
        for j in range(1, K - 1 - i + 1):
            bdd[i] += math.log2(float(j) + err)
        for j in range(1, K - 1 + i + 1):
            bdd[i] += math.log2(float(j) + err)

    maxiter = 200

    for _ in range(maxiter):
        if totdeg >= degbdd:
            break
        maxi = max_index(bdd)

        if maxi != 0:
            if totdeg + 2 > degbdd:
                break

            for i in range(K):
                bdd[i] -= math.log2(float(totdeg + 1))
                bdd[i] -= math.log2(float(totdeg + 2))
                bdd[i] += 2.0 * math.log2(2.0 * M_PI)

                if i != maxi:
                    bdd[i] += math.log2(abs(float(i - maxi)) + err)
                    bdd[i] += math.log2(float(i + maxi) + err)
                else:
                    bdd[i] += math.log2(err) - 1.0
                    bdd[i] += math.log2(2.0 * float(i) + err)

            totdeg += 2
        else:
            bdd[0] -= math.log2(float(totdeg + 1))
            bdd[0] += math.log2(err) - 1.0
            bdd[0] += math.log2(2.0 * M_PI)
            for i in range(1, K):
                bdd[i] -= math.log2(float(totdeg + 1))
                bdd[i] += math.log2(2.0 * M_PI)
                bdd[i] += math.log2(float(i) + err)

            totdeg += 1

        deg[maxi] += 1

    return deg, totdeg


def gen_nodes(deg: list[int], dev: float, totdeg: int, K: int, scnum: int) -> Tuple[list[BigFloat], list[BigFloat], list[BigFloat], int]:
    PI = BigFloat(COSINE_APPROX_PRECISION).set_string(PI_STR)

    scfac = new_float(float(1 << scnum))
    intersize = new_float(1.0 / dev)

    z = [new_float(0.0) for _ in range(totdeg)]
    cnt = 0
    if deg[0] % 2 != 0:
        z[cnt] = new_float(0.0)
        cnt += 1

    tmp = new_float(0.0)

    for i in range(K - 1, 0, -1):
        for j in range(1, deg[i] + 1):
            tmp = new_float(float(2 * j - 1))
            tmp.mul(tmp, PI)
            tmp.quo(tmp, new_float(float(2 * deg[i])))
            tmp = bigint_cos(tmp)

            tmp.mul(tmp, intersize)

            z[cnt] = new_float(float(i))
            z[cnt].add(z[cnt], tmp)
            cnt += 1

            z[cnt] = new_float(float(-i))
            z[cnt].sub(z[cnt], tmp)
            cnt += 1

    for j in range(1, deg[0] // 2 + 1):
        tmp = new_float(float(2 * j - 1))
        tmp.mul(tmp, PI)
        tmp.quo(tmp, new_float(float(2 * deg[0])))
        tmp = bigint_cos(tmp)
        tmp.mul(tmp, intersize)

        z[cnt] = new_float(0.0).add(new_float(0.0), tmp)
        cnt += 1

        z[cnt] = new_float(0.0).sub(new_float(0.0), tmp)
        cnt += 1

    # cos(2*pi*(x-0.25)/r)
    d = [new_float(0.0) for _ in range(totdeg)]
    for i in range(totdeg):
        d[i] = new_float(2.0)
        d[i].mul(d[i], PI)

        z[i].sub(z[i], new_float(0.25))
        z[i].quo(z[i], scfac)

        d[i].mul(d[i], z[i])
        d[i] = bigint_cos(d[i])

    for j in range(1, totdeg):
        for l in range(totdeg - j):
            d[l].sub(d[l + 1], d[l])
            tmp.sub(z[l + j], z[l])
            d[l].quo(d[l], tmp)

    totdeg += 1

    x = [new_float(0.0) for _ in range(totdeg)]
    for i in range(totdeg):
        x[i] = new_float(float(K))
        x[i].quo(x[i], scfac)
        tmp.mul(new_float(float(i)), PI)
        tmp.quo(tmp, new_float(float(totdeg - 1)))
        x[i].mul(x[i], bigint_cos(tmp))

    c = [new_float(0.0) for _ in range(totdeg)]
    p = [new_float(0.0) for _ in range(totdeg)]
    for i in range(totdeg):
        p[i] = d[0].copy()
        for j in range(1, totdeg - 1):
            tmp.sub(x[i], z[j])
            p[i].mul(p[i], tmp)
            p[i].add(p[i], d[j])

    return x, p, c, totdeg


# approximate_cos computes a polynomial approximation of degree "degree" in Chevyshev basis of the function
# cos(2*pi*x/2^"scnum") in the range -"K" to "K"
# The nodes of the Chevyshev approximation are are located from -dev to +dev at each integer value between -K and -K
def approximate_cos(K: int, degree: int, dev: float, scnum: int) -> list[complex]:
    scfac = new_float(float(1 << scnum))

    deg, totdeg_0 = gen_degrees(degree, K, dev)

    x, p, c, totdeg = gen_nodes(deg, dev, totdeg_0, K, scnum)

    tmp = new_float(0.0)

    T = [[new_float(0.0) for _ in range(totdeg)] for _ in range(totdeg)]

    for i in range(totdeg):
        T[i][0] = new_float(1.0)

        T[i][1] = x[i].copy()

        tmp.quo(new_float(float(K)), scfac)

        T[i][1].quo(T[i][1], tmp)

        for j in range(2, totdeg):
            T[i][j] = new_float(2.0)

            tmp.quo(new_float(float(K)), scfac)
            tmp.quo(x[i], tmp)
            T[i][j].mul(T[i][j], tmp)
            T[i][j].mul(T[i][j], T[i][j - 1])
            T[i][j].sub(T[i][j], T[i][j - 2])

    maxabs = new_float(0.0)
    for i in range(totdeg - 1):
        maxabs.abs(T[i][i])
        maxindex = i
        for j in range(i + 1, totdeg):
            tmp.abs(T[j][i])
            if tmp.cmp(maxabs) == 1:
                maxabs.abs(T[j][i])
                maxindex = j

        if i != maxindex:
            for j in range(i, totdeg):
                tmp.set(T[maxindex][j])
                T[maxindex][j].set(T[i][j])
                T[i][j].set(tmp)

            tmp.set(p[maxindex])
            p[maxindex].set(p[i])
            p[i].set(tmp)

        for j in range(i + 1, totdeg):
            T[i][j].quo(T[i][j], T[i][i])

        p[i].quo(p[i], T[i][i])
        T[i][i] = new_float(1.0)

        for j in range(i + 1, totdeg):
            tmp.mul(T[j][i], p[i])
            p[j].sub(p[j], tmp)
            for l in range(i + 1, totdeg):
                tmp.mul(T[j][i], T[i][l])
                T[j][l].sub(T[j][l], tmp)
            T[j][i] = new_float(0.0)

    c[totdeg - 1] = p[totdeg - 1]
    for i in range(totdeg - 2, -1, -1):
        c[i] = p[i].copy()
        for j in range(i + 1, totdeg):
            tmp.mul(T[i][j], c[j])
            c[i].sub(c[i], tmp)

    totdeg -= 1

    res = list[complex](totdeg)
    for i in range(totdeg):
        res.append(complex(c[i].float64(), 0.0))

    return res
