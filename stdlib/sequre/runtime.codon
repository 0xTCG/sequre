import sys

from sequre.mpc.env import MPCEnv
from sequre.constants import RUN_TOGGLES, MPC_FIELD_SIZE, MPC_RING_SIZE, NUMBER_OF_PARTIES

from C import fork() -> i32
from C import waitpid(i32, Ptr[i32], i32) -> i32
from C import kill(i32, i32) -> i32
from C import _exit(i32)
from C import usleep(int) -> int
from C import GC_start_mark_threads() as _gc_start_mark_threads


# waitpid/kill constants (same values on Linux and macOS)
_WNOHANG = i32(1)
_SIGABRT: int = 6
_SIGKILL = i32(9)

# After a party fails, how long the process that forked the parties waits for the others to exit on their own (they
# fail as soon as they read from a closed connection) before killing the ones still blocked on each other.
_FAILURE_GRACE_US: int = 5_000_000
_REAP_POLL_US: int = 20_000


def _print_sequre_help():
    print("Sequre runtime flags")
    print()
    print("Usage:")
    print("  @main programs:     sequre run my_protocol.codon --local [flags]")
    print("                      sequre run my_protocol.codon <party_id> [flags]")
    print("  Manual (mpc):       sequre run my_protocol.codon <party_id> [flags]")
    print()
    print("Flags:")
    print("  --use-ring         Use ring modulus instead of field modulus")
    print("                     (unstable: division/sqrt may fail ~50% of the time)")
    print("  --skip-mhe-setup   Skip the MHE key-generation setup phase")
    print("  --local            Run the program in local mode")
    print("  -h, --help         Show this help message and exit")
    print()
    print("Note: Use the @main decorator (recommended) to auto-detect execution mode")
    print("      (local with --local, distributed otherwise).")
    print()
    print("Examples:")
    print("  sequre run my_protocol.codon --local                      # local mode")
    print("  sequre run my_protocol.codon --local --skip-mhe-setup     # local, MPC-only")
    print("  sequre run my_protocol.codon 1                            # distributed, party 1")
    print("  sequre run my_protocol.codon 1 --use-ring                 # distributed, party 1, use ring modulus")
    print()
    print("For Codon compiler flags, run: codon run --help")


class _Controls:
    main_called: bool

    def __init__(self):
        self.main_called = False


CONTROLS = _Controls()


def _check_help(flags):
    if '--help' in flags or '-h' in flags:
        _print_sequre_help()
        sys.exit(0)


def _flush_output():
    # fflush(NULL) flushes every output stream. Needed before fork(), or each child prints again whatever the parent
    # had buffered, and before a party exits or fails: an uncaught exception aborts the process, which discards
    # buffered output.
    _C.fflush(cobj())


def _shut_down_failed_party(mpc):
    # Runs while an exception propagates out of a party. Names the party (Codon's error report, printed once the
    # exception reaches the top, does not) and closes its connections, so that the parties waiting on it fail at their
    # next receive instead of waiting forever. The end-of-run barrier (MPCEnv.done) must not run here: the other
    # parties may be mid-protocol and would read its message as protocol data. The connections may already be closed
    # (when MPCEnv.done failed after closing them); closing them again does nothing.
    #
    # Callers run this from a `finally` block, not from `except ...: raise`: in Codon, re-raising an exception
    # restarts its backtrace at the re-raise, which would hide where it was raised.
    _flush_output()  # so that the party's earlier output comes before this line
    print(f"CP{mpc.pid}:\tFAILED (see its error report)", file=sys.stderr)
    _flush_output()
    mpc.comms.clean_up()


def client(pid, foo, control_toggles, local, modulus, *args):
    # Initialize MPC environment
    mpc = MPCEnv(pid, local, modulus)
    finished = False
    try:
        if not control_toggles[RUN_TOGGLES.MHE_SETUP_SKIP_FLAG]:
            mpc.mhe.default_setup()

        foo(mpc, *args)

        # This is here just to keep P0 online until the end for data transfer
        # In practice, P0 would send data in advance before each phase and go offline
        mpc.done()
        finished = True
    finally:
        if not finished:
            _shut_down_failed_party(mpc)


def _run_forked_party(party: int, foo, control_toggles, modulus, *args):
    # Runs in a forked child and does not return. On success the child exits with status 0 instead of returning into
    # the caller, whose frames belong to the parent's control flow. On failure (client() has already named the party
    # and closed its connections) the exception propagates: Codon prints its usual error report, with a backtrace in
    # debug builds, and aborts the child, which the parent sees as a failure.
    #
    # fork() copies only the calling thread, so the garbage collector (bdwgc) turns parallel marking off in the child;
    # without restarting the marker threads, every full collection in a forked party runs on one thread (about 10x
    # slower than in the parent).
    _gc_start_mark_threads()
    try:
        client(party, foo, control_toggles, True, modulus, *args)
    finally:
        _flush_output()
    _exit(i32(0))


def _reap_parties(children: List[Tuple[int, i32]], grace_us: int) -> List[Tuple[int, int, bool]]:
    # Waits for the forked parties and returns (party, raw wait status or -1 if waitpid failed, killed) for each.
    # grace_us < 0: blocks until every party has exited. grace_us >= 0 (after a failure): the parties still running
    # after grace_us microseconds are killed, since they may be blocked on each other forever.
    statuses = [-2 for _ in range(len(children))]  # -2: still running
    killed = [False for _ in range(len(children))]
    waited = 0
    while True:
        running = 0
        for i in range(len(children)):
            if statuses[i] != -2:
                continue
            status = i32(0)
            rc = waitpid(children[i][1], __ptr__(status), _WNOHANG if grace_us >= 0 else i32(0))
            if rc == children[i][1]:
                statuses[i] = int(status)
            elif rc == i32(0):
                running += 1
            else:
                statuses[i] = -1
        if running == 0:
            break
        if waited >= grace_us:
            for i in range(len(children)):
                if statuses[i] == -2:
                    kill(children[i][1], _SIGKILL)
                    killed[i] = True
            grace_us = -1  # now block until the killed parties are reaped
        else:
            usleep(_REAP_POLL_US)
            waited += _REAP_POLL_US
    return [(children[i][0], statuses[i], killed[i]) for i in range(len(children))]


def _report_failed_parties(results: List[Tuple[int, int, bool]]) -> int:
    failed = 0
    for party, status, killed in results:
        if status == 0:
            continue
        failed += 1
        signal = status & 0x7f
        if killed:
            what = "was killed: still running after another party failed"
        elif status == -1:
            what = "could not be waited for"
        elif signal == 0:
            what = f"exited with status {(status >> 8) & 0xff}"
        elif signal == _SIGABRT:
            what = "aborted (uncaught exception, see its error report above)"
        else:
            what = f"was terminated by signal {signal}"
        print(f"CP{party}:\t{what}", file=sys.stderr)
    return failed


def fork_parties(fork_level, last_pid, foo, control_toggles, modulus, *args):
    # Runs parties fork_level..last_pid on this machine: last_pid in this process, the others in forked children.
    # Returns only if every party succeeded. A party that raises names itself and closes its connections, so the
    # parties waiting on it fail too. The children are then reaped (and killed if still blocked after a grace
    # period), every failed party is reported on stderr, and the run fails: this process's own exception propagates,
    # or it exits with status 1 when only children failed.
    children = List[Tuple[int, i32]]()
    for party in range(fork_level, last_pid):
        _flush_output()
        os_pid = fork()
        if os_pid == i32(0):
            _run_forked_party(party, foo, control_toggles, modulus, *args)
        if os_pid < i32(0):
            _report_failed_parties(_reap_parties(children, 0))
            raise OSError(f"fork() failed while starting CP{party}")
        children.append((party, os_pid))

    finished = False
    try:
        client(last_pid, foo, control_toggles, True, modulus, *args)
        finished = True
    finally:
        if not finished:
            _report_failed_parties(_reap_parties(children, _FAILURE_GRACE_US))
            _flush_output()

    if _report_failed_parties(_reap_parties(children, -1)):
        _flush_output()
        sys.exit(1)


def mpc():
    command = sys.argv[1:]
    flags = [arg for arg in command if arg.startswith('--') or arg == '-h']
    _check_help(flags)
    args = [arg for arg in command if arg not in flags]
    toggles = {toggle: toggle in flags for toggle in RUN_TOGGLES}

    modulus = MPC_RING_SIZE if toggles[RUN_TOGGLES.USE_RING_FLAG] else MPC_FIELD_SIZE
    mpc = MPCEnv(int(args[0]), False, modulus)
    if not toggles[RUN_TOGGLES.MHE_SETUP_SKIP_FLAG]:
        mpc.mhe.default_setup()
    
    return mpc


def local(foo):
    def wrapper_local(*args, **kwargs):
        command = sys.argv[1:]
        flags = [arg for arg in command if arg.startswith('--') or arg == '-h']
        _check_help(flags)
        toggles = {toggle: toggle in flags for toggle in RUN_TOGGLES}
        modulus = MPC_RING_SIZE if toggles[RUN_TOGGLES.USE_RING_FLAG] else MPC_FIELD_SIZE
        fork_parties(0, NUMBER_OF_PARTIES - 1, foo, toggles, modulus, *args, **kwargs)
    
    if CONTROLS.main_called:
        raise RuntimeError(
            "The main (i.e., @main, @local, or @online) method should only be called once per program. "
            "This is a dispatch method that sets up the execution environment.")
    CONTROLS.main_called = True
    
    return wrapper_local


def online(foo):
    def wrapper_online(*args, **kwargs):
        mpc_instance = mpc()
        finished = False
        try:
            foo(mpc_instance, *args, **kwargs)
            mpc_instance.done()
            finished = True
        finally:
            if not finished:
                _shut_down_failed_party(mpc_instance)
    
    if CONTROLS.main_called:
        raise RuntimeError(
            "The main (i.e., @main, @local, or @online) method should only be called once per program. "
            "This is a dispatch method that sets up the execution environment.")
    CONTROLS.main_called = True

    return wrapper_online


def main(foo):
    def wrapper_main(*args, **kwargs):
        command = sys.argv[1:]
        flags = [arg for arg in command if arg.startswith('--') or arg == '-h']
        positional = [arg for arg in command if arg not in flags]
        if RUN_TOGGLES.LOCAL_SETUP_FLAG in sys.argv or len(positional) == 0:
            local(foo)(*args, **kwargs)
        else:
            online(foo)(*args, **kwargs)
    return wrapper_main
