import math
import secure_operator

from sequre import sequre

from sequre.constants import (
    SUPPORTED_ACTIVATIONS, SUPPORTED_ML_METHODS, METHOD_DECOR, METHOD_CHEBYSHEV, SIN_ACTIVATION, COS_ACTIVATION)
from sequre.types.sharetensor import Sharetensor
from sequre.types.utils import double_to_fp, fp_to_double
from sequre.stdlib.numpy.ndarray import ndarray
from sequre.decor.core import via_decor_sincos
from sequre.decor.functions import modulo_float
from activations import activate, activate_with_derivative


class Input[ctype]:
    size: int
    output: ctype

    def __init__(self, size: int):
        self.size = size

    @property
    def input(self) -> ctype:
        return self.output

    @property
    def activation(self) -> str:
        return "None"

    def initialize(self, *args):
        return

    def evaluate(self, mpc, last_output: ctype, training: bool = False):
        self.output = last_output


class Dense[ctype]:
    """
    A dense layer: output = f(pre_act_scale (x W + b)).

    kernel_interval and kernel_scale shape the initial weights: the initializer's draw (on [0, 1) for "uniform") is
    mapped onto kernel_interval, then scaled (SIREN's uniform(-sqrt(6/n)/omega, sqrt(6/n)/omega)); the defaults (0, 1)
    and 1 leave the draw alone at no cost. pre_act_scale multiplies the pre-activation (SIREN's omega_0); the backward
    pass carries the same factor (the chain rule). Decor's sin and cos on a Sharetensor take it into their own
    scaling (one truncation instead of two).

    The activation is evaluated by `method` ("chebyshev", the default, or "decor"; see the activations module) on
    activation_interval ((0, 0): the method's default) with Chebyshev degree activation_degree (0: the default), and
    clipped to the interval first (activation_clip, default True: a layer's pre-activations can leave any interval; for
    Decor's periodic sin, cos, tan and cot the clip does not apply). Clipping saturates: with the default method a sin,
    cos, tan or cot layer is flat beyond (-pi, pi), (-pi, pi), (-1.2, 1.2) or (0.4, 2.7) (sin at sin(+-pi) = 0, cos at
    cos(+-pi) = -1), so size activation_interval to the pre-activations or use method "decor" (any argument). A training
    forward pass keeps the activation's derivative for the backward pass (sin keeps cos from the same Decor opening),
    beyond a clipped interval the clipped function's on Sharetensor and ndarray layers (0 for the saturating
    activations, 0.5 (1 + t) for gelu and s for silu, whose inner tanh or sigmoid is clipped), except on an output layer
    whose loss takes the fused gradient (Sequential sets skip_derivative).
    Cost and accuracy: Decor's sigmoid, tanh, tan, cot, silu and gelu divide, and the field's division is slow: on the
    field a Decor layer costs a few times a Chebyshev one; on the ring about as much as the default Chebyshev (degree 20,
    which errs by about 2e-3 for sigmoid and 4e-3 for tanh) and less than a Chebyshev interpolant as accurate as Decor
    (about 4e-6).

    activation_reduction (Chebyshev sin and cos only; Sharetensor and ndarray layers): the argument is reduced modulo
    2 pi first, so the interpolant runs on (-pi, (2 n_cp + 1) pi) whatever the pre-activations: on ring Sharetensors by
    modulo_float (share by share: the result is congruent to the argument up to a multiple of 2 pi below 2 pi n_cp),
    in the clear exactly. This reduced interval replaces activation_interval, and nothing is clipped (activation_clip is
    ignored). Other layer types refuse at construction, field Sharetensors when the weights are drawn (initialize, at
    compile: no round has run).
    """
    activation: str
    size: int
    kernel_initializer: str
    bias_initializer: str
    kernel_interval: tuple[float, float]
    kernel_scale: float
    pre_act_scale: float
    method: str
    activation_interval: tuple[float, float]
    activation_degree: int
    activation_clip: bool
    skip_derivative: bool  # the output layer of a fused loss (set by Sequential.compile): no derivative is kept
    activation_reduction: bool

    weights: ctype
    bias: ctype
    input: ctype   # x W + b (before pre_act_scale)
    output: ctype
    dact: ctype    # the activation's derivative at the last training forward pass

    # Derivatives
    dw: ctype
    db: ctype

    # Update params
    vw: ctype
    vb: ctype

    def __init__(self, activation: str, size: int, kernel_initializer: str = "uniform", bias_initializer: str = "uniform",
                 kernel_interval: tuple[float, float] = (0.0, 1.0), kernel_scale: float = 1.0,
                 pre_act_scale: float = 1.0, method: str = METHOD_CHEBYSHEV,
                 activation_interval: tuple[float, float] = (0.0, 0.0), activation_degree: int = 0,
                 activation_clip: bool = True, activation_reduction: bool = False):
        assert activation in SUPPORTED_ACTIVATIONS, f"Dense neural net layer: {activation} activation is not supported. Supported activations: {SUPPORTED_ACTIVATIONS}"
        assert method in SUPPORTED_ML_METHODS, f"Dense neural net layer: method {method} is not supported. Supported methods: {SUPPORTED_ML_METHODS}"
        assert kernel_interval[1] > kernel_interval[0], f"Dense neural net layer: kernel_interval {kernel_interval} must have low < high"
        assert not activation_reduction or (method == METHOD_CHEBYSHEV and (activation == SIN_ACTIVATION or activation == COS_ACTIVATION)), "Dense neural net layer: activation_reduction applies to Chebyshev sin and cos"
        if activation_reduction and not (isinstance(ctype, Sharetensor) or isinstance(ctype, ndarray)):
            raise ValueError("Dense neural net layer: activation_reduction takes Sharetensor or ndarray layers")
        self.activation = activation
        self.size = size
        self.kernel_initializer = kernel_initializer
        self.bias_initializer = bias_initializer
        self.kernel_interval = kernel_interval
        self.kernel_scale = kernel_scale
        self.pre_act_scale = pre_act_scale
        self.method = method
        self.activation_interval = activation_interval
        self.activation_degree = activation_degree
        self.activation_clip = activation_clip
        self.skip_derivative = False
        self.activation_reduction = activation_reduction

    def initialize(self, mpc, prev_size: int, *args, **kwargs):
        w_shape = (prev_size, self.size)
        b_shape = (1, self.size)

        weights = ctype.rand(w_shape, self.kernel_initializer, mpc, *args, **kwargs)
        if self.activation_reduction:
            if isinstance(ctype, Sharetensor):
                if weights.modulus.popcnt() != 1:
                    raise ValueError("Dense neural net layer: activation_reduction needs ring shares (--use-ring)")
        lo, hi = self.kernel_interval
        if lo != 0.0 or hi != 1.0 or self.kernel_scale != 1.0:
            weights = Dense[ctype]._shaped(mpc, weights, (hi - lo) * self.kernel_scale, lo * self.kernel_scale)
        self.weights = weights
        self.bias = ctype.rand(b_shape, self.bias_initializer, mpc, *args, **kwargs)

        self.dw = self.weights.zeros()
        self.db = self.bias.zeros()

        self.vw = self.weights.zeros()
        self.vb = self.bias.zeros()

    def is_evaluated(self):
        return not self.output.is_empty()

    def evaluate(self, mpc, last_output: ctype, training: bool = False):
        self.input = Dense[ctype]._affine(mpc, last_output, self.weights, self.bias)
        if isinstance(ctype, Sharetensor):
            if self._fused_periodic():
                s, c = via_decor_sincos(mpc, self.input, scale=self.pre_act_scale)
                if self.activation == SIN_ACTIVATION:
                    self.output = s
                    if training and not self.skip_derivative:
                        self.dact = c
                else:
                    self.output = c
                    if training and not self.skip_derivative:
                        self.dact = Dense[ctype]._negative(mpc, s)
                return
        z = self.input if self.pre_act_scale == 1.0 else Dense[ctype]._scaled(mpc, self.input, self.pre_act_scale)
        interval = self.activation_interval
        clip = self.activation_clip
        if self.activation_reduction:
            z = Dense[ctype]._reduced(mpc, z)
            n_cp = mpc.comms.number_of_parties - 1
            interval = (-math.pi, float(2 * n_cp + 1) * math.pi)
            clip = False
        if training and not self.skip_derivative:
            self.output, self.dact = activate_with_derivative(
                mpc, z, self.activation, self.method, interval, self.activation_degree, clip)
        else:
            self.output = activate(mpc, z, self.activation, self.method, interval, self.activation_degree, clip)

    def derive(self, mpc, prev_output: ctype, dhidden: ctype, fused: bool, LAYER_IDX: Static[int]) -> ctype:
        # fused: dhidden is already the gradient at the activation's input (the output activation paired with its
        # loss), so the activation's derivative is not applied
        return Dense[ctype]._derive(mpc, self, prev_output, dhidden, fused, LAYER_IDX=LAYER_IDX)

    def update(self, mpc, step: float, momentum: float):
        Dense[ctype]._nesterov_update(mpc, self, step, momentum)

    def _fused_periodic(self) -> bool:
        # Decor's sin or cos with a positive pre-activation scale: the scale joins Decor's own 1 / (2 pi) scaling
        return (self.method == METHOD_DECOR and self.pre_act_scale > 0.0 and self.pre_act_scale != 1.0 and
                (self.activation == SIN_ACTIVATION or self.activation == COS_ACTIVATION))

    def _shaped(mpc, weights: ctype, a: float, b: float) -> ctype:
        # a w + b for the initializer's draw w, locally. Every party drew w (rand draws in the clear), so no protocol is
        # needed: on a Sharetensor CP1 holds the draw and the others zeros (Sharetensor.rand), and CP1 maps it exactly;
        # the other types hold it in the clear (ndarray, MPP partitions, MPA's plain data), where public products are
        # local. A secure product would cost a truncation (one opening) per initialization.
        if isinstance(ctype, Sharetensor):
            modulus = weights.modulus
            if mpc.pid == 1:
                values = fp_to_double(weights.share, modulus)
                share = double_to_fp([[a * v + b for v in row] for row in values], modulus)
            else:
                share = weights.share.zeros()
            sv = Sharetensor(share, modulus)
            sv.fp = True
            return sv
        else:
            return secure_operator.add(mpc, secure_operator.mul(mpc, weights, a), b)

    def _reduced(mpc, z: ctype) -> ctype:
        # z modulo 2 pi (activation_reduction): modulo_float on ring Sharetensors, exact in the clear
        if isinstance(ctype, Sharetensor):
            if z.modulus.popcnt() != 1:
                raise ValueError("Dense neural net layer: activation_reduction needs ring shares (--use-ring)")
            return modulo_float(mpc, z, 2.0 * math.pi)
        elif isinstance(ctype, ndarray):
            two_pi = 2.0 * math.pi
            return z.astype(float)._propagate_call(lambda v: v - two_pi * math.floor(v / two_pi))
        else:
            # compiled for every layer type (the option is a runtime flag); __init__ refuses these types already
            raise ValueError("Dense neural net layer: activation_reduction takes Sharetensor or ndarray layers")
            return z

    @sequre
    def _affine(mpc, x: ctype, weights: ctype, bias: ctype) -> ctype:
        return x @ weights + bias

    @sequre
    def _scaled(mpc, x: ctype, scale: float) -> ctype:
        return x * scale

    @sequre
    def _negative(mpc, x: ctype) -> ctype:
        return -x

    @sequre
    def _nesterov_update(mpc, layer: Dense, step: float, momentum: float):
        # Update the weights
        vw_prev = layer.vw.copy()
        layer.vw = layer.vw * momentum - layer.dw * step
        layer.weights += layer.vw * (momentum + 1) - vw_prev * momentum

        # Update the biases
        vb_prev = layer.vb.copy()
        layer.vb = layer.vb * momentum - layer.db * step
        layer.bias += layer.vb * (momentum + 1) - vb_prev * momentum

    @sequre
    def _derive(mpc, layer: Dense, prev_output: ctype, dhidden: ctype, fused: bool, LAYER_IDX: Static[int]) -> ctype:
        # Apply the derivative of the activation (kept from the forward pass)
        if not fused:
            dhidden = dhidden * layer.dact
        # The layer computes f(s (x W + b)): d/d(x W + b) carries the public factor s (the chain rule)
        if layer.pre_act_scale != 1.0:
            dhidden = dhidden * layer.pre_act_scale
        # Compute derivative of weights
        layer.dw = prev_output.T @ dhidden
        # Compute derivative of biases
        layer.db = dhidden.sum(axis=0).expand_dims(axis=0)
        # No need to compute backpropagation of the first layer
        if LAYER_IDX == 1: return layer.output
        # Compute backpropagated activations
        return dhidden @ layer.weights.T
