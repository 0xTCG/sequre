from sequre.stdlib.numpy.create import ones

from sequre.attributes import sequre, mhe_cipher_opt
from sequre.types.internal import Internal as sq
from sequre.constants import EIGEN_DECOMP_ITER_PER_EVAL, MPC_NBIT_F
from sequre.types.sharetensor import Sharetensor

# Regularizes householder's square roots: 16 units in the last place of the fixed-point format, above the truncation
# noise of a near-zero x . x on shares, and about 4e-9 of a unit vector's x . x
HOUSEHOLDER_EPSILON: float = 2.0 ** -float(MPC_NBIT_F - 4)


@sequre
def l2(mpc, data):
    # TODO: Temp bypass until dtype is added to Sharetensor
    # Below lines should be just: dot = data * data @ ones((data.shape[0], data.shape[1]), dtype=data.dtype).T
    if isinstance(data, Sharetensor):
        dot = data * data @ ones((data.shape[0], data.shape[1]), dtype=int).T
    else:
        dot = data * data @ ones((data.shape[0], data.shape[1]), dtype=data.dtype).T
    
    distance = (data + data) @ (-data).T + dot + dot.T
    return sq.sqrt(mpc, distance)


@sequre
def householder(mpc, x):
    # The unit vector v of the reflection I - 2 v^T v that maps x to a multiple of e0: v = (x + shift * e0) / |v| with
    # shift = sign(x0) * |x|. The norm is sqrt(x . x + eps), and |v|^2 = 2 (x . x + x0 * shift) + eps exactly, so v is a
    # unit vector for every x in the clear and on shares, also where x . x is zero or a few units of fixed-point noise:
    # the zero vector gives v = +-e0, the same reflection whatever the sign (secure code cannot tell a zero vector
    # without a comparison, and used to divide 0 by 0). For x . x well above eps the reflection is the usual one, to a
    # relative eps / (x . x). On MPP and MPU inputs x . x carries the HE noise (about 1e-6), far above eps: there a zero
    # or tiny x still gives an arbitrary v (L-251); normal vectors are fine on every type.
    if len(x) == 0:
        return x.copy()
    xdot = sq.dot(mpc, x, axis=0)
    shift = sq.sqrt(mpc, xdot + HOUSEHOLDER_EPSILON) * ((x[0] > 0).astype(float) * 2 - 1)
    v = x.copy()
    v[0] += shift
    return v / sq.sqrt(mpc, (xdot + x[0] * shift) * 2 + HOUSEHOLDER_EPSILON)


@sequre
def qr_fact_square(mpc, A):
    if len(A) == 0:
        return A.copy(), A.copy()
    R = A.zeros()
    Q = A.zeros() + A.I  # a 1 x 1 matrix takes no reflection
    B = A.zeros()

    for i in range(len(A) - 1):
        v = householder(mpc, A[0]).expand_dims()
        P = A.I - (v.T @ v) * 2

        Q[i:] = P if i == 0 else (P @ Q[i:])
        B = A @ P
        R[i:, i] = B[:, 0]
        A = B[1:, 1:]

    # The last diagonal entry: what is left of A (all of it when it is 1 x 1)
    R[-1, -1] = A[0, 0]

    return Q, R


@sequre
def tridiag(mpc, A):
    if len(A) == 0:
        return A.copy(), A.copy()
    Q = A.zeros() + A.I
    T = A.zeros()
    B = A.zeros()

    for i in range(len(A) - 2):
        x = A[0, 1:].pad_right(1)
        v = householder(mpc, x)[:-1].pad_left(1).expand_dims()
        P = A.I - (v.T @ v) * 2

        Q[:, i:] = Q[:, i:] @ P
        B = P @ A @ P

        T[i, i] = B[0, 0]
        T[i + 1, i] = B[1, 0]
        T[i, i + 1] = B[0, 1]
        A = B[1:, 1:]

    # The last 2 x 2 block: what is left of A (all of it when A is 2 x 2 or 1 x 1, already tridiagonal)
    T[-2:, -2:] = A

    return T, Q


@sequre
def eigen_decomp(mpc, A, iter_per_eval = EIGEN_DECOMP_ITER_PER_EVAL):
    if len(A) == 0:
        return A.copy(), A.flatten()
    L = A[0].zeros()
    A, Q = tridiag(mpc, A)
    V = Q.T

    for i in range(len(A) - 1, 0, -1):
        for _ in range(iter_per_eval):
            shift = A.diag(A[i, i])
            Q, R = qr_fact_square(mpc, A - shift)
            A = Q @ R + shift
            V[:i + 1] = Q @ V[:i + 1]
            
        L[i] = A[i, i]
        A = A[:i, :i]

    L[0] = A[0, 0]
        
    return V, L


@sequre
def orthonormalize(mpc, A):
    v_cache = []
    Q = A.zeros() + A.I

    for i in range(len(A)):
        v = householder(mpc, A[0]).expand_dims()
        A = (A - (A @ v.T @ v) * 2)[1:, 1:]
        v_cache.append(v)

    for i in range(len(Q) - 1, -1, -1):
        Qsub = Q[:, i:]
        Q[:, i:] = Qsub - (Qsub @ v_cache[i].T @ v_cache[i]) * 2
    
    return Q
