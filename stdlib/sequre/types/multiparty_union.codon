import internal.static as static

import operator

from numpy import ndarray
from sequre.utils.arrays import empty_ndarray
from numpy import zeros

from sequre.attributes import sequre
from sequre.mpc.env import MPCEnv
from sequre.lattiseq.ckks import Ciphertext
from sequre.types.ciphertensor import Ciphertensor
from sequre.types.multiparty_partition import (
    MPP, ALIGN_ENCRYPT, _agree_on_partitions, _partition_descriptor, _encrypted_layout, _encrypt_like, _plan_indexing,
    _indexing_council, _cuts_rows, _any_diagonal, _cut_rows_through_mpc, D_KIND, D_SIZE, D_UNIFIED, D_LEFT, D_RIGHT,
    MPP_EMPTY, MPP_CLEAR, MPP_UNIFIED, MPP_SEMI)
from sequre.types.multiparty_aggregate import MPA
from sequre.constants import HE_ENC_COST_ESTIMATE, ENC_ROW


# Multiparty union
class MPU[S, dtype]:
    _mpp: MPP[S, dtype]
    _mpa: MPA[S, dtype]

    def __init__(self: MPU[S, dtype], mpc):
        self._mpp = MPP[S, dtype](mpc)
        self._mpa = MPA[S, dtype](mpc)
    
    # MPU(mpc, plain, collective_type) takes S and dtype from the array (an overload per rank: Codon 0.20 infers a
    # class's Tuple[ndim, int] wrongly where the call is a keyword one or inside a generic function, M-TOOL-29)
    def __init__(self: MPU[Tuple[int], dtype], mpc, plain: ndarray[dtype, 1], collective_type: Static[str]):
        self._init_plain(mpc, plain, collective_type)

    def __init__(self: MPU[Tuple[int, int], dtype], mpc, plain: ndarray[dtype, 2], collective_type: Static[str]):
        self._init_plain(mpc, plain, collective_type)

    def _init_plain(self, mpc, plain: ndarray, collective_type: Static[str]):
        if collective_type == "partition":
            self._mpp = MPP[S, dtype](mpc, plain)
            self._mpa = MPA[S, dtype](mpc)
        elif collective_type == "additive":
            self._mpp = MPP[S, dtype](mpc)
            self._mpa = MPA[S, dtype](mpc, plain)
        else:
            compile_error("MPU: invalid collective type. Should be either partition or additive.")

    def __init__(self: MPU[S, dtype], mpc, encryption: Ciphertensor[Ciphertext], collective_type: Static[str]):
        if collective_type == "partition":
            self._mpp = MPP[S, dtype](mpc, encryption)
            self._mpa = MPA[S, dtype](mpc)
        elif collective_type == "additive":
            self._mpp = MPP[S, dtype](mpc)
            self._mpa = MPA[S, dtype](mpc, encryption)
        else:
            compile_error("MPU: invalid collective type. Should be either partition or additive.")

    def __len__(self) -> int:
        self.check_valid()

        if self.is_mpa():
            return len(self._mpa)
        return len(self._mpp)
    
    def __getitem__(self, index) -> MPU:
        self.check_valid()
        
        if self.is_mpa():
            item = self._mpa[index]
            return MPU[item.S, item.dtype](
                _mpp=MPP[item.S, item.dtype](item._mpc),
                _mpa=item)
        
        item = self._mpp[index]
        return MPU[item.S, item.dtype](
            _mpp=item,
            _mpa=MPA[item.S, item.dtype](item._mpc))
    
    def __setitem__(self, index, val: MPU):
        self.check_valid()
        
        if self.is_mpa():
            assert val.is_mpa(), "Not implemented yet: cannot set MPA value into MPP-typed MPU"
            self._mpa[index] = val._mpa
        else:
            assert val.is_mpp(), "Not implemented yet: cannot set MPP value into MPA-typed MPU"
            self._mpp[index] = val._mpp
    
    def __setitem__(self, index, val: float):
        self.check_valid()
        
        if self.is_mpa():
            self._mpa[index] = val
        else:
            self._mpp[index] = val
    
    def __gt__(self, other) -> MPU[S, dtype]:
        if not isinstance(other, ByVal) or isinstance(other, ndarray):
            compile_error("Not implemented yet: Comparison between MPUs and arrays or secure values")
        
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa > other)
        
        return MPU[S, dtype](
            _mpp=self._mpp > other,
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    def __lt__(self, other) -> MPU[S, dtype]:
        if not isinstance(other, ByVal) or isinstance(other, ndarray):
            compile_error("Not implemented yet: Comparison between MPUs and arrays or secure values")
        
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa < other)
        
        return MPU[S, dtype](
            _mpp=self._mpp < other,
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    def __neg__(self) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=-self._mpa)
        
        return MPU[S, dtype](
            _mpp=-self._mpp,
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    def __add__(self, other) -> MPU[S, dtype]:
        self.check_valid()
        if isinstance(other, MPU):
            other.check_valid()
        return self._add(other)
    
    def __sub__(self, other) -> MPU[S, dtype]:
        self.check_valid()
        if isinstance(other, MPU):
            other.check_valid()
        return self._sub(other)
    
    def __mul__(self, other) -> MPU[S, dtype]:
        self.check_valid()
        if isinstance(other, MPU):
            other.check_valid()
        return self._mul(other)
    
    def __matmul__(self, other) -> MPU[S, dtype]:
        self.check_valid()
        if isinstance(other, MPU):
            other.check_valid()
        return self._matmul(other)
    
    def __truediv__(self, other) -> MPU[S, dtype]:
        self.check_valid()
        if isinstance(other, MPU):
            other.check_valid()
        return self._truediv(other)
    
    def __pow__(self, other: int) -> MPU[S, dtype]:
        self.check_valid()
        return self._pow(other)
    
    @property
    def ndim(self) -> int:
        return static.len(S)

    @property
    def shape(self):
        self.check_valid()

        if self.is_mpa():
            return self._mpa.shape
        return self._mpp.cohort_shape
    
    @property
    def cohort_shape(self):
        return self.shape
    
    @property
    def partition_shape(self):
        self.check_valid()

        if self.is_mpa():
            return self._mpa.partition_shape
        return self._mpp.partition_shape
    
    @property
    def shape_local(self):
        self.check_valid()

        if self.is_mpa():
            return self._mpa.shape
        return self._mpp.shape

    @property
    def mpc(self):
        return self._mpp._mpc
    
    @property
    def T(self) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.T)
        
        return MPU[S, dtype](
            _mpp=self._mpp.T,
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    @property
    def I(self) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.I)
        
        return MPU[S, dtype](
            _mpp=self._mpp.I,
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    @staticmethod
    def partition[dtype, ndim: Literal[int]](mpc, plain: ndarray[dtype, ndim]):
        S = type(plain.shape)
        if mpc.pid == 0:
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](mpc, plain.zeros()),
                _mpa=MPA[S, dtype](mpc))
        
        rows_per_party = len(plain) // (mpc.comms.number_of_parties - 1)
        start = (mpc.pid - 1) * rows_per_party
        end = (start + rows_per_party) if mpc.pid < mpc.comms.number_of_parties - 1 else len(plain)
        return MPU[S, dtype](
            _mpp=MPP[S, dtype](mpc, plain[start:end]),
            _mpa=MPA[S, dtype](mpc))

    @staticmethod
    def additive[dtype, ndim: Literal[int]](mpc, plain: ndarray[dtype, ndim]):
        S = type(plain.shape)
        return MPU[S, dtype](
            _mpp=MPP[S, dtype](mpc),
            _mpa=MPA[S, dtype](mpc, plain if mpc.pid == 1 else plain.zeros()))
    
    def enc[dtype, ndim: Literal[int]](self, mpc, data: ndarray[dtype, ndim]):
        S = type(data.shape)
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](mpc),
                _mpa=self._mpa.enc(mpc, data))
        
        return MPU[S, dtype](
            _mpp=self._mpp.enc(mpc, data, self._mpp._ratios),
            _mpa=MPA[S, dtype](mpc))
    
    @staticmethod
    def collective_load[dtype](mpc: MPCEnv, data_path: str, rows: int, cols: int, binary: bool, collective_type: Static[str]) -> MPU[Tuple[int, int], dtype]:
        if collective_type == "partition":
            return MPU[Tuple[int, int], dtype](
                _mpp=MPP[Tuple[int, int], dtype].collective_load(mpc, data_path, rows, cols, binary, dtype=dtype),
                _mpa=MPA[Tuple[int, int], dtype](mpc))
        elif collective_type == "additive":
            return MPU[Tuple[int, int], dtype](
                _mpp=MPP[Tuple[int, int], dtype](mpc),
                _mpa=MPA[Tuple[int, int], dtype].collective_load(mpc, data_path, rows, cols, binary, dtype=dtype))
        else:
            compile_error("MPU: invalid collective type for collective_load. Should be either partition or additive.")
    
    def copy(self) -> MPU[S, dtype]:
        self.check_valid()
        return MPU[S, dtype](
            _mpp=self._mpp.copy(),
            _mpa=self._mpa.copy())
    
    def is_empty(self) -> bool:
        self.check_valid()

        if self.is_mpa():
            return self._mpa.is_empty()
        return self._mpp.is_empty()
    
    def is_mpp(self) -> bool:
        return bool(self._mpp)
    
    def is_mpa(self) -> bool:
        return bool(self._mpa)
    
    def is_valid(self) -> bool:
        return self.is_mpp() ^ self.is_mpa()
    
    def check_valid(self):
        assert self.is_valid(), f"MPU: invalid MPU---should contain either MPP or MPA exclusively. MPP found: {self.is_mpp()}. MPA found: {self.is_mpa()}."
    
    def encrypt(self) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            if self._mpa.is_plain():
                self._mpa.encrypt()
        else:
            self._mpp.encrypt()

        return self
    
    def level(self) -> int:
        self.check_valid()

        if self.is_mpa():
            return self._mpa.level()
        return self._mpp.level()
    
    def reveal(self, *args):
        self.check_valid()
        
        if self.is_mpa():
            return self._mpa.reveal()
        return self._mpp.reveal()
    
    def reveal_local(self, *args):
        self.check_valid()
        
        if self.is_mpa():
            return self._mpa.reveal_local()
        return self._mpp.reveal_local()
    
    def getitem_local(self, index) -> MPU:
        self.check_valid()
        
        if self.is_mpa():
            item = self._mpa[index]
            return MPU[item.S, item.dtype](
                _mpp=MPP[item.S, item.dtype](item._mpc),
                _mpa=item)
        
        item = self._mpp.getitem_local(index)
        return MPU[item.S, item.dtype](
            _mpp=item,
            _mpa=MPA[item.S, item.dtype](item._mpc))
    
    def expand_dims(self, axis: int = 0) -> MPU:
        self.check_valid()
        
        if self.is_mpa():
            expanded = self._mpa.expand_dims(axis)
            return MPU[expanded.S, dtype](
                _mpp=MPP[expanded.S, dtype](self._mpa._mpc),
                _mpa=expanded)
        
        expanded = self._mpp.expand_dims(axis)
        return MPU[expanded.S, dtype](
            _mpp=expanded,
            _mpa=MPA[expanded.S, dtype](self._mpp._mpc))
    
    def extend(self, other: MPU[S, dtype]) -> MPU[S, dtype]:
        self.check_valid()
        other.check_valid()
        
        if self.is_mpa() and other.is_mpa():
            self._mpa.extend(other._mpa)
            return self
        
        if self.is_mpp() and other.is_mpp():
            self._mpp.extend(other._mpp)
            return self
        
        raise NotImplementedError("MPU: extending MPA by MPP and vice-versa")

    def sign(self, *args) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.sign(*args))
        
        return MPU[S, dtype](
            _mpp=self._mpp.sign(*args),
            _mpa=MPA[S, dtype](self._mpp._mpc))

    def cov_max(self, mpc, *args) -> MPU[S, dtype]:
        self.check_valid()

        if self.is_mpa():
            raise NotImplementedError("MPU: cov_max not implemented for MPA")

        return MPU[S, dtype](
            _mpp=self._mpp.cov_max(mpc, *args),
            _mpa=MPA[S, dtype](self._mpp._mpc))

    def sum(self, axis: int) -> MPU[Tuple[int], dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[Tuple[int], dtype](
                _mpp=MPP[Tuple[int], dtype](self._mpa._mpc),
                _mpa=self._mpa.sum(axis))
        
        return self._sum_mpp(axis)
    
    def dot(self, axis: int) -> MPU[Tuple[int], dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[Tuple[int], dtype](
                _mpp=MPP[Tuple[int], dtype](self._mpa._mpc),
                _mpa=self._mpa.dot(axis))
        
        return MPU[Tuple[int], dtype](
            _mpp=self._mpp.dot(axis),
            _mpa=MPA[Tuple[int], dtype](self._mpp._mpc))
    
    def via_mpc(self, foo, *args) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.via_mpc(foo, *args))
        
        return MPU[S, dtype](
            _mpp=self._mpp.via_mpc(foo, *args),
            _mpa=MPA[S, dtype](self._mpp._mpc))

    def astype(self, t: type) -> MPU[S, t]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, t](
                _mpp=MPP[S, t](self._mpa._mpc),
                _mpa=self._mpa.astype(t))
        
        return MPU[S, t](
            _mpp=self._mpp.astype(t),
            _mpa=MPA[S, t](self._mpp._mpc))
    
    def to_fp(self) -> MPU[S, float]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, float](
                _mpp=MPP[S, float](self._mpa._mpc),
                _mpa=self._mpa.to_fp())
        
        return MPU[S, float](
            _mpp=self._mpp.to_fp(),
            _mpa=MPA[S, float](self._mpp._mpc))
    
    def zeros(self, *args) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.zeros(*args))
        
        return MPU[S, dtype](
            _mpp=self._mpp.zeros(*args),
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    def ones(self, *args) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.ones(*args))
        
        return MPU[S, dtype](
            _mpp=self._mpp.ones(*args),
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    @staticmethod
    def rand(shape: S, distribution: str, mpc, collective_type: Static[str] = "additive") -> MPU[S, dtype]:
        if collective_type == "partition":
            return MPU[S, dtype](
                _mpp=MPP[S, dtype].rand(shape, distribution, mpc),
                _mpa=MPA[S, dtype](mpc))
        elif collective_type == "additive":
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](mpc),
                _mpa=MPA[S, dtype].rand(shape, distribution, mpc, plain=True))
        else:
            compile_error("MPU: invalid collective type. Should be either partition or additive.")
    
    # self typed: Codon 0.20 lets an untyped self take a class-qualified call meant for the static
    # overload of this name
    def rand(self: MPU[S, dtype], distribution: str, *args):
        self.check_valid()

        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.rand(distribution))
        
        return MPU[S, dtype](
            _mpp=self._mpp.rand(distribution),
            _mpa=MPA[S, dtype](self._mpp._mpc))

    def hstack(self, other: MPU[S, dtype]) -> MPU[S, dtype]:
        self.check_valid()
        other.check_valid()

        if self.is_mpa() and other.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.hstack(other._mpa))

        if self.is_mpp() and other.is_mpp():
            return MPU[S, dtype](
                _mpp=self._mpp.hstack(other._mpp),
                _mpa=MPA[S, dtype](self._mpp._mpc))
        
        raise NotImplementedError("MPU: hstack of MPP and MPA is not supported yet.")

    def pad_with_value(self, val, size: int, axis: int, *args) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.pad_with_value(val, size, axis, *args))
        
        return MPU[S, dtype](
            _mpp=self._mpp.pad_with_value(val, size, axis, *args),
            _mpa=MPA[S, dtype](self._mpp._mpc))

    def erase_element(self, index: int) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.erase_element(index))
        
        return MPU[S, dtype](
            _mpp=self._mpp.erase_element(index),
            _mpa=MPA[S, dtype](self._mpa._mpc))
    
    def filter(self, mask) -> MPU[S, dtype]:
        self.check_valid()
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa.filter(mask))
        
        return MPU[S, dtype](
            _mpp=self._mpp.filter(mask),
            _mpa=MPA[S, dtype](self._mpa._mpc))
    
    def get_matmul_cost(self, other) -> float:
        self.check_valid()
        
        if isinstance(other, ndarray):
            return self._get_matmul_public_cost(other)

        if self.is_mpa() and other.is_mpa():
            return self._mpa.get_matmul_cost(other._mpa)
        
        if self.is_mpp() and other.is_mpp():
            # As _matmul routes the product
            if self._mpp._transposed and not other._mpp._transposed:
                return MPU[S, dtype]._get_matmul_mpp_t_mpp_cost(self._mpp, other._mpp)

            return self._mpp.get_matmul_cost(other._mpp)
        
        if self.is_mpa():
            return MPU[S, dtype]._get_matmul_mpa_mpp_cost(self._mpa, other._mpp)
        
        return MPU[S, dtype]._get_matmul_mpp_mpa_cost(self._mpp, other._mpa)

    def _get_matmul_public_cost(self, other: ndarray) -> float:
        if self.is_mpa():
            return self._mpa.get_matmul_cost(other)
        
        if self._mpp._transposed:
            start, stop = self._mpp.get_relative_indices()
            return MPU[S, dtype]._get_matmul_mpp_t_mpp_cost(self._mpp, MPP[S, dtype](self._mpp._mpc, other[start:stop], self._mpp._ratios))

        return self._mpp.get_matmul_cost(other)

    @staticmethod
    def _get_matmul_mpa_mpp_cost(mpa: MPA[S, dtype], mpp: MPP[S, dtype]) -> float:
        if mpp._transposed:
            return MPU[S, dtype]._get_matmul_mpa_mpp_t_cost(mpa, mpp)
        
        return MPU[S, dtype]._get_matmul_mpp_mpa_cost(mpp.T, mpa.T)
    
    @staticmethod
    def _get_matmul_mpp_mpa_cost(mpp: MPP[S, dtype], mpa: MPA[S, dtype]) -> float:
        if mpp._transposed:
            return MPU[S, dtype]._get_matmul_mpp_t_mpa_cost(mpp, mpa)
        
        return MPU[S, dtype]._get_matmul_mpp_nt_mpa_cost(mpp, mpa)

    @staticmethod
    def _get_matmul_mpp_t_mpp_cost(first: MPP[S, dtype], other: MPP[S, dtype]) -> float:
        slots = first._mpc.mhe.crypto_params.params.slots()
        
        if first.is_empty() or other.is_empty() or first._mpc.pid == 0:
            matmul_cost = 0.0
        elif first.is_local() and other.is_local():
            matmul_cost = first._local_data.T.get_matmul_cost(other._local_data)
        elif first.is_local():
            matmul_cost = first._local_data.T.get_matmul_cost(other._encryption_unified) + HE_ENC_COST_ESTIMATE * Ciphertensor._count_ciphers(first._local_data.shape, slots)
        elif other.is_local():
            matmul_cost = first._encryption_unified.T.get_matmul_cost(other._local_data) + HE_ENC_COST_ESTIMATE * Ciphertensor._count_ciphers(other._local_data.shape, slots)
        else:
            matmul_cost = first._encryption_unified.T.get_matmul_cost(other._encryption_unified)
        
        return max(first._mpc.comms.collect(matmul_cost, True)[1:])
    
    @staticmethod
    def _get_matmul_mpa_mpp_t_cost(mpa: MPA[S, dtype], mpp: MPP[S, dtype]) -> float:
        slots = mpa._mpc.mhe.crypto_params.params.slots()
        _agg = Ciphertensor[Ciphertext].placeholder(list(mpa.shape), slots)

        if mpp.is_empty() or mpp._mpc.pid == 0:
            cost = 0.0
        elif mpp.is_local():
            cost = _agg.get_matmul_cost(mpp._local_data.T)
        else:
            cost = _agg.get_matmul_cost(mpp._encryption_unified.T)

        return max(mpa._mpc.comms.collect(cost + HE_ENC_COST_ESTIMATE * Ciphertensor._count_ciphers(mpa.shape, slots), True)[1:])

    @staticmethod
    def _get_matmul_mpp_t_mpa_cost(mpp: MPP[S, dtype], mpa: MPA[S, dtype]) -> float:
        mpc = mpp._mpc
        slots = mpa._mpc.mhe.crypto_params.params.slots()

        start, stop = mpp.get_relative_indices()
        other = MPP[S, dtype](mpc, Ciphertensor[Ciphertext].placeholder([stop - start, mpa.shape[1]], slots), mpp._ratios)

        if mpp.is_empty() or mpp._mpc.pid == 0:
            cost = 0.0
        elif mpp.is_local():
            cost = mpp._local_data.T.get_matmul_cost(other._encryption_unified)
        else:
            cost = mpp._encryption_unified.T.get_matmul_cost(other._encryption_unified)
        
        return max(mpa._mpc.comms.collect(cost + HE_ENC_COST_ESTIMATE * Ciphertensor._count_ciphers(mpa.shape, slots), True)[1:])

    @staticmethod
    def _get_matmul_mpp_nt_mpa_cost(mpp: MPP[S, dtype], mpa: MPA[S, dtype]) -> float:
        slots = mpa._mpc.mhe.crypto_params.params.slots()

        _agg = Ciphertensor[Ciphertext].placeholder(list(mpa.shape), slots)
        if mpp.is_empty() or mpp._mpc.pid == 0:
            cost = 0.0
        elif mpp.is_local():
            cost = mpp._local_data.get_matmul_cost(_agg)
        else:
            cost = mpp._encryption_unified.get_matmul_cost(_agg)
        
        return max(mpa._mpc.comms.collect(cost + HE_ENC_COST_ESTIMATE * Ciphertensor._count_ciphers(mpa.shape, slots), True)[1:])

    def _sum_mpp(self, axis: int) -> MPU[Tuple[int], dtype]:
        # Within the partitions (a 2-dim MPP's rows as held: X.sum(1), X.T.sum(0); a held row) the MPP's own sum, with
        # the axis as given (MPP.sum flips it for a transposed MPP: flipping it here too summed the other axis, H-32).
        # Across them (X.sum(0), X.T.sum(1); a column) an MPA whose shares are the parties' partial sums, after
        # MPP._sum_partitions' round and refresh parity: in the clear if every partition is (an empty one's zeros), else
        # encrypted at every party (those in the clear encrypt theirs, an empty one holds encrypted zeros), so that no
        # MPA comes out in the clear at some parties and encrypted at others (M-MP-23, M-MP-24).
        assert self.is_mpp(), "MPU: cannot sum empty MPP"
        mpp = self._mpp
        mpc = mpp._mpc

        assert 0 <= axis < mpp.ndim, "MPU: axis out of range for sum"
        if not mpp._sums_across(axis):
            return MPU[Tuple[int], dtype](
                _mpp=mpp.sum(axis),
                _mpa=MPA[Tuple[int], dtype](mpc))

        held = mpp._held_axis(axis)
        if mpc.pid == 0:
            return MPU[Tuple[int], dtype](
                _mpp=MPP[Tuple[int], dtype](mpc),
                _mpa=MPA[Tuple[int], dtype](mpc, mpp._local_data.sum_axis(held)))

        # length: the sums' length (the partitions' width, or 1 for a column), which an empty partition's zeros take
        _local_data, _encryption_unified, descriptors, length = mpp._sum_partitions(held, True)
        if any(d[D_KIND] == MPP_UNIFIED or d[D_KIND] == MPP_SEMI for d in descriptors):
            if not _local_data.is_empty():
                _encryption_unified = Ciphertensor[Ciphertext].enc(mpc, _local_data, encoding=ENC_ROW)
            elif not _encryption_unified:
                _encryption_unified = Ciphertensor[Ciphertext].zeros(mpc, [length])
            mpa = MPA[Tuple[int], dtype](mpc, _encryption_unified)
        else:
            mpa = MPA[Tuple[int], dtype](mpc, _local_data if not _local_data.is_empty() else zeros((length,), dtype=dtype))

        return MPU[Tuple[int], dtype](
                _mpp=MPP[Tuple[int], dtype](mpc),
                _mpa=mpa)

    def _add(self, other) -> MPU[S, dtype]:
        if isinstance(other, ndarray) or isinstance(other, ByVal):
            return self._public_op(other, operator.add)

        if self.is_mpa() and other.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa + other._mpa)
        
        if self.is_mpp() and other.is_mpp():
            return MPU[S, dtype](
                _mpp=self._mpp + other._mpp,
                _mpa=MPA[S, dtype](self._mpp._mpc))
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=MPU[S, dtype]._add_mpa_mpp(self._mpa, other._mpp))
        
        # Case self is MPP and other is MPA
        if self.shape == other.shape:
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=MPU[S, dtype]._add_mpa_mpp(other._mpa, self._mpp))
        
        if static.len(S) == 2:  # Broadcasting non-2-dimensional MPUs is not implemented yet
            # Broadcast cases
            if 1 == other.shape[0] < self.shape[0] and self.shape[1:] == other.shape[1:]:
                return MPU[S, dtype](
                    _mpp=self._mpp + MPU[S, dtype]._broadcast_mpa_to_mpp(other._mpa, self._mpp),
                    _mpa=MPA[S, dtype](self._mpp._mpc))

        raise ValueError(f"MPU: Cannot sum: shapes missmatch: {self.shape} != {other.shape}")
        
    def _sub(self, other) -> MPU[S, dtype]:
        if isinstance(other, ndarray) or isinstance(other, ByVal):
            return self._public_op(other, operator.sub)

        if self.is_mpa() and other.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa - other._mpa)
        
        if self.is_mpp() and other.is_mpp():
            return MPU[S, dtype](
                _mpp=self._mpp - other._mpp,
                _mpa=MPA[S, dtype](self._mpp._mpc))
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=MPU[S, dtype]._sub_mpa_mpp(self._mpa, other._mpp))
        
        # Case self is MPP and other is MPA
        if self.shape == other.shape:
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=MPU[S, dtype]._add_mpa_mpp(-other._mpa, self._mpp))
        
        if static.len(S) == 2:  # Broadcasting non-2-dimensional MPUs is not implemented yet
            # Broadcast cases
            if 1 == other.shape[0] < self.shape[0] and self.shape[1:] == other.shape[1:]:
                return MPU[S, dtype](
                    _mpp=self._mpp - MPU[S, dtype]._broadcast_mpa_to_mpp(other._mpa, self._mpp),
                    _mpa=MPA[S, dtype](self._mpp._mpc))

        raise ValueError(f"MPU: Cannot sum: shapes missmatch: {self.shape} != {other.shape}")
    
    def _mul(self, other) -> MPU[S, dtype]:
        if isinstance(other, ndarray) or isinstance(other, ByVal):
            return self._public_op(other, operator.mul)

        if self.is_mpa() and other.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa * other._mpa)
        
        if self.is_mpp() and other.is_mpp():
            return MPU[S, dtype](
                _mpp=self._mpp * other._mpp,
                _mpa=MPA[S, dtype](self._mpp._mpc))
        
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=MPU[S, dtype]._mul_mpa_mpp(self._mpa, other._mpp))
        
        return MPU[S, dtype](
            _mpp=MPP[S, dtype](self._mpa._mpc),
            _mpa=MPU[S, dtype]._mul_mpa_mpp(other._mpa, self._mpp))

    def _matmul(self, other) -> MPU[S, dtype]:
        if isinstance(other, ndarray):
            return self._matmul_public(other)

        if self.is_mpa() and other.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa @ other._mpa)
        
        if self.is_mpp() and other.is_mpp():
            # Routed by both factors' flags (public, the same at every party): A.T @ B (each party's product of its own
            # rows of both, an additive result) only when the right factor is not transposed; A.T @ B.T, which is
            # (B @ A).T, and the other cases are MPP's own products (the transposed one went to the A.T @ B kernel, which
            # asserted or computed A.T @ B: H-27)
            if self._mpp._transposed and not other._mpp._transposed:
                return MPU[S, dtype](
                    _mpp=MPP[S, dtype](self._mpp._mpc),
                    _mpa=MPU[S, dtype]._matmul_mpp_t_mpp(self._mpp._mpc, self._mpp, other._mpp))

            return MPU[S, dtype](
                _mpp=self._mpp @ other._mpp,
                _mpa=MPA[S, dtype](self._mpp._mpc))
        
        if self.is_mpa():
            return MPU[S, dtype]._matmul_mpa_mpp(self._mpa._mpc, self._mpa, other._mpp)
        
        return MPU[S, dtype]._matmul_mpp_mpa(self._mpp._mpc, self._mpp, other._mpa)
    
    def _truediv(self, other) -> MPU[S, dtype]:
        if isinstance(other, ByVal):
            return self._public_op(other, operator.truediv)
        raise NotImplementedError("MPUs cannot be divided by secure value yet")
    
    def _pow(self, other: int) -> MPU[S, dtype]:
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa ** other)
        
        return MPU[S, dtype](
            _mpp=self._mpp ** other,
            _mpa=MPA[S, dtype](self._mpp._mpc))
        
    def _public_op(self, other, op) -> MPU[S, dtype]:
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=op(self._mpa, other))
        
        return MPU[S, dtype](
            _mpp=op(self._mpp, other),
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    def _matmul_public(self, other: ndarray) -> MPU[S, dtype]:
        mpc = self.mpc
        if self.is_mpa():
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpa._mpc),
                _mpa=self._mpa @ other)
        
        if self._mpp._transposed:
            start, stop = self._mpp.get_relative_indices()
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](self._mpp._mpc),
                _mpa=MPU[S, dtype]._matmul_mpp_t_mpp(mpc, self._mpp, MPP[S, dtype](mpc, other[start:stop], self._mpp._ratios)))

        return MPU[S, dtype](
            _mpp=self._mpp @ other,
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    def _add_mpa_mpp(mpa: MPA[S, dtype], mpp: MPP[S, dtype], subtract: bool = False) -> MPA[S, dtype]:
        # mpa + mpp (mpa - mpp with subtract), as the user chose on 2026-11-15 (H-23, M-MP-31):
        # - an MPA that is only an aggregate: every partition's encryption goes to every party (one round) and each is
        #   added into the aggregate at its rows, at every party alike; the result is still only an aggregate;
        # - otherwise each compute party adds its partition into its own share: in the clear if every share is in the
        #   clear and every partition in the clear (or empty); else every share encrypted, at every party, in one layout
        #   (_shares_layout), those in the clear encrypting theirs (as MPA's own + does with an encrypted operand), and
        #   each partition added encrypted (a semi-encrypted one unified), through one indexing council at every
        #   compute party (the masks the additions take, and any party's error);
        # - the result carries only the representation the addition updated: an aggregate, or an encryption beside
        #   shares in the clear, would be stale (M + X revealed M's value, M-MP-31, M-MP-02), and aggregate() rebuilds
        #   the aggregate from the shares when an operation needs it.
        # One round among the compute parties agrees on every party's partition and share; the single holder takes the
        # same path as the others (M-MP-09, M-MP-28). The MPA is copied, never viewed (M-MP-10). A partition in another
        # layout than the shares or the aggregate is converted as it is added (Ciphertensor._add_rows: one masked move
        # per value), where that layout is fixed; diagonal storage raises NotImplementedError at every compute party.
        mpc = mpa._mpc
        if mpc.pid == 0:
            return mpa.copy()
        transposed = static.len(S) == 2 and mpp._transposed
        work = mpa.copy().T if transposed else mpa.copy()

        mine = _partition_descriptor(mpp)
        mine.extend([int(work.has_plain()), int(work.has_encryption()), int(work.has_aggregate()), MPU[S, dtype]._layout_code(work._encryption), mpp._held_width()])
        agreed = mpc.comms.collect(mine)
        descriptors = [d[:D_SIZE] for d in agreed]
        states = [d[D_SIZE:] for d in agreed]
        MPU[S, dtype]._check_addend_shapes(work, mpp, descriptors, states)

        aggregate_only = [bool(st[2]) and not st[0] and not st[1] for st in states]
        if any(aggregate_only):
            if not all(aggregate_only):
                raise ValueError("MPU: the MPA is only an aggregate at some compute parties and not at others")
            result = MPA[S, dtype](mpc, MPU[S, dtype]._aggregate_plus_mpp(mpc, work._aggregate, mpp, descriptors, subtract), aggregate=True)
            return result.T if transposed else result

        start, end = MPU[S, dtype]._addend_range(mpp)
        if all(bool(st[0]) for st in states) and all(d[D_KIND] == MPP_EMPTY or d[D_KIND] == MPP_CLEAR for d in descriptors):
            plain = work._plain
            if end > start:
                if subtract:
                    plain[start:end] -= mpp._local_data
                else:
                    plain[start:end] += mpp._local_data
            result = MPA[S, dtype]._from_plain(mpc, plain)
            return result.T if transposed else result

        if any(not st[0] and not st[1] for st in states):
            raise ValueError("MPU: cannot add an MPP to an MPA that holds no share at some compute party")
        if any(d[D_UNIFIED + 3] or d[D_LEFT + 3] or d[D_RIGHT + 3] for d in descriptors):
            raise NotImplementedError("MPU: adding a diagonal-encoded MPP to an MPA is not implemented yet")
        layout = MPU[S, dtype]._shares_layout(descriptors, states)
        if work.has_encryption() and MPU[S, dtype]._layout_code(work._encryption) == layout:
            share = work._encryption
        else:
            share = _encrypt_like(mpc, work._plain, layout == 2)
        share._is_broadcast = False
        take = end > start
        addend = MPU[S, dtype]._partition_encryption(mpc, mpp, layout == 2) if take else Ciphertensor[Ciphertext]()
        # Every compute party holds one council: the masks its addition takes (none where it adds whole stored rows or
        # nothing), and its status, so that a party that cannot add raises at every compute party alike
        masked, status, message = _plan_indexing(lambda: share._add_rows_masked(start, addend) if take else List[Ciphertext]())
        _indexing_council(mpc, masked, status, message)
        if take:
            share._add_rows(mpc, start, addend, subtract, refresh=False)
        result = MPA[S, dtype](mpc, share)
        return result.T if transposed else result

    @staticmethod
    def _check_addend_shapes(work: MPA[S, dtype], mpp: MPP[S, dtype], descriptors: List[List[int]], states: List[List[int]]):
        # The MPP's rows and every partition's width against the MPA's shape (as the partitions hold their rows), from
        # the agreed round: a mismatch raises ValueError at every compute party alike, also where a party holds nothing
        shape = work.shape
        n = shape[1] if static.len(S) == 2 else shape[0]
        whole_vectors = static.len(S) == 1 and not mpp._transposed
        for q in range(len(descriptors)):
            # A column's partitions are its segments: only their total is checked
            if (static.len(S) == 2 or whole_vectors) and descriptors[q][D_KIND] != MPP_EMPTY and states[q][4] != n:
                raise ValueError(f"MPU: cannot add an MPP whose partition at CP{q + 1} holds {states[q][4]} columns (or values) to an MPA of {n}")
        if not whole_vectors and mpp._ratios.sum() != shape[0]:
            raise ValueError(f"MPU: cannot add an MPP of {mpp._ratios.sum()} rows (or values) to an MPA of {shape[0]}")

    @staticmethod
    def _layout_code(enc: Ciphertensor[Ciphertext]) -> int:
        # An encryption's layout as _add_mpa_mpp agrees on it: 0 none, 1 row-wise (a vector's only layout), 2 column-wise,
        # 3 diagonal
        if not enc:
            return 0
        if enc._diagonal_contiguous:
            return 3
        return 2 if enc.ndim == 2 and enc._transposed else 1

    @staticmethod
    def _shares_layout(descriptors: List[List[int]], states: List[List[int]]) -> int:
        # The layout every compute party holds its share encrypted in, as the partitions hold their rows (1 row-wise, 2
        # column-wise): that of the shares held only encrypted (fixed: partitions in the other layout are converted as
        # they are added), else that of the encrypted partitions where they agree (column-wise ones and A @ B.T blocks
        # then shift into place, where row-wise shares would take one masked move per value), else row-wise, which
        # takes row-wise and clear partitions without masking. Raises at every party alike (the agreed round's content)
        # where the shares' layouts differ or one is diagonal.
        if static.len(S) == 1:
            return 1
        share_layouts = [st[3] for st in states if st[1] and not st[0]]
        if any(l == 3 for l in share_layouts):
            raise NotImplementedError("MPU: adding an MPP to an MPA whose shares are diagonal-encoded is not implemented yet")
        if share_layouts:
            if not all(l == share_layouts[0] for l in share_layouts):
                raise NotImplementedError("MPU: the compute parties hold their MPA shares encrypted in different layouts")
            return share_layouts[0]
        if any(d[D_KIND] == MPP_UNIFIED or d[D_KIND] == MPP_SEMI for d in descriptors):
            transposed, _, agreed = _encrypted_layout(descriptors)
            if agreed:
                return 2 if transposed else 1
        return 1

    @staticmethod
    def _partition_encryption(mpc, mpp: MPP[S, dtype], transposed: bool) -> Ciphertensor[Ciphertext]:
        # This compute party's partition, as held, as one encryption: data in the clear encrypted in the given layout, an
        # encryption as it is (a copy), a semi-encrypted partition unified (in its blocks' layout). A 1-dim encryption's
        # flag is cleared (a vector has one layout); a 2-dim one's (a row stored as a column) is its layout and stays.
        if mpp.is_local():
            return _encrypt_like(mpc, mpp._local_data, transposed)
        part = mpp.copy()
        part.unify_encryption()
        out = part._encryption_unified
        if static.len(S) == 1 and out.ndim == 1:
            out._transposed = False
        return out

    @staticmethod
    def _addend_range(mpp: MPP[S, dtype]) -> Tuple[int, int]:
        # This compute party's rows of the MPA (as the partitions hold them) its partition adds into: its rows of the
        # cohort, a column's segment; a 1-dim MPP that is not transposed adds its whole vector (a held row, as before)
        if mpp.is_empty():
            return 0, 0
        if static.len(S) == 1 and not mpp._transposed:
            return 0, mpp._held_width()
        return mpp.get_relative_indices()

    @staticmethod
    def _aggregate_plus_mpp(mpc, aggregate: Ciphertensor[Ciphertext], mpp: MPP[S, dtype], descriptors: List[List[int]], subtract: bool) -> Ciphertensor[Ciphertext]:
        # An aggregate (the same ciphertexts at every party) ± every compute party's partition: each partition's
        # encryption to every party (one round), then each added at its rows, at every party alike (broadcast refreshes,
        # no council), so that the sum stays the same at every party. What every part masks, and the aggregate's
        # ciphertexts that take its placements, are refreshed together once, before any part is added: an aggregate
        # ciphertext that takes placements from several partitions is refreshed once, not once per partition.
        if aggregate._diagonal_contiguous or any(d[D_UNIFIED + 3] or d[D_LEFT + 3] or d[D_RIGHT + 3] for d in descriptors):
            raise NotImplementedError("MPU: adding an MPP to an aggregate where either is diagonal-encoded is not implemented yet")
        own = MPU[S, dtype]._partition_encryption(mpc, mpp, static.len(S) == 2 and aggregate._transposed) if not mpp.is_empty() else Ciphertensor[Ciphertext]()
        parts = mpc.comms.collect(own)
        out = aggregate.copy()
        out._is_broadcast = True
        starts = List[int]()
        masked = List[Ciphertext]()
        offset = 0
        for q in range(len(parts)):
            start = 0 if static.len(S) == 1 and not mpp._transposed else offset
            starts.append(start)
            if parts[q]:
                parts[q]._is_broadcast = True
                masked.extend(out._add_rows_masked(start, parts[q]))
            offset += mpp._ratios[q]
        Ciphertensor._refresh_masked(mpc, masked, True)
        for q in range(len(parts)):
            if parts[q]:
                out._add_rows(mpc, starts[q], parts[q], subtract, refresh=False)
        return out

    def _sub_mpa_mpp(mpa: MPA[S, dtype], mpp: MPP[S, dtype]) -> MPA[S, dtype]:
        return MPU[S, dtype]._add_mpa_mpp(mpa, mpp, subtract=True)
    
    def _mul_mpa_mpp(mpa: MPA[S, dtype], mpp: MPP[S, dtype]) -> MPA[S, dtype]:
        if mpa._mpc.pid == 0:
            return mpa.copy()
        
        # TODO: dtype of Ciphertensor is hardcoded to float at the moment.
        # Thus mpa_float will be autocasted to MPA[S, float] below since mpp.join() returns a Ciphertensor.
        # Manual casting to dtype is required afterwards until a generic dtype is added to Ciphertensor.
        # A transposed 2-dim MPP joins the rows of its transpose: the product is taken against mpa.T and transposed back.
        # A 1-dim MPP joins the vector itself (a column's segments in order), so no transposes: on a 1-dim MPA they
        # flipped the encryption's flag, which then read back as a column of one value (M-MP-27)
        if static.len(S) == 2 and mpp._transposed:
            mpa_float = (mpa.T * mpp.join()).T
        else:
            mpa_float = mpa * mpp.join()
        
        return MPA[S, dtype]._from_parts(
            mpa._mpc,
            mpa_float._plain.astype(dtype),
            mpa_float._encryption,
            mpa_float._aggregate)
    
    def _matmul_mpp_mpa(mpc, mpp: MPP[S, dtype], mpa: MPA[S, dtype]) -> MPU[S, dtype]:
        if mpp._transposed:
            return MPU[S, dtype](
                _mpp=MPP[S, dtype](mpc),
                _mpa=MPU[S, dtype]._matmul_mpp_t_mpa(mpc, mpp, mpa))
        
        return MPU[S, dtype](
            _mpp=MPU[S, dtype]._matmul_mpp_nt_mpa(mpc, mpp, mpa),
            _mpa=MPA[S, dtype](mpc))
    
    def _matmul_mpa_mpp(mpc, mpa: MPA[S, dtype], mpp: MPP[S, dtype]) -> MPU[S, dtype]:
        if mpp._transposed:
            return MPU[S, dtype](
                _mpp=MPU[S, dtype]._matmul_mpa_mpp_t(mpc, mpa, mpp),
                _mpa=MPA[S, dtype](mpc))
        
        return MPU[S, dtype]._matmul_mpp_mpa(mpc, mpp.T, mpa.T).T
    
    @sequre
    def _matmul_mpa_mpp_t(mpc, mpa: MPA[S, dtype], mpp: MPP[S, dtype]) -> MPP[S, dtype]:
        assert mpp._transposed, "MPU: MPP expected to be tranposed in transposed x MPA matmul case"
        
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=mpp._mpc,
                _ratios=mpp._ratios.copy(),
                _local_data=zeros((mpp._local_data.shape[0], mpa.shape[0]), dtype=dtype),
                _transposed=True)
        
        mpa.aggregate()
        _encryption = Ciphertensor[Ciphertext]()
        # Every compute party runs the same HE product: an MPP that some parties hold in the clear and others encrypted is
        # encrypted at every party for it (ALIGN_ENCRYPT; one round), since a product in the clear and one of an
        # encryption by the aggregate differ in their refreshes and in their result's layout
        # The aligner cuts each party's product back to its rows, which a diagonal-encoded result (TNT's, for a
        # column-wise aggregate) cannot be cut by (H-60): a product by a partition in the clear never takes TNT; one by an
        # encrypted partition does, and its diagonal-encoded result is converted once through MPC to row-wise partitions,
        # or column-wise ones for a tall product, before the cut where a party cuts (as in MPP._matmul_case_ntt; the
        # result's columns are the aggregate's rows)
        may_be_diagonal = False
        cut = False
        with mpp.partition_aligner(ALIGN_ENCRYPT) as aligner:
            if not mpp.is_empty():
                allow_mpc_switch = mpc.default_allow_mpc_switch
                allow_diagonal = mpc.default_allow_diagonal_results
                try:
                    if mpp.is_local():
                        # Each party's own product: it never switches to MPC, which would need CP0 (as in H-53). The
                        # aggregate meets this party's data in the clear, so the product is this party's alone: it takes
                        # an unflagged copy, whose refreshes run per party (a plaintext operand counts as public, and
                        # the broadcast mode would take the hub's copy of a per-party product). The aggregate is
                        # refreshed first, in place and in the broadcast mode (one bootstrap for every party, which the
                        # aggregate keeps), so that the copy's refreshes find nothing due: refreshed in the product, the
                        # copy took a bootstrap per party per due ciphertext at every such product (review c21-cr1-4)
                        mpc.mhe.refresh(mpa._aggregate._data, True, min_level_distance=2)
                        mpc.default_allow_mpc_switch = False
                        mpc.default_allow_diagonal_results = False
                        _encryption = MPU[S, dtype]._per_party_copy(mpa._aggregate) @ mpp._local_data.T
                    else:
                        mpp.unify_encryption()
                        # Only a column-wise aggregate (a tall MPA's layout) takes TNT here
                        may_be_diagonal = mpa._aggregate._transposed
                        cut = may_be_diagonal and _cuts_rows(mpp._ratios)
                        mpc.default_allow_diagonal_results = True
                        _encryption = mpa._aggregate @ mpp._encryption_unified.T
                finally:
                    # Restored also when the product raises, so that a caller that goes on routes as CP0 does
                    mpc.default_allow_mpc_switch = allow_mpc_switch
                    mpc.default_allow_diagonal_results = allow_diagonal

            _encryption._transposed ^= True
            if cut and _any_diagonal(mpc, _encryption):
                _encryption = _cut_rows_through_mpc(mpc, _encryption, mpp._ratios, mpa.shape[0])
            result = aligner.new_mpp(
                _encryption_unified=_encryption)
        # TNT's diagonal-encoded result converted once where no party cut (as in MPP._matmul_case_ntt)
        return result._converted_if_diagonal(may_be_diagonal and not cut, mpa.shape[0])
    
    @sequre
    def _matmul_mpp_t_mpa(mpc, mpp: MPP[S, dtype], mpa: MPA[S, dtype]) -> MPA[S, dtype]:
        assert mpp._transposed, "MPU: MPP expected to be tranposed in transposed x MPA matmul case"
        
        if mpc.pid == 0:
            return MPA[S, dtype](mpc, zeros((mpp._local_data.shape[1], mpa._plain.shape[1]), dtype=dtype))
        
        mpa.aggregate()
        other = MPP[S, dtype](
            _mpc=mpc,
            _ratios=mpp._ratios,
            _encryption_unified=MPU[S, dtype]._own_aggregate_rows(mpc, mpa._aggregate, mpp._ratios))
        
        _encryption = Ciphertensor[Ciphertext]()
        # As _matmul_mpa_mpp_t: a mixed MPP is encrypted at every party for the product. The partitions' own products
        # never switch to MPC, which would need CP0.
        with mpp.partition_aligner(ALIGN_ENCRYPT), other.partition_aligner():
            if not mpp.is_empty():
                allow_mpc_switch = mpc.default_allow_mpc_switch
                mpc.default_allow_mpc_switch = False
                if mpp.is_local():
                    _encryption = mpp._local_data.T @ other._encryption_unified
                else:
                    mpp.unify_encryption()
                    _encryption = mpp._encryption_unified.T @ other._encryption_unified
                mpc.default_allow_mpc_switch = allow_mpc_switch
            
            return MPA[S, dtype](mpc, _encryption)
    
    @staticmethod
    def _per_party_copy(aggregate: Ciphertensor[Ciphertext]) -> Ciphertensor[Ciphertext]:
        # A copy of an aggregate for a product with a party's own data in the clear: its own ciphertexts (the product
        # refreshes its operand in place) and no broadcast flag, so that every refresh in the product runs per party
        out = aggregate.copy()
        out._is_broadcast = False
        return out

    @staticmethod
    def _own_aggregate_rows(mpc, aggregate: Ciphertensor[Ciphertext], ratios: List[int]) -> Ciphertensor[Ciphertext]:
        # This compute party's rows of an aggregate (the same ciphertexts at every party), empty for an empty partition
        # (whose empty slice raised there only). A row-wise aggregate's rows are whole ciphertexts. Slicing the rows of a
        # column-wise one masks, and its refreshes (collective bootstraps, the aggregate being broadcast) depend on the
        # slice, so every party slices every party's rows, in party order, and keeps its own. Every party holds the same
        # aggregate, so all take the same branch. (A diagonal-encoded aggregate raises at every party.)
        own = Ciphertensor[Ciphertext]()
        start = 0
        row_wise = not aggregate._transposed and not aggregate._diagonal_contiguous
        for q in range(len(ratios)):
            if ratios[q] and (q == mpc.pid - 1 or not row_wise):
                rows = aggregate._getitem(mpc, slice(start, start + ratios[q], 1))
                if q == mpc.pid - 1:
                    # Copied: whole rows are views of the aggregate's ciphertexts (a row-wise aggregate's, or a
                    # column-wise one's when one party holds every row), and the product refreshes its operand per
                    # party in place, which would leave the aggregate different at each party
                    own = rows.copy()
            start += ratios[q]
        # Each party keeps different rows: per-party data, not the same ciphertexts at every party (a slice of a
        # broadcast tensor stays broadcast, which holds when every party takes the same slice)
        own._is_broadcast = False
        return own

    @sequre
    def _matmul_mpp_nt_mpa(mpc, mpp: MPP[S, dtype], mpa: MPA[S, dtype]) -> MPP[S, dtype]:
        assert not mpp._transposed, "MPU: MPP expected not to be tranposed in transposed x MPA matmul case"

        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=mpp._mpc,
                _ratios=mpp._ratios.copy(),
                _local_data=zeros((mpp._local_data.shape[0], mpa.shape[1]), dtype=dtype))
        
        mpa.aggregate()

        _encryption = Ciphertensor[Ciphertext]()
        # As _matmul_mpa_mpp_t: a mixed MPP is encrypted at every party for the product, and TNT's diagonal-encoded result
        # is converted once through MPC to row-wise partitions, or column-wise ones for a tall product, before the cut
        # where a party cuts (H-60; the result's columns are the aggregate's)
        may_be_diagonal = False
        cut = False
        with mpp.partition_aligner(ALIGN_ENCRYPT) as aligner:
            if not mpp.is_empty():
                allow_mpc_switch = mpc.default_allow_mpc_switch
                allow_diagonal = mpc.default_allow_diagonal_results
                mpc.default_allow_mpc_switch = False
                try:
                    if mpp.is_local():
                        # This party's data in the clear times the aggregate: an unflagged copy of the aggregate,
                        # refreshed first in the broadcast mode (as in _matmul_mpa_mpp_t)
                        mpc.mhe.refresh(mpa._aggregate._data, True, min_level_distance=2)
                        mpc.default_allow_diagonal_results = False
                        _encryption = mpp._local_data @ MPU[S, dtype]._per_party_copy(mpa._aggregate)
                    else:
                        mpp.unify_encryption()
                        # Only column-wise partitions take TNT here
                        may_be_diagonal = _encrypted_layout(aligner.descriptors)[0]
                        cut = may_be_diagonal and _cuts_rows(mpp._ratios)
                        mpc.default_allow_diagonal_results = True
                        _encryption = mpp._encryption_unified @ mpa._aggregate
                finally:
                    mpc.default_allow_mpc_switch = allow_mpc_switch
                    mpc.default_allow_diagonal_results = allow_diagonal

            if cut and _any_diagonal(mpc, _encryption):
                _encryption = _cut_rows_through_mpc(mpc, _encryption, mpp._ratios, mpa.shape[1])
            result = aligner.new_mpp(
                _encryption_unified=_encryption)
        # TNT's diagonal-encoded result converted once where no party cut (as in MPP._matmul_case_ntt)
        return result._converted_if_diagonal(may_be_diagonal and not cut, mpa.shape[1])

    @sequre
    def _matmul_mpp_t_mpp(mpc, first: MPP[S, dtype], other: MPP[S, dtype]) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype](first._mpc, zeros((first._local_data.shape[1], other._local_data.shape[1]), dtype=dtype))

        # The compute parties agree on both factors in one round; a factor that some of them hold in the clear and others
        # encrypted is encrypted at every party for the product (ALIGN_ENCRYPT), so every party runs the same product
        # and the result's shares are all in the clear or all encrypted, in one layout
        first_descriptors, other_descriptors = _agree_on_partitions(first, other)
        MPP._check_same_partitions(first_descriptors, other_descriptors)

        plain = empty_ndarray(dtype, static.len(S))
        enc = Ciphertensor[Ciphertext]()
        
        with first.partition_aligner(ALIGN_ENCRYPT, first_descriptors), other.partition_aligner(ALIGN_ENCRYPT, other_descriptors):
            assert first.shape[1] == other.shape[0], f"MPU: Invalid shapes for per-partition matmul. {first.shape} x {other.shape}"

            if not first.is_empty():
                if not first.is_local():
                    first.unify_encryption()
                if not other.is_local():
                    other.unify_encryption()
                
                allow_mpc_switch = mpc.default_allow_mpc_switch
                mpc.default_allow_mpc_switch = False
                if first.is_local() and other.is_local():
                    plain = first._local_data.T @ other._local_data
                elif first.is_local():
                    enc = first._local_data.T @ other._encryption_unified
                elif other.is_local():
                    enc = first._encryption_unified.T @ other._local_data
                else:
                    enc = first._encryption_unified.T @ other._encryption_unified
                mpc.default_allow_mpc_switch = allow_mpc_switch

        if enc:
            return MPA[S, dtype](first._mpc, enc)
        if not plain.is_empty():
            return MPA[S, dtype](first._mpc, plain)
        return MPA[S, dtype](first._mpc)
    
    @staticmethod
    def _broadcast_mpa_to_mpp(mpa: MPA[S, dtype], mpp: MPP[S, dtype]) -> MPP[S, dtype]:
        # TODO: Figure out a better way to implement this method. Abstract away the broadcasting of _agg (as an independent Ciphertensor method).
        assert not mpp._transposed, "Not implemented yet: broadcasting to a transposed MPP"
        assert mpa.ndim == mpp.ndim == 2, "Not implemented yet: broadcasting non-2-dimensional MPAs to MPPs"
        assert mpa.shape[1] == mpp.shape[1], f"MPU: cannot broadcast mpa of shape {mpa.shape} to MPP of shape {mpp.shape}"
        assert mpa.shape[0] == 1, "MPU: can broadcast only a single-row MPA to MPU"

        mpc = mpa._mpc
        if mpc.pid == 0:
            return mpp
        
        mpa.aggregate()
        # Each party builds its own partition from the copy (its own row count): per-party data, refreshed per party (a
        # broadcast flag would put a partition's refreshes in the broadcast mode, which takes the hub's copy)
        _agg = mpa._aggregate.copy()
        _agg._diagonal_contiguous = False
        _agg._is_broadcast = False

        if mpp._encryption_unified._diagonal_contiguous or mpp._encryption_left._diagonal_contiguous or mpp._encryption_right._diagonal_contiguous:
            if min(mpp.shape) == 1:
                _encryption_unified = _agg.replicate(mpc, mpp._ratios[mpc.pid - 1])
                _encryption_unified._diagonal_contiguous = True

                return MPP[S, dtype](
                    _mpc=mpc,
                    _ratios=mpp._ratios.copy(),
                    _encryption_unified=_encryption_unified,
                    _transposed=mpp._transposed)

        _encryption_unified = Ciphertensor[Ciphertext](
            shape=[0, _agg.shape[1]],
            slots=_agg.slots)
        _agg._skinny = False

        for _ in range(mpp._ratios[mpc.pid - 1]):
            _encryption_unified.extend(mpc, _agg)
        
        if mpp._encryption_unified._diagonal_contiguous or mpp._encryption_left._diagonal_contiguous or mpp._encryption_right._diagonal_contiguous:
            assert _encryption_unified.shape[0] <= _encryption_unified.shape[1], "Not implemented yet: broadcasting skinny matrices"
            _encryption_unified._diagonal_contiguous = True
        
        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=mpp._ratios.copy(),
            _encryption_unified=_encryption_unified,
            _transposed=mpp._transposed)
    
    # Internal typechecker hack
    @property
    def _internal_type(self) -> dtype:
        return dtype()
    
    # Temporaty helpers
    def slice_local(self, i: int, *args) -> MPU[S, dtype]:
        self.check_valid()
        if self.is_mpa():
            raise NotImplementedError()
        
        return MPU[S, dtype](
            _mpp=self._mpp.slice_local(i, *args),
            _mpa=MPA[S, dtype](self._mpp._mpc))
    
    def rotate_local(self, i: int, *args) -> MPU[S, dtype]:
        self.check_valid()
        if self.is_mpa():
            raise NotImplementedError()
        
        return MPU[S, dtype](
            _mpp=self._mpp.rotate_local(i, *args),
            _mpa=MPA[S, dtype](self._mpp._mpc))


@extend
class ndarray:
    def __add__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return other + self
    
    def __sub__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return -other + self
    
    def __mul__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return other * self
    
    def __matmul__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return (other.T @ self.T).T


@extend
class int:
    def __add__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return other + self
    
    def __sub__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return -other + self
    
    def __mul__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return other * self

    def __truediv__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        raise NotImplementedError("Cannot divide by secure value without IR passes enabled.")


@extend
class float:
    def __add__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return other + self
    
    def __sub__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return -other + self
    
    def __mul__[S, T](self, other: MPU[S, T]) -> MPU[S, T]:
        return other * self
