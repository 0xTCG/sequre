import internal.static as static

import secure_operator

from sequre.stdlib.numpy.ndarray import ndarray
from sequre.stdlib.numpy.create import array, zeros, zeros_like, ones, rand

from sequre.attributes import sequre
from sequre.mpc.env import MPCEnv
from sequre.lattiseq.ckks import Ciphertext
from sequre.stdlib.builtin import sign
from sequre.types.builtin import *
from sequre.types.ciphertensor import Ciphertensor, MATMUL_VIA_MPC
from sequre.utils.io import read_ndarray
from sequre.types.utils import double_to_fp, fp_to_double
from sequre.constants import HE_ENC_COST_ESTIMATE, MHE_MUL_TO_ADD_THRESHOLD, MPC_MODULUS_BITS, MPC_NBIT_F


# Fixed point of the shares MPA.reveal masks (_masked_plain_share): twice the MPC fraction bits, and as many integer
# bits as the field leaves once the compute parties' shares are summed (MPA._plain_encoding), so masking adds no
# range limit a float share would plausibly hit (|x| < 2^105 with 192-bit fields and up to seven compute parties)
MPA_REVEAL_FRAC_BITS: Static[int] = 2 * MPC_NBIT_F


# Multiparty aggregate
class MPA[S, dtype]:
    _mpc: MPCEnv[mpc_uint]
    _plain: ndarray[S, dtype]
    _encryption: Ciphertensor[Ciphertext]
    _aggregate: Ciphertensor[Ciphertext]

    def __init__(self: MPA[S, dtype], mpc: MPCEnv[mpc_uint]):
        self._mpc = mpc
        self._plain = ndarray[S, dtype]()
        self._encryption = Ciphertensor[Ciphertext]()
        self._aggregate = Ciphertensor[Ciphertext]()
    
    def __init__(self: MPA[S, dtype], mpc: MPCEnv[mpc_uint], plain: ndarray[S, dtype]):
        self._mpc = mpc
        self._plain = plain if mpc.pid else zeros_like(plain)
        self._encryption = Ciphertensor[Ciphertext]()
        self._aggregate = Ciphertensor[Ciphertext]()
    
    def __init__(self: MPA[S, dtype], mpc: MPCEnv[mpc_uint], encryption: Ciphertensor[Ciphertext], aggregate: bool = False):
        assert mpc.pid, "MPA: encrypted MPA should be separatelly initialized at CP0 for now"
        self._mpc = mpc
        self._plain = ndarray[S, dtype]()
        self._encryption = Ciphertensor[Ciphertext]() if aggregate else encryption
        self._aggregate = encryption if aggregate else Ciphertensor[Ciphertext]()
        # An aggregate is the same ciphertexts at every party: refreshes bootstrap it once, collectively, and keep it so.
        # An encryption is each party's own (also when an operation derived it from a copy of an aggregate).
        if aggregate: self._aggregate._is_broadcast = True
        else: self._encryption._is_broadcast = False

    @staticmethod
    def _from_plain(mpc: MPCEnv[mpc_uint], plain: ndarray[S, dtype]) -> MPA[S, dtype]:
        return MPA[S, dtype](mpc, plain)

    @staticmethod
    def _from_parts(
        mpc: MPCEnv[mpc_uint],
        plain: ndarray[S, dtype],
        encryption: Ciphertensor[Ciphertext],
        aggregate: Ciphertensor[Ciphertext]) -> MPA[S, dtype]:
        out = MPA[S, dtype](mpc, plain)
        out._encryption = encryption
        out._aggregate = aggregate
        if encryption: out._encryption._is_broadcast = False
        if aggregate: out._aggregate._is_broadcast = True
        return out
    
    def __len__(self) -> int:
        return self.shape[0]
    
    def __getitem__(self, index) -> MPA:
        adj_index = self._adjust_indices(index)
        
        if isinstance(type(self._plain[adj_index]), ByVal):
            _plain = ndarray[Tuple[int], dtype]()
        else:
            _plain = type(self._plain[adj_index])()
    
        if self.has_plain():
            _plain_val = self._plain[adj_index]
            _plain = array([_plain_val]) if isinstance(_plain_val, ByVal) else _plain_val

        mpc = self._mpc
        if mpc.pid == 0:
            return MPA[_plain.S, dtype]._from_plain(mpc, _plain)
        
        return MPA[_plain.S, dtype]._from_parts(
            self._mpc,
            _plain,
            self._encryption._getitem(mpc, adj_index) if self.has_encryption() else Ciphertensor[Ciphertext](),
            self._aggregate._getitem(mpc, adj_index) if self.has_aggregate() else Ciphertensor[Ciphertext]())

    def __setitem__(self, index, other: MPA):
        mpc = self._mpc
        if mpc.pid == 0:
            return
        
        adj_index = self._adjust_indices(index)
        
        if other.has_plain():
            assert self.has_plain(), "MPA: cannot set MPA with plain value into MPA without plain value"
            self._plain[adj_index] = other._plain
        
        if other.has_encryption():
            assert self.has_encryption(), "MPA: cannot set MPA with encryption into MPA without encryption"
            self._encryption._setitem(mpc, adj_index, other._encryption)
        
        if other.has_aggregate():
            assert self.has_aggregate(), "MPA: cannot set MPA with aggregate into MPA without aggregate"
            self._aggregate._setitem(mpc, adj_index, other._aggregate)
    
    def __setitem__(self, index, other: float):
        assert self.is_plain(), "MPA: Cannot set float value into plain MPA"
        
        if self._mpc.pid == 0:
            return
        
        adj_index = self._adjust_indices(index)
        self._plain[adj_index] = other
        
    def __gt__(self, other) -> MPA[S, dtype]:
        if isinstance(other, MPA) or isinstance(other, Ciphertensor):
            compile_error("Not implemented yet: Comparison between MPAs and Ciphertensors")
        
        return self.via_mpc(lambda stensor: secure_operator.gt(self._mpc, stensor, other))

    def __lt__(self, other) -> MPA[S, dtype]:
        if isinstance(other, MPA) or isinstance(other, Ciphertensor):
            compile_error("Not implemented yet: Comparison between MPAs and Ciphertensors")

        return self.via_mpc(lambda stensor: secure_operator.lt(self._mpc, stensor, other))

    def __bool__(self) -> bool:
        return not self.is_empty()
    
    def __neg__(self) -> MPA[S, dtype]:
        return MPA[S, dtype]._from_parts(
            self._mpc,
            -self._plain,
            self._encryption.neg(self._mpc),
            self._aggregate.neg(self._mpc))
    
    def __add__(self, other):
        _self, _other = self._check_binary_operands(other)
        return MPA[S, _self.dtype]._add(self._mpc, _self, _other)
    
    def __sub__(self, other):
        _self, _other = self._check_binary_operands(other)
        return MPA[S, _self.dtype]._sub(self._mpc, _self, _other)
    
    def __mul__(self, other):
        _self, _other = self._check_binary_operands(other)
        return MPA[S, _self.dtype]._mul(self._mpc, _self, _other)
    
    def __matmul__(self, other):
        _self, _other = self._check_binary_operands(other)
        if isinstance(_other, ndarray) and static.len(S) == 2:
            if _self._public_matmul_via_mpc(list(_other.shape)):
                # One conversion of the whole MPA (the aggregate, or the sum of the encrypted shares) to MPC and back to
                # an aggregate, at every party, CP0 included
                mpc = self._mpc
                return _self.via_mpc(lambda stensor: secure_operator.matmul(mpc, stensor, _other))
        return MPA[S, _self.dtype]._matmul(self._mpc, _self, _other)
    
    def __truediv__(self, other) -> MPA[S, dtype]:
        if isinstance(other, ByVal):
            return self * (1 / other)
        raise NotImplementedError("MPAs cannot be divided by secure value yet")
    
    def __pow__(self, other: int) -> MPA[S, dtype]:
        return MPA[S, dtype]._from_parts(
            self._mpc,
            self._plain ** other,
            secure_operator.pow(self._mpc, self._encryption, other),
            secure_operator.pow(self._mpc, self._aggregate, other))

    def enc[S, dtype](self, mpc, data: ndarray[S, dtype]) -> MPA[S, dtype]:
        return MPA[S, dtype]._from_plain(mpc, data if mpc.pid == 1 else data.zeros())
    
    @staticmethod
    def collective_load[dtype](mpc: MPCEnv, data_path: str, rows: int, cols: int, binary: bool) -> MPA[Tuple[int, int], dtype]:
        assert rows and cols, "MPA: Collective load can load only matrices"
        
        if mpc.pid == 0:
            return MPA[Tuple[int, int], dtype]._from_plain(mpc, zeros((rows, cols), dtype=dtype))
        
        with open(data_path) as f:
            data = read_ndarray(f, (rows, cols), binary, dtype=dtype)
        
        return MPA[Tuple[int, int], dtype]._from_plain(mpc, data)
    
    def copy(self) -> MPA[S, dtype]:
        return MPA[S, dtype]._from_parts(
            self._mpc,
            self._plain.copy(),
            self._encryption.copy(),
            self._aggregate.copy())
    
    def astype(self, t: type) -> MPA[S, t]:
        if isinstance(dtype, float) and isinstance(t, int):
            compile_error("Not implemented yet: casting MPA[float] to MPA[int]")
        
        return MPA[S, t]._from_parts(
            self._mpc,
            self._plain.astype(t),
            self._encryption.astype(t),
            self._aggregate.astype(t))
    
    def to_fp(self) -> MPA[S, float]:
        return self.astype(float)
    
    def expand_dims(self, axis: int = 0) -> MPA[Tuple[int, int], dtype]:
        if static.len(S) != 1:
            compile_error("MPA: only 1-dim MPPs can be expanded")
        assert axis == 0, "Not implemented yet: MPA dim expansion over secondary axes"
        
        _plain = ndarray[Tuple[int, int], dtype]()
        _encryption = Ciphertensor[Ciphertext]()
        _aggregate = Ciphertensor[Ciphertext]()
        
        if self.has_plain(): _plain = self._plain.expand_dims(axis=axis)
        if self.has_encryption(): _encryption = self._encryption.expand_dims(axis=axis)
        if self.has_aggregate(): _aggregate = self._aggregate.expand_dims(axis=axis)

        return MPA[Tuple[int, int], dtype]._from_parts(
            self._mpc,
            _plain,
            _encryption,
            _aggregate)
    
    @property
    def ndim(self) -> int:
        return static.len(S)
    
    @property
    def shape(self):
        if self.has_plain():
            return self._plain.shape
        
        if self.has_encryption():
            enc = self._encryption
        else:
            assert self.has_aggregate(), "MPA: cannot get shape of empty MPA"
            enc = self._aggregate
        
        if static.len(S) == 1:
            return (enc.actual_shape[0],)
        elif static.len(S) == 2:
            m, n = enc.actual_shape
            return (m, n)
        else:
            compile_error()
    
    @property
    def partition_shape(self):
        if self.is_plain():
            return list(self._plain.shape)
        
        if self.is_distributed():
            return self._encryption.shape
        
        if self.is_aggregate():
            return self._aggregate.shape
        
        return list[int]()
    
    @property
    def T(self):
        return MPA[S, dtype]._from_parts(
            self._mpc,
            self._plain.T if self.has_plain() else self._plain,
            self._encryption.T,
            self._aggregate.T)
    
    @property
    def I(self):
        mpc = self._mpc
        id_mat = ndarray[S, dtype].diag(self.shape, dtype(1))
        return MPA[S, dtype]._from_plain(mpc, id_mat if mpc.pid == mpc.comms.hub_pid else zeros_like(id_mat))
    
    @property
    def modulus(self) -> mpc_uint:
        return self._mpc.default_mpc_modulus
    
    def has_plain(self):
        return not self._plain.is_empty()
    
    def has_encryption(self) -> bool:
        return bool(self._encryption)
    
    def has_distributed(self) -> bool:
        return self.has_plain() or self.has_encryption()
    
    def has_aggregate(self) -> bool:
        return bool(self._aggregate)
    
    def is_plain(self) -> bool:
        return self.has_plain() and not self.has_encryption() and not self.has_aggregate()
    
    def is_distributed(self) -> bool:
        return self.has_distributed() and not self.has_aggregate()
    
    def is_aggregate(self) -> bool:
        return self.has_aggregate() and not self.has_distributed()
    
    def is_empty(self) -> bool:
        return not self.has_distributed() and not self.has_aggregate()

    def encrypt(self):
        mpc = self._mpc
        if mpc.pid == 0 or self.has_encryption():
            return
        
        if not self.has_plain():
            # Only an aggregate: it is encrypted already, and held alike at every compute party, which the operations
            # rely on. Nothing to do (M-MP-19: it used to fall through to the assertion and raise).
            assert self.has_aggregate(), "MPA: Cannot encrypt empty MPA"
            return
        
        self._encryption = Ciphertensor[Ciphertext].enc(mpc, self._plain)
    
    def aggregate(self):
        mpc = self._mpc
        if mpc.pid == 0 or self.has_aggregate():
            return
        
        if self.has_encryption():
            enc = self._encryption
        else:
            assert self.has_plain(), "MPA: Cannot aggregate empty MPA"
            enc = Ciphertensor[Ciphertext].enc(mpc, self._plain)
        
        self._aggregate = enc.aggregate(mpc)
    
    def reveal(self, *args) -> ndarray[S, dtype]:
        # The sum of the shares, to every party; nothing else about the shares
        mpc = self._mpc
        if mpc.pid == 0:
            return self._plain
        
        # One round among the compute parties decides the branch: whether every one holds its share in the clear (or
        # none), and the shape of those shares, which a party without one needs
        mine = [int(self.is_plain() or self.is_empty())]
        mine.extend(list(self._plain.shape) if self.has_plain() else [0 for _ in range(static.len(S))])
        council = mpc.comms.collect(mine)
        if all(bool(d[0]) for d in council):
            return self._reveal_plain_sum(council)
        
        self.aggregate()
        revealed_matrix = self._aggregate.reveal(mpc, T=dtype)
        
        # Ciphertensor.reveal always reveals a matrix at the moment due to legacy work (this should be fixed)
        if static.len(S) == 1:
            return revealed_matrix[0]
        elif static.len(S) == 2:
            return revealed_matrix
        else:
            compile_error("MPA reveal: invalid shape")
    
    def _reveal_plain_sum(self, council: List[List[int]]) -> ndarray[S, dtype]:
        # The sum of the shares every compute party holds in the clear (or none), and nothing else about them (M-MP-15):
        # each party sends the others its share under pairwise masks that cancel in the sum (_masked_plain_share)
        mpc = self._mpc
        shape = List[int]()
        for d in council:
            if any(e != 0 for e in d[1:]):
                shape = d[1:]
                break
        if not shape:
            return self._plain  # every party's share is empty
        size = 1
        for e in shape: size *= e

        modulus = self.modulus
        total = List[mpc_uint](size)
        for _ in range(size): total.append(mpc_uint(0))
        for masked in mpc.comms.collect(self._masked_plain_share(size)):
            total = total.add_mod(masked, modulus)
        values = MPA._decode_plain_sum(total, modulus, mpc.comms.number_of_parties - 1, T=dtype)

        if static.len(S) == 1:
            return array(values, dtype=dtype)
        elif static.len(S) == 2:
            return array(values, dtype=dtype).reshape((shape[0], shape[1]))
        else:
            compile_error("MPA reveal: invalid shape")

    def _masked_plain_share(self, size: int) -> List[mpc_uint]:
        # This compute party's share in the clear (zeros of the given size if it holds none), in fixed point modulo the
        # MPC field, plus a uniform mask from the PRG stream it shares with each other compute party: added towards a
        # higher party and subtracted towards a lower one, so the masks cancel in the sum of every party's vector. With
        # three or more compute parties the vector each party sends is uniform to any other (it lacks a mask); with two,
        # the sum and one's own share give the other's anyway. Every compute party calls it, in step (the pairs' streams).
        mpc = self._mpc
        modulus = self.modulus
        if self.has_plain():
            values = self._plain.flatten().tolist()
        else:
            values = [dtype(0) for _ in range(size)]
        assert len(values) == size, f"MPA reveal: the compute parties' shares differ in size ({len(values)} vs {size})"

        k, f = MPA._plain_encoding(mpc.comms.number_of_parties - 1)
        encoded = List[mpc_uint](size)
        for v in values:
            if isinstance(dtype, float):
                encoded.append(double_to_fp(v, modulus, k, f))
            elif isinstance(dtype, int):
                encoded.append(v.to_int_t(modulus))
            else:
                compile_error("MPA reveal: shares in the clear must be float or int")

        for q in range(1, mpc.comms.number_of_parties):
            if q == mpc.pid:
                continue
            with mpc.randomness.seed_switch(q):
                mask = encoded.rand(modulus, "uniform")
            encoded = encoded.add_mod(mask, modulus) if mpc.pid < q else encoded.sub_mod(mask, modulus)
        return encoded

    @staticmethod
    def _plain_encoding(compute_parties: int) -> Tuple[int, int]:
        # The fixed point (total bits k, fraction bits f) of a float share in _masked_plain_share: a sum of the compute
        # parties' shares stays below 2^(MPC_MODULUS_BITS - 2) in magnitude, inside half the field
        return MPC_MODULUS_BITS - 1 - compute_parties.bitlen(), MPA_REVEAL_FRAC_BITS

    @staticmethod
    def _decode_plain_sum[T](total: List[mpc_uint], modulus: mpc_uint, compute_parties: int) -> List[T]:
        # The sum of the masked shares (the masks cancelled) back to values: centered modulo the field
        out = List[T](len(total))
        if isinstance(T, float):
            _, f = MPA._plain_encoding(compute_parties)
            k_sum = MPC_MODULUS_BITS - 1
            for v in total:
                out.append(0.0 if v == mpc_uint(0) else fp_to_double(v, modulus, k_sum, f))
        elif isinstance(T, int):
            half = modulus >> mpc_uint(1)
            for v in total:
                out.append(int(v) if v <= half else -int(modulus - v))
        else:
            compile_error("MPA reveal: shares in the clear must be float or int")
        return out

    def reveal_local(self, *args) -> ndarray[S, dtype]:
        # This compute party's own share: in the clear as it is; an encrypted share decrypted to this party alone
        # (MPCMHE.decrypt's default mode, in which every compute party takes part, so call it at every party). An MPA
        # that holds only its aggregate, the same ciphertexts at every party, has no share of its own: revealing it
        # reveals the sum, to every party.
        mpc = self._mpc
        if self.has_distributed():
            print(f"CP{mpc.pid}: INFO: Revealing local MPA share")
        elif self.has_aggregate():
            print(f"CP{mpc.pid}: INFO: Revealing aggregated MPA")
        else:
            raise ValueError("MPA: empty MPA share")
        
        if mpc.pid == 0 or self.has_plain():
            return self._plain
        
        if self.has_encryption():
            revealed_matrix = self._encryption.reveal(mpc, T=dtype)
        else:
            revealed_matrix = self._aggregate.reveal(mpc, source_pid=-1, T=dtype)
        
        # Ciphertensor.reveal always reveals a matrix at the moment due to legacy code therein (this should be fixed after Ciphertensor.shape is made static)
        if static.len(S) == 1:
            return revealed_matrix[0]
        elif static.len(S) == 2:
            return revealed_matrix
        else:
            compile_error("MPA reveal: invalid shape")
    
    def level(self) -> int:
        return min(self._encryption.level(), self._aggregate.level())

    def extend(self, other: MPA[S, dtype]) -> MPA[S, dtype]:
        raise NotImplementedError("MPA: extend")
    
    def sign(self, *args) -> MPA[S, dtype]:
        return sign(self._mpc, self)
    
    def sum(self, axis: int) -> MPA[Tuple[int], dtype]:
        if static.len(S) != 2 and static.len(S) != 1:
            compile_error("MPA: invalid shape for sum")
        
        mpc = self._mpc
        if mpc.pid == 0:
            return MPA[Tuple[int], dtype]._from_plain(mpc, self._plain.sum_axis(axis=axis))
        
        if self.has_plain():
            return MPA[Tuple[int], dtype]._from_plain(mpc, self._plain.sum_axis(axis=axis)) 
        elif self.has_encryption():
            return MPA[Tuple[int], dtype](mpc, self._encryption.sum(mpc, axis=axis))
        elif self.has_aggregate():
            return MPA[Tuple[int], dtype](mpc, self._aggregate.sum(mpc, axis=axis), aggregate=True)
        else: # MPA is empty
            return MPA[Tuple[int], dtype](mpc)
    
    def dot(self, axis: int) -> MPA[Tuple[int], dtype]:
        if static.len(S) != 2 and static.len(S) != 1:
            compile_error("MPA: invalid shape for dot product")
        
        return (self * self).sum(axis)
    
    def via_mpc(self, foo, *args):
        return foo(self.to_sharetensor(), *args).to_mpa(self._mpc, dtype=dtype)

    def zeros[S2](self, shape: S2) -> MPA[S2, dtype]:
        return MPA[S2, dtype]._from_plain(self._mpc, zeros(shape, dtype=dtype))
    
    def zeros(self) -> MPA[S, dtype]:
        return MPA[S, dtype]._from_plain(self._mpc, zeros(self.shape, dtype=dtype))
    
    def ones(self, *args) -> MPA[S, dtype]:
        return MPA[S, dtype]._from_plain(self._mpc, ones(self.shape, dtype=dtype))

    def hstack(self, other: MPA[S, dtype]) -> MPA[S, dtype]:
        if self.is_plain() and other.is_plain():
            return MPA[S, dtype]._from_plain(self._mpc, self._plain.hstack(other._plain))

        raise NotImplementedError("MPA: hstack supported only on local/non-encrypted MPAs for now.")
    
    def filter(self, mask) -> MPA[S, dtype]:
        assert self.shape[0] == len(mask), f"MPA: partition and filter mask size mismatch: {self.shape[0]} != {len(mask)}"
        assert self.is_plain(), "Not implemented yet: filtering encrypted MPA"
        
        return MPA[S, dtype]._from_plain(self._mpc, self._plain.filter(mask))
    
    def pad_with_value(self, val, size: int, axis: int, *args) -> MPA[S, dtype]:
        mpc = self._mpc
        if static.len(S) != 2:
            compile_error("MPA: only 2-dim MPPs can be padded with values")
        
        assert axis == 1, "Not implemented yet: MPA pad_with_value over 0-axes"
        shared_value = val if mpc.pid == 1 else type(val)(0)

        if self.has_plain():
            return MPA[S, dtype]._from_plain(mpc, self._plain.pad_with_value(shared_value, size, axis))
        elif self.has_encryption():
            return MPA[S, dtype](mpc, self._encryption.pad_with_value(shared_value, size, axis, mpc))
        else:
            assert self.has_aggregate(), "MPA: empty MPA"
            return MPA[S, dtype](mpc, self._aggregate.pad_with_value(val, size, axis, mpc))

    @staticmethod
    def rand(shape: S, distribution: str, mpc, plain: bool = False) -> MPA[S, dtype]:
        with mpc.randomness.global_stream():
            rand_data = rand(shape, distribution)

        if plain or mpc.pid == 0:
            return MPA[S, dtype](mpc, rand_data if mpc.pid == 1 else zeros(shape, dtype=dtype))
        
        transpose = False
        if static.len(S) == 2:
            transpose = shape[0] > shape[1]
            if transpose:
                rand_data = rand_data.T

        # Every party drew the same data: encrypt it trivially, so the aggregate is the same ciphertexts everywhere.
        enc = Ciphertensor[Ciphertext].enc_public(mpc, rand_data)
        if transpose:
            enc = enc.T
        
        return MPA[S, dtype](mpc, enc, aggregate=True)

    # def rand(shape: S, distribution: str, mpc) -> MPA[S, dtype]:
    #     rand_data = ndarray[S, dtype].rand(shape, distribution)
    #     return MPA[S, dtype](mpc, rand_data if mpc.pid == 1 else zeros(shape, dtype=dtype))

    def rand(self, distribution: str, *args) -> MPA[S, dtype]:
        return MPA[S, dtype].rand(self.shape, distribution, self._mpc)

    def get_matmul_cost(self, other) -> float:
        if isinstance(other, ndarray):
            return MPA[S, dtype]._get_matmul_public_cost(self, other)
        
        slots = self._mpc.mhe.crypto_params.params.slots()
        if self._mpc.pid == 0:
            cost = self._plain.get_matmul_cost(other._plain)
        else:
            _agg_self = Ciphertensor[Ciphertext].placeholder(list(self.shape), slots)
            _agg_other = Ciphertensor[Ciphertext].placeholder(list(other.shape), slots)
            
            if self.has_distributed():
                cost = _agg_self.get_matmul_cost(_agg_other)
            else:
                cost = _agg_other.get_matmul_cost(_agg_self)

        return max(self._mpc.comms.collect(cost + HE_ENC_COST_ESTIMATE * Ciphertensor._count_ciphers(self.shape, slots), True)[1:])
    
    def erase_element(self, index: int) -> MPA[S, dtype]:
        assert self.is_plain(), "Not implemented yet: erasing element of an encrypted MPA"
        return MPA[S, dtype]._from_plain(self._mpc, self._plain.erase_element(index))

    @staticmethod
    def _get_matmul_public_cost(first: MPA[S, dtype], other: ndarray[S, dtype]) -> float:
        if first._mpc.pid == 0 or first.has_plain():
            cost = first._plain.get_matmul_cost(other)
        elif first.has_aggregate():
            cost = first._aggregate.get_matmul_cost(other)
        else:
            assert first.has_encryption(), "MPA: invalid/empty factor"
            cost = first._encryption.get_matmul_cost(other)

        # Every party, CP0 included, decides on the same estimate: the compute parties' largest.
        return max(first._mpc.comms.collect(cost, True)[1:])
    
    # Internal typechecker hack
    @property
    def _internal_type(self) -> dtype:
        return dtype()
    
    def _autocast(self, other):
        if isinstance(other, ByVal):
            if isinstance(other, dtype):
                return self, other
            if isinstance(dtype, int) and isinstance(other, float):
                return self.astype(float), other
            if isinstance(dtype, float) and isinstance(other, int):
                return self, float(other)
        
        assert isinstance(other, MPA) or isinstance(other, Ciphertensor) or isinstance(other, ndarray), "MPA: Autocasting can be done only between MPAs or ndarrays for now"
        
        if isinstance(dtype, type(other._internal_type)):
            return self, other
        if isinstance(dtype, int) and isinstance(type(other._internal_type), float):
            return self.astype(float), other
        if isinstance(dtype, float) and isinstance(type(other._internal_type), int):
            return self, other.astype(float)
        
        compile_error("Cannot autocast dtypes")
    
    def _check_binary_operands(self, other):
        assert isinstance(other, MPA) or isinstance(other, Ciphertensor) or isinstance(other, ndarray) or isinstance(other, ByVal), "MPA: Elem-wise operand should be either MPA, Ciphertensor, ndarray or by-value type"
        return self._autocast(other)
    
    def _adjust_indices(self, index):
        """
        Secure container indexing should be adapted:
            - (row_idx: whatever, col_idx: int) -> (row_idx: whatever, slice(col_idx, col_idx + 1))
            - index -> slice(index, index + 1) (if self is 1-dimensional)
        """
        if isinstance(index, tuple):
            if static.len(index) != 2:
                compile_error("MPA indexing error: MPA can be indexed only up to two dimensions")
            row_idx, col_idx = index
            if isinstance(col_idx, int):
                return (row_idx, slice(start=col_idx, stop=col_idx + 1, step=1))
        
        if static.len(S) == 1:
            if isinstance(index, int):
                return slice(start=index, stop=index + 1, step=1)

        return index

    @sequre
    def _add_public[S, dtype](mpc, self: MPA[S, dtype], other) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype]._from_plain(mpc, self._plain)
        
        if self.has_plain():
            return MPA[S, dtype]._from_plain(mpc, (self._plain + other) if mpc.pid == mpc.comms.hub_pid else self._plain)
        
        if self.has_encryption():
            return MPA[S, dtype](mpc, (self._encryption + other) if mpc.pid == mpc.comms.hub_pid else self._encryption)

        assert self.has_aggregate(), "MPA: invalid/empty addend"
        return MPA[S, dtype](mpc, self._aggregate + other, aggregate=True)
    
    @sequre
    def _add_cipher[S, dtype](mpc, self: MPA[S, dtype], other: Ciphertensor) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype]._from_plain(mpc, self._plain)
        
        if self.is_plain():
            self.encrypt()
        
        if self.has_encryption() and not Ciphertensor.requires_collective(self._encryption, other):
            return MPA[S, dtype](mpc, (self._encryption + other) if mpc.pid == mpc.comms.hub_pid else self._encryption)

        self.aggregate()
        return MPA[S, dtype](mpc, self._aggregate + other, aggregate=True)

    @sequre
    def _add[S, dtype](mpc, self: MPA[S, dtype], other) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype](mpc, self._plain)

        if isinstance(other, ndarray) or isinstance(other, ByVal):
            return MPA[S, dtype]._add_public(mpc, self, other)
        
        if isinstance(other, Ciphertensor):
            return MPA[S, dtype]._add_cipher(mpc, self, other)

        if self.has_plain() and other.has_plain():
            return MPA[S, dtype](mpc, self._plain + other._plain)
        
        if self.has_aggregate() and other.has_aggregate():
            return MPA[S, dtype](mpc, self._aggregate + other._aggregate, aggregate=True)
        
        if self.has_plain() and not other.has_plain():
            self.encrypt()
        if not self.has_plain() and other.has_plain():
            other.encrypt()

        if self.has_distributed():
            if other.has_distributed():
                return MPA[S, dtype](mpc, self._encryption + other._encryption)
            if other.has_aggregate() and not Ciphertensor.requires_collective(self._encryption, other._aggregate):
                return MPA[S, dtype](mpc, (self._encryption + other._aggregate) if mpc.pid == mpc.comms.hub_pid else self._encryption)
        
        if self.has_aggregate() and other.has_encryption() and not Ciphertensor.requires_collective(self._aggregate, other._encryption):
            return MPA[S, dtype](mpc, (self._aggregate + other._encryption) if mpc.pid == mpc.comms.hub_pid else other._encryption)

        self.aggregate()
        other.aggregate()
        return MPA[S, dtype](mpc, self._aggregate + other._aggregate, aggregate=True)
    
    @sequre
    def _sub_public[S, dtype](mpc, self: MPA[S, dtype], other) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype]._from_plain(mpc, self._plain)
        
        if self.has_plain():
            return MPA[S, dtype]._from_plain(mpc, (self._plain - other) if mpc.pid == mpc.comms.hub_pid else self._plain)
        
        if self.has_encryption():
            return MPA[S, dtype](mpc, (self._encryption - other) if mpc.pid == mpc.comms.hub_pid else self._encryption)

        assert self.has_aggregate(), "MPA: invalid/empty addend"
        return MPA[S, dtype](mpc, self._aggregate - other, aggregate=True)
    
    @sequre
    def _sub_cipher[S, dtype](mpc, self: MPA[S, dtype], other: Ciphertensor) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype]._from_plain(mpc, self._plain)
        
        if self.is_plain():
            self.encrypt()
        
        if self.has_encryption() and not Ciphertensor.requires_collective(self._encryption, other):
            return MPA[S, dtype](mpc, (self._encryption - other) if mpc.pid == mpc.comms.hub_pid else self._encryption)

        self.aggregate()
        return MPA[S, dtype](mpc, self._aggregate - other, aggregate=True)

    @sequre
    def _sub[S, dtype](mpc, self: MPA[S, dtype], other) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype](mpc, self._plain)

        if isinstance(other, ndarray) or isinstance(other, ByVal):
            return MPA[S, dtype]._sub_public(mpc, self, other)
        
        if isinstance(other, Ciphertensor):
            return MPA[S, dtype]._sub_cipher(mpc, self, other)

        if self.has_plain() and other.has_plain():
            return MPA[S, dtype](mpc, self._plain - other._plain)
        
        if self.has_aggregate() and other.has_aggregate():
            return MPA[S, dtype](mpc, self._aggregate - other._aggregate, aggregate=True)
        
        if self.has_plain() and not other.has_plain():
            self.encrypt()
        if not self.has_plain() and other.has_plain():
            other.encrypt()

        if self.has_distributed():
            if other.has_distributed():
                return MPA[S, dtype](mpc, self._encryption - other._encryption)
            if other.has_aggregate() and not Ciphertensor.requires_collective(self._encryption, other._aggregate):
                return MPA[S, dtype](mpc, (self._encryption - other._aggregate) if mpc.pid == mpc.comms.hub_pid else self._encryption)
        
        if self.has_aggregate() and other.has_encryption() and not Ciphertensor.requires_collective(self._aggregate, other._encryption):
            return MPA[S, dtype](mpc, (self._aggregate - other._encryption) if mpc.pid == mpc.comms.hub_pid else -other._encryption)

        self.aggregate()
        other.aggregate()
        return MPA[S, dtype](mpc, self._aggregate - other._aggregate, aggregate=True)

    @sequre
    def _mul_public[S, dtype](mpc, self: MPA[S, dtype], other) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype]._from_plain(mpc, self._plain)
        
        if isinstance(other, int):
            if abs(other) < MHE_MUL_TO_ADD_THRESHOLD and not self.is_plain():
                # Do series of additions instead of single multiplication if other operand is small int constant
                return secure_operator.mul_via_add(mpc, self, other)
        
        if self.has_plain():
            return MPA[S, dtype]._from_plain(mpc, self._plain * other)
        
        if self.has_aggregate():
            return MPA[S, dtype](mpc, self._aggregate * other, aggregate=True)
        
        assert self.has_encryption(), "MPA: invalid/empty factor"
        return MPA[S, dtype](mpc, self._encryption * other)
    
    @sequre
    def _mul_cipher[S, dtype](mpc, self: MPA[S, dtype], other: Ciphertensor) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype]._from_plain(mpc, self._plain)
        
        if self.is_plain():
            self.encrypt()
        
        if self.has_aggregate():
            return MPA[S, dtype](mpc, self._aggregate * other, aggregate=True)
        
        assert self.has_encryption(), "MPA: invalid/empty factor"
        return MPA[S, dtype](mpc, self._encryption * other)
    
    @sequre
    def _mul[S, dtype](mpc, self: MPA[S, dtype], other) -> MPA[S, dtype]:
        if mpc.pid == 0:
            return MPA[S, dtype](mpc, self._plain)

        if isinstance(other, ndarray) or isinstance(other, ByVal):
            return MPA[S, dtype]._mul_public(mpc, self, other)
        
        if isinstance(other, Ciphertensor):
            return MPA[S, dtype]._mul_cipher(mpc, self, other)
        
        if __ptr__(self) == __ptr__(other):
            self.aggregate()
            return MPA[S, dtype](mpc, self._aggregate * other._aggregate, aggregate=True)
        
        if self.has_distributed():
            self.encrypt()
            other.aggregate()
            return MPA[S, dtype](mpc, self._encryption * other._aggregate)
        
        if other.has_distributed():
            other.encrypt()
            self.aggregate()
            return MPA[S, dtype](mpc, other._encryption * self._aggregate)
        
        assert self.is_aggregate() and other.is_aggregate(), "MPA: invalid/empty factor"
        return MPA[S, dtype](mpc, other._aggregate * self._aggregate, aggregate=True)

    @sequre
    def _matmul_public[S, dtype](mpc, self: MPA[S, dtype], other: ndarray[S, dtype]) -> MPA[S, dtype]:
        if mpc.pid == 0 or self.has_plain():
            return MPA[S, dtype](mpc, self._plain @ other)

        # Whether to switch to MPC was decided for the whole MPA (_matmul): this product stays in HE, as a switch here
        # would need CP0 and would convert every party's copy of an aggregate
        allow_mpc_switch = mpc.default_allow_mpc_switch
        mpc.default_allow_mpc_switch = False
        if self.has_aggregate():
            result = MPA[S, dtype](mpc, self._aggregate @ other, aggregate=True)
        else:
            assert self.has_encryption(), "MPA: invalid/empty factor"
            result = MPA[S, dtype](mpc, self._encryption @ other)
        mpc.default_allow_mpc_switch = allow_mpc_switch
        return result

    def _public_matmul_via_mpc(self, other_shape: List[int]) -> bool:
        # Under allow_mpc_switch: whether the product with a plaintext matrix of other_shape switches to MPC (H-53).
        # The switch is estimated on the MPA's shape as Ciphertensor's router estimates a row-wise tensor's, from public
        # data; it applies only if the compute parties hold the MPA encrypted (as an aggregate or as encrypted shares)
        # and row-wise, which CP0 cannot see: one round with every party, CP0 included, settles it. Call it at every
        # party.
        mpc = self._mpc
        if not mpc.default_allow_mpc_switch or static.len(S) != 2:
            return False
        slots = mpc.mhe.crypto_params.params.slots()
        shape = list(self.shape)
        placeholder = Ciphertensor[Ciphertext].placeholder(shape, slots)
        if placeholder._ndarray_matmul_route(other_shape, True, mpc.pid, debug=False) != MATMUL_VIA_MPC:
            return False

        if mpc.pid == 0 or self.has_plain():
            eligible = mpc.pid == 0
        else:
            enc = self._aggregate if self.has_aggregate() else self._encryption
            eligible = not enc._transposed and not enc._diagonal_contiguous
        return all(mpc.comms.collect(eligible, include_trusted_dealer=True)[1:])
    
    @sequre
    def _matmul[S, dtype](mpc, self: MPA[S, dtype], other) -> MPA[S, dtype]:
        if isinstance(other, ndarray):
            return MPA[S, dtype]._matmul_public(mpc, self, other)
        
        if mpc.pid == 0:
            return MPA[S, dtype](mpc, self._plain @ other._plain)
        
        if self.has_distributed():
            self.encrypt()
            other.aggregate()
            return MPA[S, dtype](mpc, self._encryption @ other._aggregate)
        
        if other.has_distributed():
            other.encrypt()
            self.aggregate()
            return MPA[S, dtype](mpc, self._aggregate @ other._encryption)

        assert self.is_aggregate() and other.is_aggregate(), "MPA: invalid/empty factor"
        return MPA[S, dtype](mpc, self._aggregate @ other._aggregate, aggregate=True)

    # Temporary helpers
    def slice_local(self, idx: int, *args) -> MPA[S, dtype]:
        raise NotImplementedError()
    
    def rotate_local(self, i: int, *args) -> MPA[S, dtype]:
        raise NotImplementedError()
