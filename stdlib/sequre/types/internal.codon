TP = mpc_uint


@extend
class Sharetensor:
    def to_ciphertensor(self, mpc, target_pid: int = -1) -> ndcipher:
        if len(self) == 0:
            return ndcipher()

        if isinstance(self.share, ByVal): _self = self.expand_dims()
        else: _self = self
        
        share = _self.share
        if isinstance(share, list[list]):
            if mpc.default_ciphertensor_encoding == ENC_COL:
                share = share.transpose()
            elif mpc.default_ciphertensor_encoding == ENC_DIAG:
                share = [share.cyclic_diag(i) for i in range(min(self.shape))]
        
        raw_shape = share.shape.copy()
        if mpc.pid == 0:
            ct = ndcipher.zeros(mpc, raw_shape)
        else:
            slots = mpc.mhe.crypto_params.params.slots()
            ciphervector = mpc.mhe.additive_share_vector_to_ciphervector(share, _self.modulus, self.fp, target_pid=target_pid)
            ct = ndcipher(ciphervector, raw_shape, slots)

        if isinstance(share, list[list]):
            if mpc.default_ciphertensor_encoding == ENC_COL:
                ct._transposed = True
            elif mpc.default_ciphertensor_encoding == ENC_DIAG:
                ct._diagonal_contiguous = True
                ct._skinny = _self.shape[1] < _self.shape[0]
        
        return ct

    def to_mpp[dtype](self, mpc, ratios: list[int], transpose_encryption: bool = False) -> MPP:        
        if isinstance(self.share, list[list]):
            shape = _extract_shape(self.share)
            new_ratios = MPP.apply_ratios(ratios, shape[0])
            
            if mpc.pid == 0:
                return MPP[type(shape), dtype](
                    _mpc=mpc,
                    _ratios=new_ratios,
                    _local_data=zeros(shape, dtype=dtype))

            encrypted_partitions = []
            for p in range(1, mpc.comms.number_of_parties):
                start, end = MPP.get_relative_indices(p, new_ratios)
                partition = self[start:end]

                if transpose_encryption:
                    partition = partition.T
                
                encrypted_partitions.append(partition.to_ciphertensor(mpc, target_pid=p))
            
            encrypted_partition = encrypted_partitions[mpc.pid - 1]
            encrypted_partition._transposed = transpose_encryption

            return MPP[type(shape), dtype](
                _mpc=mpc,
                _ratios=new_ratios,
                _encryption_unified=encrypted_partition)
        
        elif isinstance(self.share, list) or isinstance(self.share, ByVal):
            is_transposed = ratios.sum() > 1
            
            if mpc.pid == 0:
                shape = (self.shape[0],) if isinstance(self.share, list) else (1,)
                return MPP[Tuple[int], dtype](
                    _mpc=mpc,
                    _ratios=ratios,
                    _local_data=zeros(shape, dtype=dtype),
                    _transposed=is_transposed)

            new_mpp = MPP[Tuple[int], dtype](
                _mpc=mpc,
                _ratios=ratios,
                _local_data=ndarray[Tuple[int], dtype](),
                _transposed=is_transposed)
            
            if is_transposed:
                encrypted_partitions = []
                for p in range(1, mpc.comms.number_of_parties):
                    start, end = MPP.get_relative_indices(p, ratios)
                    partition = self[start:end]
                    encrypted_partitions.append(partition.to_ciphertensor(mpc))
                
                encrypted_partition = encrypted_partitions[mpc.pid - 1]
                encrypted_partition._transposed = transpose_encryption
                new_mpp._encryption_unified = encrypted_partition
            else:
                assert ratios.sum() == 1, "Sharetensor: invalid ratios for 1-dim MPC -> MPP conversion"
                _encryption_unified = self.to_ciphertensor(mpc)
                _encryption_unified._transposed = transpose_encryption
                if mpc.pid - 1 == argmax(ratios):
                    new_mpp._encryption_unified = _encryption_unified
            
            return new_mpp

        else:
            compile_error("Invalid shape for MPC -> MPP conversion")
    
    def to_mpa[dtype](self, mpc) -> MPA:
        shape = (1,) if isinstance(self.share, ByVal) else _extract_shape(self.share)
        
        if mpc.pid == 0:
            return MPA(mpc, zeros(shape, dtype=dtype))
        
        return MPA[type(shape), dtype](mpc, self.to_ciphertensor(mpc), aggregate=True)
    
    def to_mpu[dtype](self, mpc, ratios: list[int] = list[int]()) -> MPU:
        if ratios:
            mpp = self.to_mpp(mpc, ratios, dtype=dtype)
            return MPU[mpp.S, dtype](
                _mpp=mpp,
                _mpa=MPA[mpp.S, dtype](mpc))
        
        mpa = self.to_mpa(mpc, dtype=dtype)
        return MPU[mpa.S, dtype](
            _mpp=MPP[mpa.S, dtype](mpc),
            _mpa=mpa)
    
    def sign(self, mpc) -> Sharetensor[TP]:
        return sign(mpc, self)


@extend
class Ciphertensor:
    def to_sharetensor[S, dtype=float](
            self, mpc, modulus: mpc_uint, source_pid: int) -> Sharetensor:
        if not isinstance(dtype, float):
            # Might be possible to support integers, too, in other FHE schemes
            # CKKS is the only supported scheme for now, so we can assume that all ciphertexts are fixed-point
            compile_error("Ciphertensor: only fixed-point tensors can be converted to Sharetensor for now")
        
        padded_cipher_shape = self.cipher_shape
        padded_cipher_shape[-1] *= self.slots
        
        share: list[mpc_uint] = mpc.mhe.ciphervector_to_additive_share_vector(
            self._data, len(self._data) * self.slots, modulus, source_pid=source_pid)
        
        if static.len(S) == 0:
            stensor = Sharetensor(share[0], modulus)
        elif static.len(S) == 1:
            stensor = Sharetensor(share.resize(self.shape), modulus)
        elif static.len(S) == 2:
            stensor = Sharetensor(share.reshape(padded_cipher_shape).resize(self.shape), modulus)
            
            if self._diagonal_contiguous and self._skinny:
                stensor = stensor.diagonal_transpose(True).diagonal_contig(antidiagonal=True).T
            elif self._diagonal_contiguous:
                stensor = stensor.diagonal_contig(antidiagonal=True)
            
            stensor = stensor.T if self._transposed else stensor
        else:
            compile_error("Ciphertensor: invalid shape in MPC conversion")
    
        # Must be fixed-point when converting from MHE
        # because MHE does not support integers (it assumes CKKS)
        stensor.fp = True
        return stensor
    
    def to_mpp[S, dtype](self, mpc, ratios: list[int], source_pid: int) -> MPP[S, dtype]:
        if mpc.pid and mpc.pid != source_pid:
            return MPP[S, dtype](
                _mpc=mpc,
                _ratios=mpc.comms.receive_as_jar(source_pid, list[int]),
                _encryption_unified=mpc.comms.receive_as_jar(source_pid, Ciphertensor[ctype]))

        if static.len(S) == 0:
            shape = (1,)
        elif static.len(S) == 1:
            shape = (self.shape[0],)
        elif static.len(S) == 2:
            shape = (self.shape[0], self.shape[1])
        else:
            compile_error("MPP supports only 0-dim, 1-dim and 2-dim arrays at the momemt")
        
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=mpc,
                _ratios=ratios,
                _local_data=zeros(shape, dtype=dtype))
        
        new_ratios = MPP.apply_ratios(ratios, shape[0])
        
        for p in range(1, mpc.comms.number_of_parties):
            reference_pid = p - 1
            start = new_ratios[:reference_pid].sum()
            end = start + new_ratios[reference_pid]

            if p == source_pid:
                _mpp = MPP[S, dtype](
                    _mpc=mpc,
                    _ratios=new_ratios,
                    _encryption_unified=self._get_rows_raw(slice(start=start, stop=end, step=1)))
            else:
                mpc.comms.send_as_jar(new_ratios, p)
                mpc.comms.send_as_jar(self._get_rows_raw(slice(start=start, stop=end, step=1)), p)
        
        return _mpp


@extend
class MPP:
    def to_sharetensor(self) -> Sharetensor:
        # Call it at every party (CP0 only builds its zero shares, without any message)
        return self._to_sharetensor(self._partition_descriptors())

    def _to_sharetensor(self, descriptors: List[ndcipher]) -> Sharetensor:
        mpc = self._mpc
        modulus = self.modulus
        # The shares are fixed point whatever the dtype. Partitions switched from MHE come out fixed point, and CP0 cannot
        # tell whether the compute parties hold their partitions in the clear or encrypted, so integer partitions in the
        # clear are scaled to fixed point too (exactly): every party then takes the same fixed-point steps (truncations),
        # with no exchange.
        if mpc.pid == 0:
            stensor = Sharetensor(self._local_data.zeros().tolist().to_int_t(modulus), modulus)
            stensor.fp = True
            return stensor.T if self._transposed else stensor

        # The compute parties share each partition in turn, as its descriptor (MPP._partition_descriptors) says: one held
        # in the clear by its holder with share_from, where the others pass zeros of the holder's shape, so that the
        # masks they draw from their pairwise PRGs match the holder's; an encrypted one by the collective switch of its
        # ciphertexts, which every compute party has. An empty partition contributes nothing, and any mix works.
        pieces = []
        for p in range(1, mpc.comms.number_of_parties):
            descriptor = descriptors[p - 1]
            if descriptor:
                pieces.append(descriptor.to_sharetensor(mpc, modulus, source_pid=-1, S=S, dtype=float))
            elif descriptor.shape:
                if p == mpc.pid:
                    data = self._local_data
                elif static.len(S) == 1:
                    data = zeros((descriptor.shape[0],), dtype=dtype)
                else:
                    data = zeros((descriptor.shape[0], descriptor.shape[1]), dtype=dtype)
                pieces.append(Sharetensor.enc(mpc, data, p, modulus).to_fp())

        if pieces:
            stensor = pieces.unfence()
        else:
            stensor = Sharetensor(self._local_data.zeros().tolist().to_int_t(modulus), modulus)
            stensor.fp = True

        return stensor.T if self._transposed else stensor


@extend
class MPA:
    def to_sharetensor(self) -> Sharetensor:
        mpc = self._mpc
        # Fixed point whatever the dtype, as for MPP.
        if mpc.pid == 0:
            stensor = Sharetensor(self._plain.tolist().to_int_t(self.modulus), self.modulus)
            stensor.fp = True
            return stensor

        # An aggregate is held alike at every compute party, so they all take its path or none. Otherwise they all enter
        # one council on how they hold their shares: all in the clear, each shares its own; any encrypted, every party
        # aggregates (aggregate() encrypts a share held in the clear), so an MPA held in the clear at some parties and
        # encrypted at others goes the encrypted way (M-MP-24: only the parties in the clear entered the council)
        if not self.has_aggregate() and mpc.council(self.is_plain()).all():
            stensors = [Sharetensor.enc(mpc, self._plain.astype(dtype), p, self.modulus) for p in range(1, mpc.comms.number_of_parties)]
            return stensors.sum().to_fp()
        self.aggregate()
        return self._aggregate.to_sharetensor(mpc, self.modulus, source_pid=-1, S=S, dtype=float)


@extend
class MPU:
    def to_sharetensor(self) -> Sharetensor:
        self.check_valid()
        
        if self.is_mpa():
            return self._mpa.to_sharetensor()
        return self._mpp.to_sharetensor()


# Wrappers
@sequre
@flatten(0)
def pow_wrapper(mpc, x, p):
    modulus = x.modulus

    if x.is_fp():
        # TODO: #58 Implement efficient pows calculation for FPs
        x_pow = x
        for _ in range(p - 1):
            x_pow = x_pow * x
        return x_pow

    x_r, r = x.get_partitions(mpc, force=False)
    c = mpc.polynomial.powers_cached(x_r, r, p, modulus)[p]
    
    sv = Sharetensor(c, modulus)
    sv.fp = x.is_fp()

    # TODO: #23 Efficiently calculate beaver partitions of c here
    # TODO: #23 Check if there is a way to calculate cached sqrts efficiently
    return sv


def _trunc_public(value, modulus: mpc_uint, m: int = MPC_NBIT_F):
    # Local truncation of a public fixed-point value (scalar, list or matrix) by m bits: values above modulus / 2 are
    # negative, so they shift as -((modulus - v) >> m) (a plain >> would be wrong for them). Rounds toward zero.
    if isinstance(value, list):
        return [_trunc_public(e, modulus, m) for e in value]

    if value > (modulus >> mpc_uint(1)):
        q = (modulus - value) >> mpc_uint(m)
        return modulus - q if q else mpc_uint(0)
    return value >> mpc_uint(m)


class InternalMPC:
    def evalp(mpc, x_, coefs_, exps_):
        assert isinstance(x_[0], Sharetensor), "Secure polynomial evaluation is enabled only for Sharetensor"
        for x in x_:
            assert not x.fp, "Not implemented error: Polynomial evaluation is not implemented for fixed-point numbers yet"
        modulus = x_[0].modulus
        
        x_r = []
        r = []

        for sn in x_:
            x_r_, r_ = sn.get_partitions(mpc, force=False)
            x_r.append(x_r_)
            r.append(r_)

        coefs = [coefs_[i].to_int_t(modulus) for i in range(len(coefs_))]
        exps = [[exps_[i + j] for j in range(len(x_))]
                for i in range(0, len(exps_), len(x_))]
        
        result = mpc.polynomial._beaver_evaluate_poly(
            x_r, r, coefs, exps, modulus)
        sv = Sharetensor(result, modulus)
        sv.fp = x_[0].is_fp()
        
        # TODO: #23 Handle sqrts and partitions

        return sv

    def add(mpc, x, y):
        # Public float vectors/matrices (Decor adds public evaluations at the opened point): fixed-point encoded, added
        # once (at the hub) to a fixed-point tensor.
        if isinstance(x, Sharetensor) and (isinstance(y, List[float]) or isinstance(y, List[List[float]])):
            x_fp = x.to_fp()
            if x_fp.public:
                return InternalMPC.__public_plus_floats(x_fp, y)
            return InternalMPC.__add_public(mpc, y.to_fp(x_fp.modulus), x_fp, False)
        elif isinstance(y, Sharetensor) and (isinstance(x, List[float]) or isinstance(x, List[List[float]])):
            return InternalMPC.add(mpc, y, x)
        elif isinstance(x, float):
            return InternalMPC.__plus_constant(mpc, x.to_fp(y.modulus), y)
        elif isinstance(y, float):
            return InternalMPC.__plus_constant(mpc, y.to_fp(x.modulus), x)
        elif isinstance(x, int):
            return InternalMPC.__plus_constant(mpc, x.to_fp(y.modulus) if y.fp else mpc_uint(x), y)
        elif isinstance(y, int):
            return InternalMPC.__plus_constant(mpc, y.to_fp(x.modulus) if x.fp else mpc_uint(y), x)
        elif isinstance(x, Sharetensor[list[list[mpc_uint]]]) and isinstance(y, Sharetensor[list[mpc_uint]]):
            return x.broadcast_add(y)
        elif isinstance(x, Sharetensor[list[mpc_uint]]) and isinstance(y, Sharetensor[mpc_uint]):
            return x.broadcast_add(y)
        else:
            if not x.is_public() and not y.is_public():
                return x + y
            elif x.is_public() and y.is_public():
                return InternalMPC.__public_sum(x, y.share)
            elif x.is_public():
                return InternalMPC.__add_public(mpc, x.share, y, x.diagonal)
            elif y.is_public():
                return InternalMPC.__add_public(mpc, y.share, x, y.diagonal)

            raise ValueError("Invalid type of addends in secure add")

    def sub(mpc, x, y):
        if isinstance(x, Sharetensor) and (isinstance(y, List[float]) or isinstance(y, List[List[float]])):
            x_fp = x.to_fp()
            if x_fp.public:
                return InternalMPC.__public_plus_floats(x_fp, -y)
            return InternalMPC.__add_public(mpc, (-y).to_fp(x_fp.modulus), x_fp, False)
        elif isinstance(y, Sharetensor) and (isinstance(x, List[float]) or isinstance(x, List[List[float]])):
            y_fp = y.to_fp()
            if y_fp.public:
                return InternalMPC.__public_plus_floats(-y_fp, x)
            return InternalMPC.__add_public(mpc, x.to_fp(y_fp.modulus), -y_fp, False)
        elif isinstance(x, float):
            return InternalMPC.__plus_constant(mpc, x.to_fp(y.modulus), -y)
        elif isinstance(y, float):
            return InternalMPC.__plus_constant(mpc, (-y).to_fp(x.modulus), x)
        elif isinstance(x, int):
            return InternalMPC.__plus_constant(mpc, x.to_fp(y.modulus) if y.fp else mpc_uint(x), -y)
        elif isinstance(y, int):
            return InternalMPC.__plus_constant(mpc, (-y).to_fp(x.modulus) if x.fp else (x.modulus - y), x)
        elif isinstance(x, Sharetensor[list[list[mpc_uint]]]) and isinstance(y, Sharetensor[list[mpc_uint]]):
            return x.broadcast_add(-y)
        elif isinstance(x, Sharetensor[list[mpc_uint]]) and isinstance(y, Sharetensor[mpc_uint]):
            return x.broadcast_add(-y)
        else:
            if not x.is_public() and not y.is_public():
                return x + (-y)
            elif x.is_public() and y.is_public():
                return InternalMPC.__public_sum(x, y.share.neg_mod(x.modulus))
            elif x.is_public():
                return InternalMPC.__add_public(mpc, x.share, -y, x.diagonal)
            elif y.is_public():
                return InternalMPC.__add_public(mpc, y.share.neg_mod(x.modulus), x, y.diagonal)

            raise ValueError("Invalid type of addends in sub")

    def mul(mpc, x, y):
        if isinstance(x, Sharetensor) and (isinstance(y, List[float]) or isinstance(y, List[List[float]])):
            # Element-wise scaling by a public float vector/matrix (Decor's public evaluations)
            modulus = x.modulus
            c_share = x.share.mul_mod(double_to_fp(y, modulus), modulus)

            if x.is_fp() and x.public:
                c_share = _trunc_public(c_share, modulus)
            elif x.is_fp():
                c_share = mpc.fp.trunc(c_share, modulus)

            sv = Sharetensor(c_share, modulus)
            sv.fp = True
            sv.public = x.public
            return sv
        elif isinstance(y, Sharetensor) and (isinstance(x, List[float]) or isinstance(x, List[List[float]])):
            return InternalMPC.mul(mpc, y, x)
        elif isinstance(x, float):
            return InternalMPC.mul(mpc, y, x)
        elif isinstance(y, float):
            y_fp = double_to_fp(y, x.modulus)
            sv = x * y_fp
            # TODO: #117 Implement clever joint truncations pattern matcher
            if x.is_fp():
                if x.public:
                    sv = Sharetensor(_trunc_public(sv.share, x.modulus), x.modulus)
                else:
                    sv = sv.trunc(mpc.fp)
            sv.fp = True
            sv.public = x.public
            return sv
        else:
            if x.public or y.public:
                # A public operand multiplies each share locally. Two fixed-point factors leave the product at scale
                # 2^(2F): a secret product needs the truncation protocol, a public one (both factors public) a local
                # signed shift (M-MPC-08).
                modulus = x.modulus if y.public else y.modulus
                c_share = x.share.mul_mod(y.share, modulus)
                if x.is_fp() and y.is_fp():
                    if x.public and y.public:
                        c_share = _trunc_public(c_share, modulus)
                    else:
                        c_share = mpc.fp.trunc(c_share, modulus)
                sv = Sharetensor(c_share, modulus)
                sv.fp = x.is_fp() or y.is_fp()
                sv.public = x.public and y.public
                return sv
            
            assert x.modulus == y.modulus, f"Non-matching moduli for factors: {x.modulus} != {y.modulus}"
            modulus = x.modulus

            x_1_r, r_1 = x.get_partitions(mpc, force=False)
            x_2_r, r_2 = y.get_partitions(mpc, force=False)

            c = mpc.arithmetic.__beaver_mul(x_1_r, r_1, x_2_r, r_2, modulus)
            c = mpc.arithmetic.__beaver_reconstruct(c, modulus)

            if x.is_fp() and y.is_fp():
                c = mpc.fp.trunc(c, modulus)
            
            sv = Sharetensor(c, modulus)
            sv.fp = x.is_fp() or y.is_fp()

            # TODO: #23 Efficiently calculate beaver partitions of c here
            # Bellow is temp dirty solution for beaver partitioning which should be both:
            # - Computed with less network overhead
            # - Computed only if compiler figures out that partitions will be needed downstream
            # sv.set_partitions(mpc.arithmetic.__beaver_partition(sv.share, modulus))

            # TODO: #23 Check if there is a better way to do this
            # if x.sqrt and y.sqrt:
            #     sv.sqrt = mpc.arithmetic.multiply(x.sqrt, y.sqrt, modulus)
            #     sv.sqrt = mpc.fp.trunc(sv.sqrt, modulus)
            #     sv.sqrt_inv = mpc.arithmetic.multiply(x.sqrt_inv, y.sqrt_inv, modulus)
            #     sv.sqrt_inv = mpc.fp.trunc(sv.sqrt_inv, modulus)
            return sv

    def pow(mpc, x_, p):
        return pow_wrapper(mpc, x_, p)

    def div(mpc, x, y):
        # TODO: #26 Currently does not work for complex algebraic structures.
        # Resolve issue #26 and change code below in order to fix this.
        if isinstance(y, float) or isinstance(y, int):
            sv = x * double_to_fp(1.0 / y, x.modulus)
            if x.is_fp():
                if x.public:
                    sv = Sharetensor(_trunc_public(sv.share, x.modulus), x.modulus)
                else:
                    sv = sv.trunc(mpc.fp)
            sv.fp = True
            sv.public = x.public
            return sv
        else:
            # TODO: Efficiently calculate beaver partitions of sv here
            return fp_div(mpc, x, y)
    
    def __as_shares(mpc, x):
        # A public tensor holds its value at every party; as a comparison operand it becomes a sharing held by the hub
        # (CP1, where add_public adds) with zeros elsewhere, so the difference and the sign test count it once
        if not x.public:
            return x
        sv = Sharetensor(x.share if mpc.pid == 1 else x.share.zeros(), x.modulus)
        sv.fp = x.fp
        return sv

    def __fp_constant(c: float, modulus: TP, scaled_integers: bool):
        # (fixed-point encoding of a public constant, wide). Against fixed-point values (|x| < 2^(K - F - 1)) a constant
        # beyond that range is clamped to +-2^(K - F) exactly, which leaves every in-range comparison as it is
        # (double_to_fp would saturate it and lose its sign), and the difference is wide. Against integer shares scaled
        # into fixed point (values up to about 2^(L - F - 2)) it is encoded over L - 1 bits, exactly below
        # 2^(L - F - 2) and clamped beyond, and the difference is always wide.
        if scaled_integers:
            wide_bound = 2.0 ** (MPC_MODULUS_BITS - MPC_NBIT_F - 2)
            if c >= wide_bound or c <= -wide_bound:
                w = TP(1) << TP(MPC_MODULUS_BITS - 2)
                if c > 0:
                    return w, True
                return (modulus - w) % modulus, True
            return double_to_fp(c, modulus, k=MPC_MODULUS_BITS - 1), True
        bound = 2.0 ** (MPC_NBIT_K - MPC_NBIT_F - 1)
        if c >= bound or c <= -bound:
            v = TP(1) << TP(MPC_NBIT_K)
            if c > 0:
                return v, True
            return (modulus - v) % modulus, True
        return double_to_fp(c, modulus), False

    def __minus_public(mpc, s, c, reverse: bool):
        # (s - c, wide), or (c - s, wide) if reverse, for a Sharetensor s (not public) and a public constant c: an int,
        # a float or a raw TP. A raw TP stays raw; an int meets integer shares raw and fixed-point ones in fixed point
        # (H-10); a float puts integer shares in fixed point first. Negative constants are reduced mod the
        # modulus (M-MPC-10's comparison part). Other constant types are refused (they would be mis-scaled).
        modulus = s.modulus
        if isinstance(c, TP):
            enc = c % modulus
            magnitude = enc if enc <= (modulus >> TP(1)) else modulus - enc
            wide = s.is_fp() and magnitude >= (TP(1) << TP(MPC_NBIT_K - 1))
        elif isinstance(c, int):
            if s.is_fp():
                enc, wide = InternalMPC.__fp_constant(float(c), modulus, False)
            else:
                enc, wide = c.to_int_t(modulus), False
        elif isinstance(c, float):
            if s.is_fp():
                enc, wide = InternalMPC.__fp_constant(c, modulus, False)
            else:
                s = s.to_fp()
                enc, wide = InternalMPC.__fp_constant(c, modulus, True)
        else:
            compile_error("Sequre comparison: a public operand must be an int, a float or an mpc_uint")
        if reverse:
            share = mpc.arithmetic.add_public(s.share.zeros().sub_mod(s.share, modulus), enc, modulus)
        else:
            share = mpc.arithmetic.add_public(s.share, (modulus - enc) % modulus, modulus)
        d = Sharetensor(share, modulus)
        d.fp = s.fp
        return d, wide

    def __difference(mpc, x, y):
        # (x - y, wide) for a comparison; x or y is a Sharetensor, the other a Sharetensor or a public int, float or
        # raw TP. Public tensors count once (__as_shares). Fixed point on either side puts both in fixed point: int and
        # float constants are encoded in fixed point (H-10), non-fixed-point Sharetensors scaled. wide: the difference
        # may leave the K + 1 bits of two fixed-point values (an integer operand scaled into fixed point, or a constant
        # beyond the fixed-point range), so the ring's sign test takes the modulus' L bits.
        if isinstance(x, Sharetensor) and isinstance(y, Sharetensor):
            xs = InternalMPC.__as_shares(mpc, x)
            ys = InternalMPC.__as_shares(mpc, y)
            if xs.is_fp() != ys.is_fp():
                return InternalMPC.sub(mpc, xs.to_fp(), ys.to_fp()), True
            return InternalMPC.sub(mpc, xs, ys), False
        elif isinstance(x, Sharetensor):
            return InternalMPC.__minus_public(mpc, InternalMPC.__as_shares(mpc, x), y, False)
        else:
            return InternalMPC.__minus_public(mpc, InternalMPC.__as_shares(mpc, y), x, True)

    def __positive_share(mpc, d, wide: bool):
        # Shares of [d > 0] (strict: 0 gives 0). Ring: the ring sign test over K + 1 bits for a fixed-point d (any
        # difference of two fixed-point values), K + F + 1 inside MPCEnv.delayed_truncation() (products keep scale
        # 2^(2F) there), the modulus' L bits for integers and wide differences. Field: is_positive.
        modulus = d.modulus
        if modulus.popcnt() == 1:
            if wide or not d.is_fp():
                return mpc.bitwise.sign_ring(d.share, modulus, bits=MPC_MODULUS_BITS)
            elif mpc.fp.truncation_allowed():
                return mpc.bitwise.sign_ring(d.share, modulus, bits=MPC_NBIT_K + 1)
            else:
                return mpc.bitwise.sign_ring(d.share, modulus, bits=MPC_NBIT_K + MPC_NBIT_F + 1)
        return mpc.boolean.is_positive(d.share, modulus)

    def __ne_ring(mpc, flat, fp: bool, wide: bool, modulus):
        # [d != 0] for a list of ring shares of d: [d > 0] + [-d > 0] from one sign test of the concatenation
        n = len(flat)
        both = flat.copy()
        both.extend(flat.zeros().sub_mod(flat, modulus))
        both_st = Sharetensor(both, modulus)
        both_st.fp = fp
        signs = InternalMPC.__positive_share(mpc, both_st, wide)
        return signs[:n].add_mod(signs[n:], modulus)

    def gt(mpc, x, y):
        # [x > y] as 0/1 integer shares, on both moduli (H-10, H-12); x or y is a Sharetensor, the other may be a public
        # int, float or raw TP
        d, wide = InternalMPC.__difference(mpc, x, y)
        return Sharetensor(InternalMPC.__positive_share(mpc, d, wide), d.modulus)

    def lt(mpc, x, y):
        # [x < y] = [y - x > 0]
        d, wide = InternalMPC.__difference(mpc, y, x)
        return Sharetensor(InternalMPC.__positive_share(mpc, d, wide), d.modulus)

    def eq(mpc, x, y):
        return InternalMPC.sub(mpc, 1, InternalMPC.ne(mpc, x, y))

    def ne(mpc, x, y):
        d, wide = InternalMPC.__difference(mpc, x, y)
        modulus = d.modulus
        if modulus.popcnt() == 1:
            # [d > 0] + [-d > 0] from one sign test of (d, -d)
            if isinstance(d.share, TP):
                res = InternalMPC.__ne_ring(mpc, [d.share], d.fp, wide, modulus)
                return Sharetensor(res[0], modulus)
            elif isinstance(d.share, list[list]):
                res = InternalMPC.__ne_ring(mpc, d.share.flatten(), d.fp, wide, modulus)
                return Sharetensor(res.reshape(d.shape), modulus)
            else:
                return Sharetensor(InternalMPC.__ne_ring(mpc, d.share, d.fp, wide, modulus), modulus)

        # Field: the squared difference against 0 (unchanged: wrong when d^2 leaves the field comparison's range,
        # |d| >= about 2^47.5 raw units, and for fixed-point differences below about 2^(-F/2), which square to 0)
        return InternalMPC.gt(mpc, InternalMPC.mul(mpc, d, d), 0)

    def sqrt_inv(mpc, x, y):
        # TODO: #26 Currently does not work for complex algebraic structures.
        # Resolve issue #26 and change code below in order to fix this.
        
        if not y.sqrt_inv:
            s, sinv = fp_sqrt(mpc, y)
            y.sqrt, y.sqrt_inv = s.share, sinv.share
        
        if isinstance(x, int):
            sv = Sharetensor(y.sqrt_inv, y.modulus)
            sv.fp = True
            # TODO: #23 Efficiently calculate beaver partitions of c here
            # Bellow is temp dirty solution for beaver partitioning which should be both:
            # - Computed with less network overhead
            # - Computed only if compiler figures out that partitions will be needed downstream
            # sv.set_partitions(mpc.arithmetic.__beaver_partition(sv.share, modulus))
            return sv * x
        else:
            assert x.modulus == y.modulus
            modulus = x.modulus
            
            x_1_r, r_1 = x.get_partitions(mpc, force=False)
            x_2_r, r_2 = mpc.arithmetic.__beaver_partition(y.sqrt_inv, modulus)
            
            c = mpc.arithmetic.__beaver_mul(x_1_r, r_1, x_2_r, r_2, modulus)
            c = mpc.arithmetic.__beaver_reconstruct(c, modulus)
            if x.is_fp():
                c = mpc.fp.trunc(c, modulus)
            
            sv = Sharetensor(c, modulus)
            sv.fp = True
            # TODO: #23 Efficiently calculate beaver partitions of c here
            # Bellow is temp dirty solution for beaver partitioning which should be both:
            # - Computed with less network overhead
            # - Computed only if compiler figures out that partitions will be needed downstream
            # sv.set_partitions(mpc.arithmetic.__beaver_partition(sv.share, modulus))
            
            return sv

    def dot(mpc, x, y, axis: int):
        return x.dot(mpc, y, axis=axis)

    def dot(mpc, x, axis: int):
        return InternalMPC.dot(mpc, x, x, axis)

    def matmul(mpc, x, y):
        if isinstance(x, ndarray):
            modulus = y.modulus
            c = x.to_int_t(modulus) @ y.share

            if y.is_fp() and isinstance(type(x.data[0]), float):
                c = mpc.fp.trunc(c, modulus)
            
            sv = Sharetensor(c, modulus)
            sv.fp = y.is_fp() or isinstance(type(x.data[0]), float)
            return sv
        
        if isinstance(y, ndarray):
            modulus = x.modulus
            c = x.share @ y.to_int_t(modulus)

            if x.is_fp() and isinstance(type(y.data[0]), float):
                c = mpc.fp.trunc(c, modulus)
            
            sv = Sharetensor(c, modulus)
            sv.fp = x.is_fp() or isinstance(type(y.data[0]), float)
            return sv
        
        assert x.modulus == y.modulus
        modulus = x.modulus

        x_1_r, r_1 = x.get_partitions(mpc, force=False)
        x_2_r, r_2 = y.get_partitions(mpc, force=False)

        c = mpc.arithmetic.__beaver_matmul(x_1_r, r_1, x_2_r, r_2, modulus)
        c = mpc.arithmetic.__beaver_reconstruct(c, modulus)

        if x.is_fp() and y.is_fp():
            c = mpc.fp.trunc(c, modulus)
        
        sv = Sharetensor(c, modulus)
        sv.fp = x.is_fp() or y.is_fp()

        # TODO: #23 Efficiently calculate beaver partitions of sv here
        # Bellow is temp dirty solution for beaver partitioning which should be both:
        # - Computed with less network overhead
        # - Computed only if compiler figures out that partitions will be needed downstream
        # sv.set_partitions(mpc.arithmetic.__beaver_partition(sv.share, modulus))
        
        # TODO: #23 Check if there is a better way to do this
        # if x.sqrt and y.sqrt:
        #     sv.sqrt = mpc.arithmetic.multiply(x.sqrt, y.sqrt, modulus)
        #     sv.sqrt = mpc.fp.trunc(sv.sqrt, modulus)
        #     sv.sqrt_inv = mpc.arithmetic.multiply(x.sqrt_inv, y.sqrt_inv, modulus)
        #     sv.sqrt_inv = mpc.fp.trunc(sv.sqrt_inv, modulus)
        
        return sv

    def sqrt(mpc, x):
        # TODO: #26 Currently does not work for complex algebraic structures.
        # Resolve issue #26 and change code below in order to fix this.
        if not x.sqrt:
            s, sinv = fp_sqrt(mpc, x)
            x.sqrt, x.sqrt_inv = s.share, sinv.share
        
        sv = Sharetensor(x.sqrt, x.modulus)
        sv.fp = True
        # TODO: #23 Efficiently calculate beaver partitions of sv here
        return sv

    def reveal_to_all(mpc, value):
        value.share = mpc.comms.reveal_to_all(value.share, value.modulus)
        value.public = True
        return value

    def dist(mpc, shape, name, modulus, params):
        if name == 'normal':
            rows, cols = shape
            # The dealer's draws: secret to the compute parties, who get shares
            with mpc.randomness.private():
                gaussian = [[double_to_fp(prg.gauss(*params), modulus) if mpc.pid == 0 else TP(0)
                            for _ in range(cols)] for _ in range(rows)]
            gaussian = mpc.comms.share_from_trusted_dealer(gaussian, modulus)

            stensor = Sharetensor(gaussian, modulus)
            stensor.fp = True

            return stensor

        raise NotImplementedError(f'Distribution {name} not implemented yet.')
    
    def __plus_constant(mpc, c, y):
        # A public constant (encoded) plus y: added once (at the hub) to shares; added at every party to a public tensor,
        # which stays public (each party holds the whole value)
        if y.public:
            sv = Sharetensor(y.share.add_mod(c, y.modulus), y.modulus)
            sv.fp = y.fp
            sv.public = True
            return sv
        return InternalMPC.__add_public(mpc, c, y, False)

    def __public_sum(x, other_share):
        # Two public tensors (every party holds both values): added at every party, and the sum stays public (adding x
        # once at the hub to a public y gave x + n_cp y)
        sv = Sharetensor(x.share.add_mod(other_share, x.modulus), x.modulus)
        sv.fp = x.fp
        sv.public = True
        return sv

    def __public_plus_floats(x, y):
        # A public tensor holds its value at every party: the constant goes to every party, and the sum stays public.
        sv = Sharetensor(x.share.add_mod(y.to_fp(x.modulus), x.modulus), x.modulus)
        sv.fp = True
        sv.public = True
        return sv

    def __add_public(mpc, x_public, y, diagonal):
        share = y.share
        modulus = y.modulus

        if isinstance(share, list[list]) and isinstance(x_public, list[list]):
            if diagonal:
                for i in range(len(share)):
                    share[i][i] = mpc.arithmetic.add_public(share[i][i], x_public[i][i], modulus)
            else: share = mpc.arithmetic.add_public(share, x_public, modulus)
        else: share = mpc.arithmetic.add_public(share, x_public, modulus)
        
        sv = Sharetensor(share, modulus)
        sv.fp = y.fp

        if y.sqrt:
            sv.sqrt = type(share)(0)
            sv.sqrt_inv = type(share)(0)
        
        if not y.is_partitioned():
            return sv
        
        sv.x_r = y.x_r.add_mod(x_public, modulus)
        sv.r = y.r

        return sv        


class InternalMHE:
    def getitem(mpc, x, indices):
        return x._getitem(mpc, indices)
    
    def setitem(mpc, x, indices, value):
        return x._setitem(mpc, indices, value)

    def add(mpc, x, y):
        return x.add(mpc, y)

    def sub(mpc, x, y):
        return x.sub(mpc, y)
    
    def mul(mpc, x, y):
        return x.mul(mpc, y)

    def matmul(mpc, x, y):
        return x.matmul(mpc, y)
    
    def pow(mpc, x, p):
        return x.pow(mpc, p)
    
    def gt(mpc, x, y):
        raise NotImplementedError()
        return x  # To avoid typechecker error

    def lt(mpc, x, y):
        raise NotImplementedError()
        return x  # To avoid typechecker error

    def eq(mpc, x, y):
        raise NotImplementedError()
        return x  # To avoid typechecker error
    
    def ne(mpc, x, y):
        raise NotImplementedError()
        return x  # To avoid typechecker error


class InternalMPP:
    def dot(x, axis: int):
        return x.dot(axis)
    
    def matmul(x, y):
        return x.matmul(y)

    def sqrt(x):
        return x.via_mpc(lambda stensor: InternalMPC.sqrt(x._mpc, stensor))
    
    def sqrt_inv(x, y):
        return x * y.via_mpc(lambda stensor: InternalMPC.sqrt_inv(y._mpc, 1, stensor))


class InternalMPU:
    def dot(x, axis: int):
        return x.dot(axis)
    
    def matmul(x, y):
        return x @ y

    def sqrt(x):
        return x.via_mpc(lambda stensor: InternalMPC.sqrt(x.mpc, stensor))
    
    def sqrt_inv(x, y):
        return x * y.via_mpc(lambda stensor: InternalMPC.sqrt_inv(y.mpc, 1, stensor))


class Internal:
    def secure_getitem(mpc, x, indices):
        if isinstance(x, Ciphertensor):
            return InternalMHE.getitem(mpc, x, indices)
        else: compile_error("Invalid secure operands")
    
    def secure_setitem(mpc, x, indices, value):
        if isinstance(x, Ciphertensor):
            return InternalMHE.setitem(mpc, x, indices, value)
        else: compile_error("Invalid secure operands")

    def secure_add(mpc, x, y):
        mpc.stats.secure_add_count += 1
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.add(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.add(mpc, x, y)
        else: compile_error("Invalid secure operands")

    def secure_sub(mpc, x, y):
        mpc.stats.secure_sub_count += 1
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.sub(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.sub(mpc, x, y)
        else: compile_error("Invalid secure operands")

    def secure_mul(mpc, x, y):
        mpc.stats.secure_mul_count += 1
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.mul(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.mul(mpc, x, y)
        else: compile_error("Invalid secure operands")
    
    def secure_matmul(mpc, x, y):
        mpc.stats.secure_matmul_count += 1
        if isinstance(x, MPU) or isinstance(y, MPU):
            return InternalMPU.matmul(x, y)
        elif isinstance(x, MPP) or isinstance(y, MPP):
            return InternalMPP.matmul(x, y)
        elif isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.matmul(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.matmul(mpc, x, y)
        else: compile_error("Invalid secure operands")

    def secure_pow(mpc, x_, p):
        if isinstance(x_, Sharetensor):
            return InternalMPC.pow(mpc, x_, p)
        elif isinstance(x_, Ciphertensor):
            return InternalMHE.pow(mpc, x_, p)
        else: compile_error("Invalid secure operands")

    def secure_div(mpc, x, y):
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.div(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.div(mpc, x, y)
        else: compile_error("Invalid secure operands")
    
    def secure_gt(mpc, x, y):
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.gt(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.gt(mpc, x, y)
        else: compile_error("Invalid secure operands")

    def secure_lt(mpc, x, y):
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.lt(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.lt(mpc, x, y)
        else: compile_error("Invalid secure operands")
    
    def secure_eq(mpc, x, y):
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.eq(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.eq(mpc, x, y)
        else: compile_error("Invalid secure operands")
    
    def secure_ne(mpc, x, y):
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.ne(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.ne(mpc, x, y)
        else: compile_error("Invalid secure operands")

    def secure_sqrt_inv(mpc, x, y):
        if isinstance(x, MPU) or isinstance(y, MPU):
            return InternalMPU.sqrt_inv(x, y)
        elif isinstance(x, MPP) or isinstance(y, MPP):
            return InternalMPP.sqrt_inv(x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.sqrt_inv(mpc, x, y)
        elif isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.sqrt_inv(mpc, x, y)
        else: compile_error("Invalid secure operands")
    
    def secure_evalp(mpc, x_, coefs_, exps_):
        return InternalMPC.evalp(mpc, x_, coefs_, exps_)

    def dot(mpc, x, y, axis: int):
        if isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.dot(mpc, x, y, axis)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.dot(mpc, x, y, axis)
        elif isinstance(x, ndarray):
            return x.dot(y, axis)
        else: compile_error("Invalid secure operands")

    def dot(mpc, x, axis: int):
        if isinstance(x, MPU):
            return InternalMPU.dot(x, axis)
        elif isinstance(x, MPP):
            return InternalMPP.dot(x, axis)
        elif isinstance(x, Sharetensor):
            return InternalMPC.dot(mpc, x, axis)
        elif isinstance(x, Ciphertensor):
            return InternalMHE.dot(mpc, x, axis)
        elif isinstance(x, ndarray):
            return x.dot(x, axis)
        else: compile_error("Invalid secure operands")

    def matmul(mpc, x, y):
        if isinstance(x, MPU) or isinstance(y, MPU):
            return InternalMPU.matmul(x, y)
        elif isinstance(x, MPP) or isinstance(y, MPP):
            return InternalMPP.matmul(x, y)
        elif isinstance(x, Sharetensor) or isinstance(y, Sharetensor):
            return InternalMPC.matmul(mpc, x, y)
        elif isinstance(x, Ciphertensor) or isinstance(y, Ciphertensor):
            return InternalMHE.matmul(mpc, x, y)
        else: compile_error("Invalid secure operands")

    def sqrt(mpc, x):
        if isinstance(x, MPU):
            return InternalMPU.sqrt(x)
        elif isinstance(x, MPP):
            return InternalMPP.sqrt(x)
        elif isinstance(x, Sharetensor):
            return InternalMPC.sqrt(mpc, x)
        elif isinstance(x, Ciphertensor):
            return InternalMHE.sqrt(mpc, x)
        elif isinstance(x, ndarray):
            return x.sqrt()
        elif isinstance(x, ByVal):
            return math.sqrt(x)
        else: compile_error("Invalid secure operands")

    def reveal_to_all(mpc, value):
        if isinstance(value, Sharetensor):
            return InternalMPC.reveal_to_all(mpc, value)
        elif isinstance(value, Ciphertensor):
            return InternalMHE.reveal_to_all(mpc, value)
        else: compile_error("Invalid secure operands")

    def min_cost_router(new_vars, cost_vars):
        return new_vars[argmin(cost_vars)]


# Internal helpers
def _mhe_level(x) -> int:
    if isinstance(x, MPP) or isinstance(x, MPA) or isinstance(x, MPU) or isinstance(x, Ciphertensor):
        return x.level()
    
    print("INTERNAL: Not an HE-based type", type(x))
    return -1
