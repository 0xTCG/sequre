from sequre.constants import LATTISEQ_INT_SIZE, lattiseq_uint


@extend
class float:
    @llvm
    def bitcast_to_int(self: float) -> int:
        %0 = bitcast double %self to i64
        ret i64 %0

    @pure
    @llvm
    def _round_away(self: float) -> float:
        declare double @llvm.round.f64(double)
        %0 = call double @llvm.round.f64(double %self)
        ret double %0

    def round_half_away(self: float, ndigits: int = 0) -> float:
        # round() as Codon 0.19 had it: halves away from zero, ndigits after the point, a float. Codon 0.20's round()
        # rounds halves to even, as Python does, and returns an int without ndigits.
        if ndigits == 0:
            return self._round_away()
        nx = 10.0 ** float(ndigits)
        return (self * nx)._round_away() / nx


@extend
class UInt:
    @llvm
    def _new_from_bit(other: UInt[1]) -> UInt[N]:
        %0 = zext i1 %other to i{=N}
        ret i{=N} %0
    
    @llvm
    def _new_from_bool(other: bool) -> UInt[N]:
        %0 = zext i8 %other to i{=N}
        ret i{=N} %0
    
    @llvm
    def from_float_to_intn(other: float) -> UInt[N]:
        %0 = fptoui double %other to i{=N}
        ret i{=N} %0

    @llvm
    def raw_add_overflow(self: UInt[N], other: UInt[N]) -> Tuple[UInt[N], UInt[1]]:
        declare {i{=N}, i1} @llvm.uadd.with.overflow.imag{=N}(i{=N}, i{=N})
        %res = call {i{=N}, i1} @llvm.uadd.with.overflow.imag{=N}(i{=N} %self, i{=N} %other)
        ret {i{=N}, i1} %res

    @llvm
    def bit_reverse(self: UInt[N]) -> UInt[N]:
        declare i{=N} @llvm.bitreverse.imag{=N}(i{=N})
        %0 = call i{=N} @llvm.bitreverse.imag{=N}(i{=N} %self)
        ret i{=N} %0

    @llvm
    def bitlen(self: UInt[N]) -> UInt[N]:
        declare i{=N} @llvm.ctlz.imag{=N}(i{=N}, i1)
        %0 = call i{=N} @llvm.ctlz.imag{=N}(i{=N} %self, i1 0)
        %1 = sub i{=N} {=N}, %0
        ret i{=N} %1

    @pure
    @llvm
    def raw_mul_overflow(self: UInt[N], other: UInt[N]) -> Tuple[UInt[N], UInt[1]]:
        declare {i{=N}, i1} @llvm.umul.with.overflow.imag{=N}(i{=N}, i{=N})
        %res = call {i{=N}, i1} @llvm.umul.with.overflow.imag{=N}(i{=N} %self, i{=N} %other)
        ret {i{=N}, i1} %res

    @pure
    @llvm
    def cttz(self: UInt[N]) -> UInt[N]:
        # Trailing zeros; N for zero.
        declare i{=N} @llvm.cttz.imag{=N}(i{=N}, i1)
        %0 = call i{=N} @llvm.cttz.imag{=N}(i{=N} %self, i1 0)
        ret i{=N} %0

    @pure
    @llvm
    def wrapping_add(self: UInt[N], other: UInt[N]) -> UInt[N]:
        # Addition mod 2^N.
        %0 = add i{=N} %self, %other
        ret i{=N} %0

    @pure
    @llvm
    def wrapping_sub(self: UInt[N], other: UInt[N]) -> UInt[N]:
        # Subtraction mod 2^N.
        %0 = sub i{=N} %self, %other
        ret i{=N} %0

    @pure
    @llvm
    def wrapping_mul(self: UInt[N], other: UInt[N]) -> UInt[N]:
        # Multiplication mod 2^N.
        %0 = mul i{=N} %self, %other
        ret i{=N} %0

    @llvm
    def __naive_mod(self: UInt[N], other: UInt[N]) -> UInt[N]:
        %0 = urem i{=N} %self, %other
        ret i{=N} %0
    
    @llvm
    def upcast(other: int) -> UInt[N]:
        %0 = zext i64 %other to i{=N}
        ret i{=N} %0
    
    @llvm
    def upcast(other: u64) -> UInt[N]:
        %0 = zext i64 %other to i{=N}
        ret i{=N} %0
    
    def trunc_half(self: UInt[N]) -> UInt[N // 2]:
        # Codon does not typecheck width arithmetic in an @llvm signature: go through trunc_to
        return self.trunc_to(N // 2)
    
    @llvm
    def trunc_to(self: UInt[N], T: Static[int]) -> UInt[T]:
        %0 = trunc i{=N} %self to i{=T}
        ret i{=T} %0
    
    def ext_double(self: UInt[N]) -> UInt[N * 2]:
        # Codon does not typecheck width arithmetic in an @llvm signature: go through ext_to
        return self.ext_to(N * 2)
    
    @llvm
    def ext_to(self: UInt[N], T: Static[int]) -> UInt[T]:
        %0 = zext i{=N} %self to i{=T}
        ret i{=T} %0
    
    @llvm
    def ext_to_lattiseq_uint(self: UInt[N]) -> lattiseq_uint:
        %0 = zext i{=N} %self to i{=LATTISEQ_INT_SIZE}
        ret i{=LATTISEQ_INT_SIZE} %0


@extend
class Int:
    # int is Int[64] since Codon 0.20, so int's methods live here too, typed `self: int`: their i64 code is int's alone
    @pure
    @llvm
    def __lhsr__(self: int, other: int) -> int:
        %0 = lshr i64 %self, %other
        ret i64 %0
    
    @pure
    @llvm
    def cttz(self: int) -> int:
        # Trailing zeros; 64 for zero (Codon 0.19's int.__cttz__, a private _cttz since 0.20)
        declare i64 @llvm.cttz.i64(i64, i1)
        %0 = call i64 @llvm.cttz.i64(i64 %self, i1 0)
        ret i64 %0

    @llvm
    def bitcast_to_float(self: int) -> float:
        %0 = bitcast i64 %self to double
        ret double %0

    @llvm
    def bit_reverse(self: int) -> int:
        declare i64 @llvm.bitreverse.i64(i64)
        %0 = call i64 @llvm.bitreverse.i64(i64 %self)
        ret i64 %0
    
    @llvm
    def __naive_mod(self: int, other: int) -> int:
        declare i64 @llvm.ctpop.i64(i64)
        %popcount = call i64 @llvm.ctpop.i64(i64 %other)
        %0 = srem i64 %self, %other
        %1 = icmp slt i64 %0, 0
        %2 = add i64 %0, %other
        %3 = select i1 %1, i64 %2, i64 %0
        %4 = icmp eq i64 %popcount, 1
        %other_1 = sub i64 %other, 1
        %5 = and i64 %self, %other_1
        %6 = select i1 %4, i64 %5, i64 %3
        ret i64 %6

    @llvm
    def trunc_to_i64(self: Int[N]) -> int:
        %0 = trunc i{=N} %self to i64
        ret i64 %0
    
    @llvm
    def half(self: Int[N]) -> Int[N]:
        %0 = lshr i{=N} %self, 1
        ret i{=N} %0
    
    @llvm
    def lshr(self: Int[N], other: Int[N]) -> Int[N]:
        %0 = lshr i{=N} %self, %other
        ret i{=N} %0
    
    @llvm
    def sign(self: Int[N]) -> Int[N]:
        %0 = lshr i{=N} %self, {=N - 1}
        %1 = xor i{=N} %0, 1
        %2 = mul i{=N} %1, 2
        %3 = sub i{=N} %2, 1
        ret i{=N} %3
