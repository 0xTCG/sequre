# Partition kinds and descriptor fields, as MPPAligner agrees on them among the compute parties
MPP_EMPTY = 0    # no data
MPP_CLEAR = 1    # in the clear (MPP.is_local(): a unified encryption cached next to the data does not count)
MPP_UNIFIED = 2  # an encryption of the whole partition and no block in the clear beside it, or a semi-encrypted partition
                 # with its unified encryption cached (which operations use first)
MPP_SEMI = 3     # encrypted column blocks left and/or right of a block in the clear, not unified

D_KIND = 0
D_LOCAL = 1      # the data in the clear: present, columns (a 1-dim partition's length)
D_UNIFIED = 3    # each encryption: present, columns (length), _transposed, _diagonal_contiguous
D_LEFT = 7
D_RIGHT = 11
D_SIZE = 15

# Modes of MPPAligner
ALIGN_PAD = 0      # pad unequal partitions to the same rows (or length), and give a semi-encrypted partition the encrypted
                   # blocks other parties hold (placeholders), so per-block operations (indexing) run alike; nothing at
                   # equal ratios
ALIGN_ROWS = 1     # as ALIGN_PAD without the extra blocks: for element-wise operations, which run the other parties'
                   # products on placeholders instead (MPP._run_elem_wise_shadows)
ALIGN_UNIFORM = 2  # also agree on every partition's descriptor (one round) at equal ratios, and pad as ALIGN_ROWS: for
                   # products whose HE kernels refresh per row, run on placeholders of the padded shape where a party
                   # holds no encryption
ALIGN_ENCRYPT = 3  # as ALIGN_UNIFORM, and every encrypted partition unified, and in a mixed cohort (partitions in the clear
                   # and encrypted ones) those in the clear encrypted for the duration, in the layout of the encrypted ones:
                   # for products whose per-party results must share one kind and layout


# HE steps of per-partition operations. A compute party runs, on placeholders, every step that another party runs and it
# does not (MPP._run_elem_wise_shadows), so that every party makes the same number of refresh councils
STEP_UNIFIED_PT = 0  # element-wise: the unified encryption times data in the clear (a plaintext or a scalar)
STEP_UNIFIED_CT = 1  # element-wise: the unified encryption times another encryption
STEP_LEFT_PT = 2     # the same for a semi-encrypted partition's left block
STEP_LEFT_CT = 3
STEP_RIGHT_PT = 4    # and for its right block
STEP_RIGHT_CT = 5


def _describe_encryption(d: List[int], field: int, enc: Ciphertensor[Ciphertext]):
    if enc:
        d[field] = 1
        d[field + 1] = enc.shape[0] if (enc.ndim == 2 and enc._transposed) else enc.shape[-1]
        d[field + 2] = int(enc._transposed)
        d[field + 3] = int(enc._diagonal_contiguous)


def _partition_descriptor(mpp) -> List[int]:
    # This compute party's partition as MPPAligner's round shares it: its kind and, for each representation it holds,
    # the columns (a 1-dim partition's length) and, for an encryption, its layout (the D_* fields)
    d = [0 for _ in range(D_SIZE)]
    if mpp.is_empty():
        d[D_KIND] = MPP_EMPTY
    elif mpp.is_local():
        d[D_KIND] = MPP_CLEAR
    elif mpp.has_unified_encryption():
        d[D_KIND] = MPP_UNIFIED
    else:
        d[D_KIND] = MPP_SEMI
    if mpp.has_local_data():
        d[D_LOCAL] = 1
        d[D_LOCAL + 1] = mpp._local_data.shape[-1]
    _describe_encryption(d, D_UNIFIED, mpp._encryption_unified)
    _describe_encryption(d, D_LEFT, mpp._encryption_left)
    _describe_encryption(d, D_RIGHT, mpp._encryption_right)
    return d


def _agree_on_partitions(first, other) -> Tuple[List[List[int]], List[List[int]]]:
    # The descriptors of two operands' partitions at every compute party, in one round among them
    mpc = first._mpc
    mine = _partition_descriptor(first)
    mine.extend(_partition_descriptor(other))
    both = mpc.comms.collect(mine)
    return [d[:D_SIZE] for d in both], [d[D_SIZE:] for d in both]


def _encrypted_layout(descriptors: List[List[int]]) -> Tuple[bool, bool, bool]:
    # The layout (_transposed, _diagonal_contiguous) of the encrypted partitions: a unified encryption's own, or the one
    # a semi-encrypted partition unifies into (that of its encrypted blocks, as MPP.unify_encryption does), taken from the
    # first party that holds one (row-wise if none), and whether every encrypted partition has it
    layouts = List[Tuple[bool, bool]]()
    for d in descriptors:
        if d[D_KIND] == MPP_UNIFIED:
            layouts.append((bool(d[D_UNIFIED + 2]), bool(d[D_UNIFIED + 3])))
        elif d[D_KIND] == MPP_SEMI:
            field = D_RIGHT if d[D_RIGHT] else D_LEFT
            layouts.append((bool(d[field + 2]), bool(d[field + 3])))
    if not layouts:
        return False, False, True
    return layouts[0][0], layouts[0][1], all(l == layouts[0] for l in layouts)


def _full_width(d: List[int]) -> int:
    # A partition's columns (a 1-dim partition's length), all its parts together
    if d[D_UNIFIED]:
        return d[D_UNIFIED + 1]
    return d[D_LOCAL + 1] + d[D_LEFT + 1] + d[D_RIGHT + 1]


def _padded_kind(descriptors: List[List[int]]) -> List[int]:
    # The descriptor an empty partition takes when padded for an operation that is not per block (MPPAligner._fill_empty):
    # an encryption of the full width, in the layout of the encrypted partitions, if any party holds one; else data in the
    # clear of the full width; else nothing
    padded = [0 for _ in range(D_SIZE)]
    width = 0
    for d in descriptors:
        if d[D_KIND] != MPP_EMPTY:
            width = max(width, _full_width(d))
    if any(d[D_KIND] == MPP_UNIFIED or d[D_KIND] == MPP_SEMI for d in descriptors):
        transposed, diagonal, _ = _encrypted_layout(descriptors)
        padded[D_KIND] = MPP_UNIFIED
        padded[D_UNIFIED] = 1
        padded[D_UNIFIED + 1] = width
        padded[D_UNIFIED + 2] = int(transposed)
        padded[D_UNIFIED + 3] = int(diagonal)
    elif any(d[D_KIND] == MPP_CLEAR for d in descriptors):
        padded[D_KIND] = MPP_CLEAR
        padded[D_LOCAL] = 1
        padded[D_LOCAL + 1] = width
    return padded


def _first_holder(descriptors: List[List[int]], field: int) -> int:
    for q in range(len(descriptors)):
        if descriptors[q][field]:
            return q
    return -1


# Multiparty partition
class MPP[S, dtype]:
    """
    A matrix whose rows are partitioned among the compute parties: each holds its own rows (its partition) in the clear,
    encrypted, or semi-encrypted (encrypted column blocks beside a block in the clear, as A @ B.T leaves them), and
    _ratios lists every party's row count. CP0 holds a placeholder of the whole matrix. _transposed is a lazy
    transpose: the partitions stay rows of the matrix as held.

    A 1-dim MPP is one of two things, told apart by _transposed:
    - not transposed: a row held by one compute party (the holder). Its ratios are one-hot at the holder, whose
      partition is the row; the other compute parties hold nothing, and CP0 a placeholder of the row's length. X[i]
      gives one.
    - transposed: a column split over the compute parties. Its ratios are each party's length (0 for an empty
      partition), and CP0 holds a placeholder of the total length. X.T[j] gives one.
    A vector of length 1 held by one party with one-hot ratios reads the same either way. MPP(mpc, vector), which takes
    each party's vector, builds an untransposed 1-dim MPP whose ratios are the lengths: sums read it as a column, as
    Sharetensor.to_mpp reads ratios that sum to more than 1.

    Sums (sum, dot) follow from where they add up. Of a 2-dim MPP, within the partitions (along the rows as held:
    X.sum(1), X.T.sum(0)) the result is a column split with the operand's ratios, each party's sums in its own
    representation; across them (X.sum(0), X.T.sum(1)) it is a row held by the hub (CP1), encrypted. A held row's sum
    stays with its holder; a column's sum is a column of length 1 at the hub, encrypted.
    """
    _mpc: MPCEnv[mpc_uint]
    _ratios: list[int]
    _local_data: ndarray[S, dtype]
    _encryption_left: Ciphertensor[Ciphertext]
    _encryption_right: Ciphertensor[Ciphertext]
    _encryption_unified: Ciphertensor[Ciphertext]
    _transposed: bool

    def __init__(self, mpc: MPCEnv[mpc_uint]):
        self._mpc = mpc
        self._ratios = list[int]()
        self._local_data = ndarray[S, dtype]()
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = Ciphertensor[Ciphertext]()
        self._transposed = bool()

    def __init__(self, mpc, local_data: ndarray[S, dtype]):
        """
        Note: must be called at all parties (including trusted dealer)
        """
        self._ratios = mpc.comms.collect(local_data.shape[0], include_trusted_dealer=True)[1:]
        _local_data = zeros((self._ratios.sum(), *local_data.shape[1:]), dtype=dtype) if mpc.pid == 0 else local_data
        
        self._mpc = mpc
        self._local_data = _local_data
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = Ciphertensor[Ciphertext]()
        self._transposed = False
    
    def __init__(self, mpc, local_data: ndarray[S, dtype], ratios: List[int]):
        self._ratios = ratios.copy()
        _local_data = zeros((self._ratios.sum(), *local_data.shape[1:]), dtype=dtype) if mpc.pid == 0 else local_data
        
        self._mpc = mpc
        self._local_data = _local_data
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = Ciphertensor[Ciphertext]()
        self._transposed = False

    def __init__(self, _mpc, _ratios: List[int]):
        self._mpc = _mpc
        self._ratios = _ratios.copy()
        self._local_data = ndarray[S, dtype]()
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = Ciphertensor[Ciphertext]()
        self._transposed = False

    def __init__(self, _mpc, _ratios: List[int], _local_data: ndarray[S, dtype]):
        self._mpc = _mpc
        self._ratios = _ratios.copy()
        self._local_data = _local_data
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = Ciphertensor[Ciphertext]()
        self._transposed = False

    def __init__(self, _mpc, _ratios: List[int], _local_data: ndarray[S, dtype], _transposed: bool):
        self._mpc = _mpc
        self._ratios = _ratios.copy()
        self._local_data = _local_data
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = Ciphertensor[Ciphertext]()
        self._transposed = _transposed
    
    def __init__(self, mpc, encryption: Ciphertensor[Ciphertext]):
        """
        Note: must be called at all parties (including trusted dealer)
        """
        if static.len(S) != 2 and static.len(S) != 1:
            compile_error("MPP can only be 1-dimensional and 2-dimensional")
        assert static.len(S) == encryption.ndim, "MPP: dimensions mismatch in MPP init via Ciphertensor"
        
        self._ratios = mpc.comms.collect(encryption.actual_shape[0], include_trusted_dealer=True)[1:]
        if static.len(S) == 1:
            _local_data = zeros((self._ratios.sum(),), dtype=dtype) if mpc.pid == 0 else ndarray[S, dtype]()
        else:
            _local_data = zeros((self._ratios.sum(), encryption.shape[1]), dtype=dtype) if mpc.pid == 0 else ndarray[S, dtype]()
        _encryption_unified = Ciphertensor[Ciphertext]() if mpc.pid == 0 else encryption
        
        self._mpc = mpc
        self._local_data = _local_data
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = _encryption_unified
        self._transposed = False
    
    def __init__(self, _mpc, _ratios: List[int], _encryption_unified: Ciphertensor[Ciphertext]):
        self._mpc = _mpc
        self._ratios = _ratios.copy()
        self._local_data = ndarray[S, dtype]()
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = _encryption_unified
        self._transposed = False

    def __init__(self, _mpc, _ratios: List[int], _encryption_unified: Ciphertensor[Ciphertext], _transposed: bool):
        self._mpc = _mpc
        self._ratios = _ratios.copy()
        self._local_data = ndarray[S, dtype]()
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = _encryption_unified
        self._transposed = _transposed

    def __init__(self, _mpc, _ratios: List[int], _local_data: ndarray[S, dtype],
                 _encryption_left: Ciphertensor[Ciphertext], _encryption_right: Ciphertensor[Ciphertext],
                 _encryption_unified: Ciphertensor[Ciphertext], _transposed: bool):
        self._mpc = _mpc
        self._ratios = _ratios.copy()
        self._local_data = _local_data
        self._encryption_left = _encryption_left
        self._encryption_right = _encryption_right
        self._encryption_unified = _encryption_unified
        self._transposed = _transposed

    def __init__(self, mpc, encryption: Ciphertensor[Ciphertext], ratios: List[int]):
        if static.len(S) != 2 and static.len(S) != 1:
            compile_error("MPP can only be 1-dimensional and 2-dimensional")
        assert static.len(S) == encryption.ndim, "MPP: dimensions mismatch in MPP init via Ciphertensor"
        
        self._ratios = ratios.copy()
        if static.len(S) == 1:
            _local_data = zeros((self._ratios.sum(),), dtype=dtype) if mpc.pid == 0 else ndarray[S, dtype]()
        else:
            _local_data = zeros((self._ratios.sum(), encryption.shape[1]), dtype=dtype) if mpc.pid == 0 else ndarray[S, dtype]()
        _encryption_unified = Ciphertensor[Ciphertext]() if mpc.pid == 0 else encryption
        
        self._mpc = mpc
        self._local_data = _local_data
        self._encryption_left = Ciphertensor[Ciphertext]()
        self._encryption_right = Ciphertensor[Ciphertext]()
        self._encryption_unified = _encryption_unified
        self._transposed = False
    
    @staticmethod
    def like[T](other: T, arr: ndarray) -> T:
        if isinstance(T, ndarray):
            return arr
        elif isinstance(T, MPP):
            return MPP(
                _mpc=other._mpc,
                _ratios=other._ratios.copy(),
                _local_data=arr if other._mpc.pid else arr.zeros())
        else:
            compile_error("Invalid reference type")
    
    @staticmethod
    def enc[S, dtype](mpc, data: ndarray[S, dtype], ratios: Optional[List[int]] = None) -> MPP[S, dtype]:
        if ratios is None:
            ratios = MPP.uniform_ratios(len(data), mpc.comms.number_of_parties - 1)
        
        return MPP(
            _mpc=mpc,
            _ratios=ratios,
            _local_data=MPP.split_by_ratios(mpc, data, ratios) if mpc.pid else data.zeros())
    
    def copy(self) -> MPP[S, dtype]:
        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=self._local_data.copy(),
            _encryption_left=self._encryption_left.copy(),
            _encryption_right=self._encryption_right.copy(),
            _encryption_unified=self._encryption_unified.copy(),
            _transposed=self._transposed)

    def set(self, other: MPP[S, dtype]):
        self._ratios = other._ratios.copy()
        self._local_data = other._local_data
        self._encryption_left = other._encryption_left
        self._encryption_right = other._encryption_right
        self._encryption_unified = other._encryption_unified
        self._transposed = other._transposed
    
    @property
    def local(self) -> ndarray[S, dtype]:
        assert self.is_local(), "MPP is not local"
        return self._local_data
    
    @property
    def modulus(self) -> mpc_uint:
        return self._mpc.default_mpc_modulus
    
    @property
    def shape(self) -> S:
        if self.is_empty():
            return _extract_tuple(static.len(S))
        
        if self.is_local():
            _shape = self._local_data.shape
            
            if self._transposed:
                _shape = _shape[::-1]
            
            return _shape
        
        if self.has_unified_encryption():
            enc_shape = self._encryption_unified.actual_shape
            if static.len(S) == 2:
                rows, cols = enc_shape
                _shape = (rows, cols)
            elif static.len(S) == 1:
                _shape = (enc_shape[-1], )
            else:
                compile_error("MPP: dimension has to be less than 3")
            
            if self._transposed:
                _shape = _shape[::-1]
            
            return _shape

        assert self.is_semi_encrypted(), "MPP must be semi encrypted if it is not local and has no unified encryption"
        cols = self._local_data.shape[-1]
        if self._encryption_left: cols += self._encryption_left.actual_shape[-1]
        if self._encryption_right: cols += self._encryption_right.actual_shape[-1]
        
        _shape = (*self._local_data.shape[:-1], cols)
        
        if self._transposed:
            _shape = _shape[::-1]
        
        return _shape
    
    @property
    def cohort_shape(self) -> S:
        mpc = self._mpc
        if mpc.pid == 0:
            _shape = self._local_data.shape
            return _shape[::-1] if self._transposed else _shape
        
        if static.len(S) == 1:
            if self._transposed:
                return (self._ratios.sum(),)
            
            cols = self.shape[0] if len(self.shape) else 0
            return (mpc.comms.broadcast_from(cols, argmax(self._ratios) + 1),)
        
        _shape = self.shape[::-1] if self._transposed else self.shape

        if mpc.council(self.is_empty()).any():
            cols = max(mpc.comms.collect(_shape[-1]))
        else:
            cols = _shape[-1]

        _shape = (self._ratios.sum(), cols)
        if self._transposed:
            _shape = _shape[::-1]
        
        return _shape
    
    @property
    def shape_local(self) -> S:
        return self.shape

    @property
    def partition_shape(self):
        if self.is_local():
            return list(self._local_data.shape)

        if self.is_full_encrypted():
            return self._encryption_unified.shape

        raise ValueError("MPP is semi-encrytped. Fetching raw partition shape should be done manually via mpp._encryption_left.shape and mpp._encryption_right.shape")
    
    @property
    def T(self) -> MPP[S, dtype]:
        new_mpp = self.copy()
        new_mpp._transposed ^= True
        return new_mpp
    
    @property
    def ndim(self) -> int:
        return static.len(S)
    
    @property
    def I(self) -> MPP[S, dtype]:
        id_mat = ndarray[S, dtype].diag(self.cohort_shape, dtype(1))
        actual_id_mat = id_mat.T if self._transposed else id_mat
        
        if self._mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=self._mpc,
                _ratios=self._ratios.copy(),
                _local_data=zeros_like(actual_id_mat),
                _encryption_left=Ciphertensor[Ciphertext](),
                _encryption_right=Ciphertensor[Ciphertext](),
                _encryption_unified=Ciphertensor[Ciphertext](),
                _transposed=self._transposed)
        
        start, end = self.get_relative_indices()
        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=actual_id_mat[start:end],
            _encryption_left=Ciphertensor[Ciphertext](),
            _encryption_right=Ciphertensor[Ciphertext](),
            _encryption_unified=Ciphertensor[Ciphertext](),
            _transposed=self._transposed)

    @property
    def ratios(self):
        return self._ratios
    
    def __getitem__(self, indices) -> MPP:
        if static.len(S) == 1:
            return self._getitem_1_dim(indices)
        elif static.len(S) == 2:
            return self._getitem_2_dim(indices)
        else:
            compile_error("MPP: invalid shape")
    
    def __setitem__(self, indices, value):
        if static.len(S) == 1:
            return self._setitem_1_dim(indices, value)
        elif static.len(S) == 2:
            return self._setitem_2_dim(indices, value)
        else:
            compile_error("MPP: invalid shape")
    
    def __iter__(self):
        assert not self.is_semi_encrypted() and not self.is_full_encrypted(), "Cannot iter encrypted data"
        if self.has_local_data():
            for e in self._local_data: yield e
    
    def __bool__(self) -> bool:
        return bool(self._ratios)
    
    def __len__(self) -> int:
        return self.cohort_shape[0]
    
    def __neg__(self) -> MPP[S, dtype]:
        return MPP(
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=-self._local_data,
            _encryption_left=self._encryption_left.neg(self._mpc),
            _encryption_right=self._encryption_right.neg(self._mpc),
            _encryption_unified=self._encryption_unified.neg(self._mpc),
            _transposed=self._transposed)
    
    def __add__(self, other) -> MPP[S, dtype]:
        self._mpc.stats.secure_add_count += 1
        return self._do_elem_wise_op(other, secure_operator.add)
    
    def __sub__(self, other) -> MPP[S, dtype]:
        self._mpc.stats.secure_sub_count += 1
        return self._do_elem_wise_op(other, secure_operator.sub)

    def __mul__(self, other) -> MPP[S, dtype]:
        self._mpc.stats.secure_mul_count += 1
        return self._do_elem_wise_op(other, secure_operator.mul, MUL=1)

    def __pow__(self, p: int) -> MPP[S, dtype]:
        self._mpc.stats.secure_pow_count += 1
        return self._pow(p)
    
    def __matmul__(self, other) -> MPP[S, dtype]:
        self._mpc.stats.secure_matmul_count += 1
        self._mpc.stats.secure_matmul_complexity += (self.cohort_shape[0] * self.cohort_shape[1] * other.cohort_shape[1])
        return self.matmul(other)
    
    def __truediv__(self, other) -> MPP[S, dtype]:
        if isinstance(other, ByVal):
            return self * (1 / other)
        raise NotImplementedError("MPPs cannot be divided by secure value yet")
    
    def __gt__(self, other) -> MPP[S, dtype]:
        if not isinstance(other, ByVal):
            compile_error("Not implemented yet: Comparison between MPPs and Ciphertensors")

        mpc = self._mpc
        # Every compute party holds its partition in the clear (or none): each compares its own, and CP0, which then
        # has no part in it, returns a placeholder. Otherwise every party, CP0 included, runs the secure comparison
        # (CP0 deals its randomness), on the whole MPP, whatever mix of partitions in the clear and encrypted it has.
        if self._cohort_in_the_clear():
            return self._compare_in_the_clear(other, greater=True)

        return self.via_mpc(lambda stensor: secure_operator.gt(mpc, stensor, other))

    def __lt__(self, other) -> MPP[S, dtype]:
        if not isinstance(other, ByVal):
            compile_error("Not implemented yet: Comparison between MPPs and Ciphertensors")

        mpc = self._mpc
        # As __gt__
        if self._cohort_in_the_clear():
            return self._compare_in_the_clear(other, greater=False)

        return self.via_mpc(lambda stensor: secure_operator.lt(mpc, stensor, other))

    def _cohort_in_the_clear(self) -> bool:
        # Whether every compute party holds its partition in the clear, or holds none. CP0's placeholder cannot tell, so
        # every party, CP0 included, learns it in one round (CP0's own entry is ignored). Call it at every party.
        mpc = self._mpc
        in_the_clear = mpc.pid == 0 or self.is_local() or self.is_empty()
        return all(mpc.comms.collect(in_the_clear, include_trusted_dealer=True)[1:])

    def _cohort_encrypted(self) -> bool:
        # Whether no compute party holds its partition in the clear and at least one holds an encrypted (or
        # semi-encrypted) partition: one round with every party, CP0 included (its own entry is ignored). Call it at
        # every party.
        mpc = self._mpc
        state = 1 if mpc.pid == 0 or self.is_empty() else (0 if self.is_local() else 2)
        states = mpc.comms.collect(state, include_trusted_dealer=True)[1:]
        return all(s != 0 for s in states) and any(s == 2 for s in states)

    def _compare_in_the_clear(self, other, greater: bool) -> MPP[S, dtype]:
        mpc = self._mpc
        if mpc.pid == 0:
            result = self._local_data.zeros()
        elif self.is_empty():
            result = ndarray[S, dtype]()
        elif greater:
            result = (self._local_data > other).astype(dtype)
        else:
            result = (self._local_data < other).astype(dtype)

        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=self._ratios.copy(),
            _local_data=result,
            _transposed=self._transposed)
    
    # Partition has either of the encrypted sub-partitions
    def has_partial_encryption(self):
        return bool(self._encryption_left) or bool(self._encryption_right)
    
    # Partition has encryption for whole partition
    def has_unified_encryption(self):
        return bool(self._encryption_unified)
    
    # Partition has local data
    def has_local_data(self):
        return not self._local_data.is_empty()
    
    # Partition has local data and either of the encrypted portion
    def is_semi_encrypted(self) -> bool:
        return self.has_local_data() and self.has_partial_encryption()

    # Partition does not have local data and whole partition is encrypted
    def is_full_encrypted(self) -> bool:
        return not self.has_local_data() and self.has_unified_encryption()
    
    # Partition has local data only
    def is_local(self) -> bool:
        return self.has_local_data() and not self.has_partial_encryption()
    
    # Partition does not contain any data
    def is_empty(self) -> bool:
        return not self.has_local_data() and not self.has_unified_encryption() and not self.has_partial_encryption()
    
    # All partitions aligned
    def cohort_is_aligned(self) -> bool:
        return self._ratios.same()

    @staticmethod
    def collective_load[dtype](mpc: MPCEnv, data_path: str, rows: int, cols: int, binary: bool) -> MPP[Tuple[int, int], dtype]:
        assert rows and cols, "MPP: Collective load can load only matrices"
        
        if mpc.pid == 0:
            ratios = mpc.comms.receive_as_jar(mpc.comms.hub_pid, T=list[int])
            return MPP[Tuple[int, int], dtype](
                _mpc=mpc,
                _ratios=ratios,
                _local_data=zeros((ratios.sum(), cols), dtype=dtype))
        
        assert mpc.comms.collect(cols).reduce_and() == cols, f"MPP: The numbers of columns should be the same in the horizontaly partitioned matrix. \n\tCollected cols: {mpc.comms.collect(cols)}\n\t cols at CP{mpc.pid}: {cols}"
        ratios = mpc.comms.collect(rows)
        if mpc.pid == mpc.comms.hub_pid:
            mpc.comms.send_as_jar(ratios, 0)
        
        with open(data_path) as f:
            data = read_ndarray(f, (rows, cols), binary, dtype=dtype)
        
        return MPP[Tuple[int, int], dtype](
            _mpc=mpc,
            _ratios=ratios,
            _local_data=data)
    
    def astype(self, t: type) -> MPP[S, t]:
        if isinstance(dtype, float) and isinstance(t, int):
            compile_error("Not implemented yet: casting MPP[float] to MPP[int]")
        
        return MPP[S, t](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=self._local_data.astype(t),
            _encryption_left=self._encryption_left.astype(t),
            _encryption_right=self._encryption_right.astype(t),
            _encryption_unified=self._encryption_unified.astype(t),
            _transposed=self._transposed)
    
    def to_fp(self) -> MPP[S, float]:
        return self.astype(float)
    
    def filter(self, mask) -> MPP[S, dtype]:
        assert self.shape[0] == len(mask) or self.cohort_shape[0] == len(mask), f"MPP: partition and filter mask size mismatch: {self.shape[0]} != {len(mask)}"
        assert not self._transposed, "Not implemented yet: filtering transposed MPP"
        assert self.is_local(), "Not implemented yet: filtering encrypted MPP"
        
        mpc = self._mpc
        if self.shape[0] != len(mask) and mpc.pid:
            start = self._ratios[:mpc.pid - 1].sum()
            stop = start + self._ratios[mpc.pid - 1]
            mask = mask[start:stop]
        
        assert self.shape[0] == len(mask), f"MPP: partition and filter mask size mismatch: {self.shape[0]} != {len(mask)}"
        _local_data = self._local_data.filter(mask)
        _ratios = mpc.comms.collect(_local_data.shape[0], include_trusted_dealer=True)[1:]

        return MPP(
            _mpc=mpc,
            _ratios=_ratios,
            _local_data=_local_data)
    
    def cohort_filter(self, mask: ndarray[Tuple[int], int]) -> MPP[S, dtype]:
        if static.len(S) == 1:
            compile_error("MPP: cannot filter 1-dimensional MPP")
        
        mpc = self._mpc

        adjusted_ratios = self._ratios.zeros()
        for i, flag in enumerate(mask):
            adjusted_ratios[self._find_idx_in_ratios(i)] += int(bool(flag))
        
        if mpc.pid == 0:
            return MPP(
                _mpc=self._mpc,
                _ratios=adjusted_ratios,
                _local_data=self._local_data.filter(mask))

        ref_pid = mpc.pid - 1
        slice_start = self._ratios[:ref_pid].sum()
        adjusted_mask = mask[slice_start:slice_start + self._ratios[ref_pid]]

        assert self.shape[0] == len(adjusted_mask), f"MPP: partition and filter mask size mismatch: {self.shape[0]} != {len(adjusted_mask)}"
        assert not self._transposed, "Not implemented yet: filtering transposed MPP"
        
        if self.is_empty():
            return self.copy()
                
        if self.is_local():
            return MPP(
                _mpc=self._mpc,
                _ratios=adjusted_ratios,
                _local_data=self._local_data.filter(adjusted_mask))
        elif self.is_semi_encrypted():
            return MPP[S, dtype](
                _mpc=self._mpc,
                _ratios=adjusted_ratios,
                _encryption_left=self._encryption_left.filter(adjusted_mask),
                _encryption_right=self._encryption_right.filter(adjusted_mask))
        elif self.is_full_encrypted():
            return MPP[S, dtype](
                _mpc=self._mpc,
                _ratios=adjusted_ratios,
                _encryption_unified=self._encryption_unified.filter(adjusted_mask))
        else:
            raise ValueError("MPP: invalid partition")
    
    def unify_encryption(self, transposed: int = -1):
        # This compute party's partition as one encryption (_encryption_unified), kept beside what it holds: a
        # semi-encrypted partition's blocks and block in the clear concatenated, in the blocks' layout; a 2-dim partition
        # in the clear row-wise as held, or column-wise for transposed 1, when a caller agreed on the layout with the
        # other parties (join passes the cohort's encrypted layout)
        mpc = self._mpc
        if static.len(S) > 2:
            compile_error("MPP: cannot have dimension larger than 2")

        if mpc.pid == 0:
            return
        if self.has_unified_encryption():
            # Beside a partition in the clear the encryption is only a cache: encrypted anew if the caller asks for
            # another layout than the cached one's
            cached = self._encryption_unified
            if static.len(S) == 1 or transposed < 0 or not self.is_local():
                return
            if cached._transposed == bool(transposed) and not cached._diagonal_contiguous:
                return
        if self.is_empty():
            return
        assert self.has_local_data(), "MPP must have local data if it has no unified encryption"

        is_transposed = False
        is_d_contig = False
        local_data = self._local_data

        if static.len(S) == 2:
            if transposed >= 0:
                is_transposed = bool(transposed)
            if self._encryption_left and self._encryption_right:
                assert self._encryption_left._transposed == self._encryption_right._transposed, "Not implemented yet: Unifying transposed and non-transposed partitions is not supported yet"
                assert self._encryption_left._diagonal_contiguous == self._encryption_right._diagonal_contiguous, "Not implemented yet: Unifying diagonal-contiguous and non-diagonal-contiguous partitions is not supported yet"
            if self._encryption_left:
                is_transposed = self._encryption_left._transposed
                is_d_contig = self._encryption_left._diagonal_contiguous
            if self._encryption_right:
                is_transposed = self._encryption_right._transposed
                is_d_contig = self._encryption_right._diagonal_contiguous
            
            local_data = local_data.T if is_transposed else local_data

        self._encryption_unified = Ciphertensor[Ciphertext].enc(mpc, local_data, encoding=ENC_DIAG if is_d_contig else ENC_ROW)
        self._encryption_unified._transposed = is_transposed
        if self._encryption_left:
            self._encryption_unified = self._encryption_left.concat(mpc, self._encryption_unified, axis=1)
        if self._encryption_right:
            self._encryption_unified = self._encryption_unified.concat(mpc, self._encryption_right, axis=1)

    def collect(self, transposed: int = -1) -> list[Ciphertensor[Ciphertext]]:
        # Every compute party's partition as one encryption (unify_encryption; transposed is its), to every compute party
        mpc = self._mpc
        if mpc.pid == 0:
            return []
        self.unify_encryption(transposed)
        return mpc.comms.collect(self._encryption_unified.copy())

    def _describe(self) -> Ciphertensor[Ciphertext]:
        # This compute party's partition, as _partition_descriptors sends it: its encryption if it is encrypted (a
        # semi-encrypted partition is unified first); an empty Ciphertensor carrying the partition's shape as held
        # (untransposed) if it is in the clear; an empty Ciphertensor without a shape if the partition is empty.
        slots = self._mpc.mhe.crypto_params.params.slots()
        if self.is_empty():
            return Ciphertensor[Ciphertext](slots=slots)
        if self.is_local():
            return Ciphertensor[Ciphertext](shape=list(self._local_data.shape), slots=slots)
        self.unify_encryption()
        return self._encryption_unified.copy()

    def _partition_descriptors(self) -> List[Ciphertensor[Ciphertext]]:
        # One round among the compute parties (CP0 gets []): every compute party learns every partition's state, its
        # shape, and the ciphertexts of an encrypted one (see _describe), an empty partition's included, whatever it
        # holds itself. The partitions' row counts are the ratios; their shapes are not public otherwise.
        mpc = self._mpc
        if mpc.pid == 0:
            return List[Ciphertensor[Ciphertext]]()
        return mpc.comms.collect(self._describe())

    @staticmethod
    def _agreed_transpose_encryption(descriptors: List[Ciphertensor[Ciphertext]]) -> bool:
        # The layout of the encryptions a switch back from MPC gives the partitions (Sharetensor.to_mpp's
        # transpose_encryption), which every compute party must pass alike: column-wise if every encrypted partition
        # is, row-wise otherwise (also when none is encrypted).
        encrypted = [d for d in descriptors if d]
        return bool(encrypted) and all(d._transposed for d in encrypted)
    
    def collect_and_execute_at(self, target_pid: int, op) -> Ciphertensor[Ciphertext]:
        mpc = self._mpc
        if mpc.pid == 0:
            return Ciphertensor[Ciphertext]()
        
        self.unify_encryption()
        enc = self._encryption_unified.copy()
        
        partitions = mpc.comms.collect_at(enc, target_pid)
        if mpc.pid == target_pid:
            return op(partitions, mpc)
        
        return Ciphertensor[Ciphertext]()
    
    def aggregate(self) -> MPP[S, dtype]:
        mpc = self._mpc

        if mpc.pid == 0:
            _local_data = zeros((max(self._ratios), *self.shape[1:]), dtype=dtype)
            
            if static.len(S) == 1:
                _ratios = self._ratios.copy()
            elif static.len(S) == 2:
                _ratios = MPP.apply_ratios(self._ratios, max(self._ratios))
            else:
                compile_error("MPP: invalid shape")

            return MPP[S, dtype](
                _mpc=mpc,
                _ratios=_ratios,
                _local_data=_local_data,
                _transposed=self._transposed)

        if static.len(S) == 1:
            _ratios = self._ratios.copy()
            self.unify_encryption()
            _encryption_unified = self._encryption_unified
        elif static.len(S) == 2:
            _encryption_unified=self.collect().sum(mpc)
            _ratios = MPP.apply_ratios(self._ratios, _encryption_unified.shape[0])
            start = _ratios[:mpc.pid - 1].sum()
            stop = start + _ratios[mpc.pid - 1]
            _encryption_unified = _encryption_unified._getitem(mpc, slice(start=start, stop=stop, step=1))
        else:
            compile_error("MPP: invalid shape")
        
        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=_ratios,
            _encryption_unified=_encryption_unified,
            _transposed=self._transposed)
    
    def aggregate_at(self, target_pid: int) -> MPP[S, dtype]:
        mpc = self._mpc
        if mpc.pid == 0:
            return self.copy()
        
        self.unify_encryption()
        enc = self._encryption_unified.copy()
        _ratios = [0 if p != target_pid else enc.shape[0] for p in range(1, mpc.comms.number_of_parties)]
        partitions = mpc.comms.collect_at(enc, target_pid)
        if mpc.pid == target_pid:
            return MPP[S, dtype](
                _mpc=mpc,
                _ratios=_ratios,
                _encryption_unified=partitions.sum(mpc),
                _transposed=self._transposed)
        
        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=_ratios,
            _transposed=self._transposed)
    
    def join(self) -> Ciphertensor[Ciphertext]:
        # The whole cohort as one encryption, its partitions extended in party order, at every compute party. Extending
        # takes one layout, so for a 2-dim MPP the compute parties agree on their partitions first (one round) and a
        # partition in the clear is encrypted in the layout of the encrypted ones (row-wise as held if none is
        # encrypted). It used to be row-wise always, which a column-wise one (a transposed MPP's, encrypted after the
        # transposition) could not be extended by (L-226). Encrypted layouts that differ, and diagonal storages (which
        # Ciphertensor.extend does not stack), raise at every compute party alike; CP0 has returned by then. A vector's
        # transposed flag is no layout (encrypt() sets it on a column's encryption, a sum clears it): the copies join with
        # it cleared, without a round.
        mpc = self._mpc
        if mpc.pid == 0:
            return Ciphertensor[Ciphertext]()
        if static.len(S) == 1:
            partitions = self.collect()
            for partition in partitions:
                partition._transposed = False
            return partitions.unfence(mpc)
        transposed, diagonal, agreed = _encrypted_layout(mpc.comms.collect(_partition_descriptor(self)))
        if not agreed:
            raise ValueError("MPP: the compute parties hold their partitions encrypted in different layouts")
        if diagonal:
            raise NotImplementedError("MPP: joining diagonal-encoded partitions is not implemented yet (Ciphertensor.extend does not stack diagonal storages)")
        return self.collect(int(transposed)).unfence(mpc)
    
    def join_at(self, target_pid: int) -> Ciphertensor[Ciphertext]:
        return self.collect_and_execute_at(target_pid, List.unfence)
    
    def align_ratios(self, ratios: List[int], force: bool) -> MPP[S, dtype]:
        if self._ratios == ratios:
            return self
        
        assert force or self._ratios.sum() == ratios.sum(), f"MPP: cannot align partitions {self._ratios} to {ratios}"

        if self._mpc.pid == 0:
            self_cp = self.copy()
            self_cp._ratios = ratios.copy()
            return self_cp
        
        source_pid = argmax(self._ratios) + 1
        return self.join_at(source_pid).to_mpp(self._mpc, ratios, source_pid=source_pid, S=S, dtype=dtype)
    
    def broadcast_from(self, source_pid: int):
        mpc = self._mpc
        self._ratios = mpc.comms.broadcast_from(self._ratios, source_pid)
        self._local_data = mpc.comms.broadcast_from(self._local_data, source_pid)
        self._encryption_left = mpc.comms.broadcast_from(self._encryption_left, source_pid)
        self._encryption_right = mpc.comms.broadcast_from(self._encryption_right, source_pid)
        self._encryption_unified = mpc.comms.broadcast_from(self._encryption_unified, source_pid)
        self._transposed = mpc.comms.broadcast_from(self._transposed, source_pid)
    
    def encrypt(self):
        mpc = self._mpc
        if mpc.pid == 0 or not self.is_local():
            return

        # Rows of the MPP's orientation go into ciphertext rows: the partition row-wise, or column-wise when the MPP is
        # transposed. The encoding is explicit: left to Ciphertensor.enc, a tall partition would be encoded
        # column-wise and the flag below would then misdescribe it (C-07), and each compute party would pick its layout
        # from its own partition's shape, which differs between them when the ratios do.
        self._encryption_unified = Ciphertensor[Ciphertext].enc(
            mpc, self._local_data.T if self._transposed else self._local_data, encoding=ENC_ROW)
        self._encryption_unified._transposed = self._transposed
        self._local_data = ndarray[S, dtype]()
    
    def reveal(self, *args):
        mpc = self._mpc
        if mpc.pid == 0:
            return self._local_data.T if self._transposed else self._local_data
        
        if self.has_local_data():
            print(
                f"CP{mpc.pid}: WARNING! At least part of the MPP partition is in plaintext. "
                f"Revealing with secure aggregation may cause information leakage.")

        if mpc.council(self.is_local() or self.is_empty()).all():
            print(
                f"CP{mpc.pid}: WARNING! Revealing MPP partition without secure "
                f"aggregation since all parties have plaintext data")
            arr = mpc.comms.collect(self._local_data.copy()).unfence()
        else:
            reveals = [enc.reveal(mpc, source_pid=-1, T=dtype) for enc in self.collect()]
            non_empty_reveals = [e for e in reveals if not e.is_empty()]

            if static.len(S) == 1:
                arr = [item.flatten() for item in non_empty_reveals].unfence()
            elif static.len(S) == 2:
                arr = non_empty_reveals.unfence()
            else:
                compile_error("MPP: can only be 1-dimensional or 2-dimensional")
        
        return arr.T if self._transposed else arr
    
    def reveal_local(self, *args):
        # This compute party's partition, decrypted to it alone (MPCMHE.decrypt's default mode): no other party learns
        # it. Every compute party takes part in that decryption whatever it holds (in the clear, encrypted,
        # semi-encrypted, empty), so it must be called at every party. A semi-encrypted partition's blocks (A @ B.T)
        # belong to the party that holds them: they are decrypted as they are and joined with the block in the clear,
        # without unifying them first (an HE concatenation, whose refreshes only the semi-encrypted parties would run).
        mpc = self._mpc
        print(f"CP{mpc.pid}: INFO: Revealing MPP partition")

        if mpc.pid == 0:
            return self._local_data.T if self._transposed else self._local_data

        if static.len(S) > 2:
            compile_error("MPP: can only be 1-dimensional or 2-dimensional")

        if self.has_unified_encryption():
            blocks = [self._encryption_unified]
        else:
            blocks = [self._encryption_left, self._encryption_right]
        ciphertexts = List[Ciphertext]()
        for block in blocks:
            ciphertexts.extend(block._data)
        plaintexts = mpc.mhe.decrypt(ciphertexts, -2)

        if self.has_unified_encryption():
            arr_mat = MPP._decode_block(mpc, self._encryption_unified, plaintexts, T=dtype)
        elif self.has_partial_encryption():
            arr_mat = self._join_decrypted_blocks(plaintexts)
        else:
            arr = self._local_data
            return arr.T if self._transposed and not arr.is_empty() else arr  # (an empty array cannot be transposed)

        if static.len(S) == 1:
            arr = arr_mat[0]
        else:
            arr = arr_mat
        return arr.T if self._transposed else arr

    @staticmethod
    def _decode_block[T](mpc, block: Ciphertensor[Ciphertext], plaintexts: List[Plaintext]) -> ndarray[Tuple[int, int], T]:
        # The values of an encrypted block from its decryption (a matrix: one row for a 1-dim block)
        return Ciphertensor[Plaintext](
            _data=plaintexts,
            shape=block.shape.copy(),
            slots=block.slots,
            _transposed=block._transposed,
            _diagonal_contiguous=block._diagonal_contiguous,
            _skinny=block._skinny).decode(mpc, T=T)

    def _join_decrypted_blocks(self, plaintexts: List[Plaintext]) -> ndarray[Tuple[int, int], dtype]:
        # A semi-encrypted partition in the clear: its left block, the block in the clear, its right block, side by side
        # (the order MPP.unify_encryption concatenates them in), from the left and right blocks' decryptions in a row
        if static.len(S) == 1:
            raise NotImplementedError("MPP: 1-dimensional semi-encrypted partitions are not supported")
            return ndarray[Tuple[int, int], dtype]()
        else:
            mpc = self._mpc
            n_left = len(self._encryption_left._data)
            arr = self._local_data.copy()
            if self._encryption_left:
                left = MPP._decode_block(mpc, self._encryption_left, plaintexts[:n_left], T=dtype)
                arr = left if arr.is_empty() else left.hstack(arr)
            if self._encryption_right:
                right = MPP._decode_block(mpc, self._encryption_right, plaintexts[n_left:], T=dtype)
                arr = right if arr.is_empty() else arr.hstack(right)
            return arr
    
    def level(self) -> int:
        return min(
            self._encryption_left.level(),
            self._encryption_right.level(),
            self._encryption_unified.level())

    def getitem_local(self, index) -> MPP:
        if not (self.is_local() and isinstance(index, slice) and not self._transposed):
            raise NotImplementedError()
        
        assert index.stop <= len(self._local_data), f"MPP: index out of bound: {index} > {len(self._local_data)}"
        size = index.stop - index.start
        
        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=[size for _ in range(len(self._ratios))],
            _local_data=self._local_data[index])

    def actual_itranspose(self) -> MPP[S, dtype]:
        self.set(self.via_mpc(lambda stensor: stensor.T))
        return self
    
    def actual_transpose(self) -> MPP[S, dtype]:
        return self.copy().actual_itranspose()
    
    def sign(self, *args) -> MPP[S, dtype]:
        return sign(self._mpc, self)
    
    def sum(self, axis: int) -> MPP[Tuple[int], dtype]:
        # The sum along axis, laid out as the class docstring says (a 2-dim MPP's sums within its partitions are a
        # column split, those across them a row at the hub). Call it at every party: CP0 returns a placeholder of the
        # result's shape, and the compute parties agree on their partitions in one round (_sum_partitions).
        if static.len(S) != 2 and static.len(S) != 1:
            compile_error("MPP: invalid shape for sum")
        assert 0 <= axis < self.ndim, "MPP: axis out of range for sum"

        mpc = self._mpc
        held = self._held_axis(axis)
        across = self._sums_across(axis)
        hub = mpc.comms.hub_pid
        if across:
            # A row the hub holds (2-dim), or a column of length 1 at the hub (1-dim), which MPP.broadcast takes
            _ratios = one_hot_vector(idx=hub - 1, size=mpc.comms.number_of_parties - 1, TP=int)
            _transposed = static.len(S) == 1
        else:
            # Every party's sums of its rows: a column split like the operand (2-dim); a held row's sum stays with its
            # holder (1-dim)
            _ratios = self._ratios.copy()
            _transposed = static.len(S) == 2

        if mpc.pid == 0:
            return MPP[Tuple[int], dtype](
                _mpc=mpc,
                _ratios=_ratios,
                _local_data=self._local_data.sum_axis(held),
                _transposed=_transposed)

        _local_data, _encryption_unified, _, _ = self._sum_partitions(held, across)
        if across:
            # Each party's partial sums, encrypted (those in the clear for this, row-wise whatever the ambient encoding), go
            # to the hub alone, which adds them: no party gathers the whole cohort (it used to be joined at every party,
            # L-105)
            if not _local_data.is_empty():
                _encryption_unified = Ciphertensor[Ciphertext].enc(mpc, _local_data, encoding=ENC_ROW)
                _local_data = ndarray[Tuple[int], dtype]()
            partial_sums = mpc.comms.collect_at(_encryption_unified, hub)
            if mpc.pid == hub and any(bool(partial) for partial in partial_sums):  # (a cohort without rows sums to nothing)
                _encryption_unified = partial_sums.sum(mpc)
            else:
                _encryption_unified = Ciphertensor[Ciphertext]()

        return MPP[Tuple[int], dtype](
            _mpc=mpc,
            _ratios=_ratios,
            _local_data=_local_data,
            _encryption_left=Ciphertensor[Ciphertext](),
            _encryption_right=Ciphertensor[Ciphertext](),
            _encryption_unified=_encryption_unified,
            _transposed=_transposed)

    def _held_axis(self, axis: int) -> int:
        # The axis of the partitions as held that a sum along axis runs along
        if static.len(S) == 2:
            return axis ^ int(self._transposed)
        return 0

    def _sums_across(self, axis: int) -> bool:
        # Whether a sum along axis adds up across the partitions (a 2-dim MPP's columns as held, a column's entries) or
        # within each (a 2-dim MPP's rows as held, a held row). An untransposed 1-dim MPP whose ratios sum to more than 1
        # is no held row: MPP(mpc, vector) builds one from each party's vector, and it reads as a column, as
        # Sharetensor.to_mpp reads such ratios (summed as a held row, each party's sum came back apart)
        if static.len(S) == 2:
            return self._held_axis(axis) == 0
        return self._transposed or self._ratios.sum() > 1

    def _sum_partitions(self, axis: int, across: bool) -> Tuple[ndarray[Tuple[int], dtype], Ciphertensor[Ciphertext], List[List[int]], int]:
        # This compute party's partition summed along axis (of the partitions as held), in the clear or encrypted as it
        # holds it (_own_sum), every partition's descriptor, and the sums' length. Call it at every compute party. They
        # agree in one round, which carries each party's descriptor, the refresh councils (collective bootstrap checks)
        # its own sum will make (_own_sum_refreshes: each party counts its own, knowing its tensors), and its sums'
        # length. Each party then makes as many councils as the most any makes, the difference on nil-ideal placeholders
        # (a party in the clear, with an empty partition, or with fewer rows makes fewer). A sum that some party cannot
        # compute raises at every compute party alike, before any sums (CP0 has returned its placeholder). Each party sums
        # its own partition: none is padded, and a mixed cohort keeps each party's representation (M-MP-23).
        mpc = self._mpc
        mine = _partition_descriptor(self)
        mine.append(self._own_sum_refreshes(axis, across))
        mine.append(self._own_sum_length(axis))
        everyone = mpc.comms.collect(mine)
        refreshes = [d[D_SIZE] for d in everyone]
        if any(r < 0 for r in refreshes):
            raise NotImplementedError("MPP: this sum of an encrypted partition is not implemented yet (along the rows of a diagonal storage; a skinny diagonal storage whose rows span several ciphertexts it cannot fold; a semi-encrypted partition's blocks that are not column-wise, summed across the partitions; or as many storage rows to reduce as there are slots)")
        local, encryption = self._own_sum(axis, across)
        MPP._shadow_sum_refreshes(mpc, max(refreshes) - refreshes[mpc.pid - 1])
        return local, encryption, [d[:D_SIZE] for d in everyone], max(d[D_SIZE + 1] for d in everyone)

    def _own_sum(self, axis: int, across: bool) -> Tuple[ndarray[Tuple[int], dtype], Ciphertensor[Ciphertext]]:
        # This compute party's partition summed along axis (of the partition as held), as it holds it: in the clear, its
        # unified encryption, or a semi-encrypted one block by block (an A @ B.T result's blocks are lazily transposed:
        # their row sums add ciphertexts). Across the partitions a 2-dim semi-encrypted partition is unified first: one
        # column-wise tensor of all its columns, whose column sums' refreshes the width alone sets (_own_sum_refreshes
        # counts them; the shadows make up any difference between the parties). The result
        # is a 1-dim tensor, row-wise whatever flag the encryption carried (a flag left set would decode it as a column).
        mpc = self._mpc
        local = ndarray[Tuple[int], dtype]()
        encryption = Ciphertensor[Ciphertext]()
        if self.is_empty():
            return local, encryption
        if self.is_local():
            return self._local_data.sum_axis(axis), encryption
        if across and static.len(S) == 2:
            self.unify_encryption()
        if self.has_unified_encryption():
            encryption = MPP._encryption_sum(mpc, self._encryption_unified, axis)
        else:
            # Row-wise whatever the ambient encoding: a 1-dim tensor has no other layout
            encryption = Ciphertensor[Ciphertext].enc(mpc, self._local_data.sum_axis(axis), encoding=ENC_ROW)
            if self._encryption_left: encryption.iadd(mpc, MPP._encryption_sum(mpc, self._encryption_left, axis))
            if self._encryption_right: encryption.iadd(mpc, MPP._encryption_sum(mpc, self._encryption_right, axis))
        return local, encryption

    @staticmethod
    def _encryption_sum(mpc, encryption: Ciphertensor[Ciphertext], axis: int) -> Ciphertensor[Ciphertext]:
        summed = encryption.sum(mpc, axis)
        summed._transposed = False
        return summed

    def _own_sum_refreshes(self, axis: int, across: bool) -> int:
        # The refresh councils this compute party's _own_sum will make, as Ciphertensor.sum makes them, or -1 where it
        # cannot sum (it asserts or raises there): one for each 1-dim encryption it reduces (a masked product); for a 2-dim
        # one see _encryption_sum_refreshes. Across the partitions a semi-encrypted partition is unified first: with
        # column-wise blocks (an A @ B.T result's) that appends ciphertexts, giving a column-wise encryption of all its
        # columns; other blocks would unify through concatenations, whose refreshes are not counted here (-1).
        if self.is_empty() or self.is_local():
            return 0
        if static.len(S) == 1:
            if self.has_unified_encryption():
                return 1
            return int(bool(self._encryption_left)) + int(bool(self._encryption_right))
        slots = self._mpc.mhe.crypto_params.params.slots()
        if self.has_unified_encryption():
            return MPP._encryption_sum_refreshes(self._encryption_unified, axis, slots)
        blocks = [block for block in (self._encryption_left, self._encryption_right) if block]
        if across:
            if not all(block._transposed and not block._diagonal_contiguous for block in blocks):
                return -1
            width = self._local_data.shape[-1]
            for block in blocks:
                width += block.actual_shape[-1]
            return MPP._storage_row_refreshes(width, slots)
        total = 0
        for block in blocks:
            refreshes = MPP._encryption_sum_refreshes(block, axis, slots)
            if refreshes < 0:
                return -1
            total += refreshes
        return total

    @staticmethod
    def _encryption_sum_refreshes(encryption: Ciphertensor[Ciphertext], axis: int, slots: int) -> int:
        # Ciphertensor.sum's refreshes along axis (of the encryption as held) of a 2-dim encryption: along its ciphertext
        # rows (axis 1 of its storage) one for each row it reduces, fewer than the slots; down its rows none. A diagonal
        # storage sums only down its rows: a wide one adds its diagonals, a skinny one then folds them (reduce_add_tiled:
        # one masked product of one diagonal, or two refreshes of mhe.mul for more, which raises for a storage row over
        # several ciphertexts it cannot fold).
        if encryption._diagonal_contiguous:
            if axis ^ int(encryption._transposed) == 1:
                return -1
            if not encryption._skinny:
                return 0
            tile = min(encryption.shape)
            if tile == 1:
                return 1
            row = encryption.shape[-1]
            return -1 if row > slots and (row % slots or slots % tile) else 2
        if axis ^ int(encryption._transposed) == 0:
            return 0
        return MPP._storage_row_refreshes(encryption.shape[0], slots)

    @staticmethod
    def _storage_row_refreshes(storage_rows: int, slots: int) -> int:
        # Ciphertensor.sum along the rows of a storage (row-wise: the rows as held; column-wise, transposed: the columns)
        # reduces each storage row with one masked product, one refresh each; it asserts on as many rows as slots
        return storage_rows if storage_rows < slots else -1

    def _own_sum_length(self, axis: int) -> int:
        # The length of this compute party's sums along axis: a 2-dim partition's rows (along its rows) or columns (down
        # them), as held, 1 for a 1-dim partition, 0 for an empty one (the shares an empty partition holds in MPU sums)
        if self.is_empty():
            return 0
        if static.len(S) == 1:
            return 1
        held = self.shape[::-1] if self._transposed else self.shape
        return held[0] if axis == 1 else held[1]

    @staticmethod
    def _shadow_sum_refreshes(mpc, count: int):
        # count refresh councils that other compute parties' sums make, through Ciphertensor.sum itself on a nil-ideal
        # placeholder: one council per row it reduces, no arithmetic
        slots = mpc.mhe.crypto_params.params.slots()
        while count > 0:
            rows = min(count, slots - 1)
            Ciphertensor[Ciphertext].placeholder([rows, 1], slots).sum(mpc, 1)
            count -= rows

    def dot(self, axis: int) -> MPP[Tuple[int], dtype]:
        if static.len(S) != 2 and static.len(S) != 1:
            compile_error("MPP: invalid shape for dot product")
        
        return (self * self).sum(axis)
    
    def matmul(self, other) -> MPP[S, dtype]:
        mpc = self._mpc
        assert self.ndim == other.ndim == 2, f"MPP: Invalid dimensions for matmul. {self.ndim} != {other.ndim}"
        if mpc.pid: assert self.cohort_shape[1] == other.cohort_shape[0], f"MPP: Invalid shapes for matmul at CP{mpc.pid}. {self.cohort_shape} x {other.cohort_shape}"
        else: assert self.shape[1] == other.shape[0], f"MPP: Invalid shapes for matmul at CP0. {self.shape} x {other.shape}"
                
        if isinstance(other, ndarray):
            # Under allow_mpc_switch the product may switch the whole MPP to MPC (H-53). The choice is made once, from
            # public data, and taken only if no compute party holds its partition in the clear, which takes one round
            # with every party: CP0 cannot tell, and it must join the MPC product.
            if static.len(S) == 2:
                if not self._transposed and MPP._public_matmul_via_mpc_wins(mpc, self._ratios, list(other.shape)) and self._cohort_encrypted():
                    return self.via_mpc(lambda stensor: secure_operator.matmul(mpc, stensor, other))
            return MPP._matmul_public(mpc, self, other)
        
        if self._transposed and other._transposed:
            return MPP._matmul_case_tt(mpc, self, other)
        if not self._transposed and not other._transposed:
            return MPP._matmul_case_ntnt(mpc, self, other)

        if self._transposed and not other._transposed:
            return MPP._matmul_case_tnt(mpc, self, other)
        else: # case not self._transposed and other._transposed
            return MPP._matmul_case_ntt(mpc, self, other)
    
    def replicate(self, new_size: int) -> MPP[S, dtype]:
        mpc = self._mpc
        if static.len(S) != 1 and static.len(S) != 2:
            compile_error("Not implemented yet: MPP n-dim patch copy")
        assert not self.is_semi_encrypted(), "Not implemented yet: Semi-encrypted MPP patch copy"
        assert not self.is_empty(), "MPP: cannot patch copy empty partition"

        new_mpp = MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=self._ratios)
        
        if self.is_local() or mpc.pid == 0:
            new_mpp._local_data = self._local_data.replicate(new_size)
        elif self.is_full_encrypted():
            new_mpp._encryption_unified = self._encryption_unified.replicate(mpc, new_size, True)
        else:
            raise NotImplementedError("MPP: expected to be either local or fully encrypted for patch copy at the moment")
        
        return new_mpp
    
    def local_broadcast[S2](self, target_shape: S2) -> MPP[S2, dtype]:
        if self.is_empty():
            return self
        
        if self.shape == target_shape:
            return self
        
        if static.len(S2) > static.len(S):
            raise NotImplementedError("Broadasting MPP from lower to higher dimension not implemented yet")
        elif static.len(S2) == static.len(S):
            if static.len(S2) == 1 and target_shape[0] > self.shape[0] and self.shape[0] == 1:
                return self.replicate(target_shape[0])
            if static.len(S2) == 2:
                if self.shape[0] == target_shape[0]:
                    assert self.shape[1] == 1, f"CP{self._mpc.pid}:\tCannot broadcast shape {self.shape} to {target_shape}"
                    return self.replicate(target_shape[1])
            return self
        else:
            compile_error("MPP: Incompatible shapes for broadcast")

    def broadcast(self, target: MPP[S, dtype]) -> MPP[S, dtype]:
        assert self._ratios.sum() == 1, "MPP: only single-row MPPs can be broadcasted"
        
        assert self.ndim == 1, "Not implemented yet: broadcasting n-dimensional MPP"
        assert self._transposed, "Not implemented yet: broadcasting non-transposed MPP"
        assert target._transposed, "Not implemented yet: broadcasting to non-transposed MPP"
        assert self.is_full_encrypted() or self.is_empty(), "Not implemented yet: broadcasting a non-encrypted MPP"
        assert target.is_full_encrypted() or target.is_empty(), "Not implemented yet: broadcasting to a non-encrypted MPP"

        self_cp = self.copy()

        mpc = self._mpc
        if mpc.pid == 0:
            self_cp._ratios = target._ratios.copy()
            self_cp._local_data = self_cp._local_data.replicate(target._ratios[mpc.pid - 1])
        
        self_cp.broadcast_from(argmax(self._ratios) + 1)
        self_cp._encryption_unified = self_cp._encryption_unified.replicate(mpc, target._ratios[mpc.pid - 1])
        self_cp._ratios = target._ratios.copy()

        return self_cp

    def zeros[S1](self, shape: S1) -> MPP[S1, dtype]:
        mpc = self._mpc
        ref_pid = mpc.pid - 1

        if static.len(S1) == 1:
            _local_data = zeros(shape, dtype=dtype) if (mpc.pid == 0 or ref_pid == argmax(self._ratios)) else ndarray[S1, dtype]()
            return MPP[S1, dtype](
                _mpc=mpc,
                _ratios=self._ratios.copy(),
                _local_data=_local_data)
        
        adjusted_ratios = MPP.apply_ratios(self._ratios, shape[0])
        adjusted_shape = (adjusted_ratios[ref_pid], *shape[1:])
        
        if mpc.pid == 0:
            return MPP[S1, dtype](
                _mpc=mpc,
                _ratios=adjusted_ratios,
                _local_data=zeros(shape, dtype=dtype))

        return MPP[S1, dtype](
            _mpc=mpc,
            _ratios=adjusted_ratios,
            _local_data=zeros(adjusted_shape, dtype=dtype))
    
    def zeros(self) -> MPP[S, dtype]:
        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=zeros(self.shape, dtype=dtype))
    
    def ones(self, *args) -> MPP[S, dtype]:
        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=ones(self.shape, dtype=dtype))
    
    @staticmethod
    def rand(shape: S, distribution: str, mpc) -> MPP[S, dtype]:
        """
        Note: must be called at all parties (including trusted dealer)
        """
        if distribution == "uniform":
            random_local_data = rand_uniform(shape)
        elif distribution == "normal":
            random_local_data = rand_normal(shape)
        elif distribution == "zeros":
            random_local_data = ndarray[S, dtype].zeros(shape)
        elif distribution == "ones":
            random_local_data = ndarray[S, dtype].zeros(shape)
            for i in range(random_local_data.size):
                random_local_data._data[i] = dtype(1)
        else:
            raise ValueError(f"Non-supported distribution: {distribution}")

        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=mpc.comms.collect(shape[0], include_trusted_dealer=True)[1:],
            _local_data=random_local_data)
    
    def rand(self, distribution: str, *args) -> MPP[S, dtype]:
        if distribution == "uniform":
            random_local_data = rand_uniform(self.shape)
        elif distribution == "normal":
            random_local_data = rand_normal(self.shape)
        elif distribution == "zeros":
            random_local_data = ndarray[S, dtype].zeros(self.shape)
        elif distribution == "ones":
            random_local_data = ndarray[S, dtype].zeros(self.shape)
            for i in range(random_local_data.size):
                random_local_data._data[i] = dtype(1)
        else:
            raise ValueError(f"Non-supported distribution: {distribution}")

        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=random_local_data)

    def hstack(self, other:  MPP[S, dtype]) ->  MPP[S, dtype]:
        if self.is_local() and other.is_local():
            return MPP[S, dtype](
                _mpc=self._mpc,
                _ratios=self._ratios.copy(),
                _local_data=self._local_data.hstack(other._local_data))

        raise NotImplementedError("MPP: hstack supported only on local/non-encrypted MPPs for now.")
    
    def pad_with_value(self, val, size: int, axis: int, *args):
        mpc = self._mpc
        
        if static.len(S) != 2:
            compile_error("MPP: only 2-dim MPPs can be padded with values")
        
        if self._transposed:
            axis ^= 1
        
        assert axis == 1, "Not implemented yet: MPP pad_with_value over 0-axes"
        
        _local_data = ndarray[Tuple[int, int], dtype]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        if not self._local_data.is_empty(): _local_data = self._local_data.pad_with_value(val, size, axis)
        if self._encryption_right: _encryption_right = self._encryption_right.pad_with_value(val, size, axis, mpc)
        if self._encryption_unified: _encryption_unified = self._encryption_unified.pad_with_value(val, size, axis, mpc)

        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=self._ratios.copy(),
            _local_data=_local_data,
            _encryption_left=_encryption_left,
            _encryption_right=_encryption_right,
            _encryption_unified=_encryption_unified,
            _transposed=self._transposed)
    
    def expand_dims(self, axis: int = 0) -> MPP:
        if static.len(S) != 1:
            compile_error("MPP: only 1-dim MPPs can be expanded")
        
        _local_data = ndarray[Tuple[int, int], dtype]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        if self._transposed:
            axis ^= 1
        
        if not self._local_data.is_empty(): _local_data = self._local_data.expand_dims(axis=axis)
        if self._encryption_left: _encryption_left = self._encryption_left.expand_dims(axis=axis)
        if self._encryption_right: _encryption_right = self._encryption_right.expand_dims(axis=axis)
        if self._encryption_unified: _encryption_unified = self._encryption_unified.expand_dims(axis=axis)

        return MPP[Tuple[int, int], dtype](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=_local_data,
            _encryption_left=_encryption_left,
            _encryption_right=_encryption_right,
            _encryption_unified=_encryption_unified,
            _transposed=self._transposed)
    
    def extend(self, other: MPP[S, dtype]) -> MPP[S, dtype]:
        assert self._transposed and other._transposed, "Not implemented yet: non-transposed MPP"
        
        mpc = self._mpc
        if mpc.pid == 0:
            self._local_data = self._local_data.T.extend(other._local_data.T).T
            return self

        assert self.has_unified_encryption() and other.is_local(), "Not implemented yet: MPP extend for arbitrary operands"
        self._encryption_unified.iconcat(mpc, Ciphertensor[Ciphertext].enc(mpc, other._local_data.T).T, axis=1)

        return self
    
    @staticmethod
    def get_relative_indices(pid: int, ratios: List[int]) -> Tuple[int, int]:
        ref_pid = pid - 1
        start = ratios[:ref_pid].sum()
        stop = start + ratios[ref_pid]
        return start, stop
    
    def get_relative_indices(self) -> Tuple[int, int]:
        ref_pid = self._mpc.pid - 1
        start = self._ratios[:ref_pid].sum()
        stop = start + self._ratios[ref_pid]
        return start, stop
    
    @staticmethod
    def apply_ratios(ratios: List[int], target_size: int, approximate: bool = True) -> List[int]:
        s = ratios.sum()
        
        if not approximate:
            new_ratios = []
            for r in ratios:
                scaled_r = r * target_size
                assert scaled_r % s == 0, f"MPP: cannot distribute partitions by the given proportion. Target number of rows: {target_size}. Ratios: {ratios}"
                new_ratios.append(scaled_r // s)
            return new_ratios
        
        new_ratios = [int(r * target_size / s) for r in ratios]
        offset = target_size - new_ratios.sum()
        if offset:
            new_ratios[-1] += offset
        
        return new_ratios
    
    @staticmethod
    def split_by_ratios(mpc, data: ndarray[S, dtype], ratios: List[int]) -> ndarray[S, dtype]:
        if mpc.pid == 0:
            return data.zeros()
        
        if not ratios:
            return data
        
        ref_pid = mpc.pid - 1
        slice_start = ratios[:ref_pid].sum()
        slice_end = slice_start + ratios[ref_pid]

        return data[slice_start:slice_end]
    
    @staticmethod
    def uniform_ratios(size: int, number_of_parties: int) -> List[int]:
        assert number_of_parties > 0, "MPP: Invalid number of parties to uniformly split the ratios"
        
        ratio = size // number_of_parties
        ratios = [ratio for _ in range(number_of_parties)]
        ratios[-1] += size % number_of_parties
        
        assert ratios.sum() == size, "MPP: Internal error. Ratios uniform distribution failed"
        return ratios

    def get_matmul_cost(self, other):
        if isinstance(other, ndarray):
            return MPP._get_matmul_public_cost(self, other)
        
        if self._transposed and other._transposed:
            return MPP._get_matmul_case_tt_cost(self, other)
        if not self._transposed and not other._transposed:
            return MPP._get_matmul_case_ntnt_cost(self, other)

        if self._transposed and not other._transposed:
            return MPP._get_matmul_case_tnt_cost(self, other)
        else: # case not self._transposed and other._transposed
            return MPP._get_matmul_case_ntt_cost(self, other)
    
    def via_mpc(self, foo, *args):
        # Call it at every party, CP0 included: foo runs the MPC protocol, in which CP0 deals randomness
        descriptors = self._partition_descriptors()
        stensor = foo(self._to_sharetensor(descriptors), *args)
        lazy_stensor = stensor.T if self._transposed else stensor
        transpose_encryption = MPP._agreed_transpose_encryption(descriptors)
        new_mpp = lazy_stensor.to_mpp(self._mpc, self._ratios.copy(), transpose_encryption, dtype=dtype)
        new_mpp._transposed = self._transposed
        return new_mpp
    
    def cov_max(self, mpc, transpose_encryption: bool = False):
        stensor = self.to_sharetensor()
        result = maximum(mpc, stensor, stensor.T)
        lazy_result = result.T if self._transposed else result
        new_mpp = lazy_result.to_mpp(self._mpc, self._ratios.copy(), transpose_encryption, dtype=dtype)
        new_mpp._transposed = self._transposed
        return new_mpp
    
    def erase_element(self, index: int) -> MPP[S, dtype]:
        assert self.is_local() or self.is_empty(), "Not implemented yet: erasing element of encrypted MPP"
        _local_data = ndarray[S, dtype]()

        if not self.is_empty():
            _local_data = self._local_data.erase_element(index)
        
        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=self._ratios.copy(),
            _local_data=_local_data)

    def _autocast(self, other):
        assert isinstance(other, MPP) or isinstance(other, ndarray), "MPP: Autocasting can be done only between MPPs or ndarrays for now"
        
        if isinstance(dtype, type(other._internal_type)):
            return self, other
        if isinstance(dtype, int) and isinstance(type(other._internal_type), float):
            return self.astype(float), other
        if isinstance(dtype, float) and isinstance(type(other._internal_type), int):
            return self, other.astype(float)
        
        compile_error("Cannot autocast dtypes")
    
    @staticmethod
    def _get_matmul_public_cost(first: MPP, other: ndarray) -> float:
        if first.is_empty() or first._mpc.pid == 0:
            cost = 0.0
        elif first.is_local():
            cost = first._local_data.get_matmul_cost(other)
        else:
            cost = first._encryption_unified.get_matmul_cost(other)
        
        return max(first._mpc.comms.collect(cost, True)[1:])
    
    @staticmethod
    def _get_matmul_case_ntnt_cost(first: MPP, other: MPP) -> float:
        slots = first._mpc.mhe.crypto_params.params.slots()
        shape_1 = first.shape
        shape_2 = other.shape
        return (Ciphertensor._count_ciphers(shape_1, slots) + Ciphertensor._count_ciphers(shape_2, slots)) * MHE_MPC_SWITCH_COST_ESTIMATE + Sharetensor.get_matmul_cost_for_shapes(shape_1, shape_2)

    @staticmethod
    def _get_matmul_case_tt_cost(first: MPP, other: MPP) -> float:
        return MPP._get_matmul_case_ntnt_cost(first, other)
    
    @staticmethod
    def _get_matmul_case_tnt_cost(first: MPP, other: MPP) -> float:
        slots = first._mpc.mhe.crypto_params.params.slots()
        
        if first.is_empty() or other.is_empty() or first._mpc.pid == 0:
            matmul_cost = 0.0
        elif first.is_local() and other.is_local():
            matmul_cost = first._local_data.T.get_matmul_cost(other._local_data) + HE_ENC_COST_ESTIMATE * Ciphertensor._count_ciphers([first._local_data.shape[1], other._local_data.shape[1]], slots)
        elif first.is_local():
            matmul_cost = first._local_data.T.get_matmul_cost(other._encryption_unified) 
        elif other.is_local():
            matmul_cost = first._encryption_unified.T.get_matmul_cost(other._local_data)
        else:
            matmul_cost = first._encryption_unified.T.get_matmul_cost(other._encryption_unified)
        
        result_shape = (first.shape[1], other.shape[1])
        matmul_cost += MHE_MPC_SWITCH_COST_ESTIMATE * Ciphertensor._count_ciphers(result_shape, slots)
        return max(first._mpc.comms.collect(matmul_cost, True)[1:])
    
    @staticmethod
    def _get_matmul_case_ntt_cost(first: MPP, other: MPP) -> float:
        slots = first._mpc.mhe.crypto_params.params.slots()
        reference_pid = first._mpc.pid - 1
        cost = 0.0
        
        if first.is_empty() or other.is_empty() or first._mpc.pid == 0:
            pass
        elif other.is_local():
            other_encryption_left_shape = (other._ratios[:reference_pid].sum(), other.shape[-1])
            other_encryption_right_shape = (other._ratios[reference_pid + 1:].sum(), other.shape[-1])
            other_encryption_left = Ciphertensor[Ciphertext](
                shape=list(other_encryption_left_shape),
                slots=slots)
            other_encryption_right = Ciphertensor[Ciphertext](
                shape=list(other_encryption_right_shape),
                slots=slots)

            if first.is_local():
                if ndarray._count(other_encryption_left_shape): cost += first._local_data.get_matmul_cost(other_encryption_left.T)
                cost += first._local_data.get_matmul_cost(other._local_data.T)
                if ndarray._count(other_encryption_right_shape): cost += first._local_data.get_matmul_cost(other_encryption_right.T)
            else:
                if ndarray._count(other_encryption_left_shape):
                    cost += first._encryption_unified.get_matmul_cost(other_encryption_left.T)
                cost += first._encryption_unified.get_matmul_cost(other._local_data.T)
                if ndarray._count(other_encryption_right_shape):
                    cost += first._encryption_unified.get_matmul_cost(other_encryption_right.T)
        else:
            other_encryption = Ciphertensor[Ciphertext](
                shape=[other._ratios.sum(), other.shape[-1]],
                slots=slots)
        
            if first.is_local():
                cost = first._local_data.get_matmul_cost(other_encryption.T)
            else:
                cost = first._encryption_unified.get_matmul_cost(other_encryption.T)
    
        return max(first._mpc.comms.collect(cost, True)[1:])
    
    @sequre
    def _matmul_public(mpc, first: MPP[S, dtype], other: ndarray[S, dtype]) -> MPP[S, dtype]:
        if DEBUG: print(f"CP{mpc.pid}:\tMPP matmul public. Local shapes: {first.shape} x {other.shape}")
        
        assert first.ndim == other.ndim == 2, f"MPP: Invalid dimensions for matmul. {first.ndim} != {other.ndim}"

        if first._transposed:
            start, stop = first.get_relative_indices()
            return MPP._matmul_case_tnt(mpc, first, MPP[S, dtype](mpc, other[start:stop], first._ratios))
        
        assert first.is_empty() or first.shape[1] == other.shape[0], f"MPP: Invalid shapes for public matmul. {first.shape} x {other.shape}"
        
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=first._mpc,
                _ratios=first._ratios.copy(),
                _local_data=zeros((first._local_data.shape[0], other.shape[1]), dtype=dtype))
        
        _local_data = ndarray[S, dtype]()
        _encryption_unified = Ciphertensor[Ciphertext]()
        
        # The compute parties agree on their partitions (one round), padded to the most rows: the HE kernels refresh per
        # row. Each multiplies its own partition, in the clear or in HE; if some party holds an encrypted one, those that
        # hold theirs in the clear (or none) run the same HE product on a placeholder of the same shape and layout, so
        # every party makes the same refresh councils. Whether to switch to MPC was decided for the whole MPP (matmul):
        # each partition's own product stays in HE, as a switch there would need CP0.
        with first.partition_aligner(ALIGN_UNIFORM) as aligner:
            kind = aligner.own_kind()
            shadow = MPP._shadow_operand(mpc, aligner.descriptors, max(first._ratios), other.shape[0])
            allow_mpc_switch = mpc.default_allow_mpc_switch
            mpc.default_allow_mpc_switch = False
            if kind == MPP_CLEAR:
                _local_data = first._local_data @ other
            elif kind != MPP_EMPTY:
                first.unify_encryption()
                _encryption_unified = first._encryption_unified @ other
            if shadow and (kind == MPP_CLEAR or kind == MPP_EMPTY):
                shadow @ other
            mpc.default_allow_mpc_switch = allow_mpc_switch
            
            return aligner.new_mpp(
                _local_data=_local_data,
                _encryption_unified=_encryption_unified)

    @staticmethod
    def _shadow_operand(mpc, descriptors: List[List[int]], rows: int, cols: int) -> Ciphertensor[Ciphertext]:
        # A nil-ideal placeholder in the shape (rows x cols) and layout of the cohort's encrypted partitions, on which a
        # party that holds its partition in the clear (or none) runs the others' HE product; empty if no party holds an
        # encrypted partition. Call it at every compute party: it raises at every one if the layouts disagree.
        if not any(d[D_KIND] == MPP_UNIFIED or d[D_KIND] == MPP_SEMI for d in descriptors):
            return Ciphertensor[Ciphertext]()
        transposed, diagonal, agreed = _encrypted_layout(descriptors)
        if not agreed:
            raise ValueError("MPP: the compute parties hold their partitions encrypted in different layouts")
        if diagonal:
            raise NotImplementedError("MPP: a product of diagonal-encoded partitions with partitions in the clear or empty ones")
        slots = mpc.mhe.crypto_params.params.slots()
        placeholder = Ciphertensor[Ciphertext].placeholder([cols, rows] if transposed else [rows, cols], slots)
        placeholder._transposed = transposed
        return placeholder

    @staticmethod
    def _public_matmul_via_mpc_wins(mpc, ratios: List[int], other_shape: List[int]) -> bool:
        # Under allow_mpc_switch: whether switching the whole MPP to MPC for its product with a plaintext matrix of
        # other_shape is estimated cheaper than the HE products the compute parties run on their partitions at the
        # same time (row-wise partitions, aligned to the most rows). The switch converts and multiplies every row, so
        # it is costed on all of them. Public data only, so every party, CP0 included, decides alike.
        if not mpc.default_allow_mpc_switch:
            return False
        total_rows = ratios.sum()
        if total_rows == 0:
            return False
        slots = mpc.mhe.crypto_params.params.slots()
        partition_shape = [max(ratios), other_shape[0]]
        via_mpc = Ciphertensor._get_matmul_via_mpc_cost_by_shape([total_rows, other_shape[0]], other_shape, slots)
        he = min(
            Ciphertensor._get_matmul_v1_cost_by_shape(partition_shape, other_shape, slots),
            Ciphertensor._get_matmul_v2_cost_by_shape(partition_shape, other_shape, slots),
            Ciphertensor._get_matmul_v3_cost_by_shape(partition_shape, other_shape, slots),
            Ciphertensor._get_matmul_bsgs_cost_by_shape(partition_shape, other_shape, slots))
        return via_mpc <= he
    
    def _matmul_case_ntnt(mpc, first: MPP[S, dtype], other: MPP[S, dtype]) -> MPP[S, dtype]:
        if DEBUG: print(f"CP{mpc.pid}:\tMPP matmul case non-transposed x non-transposed. Local shapes: {first.shape} x {other.shape}")
        return first.via_mpc(lambda stensor: secure_operator.matmul(mpc, stensor, other.to_sharetensor()))

    def _matmul_case_tt(mpc, first: MPP[S, dtype], other: MPP[S, dtype]) -> MPP[S, dtype]:
        if DEBUG: print(f"CP{mpc.pid}:\tMPP matmul case transposed x transposed. Local shapes: {first.shape} x {other.shape}")
        return first.via_mpc(lambda stensor: secure_operator.matmul(mpc, stensor, other.to_sharetensor()))

    @sequre
    def _matmul_case_tnt(mpc, first: MPP[S, dtype], other: MPP[S, dtype]) -> MPP[S, dtype]:
        if DEBUG: print(f"CP{mpc.pid}:\tMPP matmul case transposed x non-transposed. Local shapes: {first.shape} x {other.shape}")
        
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=first._mpc,
                _ratios=MPP.apply_ratios(first._ratios, first._local_data.shape[1]),
                _local_data=zeros((first._local_data.shape[1], other._local_data.shape[1]), dtype=dtype))

        # The compute parties agree on both factors in one round. A factor that some of them hold in the clear and others
        # encrypted is encrypted at every party for the product (ALIGN_ENCRYPT): the per-party products are summed, so
        # every party must run the same HE product and get a result of the same layout. The partitions' own products
        # never switch to MPC, which would need CP0.
        first_descriptors, other_descriptors = _agree_on_partitions(first, other)
        MPP._check_same_partitions(first_descriptors, other_descriptors)

        enc = Ciphertensor[Ciphertext]()
        
        with first.partition_aligner(ALIGN_ENCRYPT, first_descriptors), other.partition_aligner(ALIGN_ENCRYPT, other_descriptors):
            assert first.shape[1] == other.shape[0], f"MPP: Invalid shapes for per-partition matmul. {first.shape} x {other.shape}"

            if not first.is_empty():
                if not first.is_local():
                    first.unify_encryption()
                if not other.is_local():
                    other.unify_encryption()
                
                allow_mpc_switch = mpc.default_allow_mpc_switch
                mpc.default_allow_mpc_switch = False
                if first.is_local() and other.is_local():
                    enc = Ciphertensor[Ciphertext].enc(mpc, first._local_data.T @ other._local_data)
                elif first.is_local():
                    enc = first._local_data.T @ other._encryption_unified
                elif other.is_local():
                    enc = first._encryption_unified.T @ other._local_data
                else:
                    enc = first._encryption_unified.T @ other._encryption_unified
                mpc.default_allow_mpc_switch = allow_mpc_switch

        # Every compute party ran the same product on partitions of the same shape, so the results' layouts agree
        # without a council. A result that is not row-wise (diagonal, or column-wise: the kernels' layout for an
        # encrypted factor) is redistributed through MPC, which splits it by its rows; splitting its physical rows
        # instead returned the wrong layout (H-25). TODO: Temporary solution. Inefficient.
        if enc._diagonal_contiguous or enc._transposed:
            joined_sum = mpc.comms.collect(enc).sum(mpc)
            return joined_sum.to_sharetensor(
                mpc, modulus=mpc.default_mpc_modulus, source_pid=-1, S=S, dtype=float).to_mpp(
                    mpc, ratios=first._ratios, dtype=dtype)
        
        return mpc.comms.collect_at(enc, mpc.comms.hub_pid).sum(mpc).to_mpp(mpc, first._ratios, source_pid=mpc.comms.hub_pid, S=S, dtype=dtype)

    @sequre
    def _matmul_case_ntt(mpc, first: MPP[S, dtype], other: MPP[S, dtype]) -> MPP[S, dtype]:
        if DEBUG: print(f"CP{mpc.pid}:\tMPP matmul case non-transposed x transposed. Local shapes: {first.shape} x {other.shape}")

        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=first._mpc,
                _ratios=first._ratios.copy(),
                _local_data=zeros((first._local_data.shape[0], other._local_data.shape[0]), dtype=dtype))

        _local_data = ndarray[S, dtype]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        # Every compute party runs the same HE products, with the same shapes, in the same order: a product may refresh
        # its operands, and each refresh is a council among the compute parties (a collective bootstrap), so a party
        # that ran one product more than the others would read another party's next message (M-MP-18). The parties
        # first agree on how they hold the factors, in one round. A first factor that some of them hold in the clear and
        # others encrypted is encrypted at every party for the product (ALIGN_ENCRYPT). The partitions' own products
        # never switch to MPC, which would need CP0 (H-53).
        first_descriptors, other_descriptors = _agree_on_partitions(first, other)
        with first.partition_aligner(ALIGN_ENCRYPT, first_descriptors) as aligner:
            first_clear = MPP._cohort_in_the_clear(aligner.descriptors)
            other_clear = MPP._cohort_in_the_clear(other_descriptors)
            if not first.is_empty():
                other_partitions = other.collect()
                reference_pid = mpc.pid - 1  # Avoid CP0

                allow_mpc_switch = mpc.default_allow_mpc_switch
                mpc.default_allow_mpc_switch = False
                if first_clear and other_clear:
                    # Both factors in the clear: the own block of the result is a plaintext product, and the other
                    # parties' blocks come from one HE product against their partitions, stacked (the parties before
                    # this one, then those after it) and padded with zero rows to the count every party stacks
                    left_rows = other._ratios[:reference_pid].sum()
                    right_rows = other._ratios[reference_pid + 1:].sum()
                    stacked_rows = other._ratios.sum() - min(other._ratios)
                    if stacked_rows:
                        stacked = MPP._stack_other_partitions(mpc, other_partitions, stacked_rows, first._local_data.shape[1])
                        # Lazily transposed: its physical rows are the stacked rows, so the blocks are slices of them
                        blocks = first._local_data @ stacked.T
                        if left_rows: _encryption_left = blocks._get_rows_raw(slice(start=0, stop=left_rows, step=1))
                        if right_rows: _encryption_right = blocks._get_rows_raw(slice(start=left_rows, stop=left_rows + right_rows, step=1))
                    
                    if other.is_empty():
                        # No own block: the other parties' blocks form the whole result
                        if _encryption_left and _encryption_right:
                            _encryption_unified = _encryption_left.concat(mpc, _encryption_right, axis=1)
                        else:
                            _encryption_unified = _encryption_left if _encryption_left else _encryption_right
                        _encryption_left = Ciphertensor[Ciphertext]()
                        _encryption_right = Ciphertensor[Ciphertext]()
                    else:
                        _local_data = first._local_data @ other._local_data.T
                elif first_clear:
                    _encryption_unified = first._local_data @ other_partitions.unfence(mpc).T
                else:
                    first.unify_encryption()
                    if other_clear and MPP._own_block_apart(mpc, aligner.descriptors, other._ratios):
                        _encryption_unified = MPP._matmul_ntt_own_block_apart(mpc, first._encryption_unified, other, other_partitions)
                    else:
                        _encryption_unified = first._encryption_unified @ other_partitions.unfence(mpc).T
                mpc.default_allow_mpc_switch = allow_mpc_switch
        
            return aligner.new_mpp(
                _local_data=_local_data,
                _encryption_left=_encryption_left,
                _encryption_right=_encryption_right,
                _encryption_unified=_encryption_unified)

    @staticmethod
    def _cohort_in_the_clear(descriptors: List[List[int]]) -> bool:
        # Whether every compute party holds its partition in the clear, or none
        return all(d[D_KIND] == MPP_CLEAR or d[D_KIND] == MPP_EMPTY for d in descriptors)

    @staticmethod
    def _check_same_partitions(first_descriptors: List[List[int]], other_descriptors: List[List[int]]):
        # A per-partition product needs every compute party to hold both factors' partitions, or neither: raised at every
        # compute party alike
        for q in range(len(first_descriptors)):
            if (first_descriptors[q][D_KIND] == MPP_EMPTY) != (other_descriptors[q][D_KIND] == MPP_EMPTY):
                raise ValueError(f"MPP: all or none of the partitions should be empty (CP{q + 1} holds one factor's partition only)")

    @staticmethod
    def _own_block_apart(mpc, first_descriptors: List[List[int]], other_ratios: List[int]) -> bool:
        # Whether A @ B.T with A encrypted and B in the clear can compute each party's own block apart
        # (_matmul_ntt_own_block_apart): A's partitions row-wise, and a result row plus the own block's padding in one
        # ciphertext. Public and agreed data only, so every compute party decides alike.
        transposed, diagonal, _ = _encrypted_layout(first_descriptors)
        slots = mpc.mhe.crypto_params.params.slots()
        return not transposed and not diagonal and other_ratios.sum() + max(other_ratios) <= slots

    @staticmethod
    def _matmul_ntt_own_block_apart(mpc, first_encryption: Ciphertensor[Ciphertext], other: MPP[S, dtype], other_partitions: List[Ciphertensor[Ciphertext]]) -> Ciphertensor[Ciphertext]:
        # This party's partition of A (encrypted, padded to the most rows) @ B.T, every partition of B in the clear
        # (L-225). One ct @ ct product (M1) against the other parties' partitions of B, stacked in party order and padded
        # with nil-ideal rows to the count every party stacks (sum - min(ratios)), each cell written at its final column;
        # every cell refreshes, which keeps the parties in step cell by cell, so each party's real cells must sit at the
        # same indices as the others' for the padding to save anything. The own block comes from one ct @ pt product
        # against the own partition, padded with zero rows to the most rows (all zeros for an empty one: every party runs
        # it), shifted right to its columns and added. With two equal partitions that halves the ct @ ct cells.
        pid = mpc.pid
        ratios = other._ratios
        slots = first_encryption.slots
        cols = first_encryption.shape[-1]
        total = ratios.sum()
        stacked_rows = total - min(ratios)
        stacked = Ciphertensor[Ciphertext]()
        columns = List[int]()
        start = 0
        for q in range(len(other_partitions)):
            if ratios[q] and q != pid - 1:
                stacked = other_partitions[q].copy() if not stacked else stacked.concat(mpc, other_partitions[q], axis=0)
                for k in range(ratios[q]):
                    columns.append(start + k)
            start += ratios[q]
        if len(columns) < stacked_rows:
            padding = Ciphertensor[Ciphertext].placeholder([stacked_rows - len(columns), cols], slots)
            stacked = padding if not stacked else stacked.concat(mpc, padding, axis=0)
            while len(columns) < stacked_rows:
                columns.append(0)  # A nil-ideal row's cells add nothing
        result = first_encryption._matmul_v1_at(mpc, stacked.T, columns, total) if stacked else Ciphertensor[Ciphertext].zeros(mpc, [first_encryption.shape[0], total])

        rows = max(ratios)
        own = other._local_data
        if own.is_empty():
            own = zeros((rows, cols), dtype=dtype)
        elif own.shape[0] < rows:
            own = own.pad(rows - own.shape[0], axis=0)
        own_block = first_encryption.matmul(mpc, own.T)
        Ciphertensor._rotate_slots(mpc, own_block._data, -ratios[:pid - 1].sum())
        mpc.mhe.iadd(result._data, own_block._data)
        return result

    @staticmethod
    def _stack_other_partitions(mpc, partitions: List[Ciphertensor[Ciphertext]], rows: int, cols: int) -> Ciphertensor[Ciphertext]:
        # The other compute parties' partitions (all but this party's), in party order, stacked into one row-wise
        # tensor and padded with zero rows (trivial encryptions) to rows
        stacked = Ciphertensor[Ciphertext]()
        stacked_rows = 0
        for q in range(len(partitions)):
            if q != mpc.pid - 1 and partitions[q]:
                stacked = partitions[q].copy() if not stacked else stacked.concat(mpc, partitions[q], axis=0)
                stacked_rows += partitions[q].shape[0]
        if rows > stacked_rows:
            padding = Ciphertensor[Ciphertext].zeros(mpc, [rows - stacked_rows, cols])
            stacked = padding if not stacked else stacked.concat(mpc, padding, axis=0)
        return stacked

    def _check_binary_operands(self, other):
        assert isinstance(other, MPP) or isinstance(other, ndarray) or isinstance(other, ByVal), "MPP: Elem-wise operand should be either MPP, ndarray or by-value type"
        return self._autocast(array([other]) if isinstance(other, ByVal) else other)

    @staticmethod
    def _check_broadcast(operand, target):
        # An operand whose ratios sum to 1 goes to MPP.broadcast, which spreads a column of length 1 (1-dim, transposed)
        # over a transposed MPP, encrypted at every compute party, replicating it to each partition's length (more than 1),
        # and does nothing else yet. Anything else raises here at every party alike, CP0 included (it asserted at the
        # compute parties only, L-103): a held row (a column sum, X[i]) or a target in other layouts or lengths, from
        # public metadata; an operand or a target held in the clear somewhere, from one round with every party, CP0
        # included, which cannot see it
        if operand.ndim != 1 or not operand._transposed or not target._transposed:
            raise NotImplementedError("MPP: broadcasting an operand held by one party (a held row, such as a column sum) is not implemented yet: only a transposed vector of length 1 broadcasts, over a transposed MPP")
        if any(r < 2 for r in target._ratios):
            raise NotImplementedError("MPP: broadcasting a vector of length 1 over an MPP with a partition of fewer than two elements is not implemented yet")
        mpc = target._mpc
        # The replication masks its last ciphertext (a refresh) only for a length that is not a multiple of the slots:
        # partitions of both kinds would leave the parties making different numbers of refreshes
        slots = mpc.mhe.crypto_params.params.slots()
        whole = [r % slots == 0 for r in target._ratios]
        if any(whole) and not all(whole):
            raise NotImplementedError("MPP: broadcasting a vector of length 1 over partitions some of whose lengths are multiples of the slots and others not is not implemented yet")
        encrypted = mpc.pid == 0 or ((operand.is_full_encrypted() or operand.is_empty()) and target.is_full_encrypted())
        if not all(mpc.comms.collect(encrypted, include_trusted_dealer=True)[1:]):
            raise NotImplementedError("MPP: broadcasting a vector of length 1 needs it and the MPP it spreads over encrypted at every compute party (in the clear: not implemented yet)")
    
    def _do_elem_wise_op_public(self, other_data: ndarray[S, dtype], elem_wise_op) -> Tuple[ndarray[S, dtype], Ciphertensor[Ciphertext], Ciphertensor[Ciphertext], Ciphertensor[Ciphertext]]:
        mpc = self._mpc
        assert self.shape[-1] == other_data.shape[-1], f"MPP: shapes missmatch in public elem-wise operation: {self.shape} vs {other_data.shape}"
        _local_data = ndarray[S, dtype]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        if mpc.pid == 0:
            return (self._local_data, _encryption_left, _encryption_right, _encryption_unified)

        other_data = other_data.T if self._transposed else other_data

        if static.len(S) == 2:
            if other_data.shape[0] == self._ratios.sum() and self.shape[0] == self._ratios[mpc.pid - 1]:
                start, end = self.get_relative_indices()
                other_data = other_data[start:end]
            else:
                other_data_size = other_data.shape[1] if self._transposed else other_data.shape[0]
                if not other_data_size == self.shape[0]:
                    raise ValueError("MPP: shapes missmatch in public elem-wise operation")
        
        col_end = 0
        if self.is_local():
            _local_data = elem_wise_op(mpc, self._local_data, other_data)
        elif self.has_unified_encryption():
            _encryption_unified = elem_wise_op(mpc, self._encryption_unified, other_data)
        elif self.has_partial_encryption():
            if self._encryption_left:
                # A block's logical width: the blocks of an A @ B.T result are lazily transposed (M-MP-03)
                col_end = self._encryption_left.actual_shape[-1]
                _encryption_left = elem_wise_op(mpc, self._encryption_left, other_data._slice_cols(0, col_end))
            assert self.has_local_data(), "MPP must have local data if it has partial encryption"
            col_start = col_end
            col_end = col_start + self._local_data.shape[-1]
            _local_data = elem_wise_op(mpc, self._local_data, other_data._slice_cols(col_start, col_end))
            if self._encryption_right:
                col_start = col_end
                _encryption_right = elem_wise_op(mpc, self._encryption_right, other_data._slice_cols(col_start, other_data.shape[-1]))
        else:
            raise ValueError("MPP: Invalid partition")

        return (_local_data, _encryption_left, _encryption_right, _encryption_unified)
    
    def _do_elem_wise_op(self, other, elem_wise_op, MUL: Static[int] = 0) -> MPP:
        mpc = self._mpc
        if isinstance(other, MPP):
            if static.len(other.S) != static.len(S):
                compile_error("MPP: element-wise operations between MPPs of different dimensions (a row or a column broadcast over a matrix, such as X - X.sum(0)) are not implemented yet")

        if isinstance(other, int) and MUL == 1:
            if abs(other) < MHE_MUL_TO_ADD_THRESHOLD:
                # By a small int: a series of additions on an encryption (cheaper than a product, and never a refresh),
                # one product in the clear. Decided on the public factor alone, partition by partition inside one
                # element-wise operation, so every compute party takes the same collective steps whatever it holds
                # (M-MP-01: the choice used to depend on the party's own partition)
                factor = other
                return self._do_elem_wise_op(other, lambda mpc, x, y: MPP._mul_by_small_int(mpc, x, factor))
        
        _self, _other = self._check_binary_operands(other)
        ac_type = _self.dtype

        if isinstance(_other, MPP):
            if _self._ratios != _other._ratios and _other._ratios.sum() == 1:
                MPP._check_broadcast(_other, _self)

        if mpc.pid == 0:
            return MPP[S, ac_type](
                _mpc=_self._mpc,
                _ratios=_self._ratios.copy(),
                _local_data=_self._local_data.zeros(),
                _transposed=self._transposed)

        transposition_mismatch = False
        if isinstance(_other, MPP):
            if _self._ratios != _other._ratios and _other._ratios.sum() == 1:
                _other = _other.broadcast(_self)
            elif _self._ratios != _other._ratios:
                _other = _other.align_ratios(_self._ratios, False)
            transposition_mismatch = _self._transposed ^ _other._transposed
        
        # A product refreshes its encrypted operands, and each refresh is a council among the compute parties. So for a
        # product the compute parties first agree on their partitions, in one round (MPPAligner's descriptors), and each
        # of them then runs every HE step some party runs: its own on its partition, the others on placeholders
        # (_run_elem_wise_shadows). Each party computes in its own representation. Sums and differences never refresh:
        # no round at equal ratios.
        descriptors = List[List[int]]()
        other_descriptors = List[List[int]]()
        if isinstance(_other, MPP):
            if transposition_mismatch:
                # The operand goes whole, before anything is padded, through MPC into this one's orientation, and comes
                # back in the layout of this one's encrypted partitions, which every party passes alike (M-MP-05)
                descriptors = mpc.comms.collect(_partition_descriptor(_self))
                transpose_encryption, _, _ = _encrypted_layout(descriptors)
                other_stensor = _other.to_sharetensor()
                other_stensor_t = other_stensor if _other._transposed else other_stensor.T
                _other = other_stensor_t.to_mpp(mpc, _self._ratios, transpose_encryption=transpose_encryption, dtype=ac_type)
                if MUL == 1:
                    other_descriptors = mpc.comms.collect(_partition_descriptor(_other))
            elif MUL == 1:
                descriptors, other_descriptors = _agree_on_partitions(_self, _other)
        elif MUL == 1:
            descriptors = mpc.comms.collect(_partition_descriptor(_self))
        
        # Unequal partitions are padded (MPPAligner, with the descriptors already agreed, else one round): an empty
        # partition takes the cohort's representations and runs the same code path as the others, which matters beyond
        # the product itself (the broadcast of an encrypted operand replicates it, and its masks refresh). A public
        # operand with the cohort's rows is cut to this party's rows and padded alike.
        if isinstance(_other, ndarray):
            _other = _self._rows_of_public(_other)
        
        _local_data = ndarray[S, ac_type]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()
        
        with _self.partition_aligner(ALIGN_ROWS, descriptors) as aligner, (_other.partition_aligner(ALIGN_ROWS, other_descriptors) if isinstance(_other, MPP) else EmptyWith()):
            if not _self.is_empty():
                other_broadcast = _other.local_broadcast(_self.shape)

                if isinstance(other_broadcast, ndarray):
                    _local_data, _encryption_left, _encryption_right, _encryption_unified = _self._do_elem_wise_op_public(other_broadcast, elem_wise_op)
                elif isinstance(other_broadcast, MPP):
                    assert not other_broadcast.is_empty(), "MPP: cannot do elem-wise operation with an empty partition"

                    if static.len(S) == 1:
                        assert _self.shape == other_broadcast.shape, f"MPP: Shapes mismatch in elem-wise operation. {_self.shape} != {other_broadcast.shape}"

                    if transposition_mismatch:
                        other_encryption_unified = other_broadcast._encryption_unified
                        if _self.is_local():
                            _encryption_unified = elem_wise_op(mpc, _self._local_data, other_encryption_unified)
                        else:
                            _self.unify_encryption()
                            _encryption_unified = elem_wise_op(mpc, _self._encryption_unified, other_encryption_unified)
                    elif _self.is_local() and other_broadcast.is_local():
                        _local_data = elem_wise_op(mpc, _self._local_data, other_broadcast._local_data)
                    elif other_broadcast.is_local():
                        _local_data, _encryption_left, _encryption_right, _encryption_unified = _self._do_elem_wise_op_public(other_broadcast._local_data, elem_wise_op)
                    elif _self.is_local():
                        _local_data, _encryption_left, _encryption_right, _encryption_unified = _self._local_data._do_elem_wise_op_public(other_broadcast, elem_wise_op)
                    elif _self.has_unified_encryption() and not other_broadcast.has_unified_encryption():
                        assert other_broadcast.is_semi_encrypted(), "MPP: Operand expected to be semi-encrypted"
                        other_broadcast.unify_encryption()
                        _encryption_unified = elem_wise_op(mpc, _self._encryption_unified, other_broadcast._encryption_unified)
                    elif not _self.has_unified_encryption() and other_broadcast.has_unified_encryption():
                        assert _self.is_semi_encrypted(), "MPP: Operand expected to be semi-encrypted"
                        _self.unify_encryption()
                        _encryption_unified = elem_wise_op(mpc, _self._encryption_unified, other_broadcast._encryption_unified)
                    else:
                        if _self.has_local_data() and other_broadcast.has_local_data():
                            _local_data = elem_wise_op(mpc, _self._local_data, other_broadcast._local_data)
                        if _self._encryption_left and other_broadcast._encryption_left:
                            _encryption_left = elem_wise_op(mpc, _self._encryption_left, other_broadcast._encryption_left)
                        if _self._encryption_right and other_broadcast._encryption_right:
                            _encryption_right = elem_wise_op(mpc, _self._encryption_right, other_broadcast._encryption_right)
                        if _self.has_unified_encryption() and other_broadcast.has_unified_encryption():
                            _encryption_unified = elem_wise_op(mpc, _self._encryption_unified, other_broadcast._encryption_unified)
                else:
                    compile_error("Invalid operand type for MPP elem-wise operation")
        
        
            if MUL == 1:
                MPP._run_elem_wise_shadows(mpc, descriptors, other_descriptors, isinstance(_other, ndarray), transposition_mismatch, not _self.cohort_is_aligned())
            
            return aligner.new_mpp(
                _local_data=_local_data,
                _encryption_left=_encryption_left,
                _encryption_right=_encryption_right,
                _encryption_unified=_encryption_unified)

    def _rows_of_public[S2, T2](self, data: ndarray[S2, T2]) -> ndarray[S2, T2]:
        # A public operand with the cohort's rows: this party's rows of it, padded with zero rows to the most rows when
        # the partitions are unequal, as the aligner pads the partition; anything else as is (a row to broadcast, an
        # operand of the partition's shape). Untransposed 2-dim MPPs only: transposed ones with public operands are M-MP-04.
        if static.len(S2) != 2 or self._transposed or data.shape[0] != self._ratios.sum():
            return data
        start, end = self.get_relative_indices()
        rows = max(self._ratios) if not self.cohort_is_aligned() else end - start
        if end == start:
            return zeros((rows, data.shape[1]), dtype=T2)
        own = data[start:end]
        return own.pad(rows - (end - start), axis=0) if rows > end - start else own

    @staticmethod
    def _mul_by_small_int(mpc, x, factor: int):
        # x times a small int: one product in the clear; a series of additions on an encryption, which never refreshes
        if isinstance(x, ndarray):
            return x * factor
        else:
            if factor == 0:
                return x.sub(mpc, x)
            result = x.copy()
            for _ in range(abs(factor) - 1):
                result.iadd(mpc, x)
            return result.ineg(mpc) if factor < 0 else result

    @staticmethod
    def _steps_against_clear(d: List[int]) -> List[int]:
        # The HE products of a partition times data in the clear (_do_elem_wise_op_public and ndarray's): its unified
        # encryption if it has one, else each of its encrypted blocks
        if d[D_KIND] == MPP_CLEAR:
            return List[int]()
        if d[D_UNIFIED]:
            return [STEP_UNIFIED_PT]
        steps = List[int]()
        if d[D_LEFT]: steps.append(STEP_LEFT_PT)
        if d[D_RIGHT]: steps.append(STEP_RIGHT_PT)
        return steps

    @staticmethod
    def _elem_wise_steps(ds: List[int], do: List[int], public: bool, mismatch: bool) -> List[int]:
        # The HE products a compute party runs in an element-wise product, picked from the descriptors of its partitions
        # of the two operands as _do_elem_wise_op picks its branch (public: the other operand is an ndarray or a scalar;
        # mismatch: it came back from MPC encrypted, in this one's orientation)
        if ds[D_KIND] == MPP_EMPTY:
            return List[int]()
        if public:
            return MPP._steps_against_clear(ds)
        if do[D_KIND] == MPP_EMPTY:
            return List[int]()
        if mismatch:
            return [STEP_UNIFIED_PT] if ds[D_KIND] == MPP_CLEAR else [STEP_UNIFIED_CT]
        if ds[D_KIND] == MPP_CLEAR and do[D_KIND] == MPP_CLEAR:
            return List[int]()
        if do[D_KIND] == MPP_CLEAR:
            return MPP._steps_against_clear(ds)
        if ds[D_KIND] == MPP_CLEAR:
            return MPP._steps_against_clear(do)
        if bool(ds[D_UNIFIED]) != bool(do[D_UNIFIED]):
            return [STEP_UNIFIED_CT]
        steps = List[int]()
        if ds[D_LEFT] and do[D_LEFT]: steps.append(STEP_LEFT_CT)
        if ds[D_RIGHT] and do[D_RIGHT]: steps.append(STEP_RIGHT_CT)
        if ds[D_UNIFIED] and do[D_UNIFIED]: steps.append(STEP_UNIFIED_CT)
        return steps

    @staticmethod
    def _missing_steps(own: List[int], cohort: List[List[int]]) -> List[int]:
        # The HE steps some compute party runs and this one does not, in a fixed order
        missing = List[int]()
        for steps in cohort:
            for step in steps:
                if step not in own and step not in missing:
                    missing.append(step)
        missing.sort()
        return missing

    @staticmethod
    def _run_elem_wise_shadows(mpc, descriptors: List[List[int]], other_descriptors: List[List[int]], public: bool, mismatch: bool, padded: bool):
        # The element-wise products some compute party runs and this one does not (_elem_wise_steps), on placeholders: a
        # council's content drives every bootstrap in it, so the parties need only make the same number of refresh calls.
        # With unequal partitions an empty one was padded, and runs the operation as a partition of that kind.
        if not descriptors:
            return
        selfs = MPP._as_padded(descriptors) if padded else descriptors
        others = (MPP._as_padded(other_descriptors) if padded else other_descriptors) if other_descriptors else List[List[int]]()
        empty = [0 for _ in range(D_SIZE)]
        cohort = List[List[int]]()
        for q in range(len(selfs)):
            cohort.append(MPP._elem_wise_steps(selfs[q], others[q] if others else empty, public, mismatch))
        for step in MPP._missing_steps(cohort[mpc.pid - 1], cohort):
            MPP._shadow_product(mpc, step % 2 == 1)

    @staticmethod
    def _as_padded(descriptors: List[List[int]]) -> List[List[int]]:
        # The descriptors as MPPAligner pads the partitions for an element-wise operation (ALIGN_ROWS): an empty one takes
        # one block of the cohort's kind (_padded_kind), and runs the operation as a partition of that kind
        padded = _padded_kind(descriptors)
        return [padded if d[D_KIND] == MPP_EMPTY else d for d in descriptors]

    @staticmethod
    def _shadow_product(mpc, ciphertext: bool):
        # The refresh councils of an element-wise product of an encryption that another compute party runs (MPCMHE.imul
        # refreshes each ciphertext operand once), on nil-ideal placeholders, which cost no arithmetic
        x = [Ciphertext.nil_ideal()]
        if ciphertext:
            mpc.mhe.imul(x, [Ciphertext.nil_ideal()])
        else:
            mpc.mhe.imul(x, [Plaintext.nil_ideal()])

    def _pow(self, p: int) -> MPP[S, dtype]:
        mpc = self._mpc
        
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=mpc,
                _ratios=self._ratios.copy(),
                _local_data=self._local_data,
                _transposed=self._transposed)
        
        # The power of an encryption refreshes at every product, so the compute parties agree on their partitions first
        # (one round), and if any of them holds an encrypted one, those that hold theirs in the clear (or none) run the
        # same power on a placeholder. A refresh is one council per tensor whatever its size: nothing is padded.
        descriptors = mpc.comms.collect(_partition_descriptor(self))
        _local_data = ndarray[S, dtype]()
        _encryption_unified = Ciphertensor[Ciphertext]()
        
        if self.is_local():
            _local_data = self._local_data ** p
        elif not self.is_empty():
            self.unify_encryption()
            _encryption_unified = secure_operator.pow(self._mpc, self._encryption_unified, p)
        
        if self.is_local() or self.is_empty():
            if any(d[D_KIND] == MPP_UNIFIED or d[D_KIND] == MPP_SEMI for d in descriptors):
                slots = mpc.mhe.crypto_params.params.slots()
                secure_operator.pow(self._mpc, Ciphertensor[Ciphertext].placeholder([1, 1], slots), p)
        
        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=self._ratios.copy(),
            _local_data=_local_data,
            _encryption_left=Ciphertensor[Ciphertext](),
            _encryption_right=Ciphertensor[Ciphertext](),
            _encryption_unified=_encryption_unified,
            _transposed=self._transposed)

    def _getitem_1_dim(self, indices) -> MPP[S, dtype]:
        if isinstance(indices, slice):
            compile_error("Not implemented yet: slicing 1-dim MPP")
        
        if isinstance(indices, tuple):
            compile_error("MPP: cannot slice 1-dim MPP --- too many indices")
        
        idx = indices
        mpc = self._mpc
        if static.len(S) != 1: compile_error("MPP: cannot do 1-dim getitem from non-1-dim MPP")
        if self._ratios.sum() != 1:
            assert self._transposed, "MPP: 1-dimensional MPP should be either present at one party only or transposed"

        _local_data = ndarray[S, dtype]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        _ratio_idx = self._find_idx_in_ratios(idx)
        if self._transposed:
            _ratios = one_hot_vector(idx=_ratio_idx, size=len(self._ratios), TP=int)
        else:
            _ratios = self._ratios.copy()
        
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=self._mpc,
                _ratios=_ratios,
                _local_data=self._local_data[idx:idx+1],
                _transposed=self._transposed)
        
        if self._transposed:
            assert not self.is_semi_encrypted(), "MPP: 1-dimensional transposed MPP should not be partially encrypted"
            
            adjusted_idx = idx - self._ratios[:_ratio_idx].sum()
            is_local = mpc.council(self.is_local())[_ratio_idx]
            
            if mpc.pid == _ratio_idx + 1:
                if is_local:
                    return MPP[S, dtype](
                        _mpc=self._mpc,
                        _ratios=_ratios,
                        _local_data=self._local_data[adjusted_idx:adjusted_idx+1],
                        _transposed=self._transposed)
                else:
                    assert self.has_unified_encryption(), "MPP: 1-dimensional transposed MPP should have either local or full-encrypted partition"
                    mpc.comms.send_to_all_from(self._encryption_unified.shape[0], mpc.pid)
                    _encryption_unified = self._encryption_unified._getitem_1_dim(mpc, adjusted_idx)
            elif not is_local: # Manual aligner to support bootstrapping
                slots = mpc.mhe.crypto_params.params.slots()
                size = mpc.comms.receive_as_jar(_ratio_idx + 1, T=int)
                Ciphertensor[Ciphertext].placeholder([size], slots)._getitem_1_dim(mpc, adjusted_idx)
            
            return MPP[S, dtype](
                _mpc=self._mpc,
                _ratios=_ratios,
                _local_data=_local_data,
                _encryption_left=Ciphertensor[Ciphertext](),
                _encryption_right=Ciphertensor[Ciphertext](),
                _encryption_unified=_encryption_unified,
                _transposed=self._transposed)

        with self.partition_aligner() as aligner:
            if not self.is_empty():
                if self.is_local():
                    _local_data = self._local_data[idx:idx+1]
                elif self.is_semi_encrypted():
                    idx_up_bound = 0
                    if self._encryption_left:
                        assert self._encryption_left.ndim == 1, "MPP: invalid dimension of ciphertensor"
                        idx_up_bound += self._encryption_left.shape[-1]
                        if idx < idx_up_bound:
                            _encryption_unified = self._encryption_left._getitem_1_dim(mpc, idx)

                            return MPP[S, dtype](
                                _mpc=self._mpc,
                                _ratios=self._ratios.copy(),
                                _encryption_unified=_encryption_unified)
                    
                    idx_low_bound = idx_up_bound
                    idx_up_bound += self._local_data.shape[-1]
                    if idx < idx_up_bound:
                        _local_data = self._local_data[idx - idx_low_bound:idx - idx_low_bound + 1]

                        return MPP[S, dtype](
                            _mpc=self._mpc,
                            _ratios=self._ratios.copy(),
                            _local_data=_local_data)
                    
                    idx_low_bound = idx_up_bound
                    if self._encryption_right:
                        assert self._encryption_right.ndim == 1, "MPP: invalid dimension of ciphertensor"
                        idx_up_bound += self._encryption_right.shape[-1]
                        if idx < idx_up_bound:
                            _encryption_unified = self._encryption_right._getitem_1_dim(mpc, idx - idx_low_bound)

                            return MPP[S, dtype](
                                _mpc=self._mpc,
                                _ratios=self._ratios.copy(),
                                _encryption_unified=_encryption_unified)
                    
                    raise ValueError("MPP: index out of bound")
                else:
                    assert self.has_unified_encryption(), "MPP: must have unified encryption if not local and semi encrypted"
                    _encryption_unified = self._encryption_unified._getitem_1_dim(mpc, idx)
        
            return aligner.new_mpp(
                _local_data=_local_data,
                _encryption_unified=_encryption_unified)
    
    @sequre
    def _get_column(mpc, mpp: MPP[Tuple[int, int], dtype], idx: int) -> MPP[Tuple[int], dtype]:
        _local_data = ndarray[Tuple[int], dtype]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        if not mpp.is_empty():
            if mpp.is_local():
                _local_data = mpp._local_data[:, idx]
            elif mpp.is_semi_encrypted():
                if idx < mpp._encryption_left.shape[-1]:
                    _encryption_unified = mpp._encryption_left[:, idx]
                elif idx < mpp._encryption_left.shape[-1] + mpp._local_data.shape[-1]:
                    _local_data = mpp._local_data[:, idx - mpp._encryption_left.shape[-1]]
                else:
                    _encryption_unified = mpp._encryption_right[:, idx - mpp._encryption_left.shape[-1] - mpp._local_data.shape[-1]]
            else:
                assert mpp.has_unified_encryption(), "MPP: must have unified encryption if not local and semi encrypted"
                _encryption_unified = mpp._encryption_unified[:, idx]
        
        return MPP[Tuple[int], dtype](
            _mpc=mpc,
            _ratios=mpp._ratios,
            _local_data=_local_data,
            _encryption_left=Ciphertensor[Ciphertext](),
            _encryption_right=Ciphertensor[Ciphertext](),
            _encryption_unified=_encryption_unified,
            _transposed=mpp._transposed)
    
    @sequre
    def _getitem_core[S1](mpc, mpp: MPP[S, dtype], adjusted_idx, ratios: List[int]) -> MPP[S1, dtype]:
        assert not mpp.is_empty(), "MPP: _getitem_core should be called on top of a non-empty partition"

        _local_data = ndarray[S1, dtype]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()
        
        if mpp.is_local():
            _local_data = mpp._local_data[adjusted_idx]
        elif mpp.is_semi_encrypted():
            assert not static.len(S) == 1 and not isinstance(adjusted_idx, tuple), "Not implemented yet: slicing along 1-axis semi-encrypted MPP via _getitem_core"
            _local_data = mpp._local_data[adjusted_idx]
            _encryption_left = mpp._encryption_left[adjusted_idx]
            _encryption_right = mpp._encryption_right[adjusted_idx]
        else:
            assert mpp.has_unified_encryption(), "MPP: must have unified encryption if not local and semi encrypted"
            _encryption_unified = mpp._encryption_unified[adjusted_idx]
        
        return MPP[S1, dtype](
            _mpc=mpc,
            _ratios=ratios,
            _local_data=_local_data,
            _encryption_left=_encryption_left,
            _encryption_right=_encryption_right,
            _encryption_unified=_encryption_unified,
            _transposed=False)

    def _getitem_2_dim(self, idx: int) -> MPP[Tuple[int], dtype]:
        mpc = self._mpc
        assert self.ndim == 2, "MPP: cannot do 2-dim-getitem from non-2-dimensional MPP"

        if self._transposed:
            return MPP[S, dtype]._get_column(mpc, self, idx)

        assert 0 <= idx < self._ratios.sum(), f"MPP: getitem - index out of bound --- {idx} not in [0, {self._ratios.sum()})"

        _ratio_idx = self._find_idx_in_ratios(idx)
        _ratios = one_hot_vector(idx=_ratio_idx, size=len(self._ratios), TP=int)

        if mpc.pid == 0:
            return MPP[Tuple[int], dtype](
                _mpc=self._mpc,
                _ratios=_ratios,
                _local_data=self._local_data[idx])

        if mpc.pid == _ratio_idx + 1:
            adjusted_idx = idx - self._ratios[:_ratio_idx].sum()
            return MPP._getitem_core(mpc, self, adjusted_idx, _ratios, S1=Tuple[int])
            
        return MPP[Tuple[int], dtype](
            _mpc=self._mpc,
            _ratios=_ratios)
    
    def _getitem_2_dim(self, s: slice) -> MPP[S, dtype]:
        mpc = self._mpc
        assert self.ndim == 2, "MPP: cannot do 2-dim-getitem from non-2-dimensional MPP"
        assert not self._transposed, "Not implemented yet: getitem from transposed MPP"

        start, stop, _, _ = s.adjust_indices(self.cohort_shape[0])
        
        _start_ratio_idx = self._find_idx_in_ratios(start)
        _stop_ratio_idx = self._find_idx_in_ratios(stop)
        _ratios = self._get_sliced_ratios(_start_ratio_idx, _stop_ratio_idx, start, stop)

        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=self._mpc,
                _ratios=_ratios,
                _local_data=self._local_data[s])

        reference_pid = mpc.pid - 1
        if _ratios[reference_pid]:
            adjusted_slice = self._adjust_row_slice(start, stop)
            return MPP._getitem_core(mpc, self, adjusted_slice, _ratios, S1=S)
            
        return MPP[S, dtype](
            _mpc=self._mpc,
            _ratios=_ratios)
    
    def _getitem_2_dim_tuple[T1](self, slices: Tuple[T1, slice]) -> MPP:
        mpc = self._mpc
        rs = slices[0]
        row_sliced_self = self._getitem_2_dim(rs)
        _ratios = row_sliced_self._ratios
        
        if mpc.pid == 0:
            return MPP[row_sliced_self.S, dtype](
                _mpc=self._mpc,
                _ratios=_ratios,
                _local_data=self._local_data[slices])

        with row_sliced_self.partition_aligner() as aligner:
            if not row_sliced_self.is_empty():
                adjusted_idx = MPP._adjust_col_slice_tuple(slices[1], T1=T1)
                col_sliced_self = MPP._getitem_core(mpc, row_sliced_self, adjusted_idx, _ratios, S1=row_sliced_self.S)

                return aligner.new_mpp(
                    _local_data=col_sliced_self._local_data,
                    _encryption_left=col_sliced_self._encryption_left,
                    _encryption_right=col_sliced_self._encryption_right,
                    _encryption_unified=col_sliced_self._encryption_unified)

        return MPP[row_sliced_self.S, dtype](
            _mpc=self._mpc,
            _ratios=_ratios)
    
    def _getitem_2_dim(self, slices: Tuple[slice, slice]) -> MPP[S, dtype]:
        assert self.ndim == 2, "MPP: cannot do 2-dim-getitem from non-2-dimensional MPP"
        if self._transposed:
            slices = slices[::-1]
            self._transposed = False
            r = self._getitem_2_dim_tuple(slices)
            r._transposed = True
            self._transposed = True
            return r
        
        return self._getitem_2_dim_tuple(slices)
    
    def _getitem_2_dim(self, slices: Tuple[slice, int]) -> MPP[S, dtype]:
        assert self.ndim == 2, "MPP: cannot do 2-dim-getitem from non-2-dimensional MPP"
        assert not self._transposed, "Not implemented yet: getitem from transposed MPP"

        rs, c_idx = slices
        cs = slice(start=c_idx, stop=c_idx + 1, step=1)
        return self._getitem_2_dim_tuple((rs, cs))
    
    def _getitem_2_dim(self, slices: Tuple[int, slice]) -> MPP[Tuple[int], dtype]:
        assert self.ndim == 2, "MPP: cannot do 2-dim-getitem from non-2-dimensional MPP"
        assert not self._transposed, "Not implemented yet: getitem from transposed MPP"
        return self._getitem_2_dim_tuple(slices)
    
    def _getitem_2_dim(self, slices: Tuple[int, int]) -> MPP[Tuple[int], dtype]:
        assert self.ndim == 2, "MPP: cannot do 2-dim-getitem from non-2-dimensional MPP"
        assert not self._transposed, "Not implemented yet: getitem from transposed MPP"

        r_idx, c_idx = slices
        cs = slice(start=c_idx, stop=c_idx + 1, step=1)
        return self._getitem_2_dim_tuple((r_idx, cs))
    
    def _setitem_1_dim(self, indices, value: MPP):
        if isinstance(indices, slice):
            compile_error("MPP: slicing 1-dim MPP is not implemented yet")
        
        if isinstance(indices, tuple):
            compile_error("MPP: cannot slice 1-dim MPP --- too many indices")

        idx = indices
        mpc = self._mpc
        assert static.len(S) == static.len(value.S) == 1, "MPP: 1-dim setitem expects 1-dim operands"
        
        if mpc.pid == 0:
            self._local_data[idx] = value._local_data[0]
            return
        
        if self._transposed:
            assert not self.is_semi_encrypted(), "MPP: 1-dimensional transposed MPP should not be partially encrypted"
            
            _ratio_idx = self._find_idx_in_ratios(idx)
            adjusted_idx = idx - self._ratios[:_ratio_idx].sum()
            is_local = mpc.council(self.is_local())[_ratio_idx]
            
            if mpc.pid == _ratio_idx + 1:
                if is_local:
                    self._local_data[adjusted_idx] = value._local_data[0]
                else:
                    assert self.has_unified_encryption(), "MPP: 1-dimensional transposed MPP should have either local or full-encrypted partition"
                    mpc.comms.send_to_all_from(self._encryption_unified.shape[0], mpc.pid)
                    mpc.comms.send_to_all_from(value._encryption_unified.shape[0], mpc.pid)
                    self._encryption_unified._setitem(mpc, adjusted_idx, value._encryption_unified)
            elif not is_local: # Manual aligner to support bootstrapping
                slots = mpc.mhe.crypto_params.params.slots()
                self_size = mpc.comms.receive_as_jar(_ratio_idx + 1, T=int)
                value_size = mpc.comms.receive_as_jar(_ratio_idx + 1, T=int)
                self_placeholder = Ciphertensor[Ciphertext].placeholder([self_size], slots)
                value_placeholder = Ciphertensor[Ciphertext].placeholder([value_size], slots)
                self_placeholder._setitem(mpc, adjusted_idx, value_placeholder)

            return
            
        assert self._ratios == value._ratios, f"MPP: partitioning missmatch in 1-dim setitem: {self._ratios} != {value._ratios}"
        assert self._ratios.sum() == value._ratios.sum(), "MPP: invalid partition ratios for 1-dim setitem"

        with self.partition_aligner(), value.partition_aligner():
            if not self.is_empty():
                assert value.shape == (1,), "MPP: 1-dim setitem operand should contain a single value"
                assert not value.is_semi_encrypted(), "MPP: single-element setitem value should not be semi-encrypted"

                if self.is_full_encrypted() or value.is_full_encrypted():
                    self.unify_encryption()
                    _value_cp = value.copy()
                    _value_cp.unify_encryption()
                    self._encryption_unified._setitem(mpc, idx, _value_cp._encryption_unified)
                else:
                    assert self.is_local() or self.is_semi_encrypted(), "MPP: ivalid self operand in 1-dim setitem"
                    assert value.is_local(), "MPP: ivalid value operand in 1-dim setitem"
                    
                    border = 0
                    if self._encryption_left:
                        border = self._encryption_left.shape[-1]
                        if idx < border:
                            _value_cp = value.copy()
                            _value_cp.unify_encryption()
                            self._encryption_left._setitem(mpc, idx, _value_cp._encryption_unified)
                            return
                    
                    if idx < border + self._local_data.shape[-1]:
                        self._local_data[idx - border] = value._local_data[0]
                        return
                    border += self._local_data.shape[-1]

                    assert bool(self._encryption_right) and idx < border + self._encryption_right.shape[-1], "MPP: 1-dim setitem index out of bound"
                    _value_cp = value.copy()
                    _value_cp.unify_encryption()
                    self._encryption_right._setitem(mpc, idx - border, _value_cp._encryption_unified)
    
    def _setitem_1_dim(self, indices, value: float):
        assert self.is_local(), "MPP: Cannot set public value into an encrypted MPP."
        assert static.len(S) == 1, "MPP: 1-dim setitem expects 1-dim operands"
        
        if isinstance(indices, slice):
            compile_error("MPP: slicing 1-dim MPP is not implemented yet")
        
        if isinstance(indices, tuple):
            compile_error("MPP: cannot slice 1-dim MPP --- too many indices")

        idx = indices
        mpc = self._mpc
        
        if mpc.pid == 0:
            return
        
        if self._transposed:
            _ratio_idx = self._find_idx_in_ratios(idx)
            adjusted_idx = idx - self._ratios[:_ratio_idx].sum()
            
            if mpc.pid == _ratio_idx + 1:
                self._local_data[adjusted_idx] = value._local_data[0]
        elif self.has_local_data():
            self._local_data[idx] = value

    @sequre
    def _setitem_core(mpc, mpp: MPP[S, dtype], adjusted_idx, value: MPP):
        assert not mpp.is_empty() and not value.is_empty(), "MPP: _setitem_core should be called on top of non-empty partitions"
        
        if mpp.is_full_encrypted() or value.is_full_encrypted():
            _value_cp = value.copy()
            mpp.unify_encryption()
            _value_cp.unify_encryption()
            mpp._encryption_unified[adjusted_idx] = _value_cp._encryption_unified
            mpp._local_data = ndarray[S, dtype]()
        elif mpp.is_local() and value.is_local():
            mpp._local_data[adjusted_idx] = value._local_data
        else:
            assert not static.len(S) == 1 and not isinstance(adjusted_idx, tuple), "Not implemented yet: slicing along 1-axis semi-encrypted MPP within _setitem_core"
            value_enc_left, value_local, value_enc_right = mpp._align_semi_encryptions(value)
            if mpp._encryption_left: mpp._encryption_left[adjusted_idx] = value_enc_left
            mpp._local_data[adjusted_idx] = value_local
            if mpp._encryption_right: mpp._encryption_right[adjusted_idx] = value_enc_right

    def _setitem_2_dim(self, idx: int, value: MPP[Tuple[int], dtype]):
        mpc = self._mpc
        if static.len(S) != 2 or static.len(value.S) != 1:
            compile_error("MPP: invalid shapes for setitem")

        assert not self._transposed, "Not implemented yet: setitem for transposed MPP"
        assert value._ratios.sum() == max(value._ratios) == 1, "Not implemented yet: setitem value should be at one partition/party for now"
        
        reference_pid = mpc.pid - 1  # Skip CP0
        
        if reference_pid == argmax(value._ratios):
            adjusted_idx = idx - self._ratios[:reference_pid].sum()
            assert 0 <= adjusted_idx < self._ratios[reference_pid], "MPP: setitem index out of bound"
            MPP._setitem_core(mpc, self, adjusted_idx, value)
    
    def _setitem_2_dim(self, s: slice, value: MPP[S, dtype]):
        mpc = self._mpc
        if static.len(S) != 2 or static.len(value.S) != 2:
            compile_error("MPP: invalid shapes for setitem")

        assert not self._transposed, "Not implemented yet: setitem for transposed MPP"

        start, stop, _, _ = s.adjust_indices(self.cohort_shape[0])
        assert value._ratios.sum() == stop - start, f"MPP: setitem value does not match the slice size {value._ratios.sum()} != {stop - start}"
        
        _start_ratio_idx = self._find_idx_in_ratios(start)
        _stop_ratio_idx = self._find_idx_in_ratios(stop)
        reference_pid = mpc.pid - 1
        
        if not self._ratios[reference_pid]:
            return
        
        if _start_ratio_idx <= reference_pid <= _stop_ratio_idx:
            adjusted_slice = self._adjust_row_slice(start, stop)
            assert value._ratios[reference_pid] == adjusted_slice.stop - adjusted_slice.start, f"MPP: setitem value does not match the adjusted slice size: {value._ratios[reference_pid]} != {adjusted_slice.stop} - {adjusted_slice.start}"
            MPP._setitem_core(mpc, self, adjusted_slice, value)
    
    def _setitem_2_dim_tuple[T1, T2](self, s: Tuple[T1, T2], value: MPP):
        mpc = self._mpc
        
        if mpc.pid == 0:
            return
        
        rs = s[0]
        rows_to_set = self._getitem_2_dim(rs)

        with rows_to_set.partition_aligner(), value.partition_aligner():
            if rows_to_set.is_empty():
                assert value.is_empty(), "MPP: alligner error while setting item"
            if not rows_to_set.is_empty():
                adjusted_idx = MPP._adjust_col_slice_tuple(s[1], T1=T1)
                MPP._setitem_core(mpc, rows_to_set, adjusted_idx, value)

        self._setitem_2_dim(rs, rows_to_set)
    
    def _setitem_2_dim[T1, T2](self, s: Tuple[T1, T2], value: MPP):
        if static.len(S) != 2:
            compile_error("MPP: invalid shapes for setitem")
        
        rs, cs = s
        cohort_shape = self.cohort_shape
        
        if isinstance(T1, slice):
            if static.len(value.S) != 2:
                compile_error("MPP: invalid shapes for setitem")

            start, stop, _, _ = s[0].adjust_indices(cohort_shape[0])
            assert not self._transposed, "Not implemented yet: setitem for transposed MPP"
            assert value._ratios.sum() == stop - start, f"MPP: setitem value does not match the slice size {value._ratios.sum()} != {stop - start}"
            adjusted_cs = cs
        elif isinstance(T1, int):
            _rows_count = cohort_shape[0]
            assert rs < _rows_count, "MPP: invalid setitem indices"
            rs = (rs + _rows_count) % _rows_count
            
            if static.len(value.S) != 1:
                compile_error("MPP: invalid shapes for setitem")

            assert not self._transposed, "Not implemented yet: setitem for transposed MPP"
            assert value._ratios.sum() == max(value._ratios) == 1, "Not implemented yet: setitem operands should be at the same partition/party for now"

            if isinstance(T2, int):
                _cols_count = cohort_shape[1]
                assert cs < _cols_count, "MPP: invalid setitem indices"
                cs = (cs + _cols_count) % _cols_count
                adjusted_cs = slice(start=cs, stop=cs + 1, step=1)
            else:
                adjusted_cs = cs
        else:
            compile_error("MPP: invalid index --- should be either slice or int")

        self._setitem_2_dim_tuple((rs, adjusted_cs), value)
    
    def _setitem_2_dim(self, s: Tuple[int, int], value: float):
        assert not self._transposed, "Not implemented yet: setitem for transposed MPP"
        if static.len(S) != 2:
            compile_error("MPP: invalid shapes for setitem")
        
        mpc = self._mpc
        if mpc.pid == 0:
            return

        rs, cs = s
        cohort_shape = self.cohort_shape
        
        _rows_count = cohort_shape[0]
        assert rs < _rows_count, "MPP: invalid setitem indices"
        rs = (rs + _rows_count) % _rows_count

        _cols_count = cohort_shape[1]
        assert cs < _cols_count, "MPP: invalid setitem indices"
        cs = (cs + _cols_count) % _cols_count

        _ratio_idx = self._find_idx_in_ratios(rs)
        adjusted_idx = rs - self._ratios[:_ratio_idx].sum()

        if mpc.pid == _ratio_idx + 1:
            self._local_data[adjusted_idx, cs] = value

    def _align_semi_encryptions(self, other: MPP) -> Tuple[Ciphertensor[Ciphertext], ndarray, Ciphertensor[Ciphertext]]:
        mpc = self._mpc
        assert self.is_semi_encrypted() or other.is_semi_encrypted(), "MPP: at least on of the MPPs needs to be semi-encrypted to align the semi ancryptions"

        if self.is_semi_encrypted() and other.is_semi_encrypted():
            if self._encryption_left:
                assert bool(other._encryption_left) and self._encryption_left.shape[-1] == other._encryption_left.shape[-1], "MPP: left semi encryption shape missmatch"
            if self._encryption_right:
                assert bool(other._encryption_right) and self._encryption_right.shape[-1] == other._encryption_right.shape[-1], "MPP: right semi encryption shape missmatch"
            
            assert self.has_local_data() and other.has_local_data(), "MPP: semi-encrypted MPP should have local data"
            return other._encryption_left, other._local_data, other._encryption_right
        
        elif self.is_local():
            if other._encryption_left:
                left_border = other._encryption_left.shape[-1]
                self._encryption_left = Ciphertensor[Ciphertext].enc(mpc, self._local_data._slice_cols(0, left_border))
                self._local_data = self._local_data._slice_cols(left_border, self._local_data.shape[-1])
            if other._encryption_right:
                right_border = -other._encryption_right.shape[-1]
                self._encryption_right = Ciphertensor[Ciphertext].enc(mpc, self._local_data._slice_cols(right_border, self._local_data.shape[-1]))
                self._local_data = self._local_data._slice_cols(0, right_border)
            
            return other._encryption_left, other._local_data, other._encryption_right
        
        else:  # other is local
            _encryption_left = Ciphertensor[Ciphertext]()
            _local_data = other._local_data
            _encryption_right = Ciphertensor[Ciphertext]()

            if self._encryption_left:
                left_border = self._encryption_left.shape[-1]
                _encryption_left = Ciphertensor[Ciphertext].enc(mpc, other._local_data._slice_cols(0, left_border))
                _local_data = _local_data._slice_cols(left_border, _local_data.shape[-1])
            if self._encryption_right:
                right_border = -self._encryption_right.shape[-1]
                _encryption_right = Ciphertensor[Ciphertext].enc(mpc, _local_data._slice_cols(right_border, _local_data.shape[-1]))
                _local_data = _local_data._slice_cols(0, right_border)
            
            return _encryption_left, _local_data, _encryption_right

    def _rows_count(self) -> int:
        if self._mpc.pid == 0: return self._ratios.sum()
        return self._ratios[self._mpc.pid - 1]
    
    def _find_idx_in_ratios(self, idx: int) -> int:
        _ratio_idx = 0
        _ratio_sum = 0
        for count in self._ratios:
            _ratio_sum += count
            if idx >= _ratio_sum:
                _ratio_idx += 1
            else: break
        return _ratio_idx

    def _adjust_row_slice(self, start, stop):
        reference_pid = self._mpc.pid - 1
        ratios_sum = self._ratios[:reference_pid].sum()
        adjusted_start = max(start - ratios_sum, 0)
        adjusted_stop = min(stop - ratios_sum, self._ratios[reference_pid])

        assert 0 <= adjusted_start < self._ratios[reference_pid], f"MPP: index out of bound --- {adjusted_start} not in [0, {self._ratios[reference_pid]})"
        assert 0 <= adjusted_stop <= self._ratios[reference_pid], f"MPP: index out of bound --- {adjusted_start} not in [0, {self._ratios[reference_pid]}]"
        
        return slice(start=adjusted_start, stop=adjusted_stop, step=1)
    
    @staticmethod
    def _adjust_col_slice_tuple[T1](cs):
        whole_slice = slice(start=None, stop=None, step=1)
                
        if isinstance(T1, slice):
            return (whole_slice, cs)
        elif isinstance(T1, int):
            return cs
        else:
            compile_error("MPP: invalid index --- should be either slice or int")
    
    def _get_sliced_ratios(self, _start_ratio_idx: int, _stop_ratio_idx: int, start: int, stop: int) -> List[int]:
        _ratios = []
        _ratios_start_sum = 0
        _ratios_stop_sum = 0
        
        for i, ratio in enumerate(self._ratios):
            _ratios_start_sum += ratio
            if i < _start_ratio_idx or i > _stop_ratio_idx:
                _ratios.append(0)
            elif i == _start_ratio_idx == _stop_ratio_idx:
                _ratios.append(stop - start)
            elif i == _start_ratio_idx:
                _ratios.append(_ratios_start_sum - start)
            elif i == _stop_ratio_idx:
                _ratios.append(stop - _ratios_stop_sum)
            else:
                _ratios.append(self._ratios[i])
            _ratios_stop_sum += ratio
        
        return _ratios
    
    # Internal typechecker hack
    @property
    def _internal_type(self) -> dtype:
        return dtype()

    # Temporary helpers
    def slice_local(self, idx: int, *args) -> MPP[S, dtype]:
        assert self._transposed, "Not implemented case: transposed"

        mpc = self._mpc
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=mpc,
                _ratios=self._ratios.copy(),
                _local_data=self._local_data.copy(),
                _transposed=True)
        
        assert self.has_unified_encryption(), "Not implemented case: unified encryption"
        
        local_enc = self._encryption_unified.copy()
        assert local_enc._transposed, "Not implemented case: enc transposed"
        assert local_enc.cipher_shape[-1] == 1, "Not implemented case: single cipher"

        slots = mpc.mhe.crypto_params.params.slots()
        local_enc._data = local_enc._data.rotate(1)
        local_enc._data[-1] = mpc.mhe.zero_cipher()

        if mpc.pid == 1:
            for i in range(idx):
                mpc.mhe.crypto_params.evaluator.rotate(local_enc._data[i], 1, local_enc._data[i])
            
            mask = one_hot_vector(idx=slots - 1, size=slots, complement=True, TP=dtype)
        else:
            mask = [dtype(1) for _ in range(slots)]
        
        cipher_mask = mpc.mhe.enc_vector(mask, T=Plaintext)
        
        for i in range(idx):
            mpc.mhe.imul([local_enc._data[i]], cipher_mask)

        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=self._ratios.copy(),
            _local_data=ndarray[S, dtype](),
            _encryption_unified=local_enc,
            _transposed=True)

    def rotate_local(self, i: int, *args) -> MPP[S, dtype]:
        assert self._transposed, "Not implemented case"

        mpc = self._mpc
        if mpc.pid == 0:
            return MPP[S, dtype](
                _mpc=mpc,
                _ratios=self._ratios.copy(),
                _local_data=self._local_data.copy(),
                _transposed=self._transposed)
        
        assert self.has_unified_encryption(), "Not implemented case"
        
        local_enc = self._encryption_unified.copy()
        assert local_enc._transposed, "Not implemented case"
        assert local_enc.cipher_shape[-1] == 1, "Not implemented case"

        if mpc.pid == 1:
            mpc.mhe.crypto_params.evaluator.rotate(local_enc._data[0], i, local_enc._data[0])

        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=self._ratios.copy(),
            _local_data=ndarray[S, dtype](),
            _encryption_unified=local_enc,
            _transposed=True)
    

class MPPAligner[S, dtype]:
    # For the duration of a with-block, makes per-partition HE operations, which may refresh their operands (each
    # refresh a collective bootstrap council among the compute parties), run alike at every compute party. It pads each
    # party's partition to the cohort's shape, and an empty partition takes the representations the others hold (zeros,
    # or nil-ideal placeholders: encrypted zero rows; block by block for ALIGN_PAD, else one block of the full width),
    # so that it runs the same operations; a partition in the clear never gets a placeholder encryption, nor an
    # encrypted one zero data in the clear, since each party's real representations decide what it computes. Results
    # built with new_mpp, and the operand itself on exit, are cut back to each party's own size. A 2-dim partition is
    # padded to the most rows (the ratios). A 1-dim one is padded to the longest vector: a row of a 2-dim MPP is held by
    # one party, whose ratio is 1 whatever the row's length, and a partitioned vector by several, whose ratios are their
    # lengths. Beyond that (the ALIGN_* modes) it agrees on every partition's descriptor in one round among the compute
    # parties, which an operation can pass in when it agrees on two operands at once, and in ALIGN_ENCRYPT it unifies
    # encrypted partitions and encrypts those in the clear of a mixed cohort for the duration.
    mpp: MPP[S, dtype]
    mode: int
    length: int  # 1-dim and unaligned: this party's vector length on entry (-1 otherwise)
    descriptors: List[List[int]]  # every compute party's partition (_partition_descriptor), when agreed
    padded: bool
    stashed: bool  # ALIGN_ENCRYPT: this party's partition in the clear is set aside for the duration
    # Set only when stashed: an aligner is built for every element-wise operation, where empty placeholders cost
    stash_local: Optional[ndarray[S, dtype]]
    stash_unified: Optional[Ciphertensor[Ciphertext]]

    def __init__(self, mpp: MPP[S, dtype], mode: int = ALIGN_PAD, descriptors: Optional[List[List[int]]] = None):
        assert mpp._mpc.pid, "MPPAligner should not be called at CP0"
        self.mpp = mpp
        self.mode = mode
        self.length = -1
        self.descriptors = descriptors if descriptors is not None else List[List[int]]()
        self.padded = False
        self.stashed = False
        self.stash_local = None
        self.stash_unified = None

    def __enter__(self):
        mpp = self.mpp
        unaligned = not mpp.cohort_is_aligned()
        if (self.mode == ALIGN_PAD or self.mode == ALIGN_ROWS) and not unaligned:
            return
        if not self.descriptors:
            self.descriptors = mpp._mpc.comms.collect(_partition_descriptor(mpp))
        if self.mode == ALIGN_ENCRYPT:
            self._unify_for_products()
        if unaligned:
            if static.len(S) == 1:
                self.length = MPPAligner._vector_length(mpp)
            MPPAligner._align(mpp, self.descriptors, self.mode == ALIGN_PAD)
            self.padded = True

    def __exit__(self):
        if self.padded:
            MPPAligner._revert(self.mpp, self.length)
        if self.stashed:
            self.mpp._local_data = unwrap(self.stash_local)
            self.mpp._encryption_unified = unwrap(self.stash_unified)

    def own_kind(self) -> int:
        # This party's partition kind, as agreed (valid once the descriptors are)
        return self.descriptors[self.mpp._mpc.pid - 1][D_KIND]

    def _unify_for_products(self):
        # For a product of two secret factors, whose per-party products must match in kind and layout: every encrypted
        # partition as one unified encryption (a semi-encrypted one unifies before it is padded, so it keeps its width),
        # and in a mixed cohort (partitions in the clear and encrypted ones) every partition in the clear encrypted for the
        # duration, by public-key encryption (never trivially: the data is private), in the layout of the encrypted ones,
        # with its data in the clear set aside and restored on exit. Every party updates its copy of the descriptors alike.
        descriptors = self.descriptors
        kinds = [d[D_KIND] for d in descriptors]
        mixed = MPP_CLEAR in kinds and (MPP_UNIFIED in kinds or MPP_SEMI in kinds)
        if not mixed and MPP_SEMI not in kinds:
            return
        transposed, diagonal, agreed = _encrypted_layout(descriptors)
        if not agreed:
            raise ValueError("MPP: the compute parties hold their partitions encrypted in different layouts")
        mpp = self.mpp
        mpc = mpp._mpc
        kind = kinds[mpc.pid - 1]
        if kind == MPP_SEMI:
            mpp.unify_encryption()
        elif kind == MPP_CLEAR and mixed:
            self.stash_local = mpp._local_data
            self.stash_unified = mpp._encryption_unified
            if static.len(S) == 2:
                data = mpp._local_data.T if transposed else mpp._local_data
                encryption = Ciphertensor[Ciphertext].enc(mpc, data, encoding=ENC_DIAG if diagonal else ENC_ROW)
            else:
                encryption = Ciphertensor[Ciphertext].enc(mpc, mpp._local_data, encoding=ENC_ROW)
            encryption._transposed = transposed
            mpp._encryption_unified = encryption
            mpp._local_data = ndarray[S, dtype]()
            self.stashed = True
        for d in descriptors:
            if d[D_KIND] == MPP_SEMI:
                d[D_UNIFIED + 1] = d[D_LOCAL + 1] + d[D_LEFT + 1] + d[D_RIGHT + 1]
            elif d[D_KIND] == MPP_CLEAR and mixed:
                d[D_UNIFIED + 1] = d[D_LOCAL + 1]
                d[D_LOCAL] = 0
                d[D_LOCAL + 1] = 0
            else:
                continue
            d[D_KIND] = MPP_UNIFIED
            d[D_UNIFIED] = 1
            d[D_UNIFIED + 2] = int(transposed)
            d[D_UNIFIED + 3] = int(diagonal)

    def new_mpp(self,
            _local_data = None,
            _encryption_left = None,
            _encryption_right = None,
            _encryption_unified = None) -> MPP[S, dtype]:

        local_data = ndarray[S, dtype]() if _local_data is None else _local_data
        enc_left = Ciphertensor[Ciphertext]() if _encryption_left is None else _encryption_left
        enc_right = Ciphertensor[Ciphertext]() if _encryption_right is None else _encryption_right
        enc_unified = Ciphertensor[Ciphertext]() if _encryption_unified is None else _encryption_unified

        mpc = self.mpp._mpc
        if static.len(S) == 1:
            if self.length >= 0:
                if not local_data.is_empty(): local_data = MPPAligner._cut_vector(local_data, self.length)
                if enc_left: enc_left = MPPAligner._cut_vector_encryption(enc_left, self.length)
                if enc_right: enc_right = MPPAligner._cut_vector_encryption(enc_right, self.length)
                if enc_unified: enc_unified = MPPAligner._cut_vector_encryption(enc_unified, self.length)
        else:
            if not local_data.is_empty():
                local_data = MPPAligner._revert_local_data(mpc, local_data, self.mpp._ratios)
            if enc_left:
                enc_left = MPPAligner._revert_encryption(mpc, enc_left, self.mpp._ratios, S=self.mpp.S)
            if enc_right:
                enc_right = MPPAligner._revert_encryption(mpc, enc_right, self.mpp._ratios, S=self.mpp.S)
            if enc_unified:
                enc_unified = MPPAligner._revert_encryption(mpc, enc_unified, self.mpp._ratios, S=self.mpp.S)

        return MPP[S, dtype](
            _mpc=mpc,
            _ratios=self.mpp._ratios.copy(),
            _local_data=local_data,
            _encryption_left=enc_left,
            _encryption_right=enc_right,
            _encryption_unified=enc_unified,
            _transposed=self.mpp._transposed)
    
    @staticmethod
    def _align(mpp: MPP[S, dtype], descriptors: List[List[int]], semi_blocks: bool):
        # Each representation this party holds, padded to the cohort's rows (or length). No round: the descriptors give
        # every party's widths and layouts. With semi_blocks (ALIGN_PAD, per-block operations such as indexing), an empty
        # partition takes every representation some party holds, and a semi-encrypted one also the encrypted blocks some
        # other semi-encrypted one has (nil-ideal), so that each block refreshes alike at every party; those blocks add
        # nothing. Otherwise (a product unifies a semi-encrypted partition, which extra blocks would widen) an empty
        # partition takes one block of the full width (_fill_empty).
        mpc = mpp._mpc
        kind = descriptors[mpc.pid - 1][D_KIND]
        empty = kind == MPP_EMPTY
        if empty and not semi_blocks:
            MPPAligner._fill_empty(mpp, descriptors)
            return
        blocks = empty or (semi_blocks and kind == MPP_SEMI)
        if static.len(S) == 1:
            mpp._local_data = MPPAligner._align_vector(mpp._local_data, descriptors, empty)
            mpp._encryption_unified = MPPAligner._align_vector_encryption(mpc, mpp._encryption_unified, descriptors, D_UNIFIED, empty)
            mpp._encryption_left = MPPAligner._align_vector_encryption(mpc, mpp._encryption_left, descriptors, D_LEFT, blocks)
            mpp._encryption_right = MPPAligner._align_vector_encryption(mpc, mpp._encryption_right, descriptors, D_RIGHT, blocks)
            return
        
        mpp._local_data = MPPAligner._align_local_data(mpc, mpp._local_data, mpp._ratios, descriptors, empty)
        mpp._encryption_unified = MPPAligner._align_encryption(mpc, mpp._encryption_unified, mpp._ratios, descriptors, D_UNIFIED, empty, S=S)
        mpp._encryption_left = MPPAligner._align_encryption(mpc, mpp._encryption_left, mpp._ratios, descriptors, D_LEFT, blocks, S=S)
        mpp._encryption_right = MPPAligner._align_encryption(mpc, mpp._encryption_right, mpp._ratios, descriptors, D_RIGHT, blocks, S=S)
    
    @staticmethod
    def _fill_empty(mpp: MPP[S, dtype], descriptors: List[List[int]]):
        # An empty partition padded for an operation that is not per block (every mode but ALIGN_PAD): one block of the
        # full width in the cohort's kind, a nil-ideal placeholder in the layout of the encrypted partitions if any party
        # holds one, else zeros in the clear (_padded_kind gives what it then counts as). Taking each block from another
        # holder would not add up to the cohort's width.
        mpc = mpp._mpc
        padded = _padded_kind(descriptors)
        if padded[D_KIND] == MPP_EMPTY:
            return
        width = padded[D_UNIFIED + 1] if padded[D_KIND] == MPP_UNIFIED else padded[D_LOCAL + 1]
        if static.len(S) == 1:
            if padded[D_KIND] == MPP_UNIFIED:
                placeholder = Ciphertensor[Ciphertext].placeholder([width], mpc.mhe.crypto_params.params.slots())
                placeholder._transposed = bool(padded[D_UNIFIED + 2])
                mpp._encryption_unified = placeholder
            else:
                mpp._local_data = zeros((width,), dtype=dtype)
            return
        rows = max(mpp._ratios)
        if padded[D_KIND] == MPP_UNIFIED:
            transposed = bool(padded[D_UNIFIED + 2])
            placeholder = Ciphertensor[Ciphertext].placeholder([width, rows] if transposed else [rows, width], mpc.mhe.crypto_params.params.slots())
            placeholder._transposed = transposed
            mpp._encryption_unified = placeholder
        else:
            mpp._local_data = zeros((rows, width), dtype=dtype)

    @staticmethod
    def _revert(mpp: MPP[S, dtype], length: int):
        mpc = mpp._mpc
        if static.len(S) == 1:
            if not mpp._local_data.is_empty(): mpp._local_data = MPPAligner._cut_vector(mpp._local_data, length)
            if mpp._encryption_unified: mpp._encryption_unified = MPPAligner._cut_vector_encryption(mpp._encryption_unified, length)
            if mpp._encryption_left: mpp._encryption_left = MPPAligner._cut_vector_encryption(mpp._encryption_left, length)
            if mpp._encryption_right: mpp._encryption_right = MPPAligner._cut_vector_encryption(mpp._encryption_right, length)
            return
        
        if not mpp._local_data.is_empty():
            mpp._local_data = MPPAligner._revert_local_data(mpc, mpp._local_data, mpp._ratios)
        if mpp._encryption_unified:
            mpp._encryption_unified = MPPAligner._revert_encryption(mpc, mpp._encryption_unified, mpp._ratios, S=S)
        if mpp._encryption_left:
            mpp._encryption_left = MPPAligner._revert_encryption(mpc, mpp._encryption_left, mpp._ratios, S=S)
        if mpp._encryption_right:
            mpp._encryption_right = MPPAligner._revert_encryption(mpc, mpp._encryption_right, mpp._ratios, S=S)

    @staticmethod
    def _vector_length(mpp: MPP[S, dtype]) -> int:
        # A 1-dim partition's length: its data in the clear and encrypted blocks together (a row of a semi-encrypted MPP
        # has several), else its unified encryption. A unified encryption beside data in the clear (or beside blocks) is
        # a cache of the same values, as MPP.reveal leaves it: counting it too left the padding uncut (M-MP-26)
        length = 0 if mpp._local_data.is_empty() else mpp._local_data.shape[0]
        for enc in (mpp._encryption_left, mpp._encryption_right):
            if enc: length += enc.shape[-1]
        if length == 0 and mpp._encryption_unified:
            length = mpp._encryption_unified.shape[-1]
        return length

    @staticmethod
    def _vector_target(descriptors: List[List[int]], field: int) -> int:
        # The length a 1-dim representation (data in the clear D_LOCAL, or an encryption D_UNIFIED, D_LEFT, D_RIGHT) is
        # padded to, 0 if no party holds one. Data in the clear and unified encryptions: the cohort's longest vector,
        # whatever representation holds it, so that two operands a party holds differently (one in the clear, one
        # encrypted) meet at one length; padded to the longest of their own kind, they did not in a mixed cohort at
        # unequal lengths (a crash or a refresh at one party only). A semi-encrypted row's data in the clear and its
        # blocks are blocks, not whole vectors: the longest of the same kind.
        if not any(bool(d[field]) for d in descriptors):
            return 0
        if field == D_LEFT or field == D_RIGHT or any(d[D_KIND] == MPP_SEMI for d in descriptors):
            return max(d[field + 1] for d in descriptors if d[field])
        return max(_full_width(d) for d in descriptors if d[D_KIND] != MPP_EMPTY)

    @staticmethod
    def _align_vector[S, dtype](data: ndarray[S, dtype], descriptors: List[List[int]], empty: bool) -> ndarray[S, dtype]:
        # A vector in the clear padded with zeros to _vector_target's length; an empty partition takes zeros of that length
        target = MPPAligner._vector_target(descriptors, D_LOCAL)
        if target == 0:
            return data
        if not data.is_empty():
            return data.pad(target - data.shape[0], axis=0) if data.shape[0] < target else data
        return zeros((target,), dtype=dtype) if empty else data

    @staticmethod
    def _align_vector_encryption(mpc, encryption: Ciphertensor[Ciphertext], descriptors: List[List[int]], field: int, fill: bool) -> Ciphertensor[Ciphertext]:
        # As _align_vector, for an encrypted vector: its ciphertexts in a placeholder of _vector_target's length (nil-ideal
        # ciphertexts for the rest); without one, a placeholder with the layout of the first party that holds one if fill
        target = MPPAligner._vector_target(descriptors, field)
        if target == 0:
            return encryption
        if encryption:
            transposed = encryption._transposed
        elif fill:
            transposed = bool(descriptors[_first_holder(descriptors, field)][field + 2])
        else:
            return encryption
        
        slots = mpc.mhe.crypto_params.params.slots()
        placeholder = Ciphertensor[Ciphertext].placeholder([target], slots)
        placeholder._transposed = transposed
        for i, cipher in enumerate(encryption._data):
            placeholder._data[i] = cipher
        return placeholder

    @staticmethod
    def _cut_vector[S, dtype](data: ndarray[S, dtype], length: int) -> ndarray[S, dtype]:
        # Back to this party's own length (empty if it had none); a shorter result (an element taken out) stays
        if length == 0:
            return ndarray[S, dtype]()
        return data[:length] if data.shape[0] > length else data

    @staticmethod
    def _cut_vector_encryption(encryption: Ciphertensor[Ciphertext], length: int) -> Ciphertensor[Ciphertext]:
        if length == 0:
            return Ciphertensor[Ciphertext].like(encryption)
        if encryption.shape[-1] <= length:
            return encryption
        return Ciphertensor[Ciphertext](
            _data=encryption._data[:Ciphertensor._count_ciphers([length], encryption.slots)],
            shape=[length],
            slots=encryption.slots,
            _transposed=encryption._transposed,
            _diagonal_contiguous=encryption._diagonal_contiguous,
            _skinny=encryption._skinny,
            _is_broadcast=encryption._is_broadcast)
    
    @staticmethod
    def _align_local_data[S, dtype](mpc, data: ndarray[S, dtype], ratios: List[int], descriptors: List[List[int]], empty: bool):
        # This party's data in the clear padded with zero rows to the most rows; an empty partition takes zero rows when
        # some party holds data in the clear
        if static.len(S) != 2:
            compile_error("MPPAligner: invalid dimension")

        assert ratios.sum() > 0, "MPPAligner: nothing to align -- MPP empty"
        rows = max(ratios)
        if not data.is_empty():
            return data.pad(rows - data.shape[0], axis=0) if data.shape[0] < rows else data
        if not empty:
            return data
        source = _first_holder(descriptors, D_LOCAL)
        return zeros((rows, descriptors[source][D_LOCAL + 1]), dtype=dtype) if source >= 0 else data
    
    @staticmethod
    def _align_encryption[S](mpc, encryption: Ciphertensor[Ciphertext], ratios: List[int], descriptors: List[List[int]], field: int, fill: bool):
        # This party's encryption (field: unified, left or right) padded with nil-ideal rows to the most rows, in its own
        # layout; without one, a placeholder in the layout and width of the first party that holds one if fill
        if static.len(S) != 2:
            compile_error("MPPAligner: invalid dimension")

        assert ratios.sum() > 0, "MPPAligner: nothing to align -- MPP empty"
        rows = max(ratios)
        if encryption:
            if ratios[mpc.pid - 1] == rows:
                return encryption
            own = descriptors[mpc.pid - 1]
            cols, _transposed = own[field + 1], bool(own[field + 2])
        elif fill:
            source = _first_holder(descriptors, field)
            if source < 0:
                return encryption
            cols, _transposed = descriptors[source][field + 1], bool(descriptors[source][field + 2])
        else:
            return encryption

        slots = mpc.mhe.crypto_params.params.slots()
        _encryption_placeholder = Ciphertensor[Ciphertext].placeholder([cols, rows] if _transposed else [rows, cols], slots)
        _encryption_placeholder._transposed = _transposed
        for i, cipher in enumerate(encryption._data):
            _encryption_placeholder._data[i] = cipher

        return _encryption_placeholder
    
    @staticmethod
    def _revert_local_data[S, dtype](mpc, data: ndarray[S, dtype], ratios: List[int]):
        if static.len(S) != 2:
            compile_error("MPPAligner: invalid dimension")

        assert ratios.sum() > 0, "MPPAligner: nothing to align -- MPP empty"
        if ratios[mpc.pid - 1] == max(ratios):
            return data
        if ratios[mpc.pid - 1] == 0:
            return ndarray[S, dtype]()

        return data[:ratios[mpc.pid - 1]]

    @staticmethod
    def _revert_encryption[S](mpc, encryption: Ciphertensor[Ciphertext], ratios: List[int]):
        if static.len(S) != 2:
            compile_error("MPPAligner: invalid dimension")

        assert ratios.sum() > 0, "MPPAligner: nothing to align -- MPP empty"
        if ratios[mpc.pid - 1] == max(ratios):
            return encryption
        if ratios[mpc.pid - 1] == 0:
            return Ciphertensor[Ciphertext].like(encryption)

        if encryption._transposed:
            # Assume that slice of the result that was produced by nil-ideals is all zeros
            
            _data = [cipher for cipher in encryption._data if not cipher._nil_ideal]
            encryption.shape[-1] = ratios[mpc.pid - 1]
            encryption._data = _data
            encryption.validate()
            return encryption
        
        return encryption._get_rows_raw(slice(start=0, stop=ratios[mpc.pid - 1], step=1))


@extend
class MPP:
    def partition_aligner(self, mode: int = ALIGN_PAD, descriptors: Optional[List[List[int]]] = None):
        return MPPAligner(self, mode, descriptors)


@extend
class ndarray:
    def __add__(self, other: MPP[S, T]) -> MPP[S, T]:
        return self._do_elem_wise_op(other, secure_operator.add)
    
    def __sub__(self, other: MPP[S, T]) -> MPP[S, T]:
        return self._do_elem_wise_op(-other, secure_operator.add)
    
    def __mul__(self, other: MPP[S, T]) -> MPP[S, T]:
        return self._do_elem_wise_op(other, secure_operator.mul, MUL=1)
    
    def __matmul__(self, other: MPP[S, T]) -> MPP[S, T]:
        return (other.T @ self.T).T
    
    def _do_elem_wise_op(self, other: MPP[S, T], elem_wise_op) -> MPP[S, T]:
        mpc = other._mpc
        
        _other, _self = other._check_binary_operands(self)
        ac_type = _other.dtype
        _self = _self.T if _other._transposed else _self

        if mpc.pid == 0:
            return MPP[S, ac_type](
                _mpc=mpc,
                _ratios=_other._ratios.copy(),
                _local_data=_other._local_data)

        _local_data = ndarray[S, ac_type]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        if static.len(S) == 2:
            if _self.shape[0] == _other._ratios.sum():
                start, end = _other.get_relative_indices()
                _self = _self[start:end]
            elif not _self.shape[0] == _other.shape[0]:
                raise ValueError(f"ndarray: shapes missmatch in public elem-wise MPP operation {_self.shape} vs {_other.shape} at CP{mpc.pid}")
        
        # A sum or a difference (a product of an ndarray by an MPP does not compile yet: L-095), which never refreshes:
        # each compute party computes on its own partition, nothing padded, no round
        if not _other.is_empty():
            _local_data, _encryption_left, _encryption_right, _encryption_unified = _self._do_elem_wise_op_public(_other, elem_wise_op)

        return MPP[S, ac_type](
            _mpc=mpc,
            _ratios=_other._ratios.copy(),
            _local_data=_local_data,
            _encryption_left=_encryption_left,
            _encryption_right=_encryption_right,
            _encryption_unified=_encryption_unified,
            _transposed=_other._transposed)

    def _do_elem_wise_op_public(self, other_mpp: MPP[S, T], elem_wise_op) -> Tuple[ndarray[S, T], Ciphertensor[Ciphertext], Ciphertensor[Ciphertext], Ciphertensor[Ciphertext]]:
        last_dim = self.shape[0] if other_mpp._transposed else self.shape[-1]
        assert last_dim == other_mpp.shape[-1], f"ndarray: shapes missmatch in public elem-wise MPP operation {self.shape} vs {other_mpp.shape}"
        _local_data = ndarray[S, T]()
        _encryption_left = Ciphertensor[Ciphertext]()
        _encryption_right = Ciphertensor[Ciphertext]()
        _encryption_unified = Ciphertensor[Ciphertext]()

        mpc = other_mpp._mpc
        if mpc.pid == 0:
            return (self, _encryption_left, _encryption_right, _encryption_unified)
        
        col_end = 0
        if other_mpp.is_local():
            _local_data = elem_wise_op(mpc, self, other_mpp._local_data)
        elif other_mpp.has_unified_encryption():
            _encryption_unified = elem_wise_op(mpc, self, other_mpp._encryption_unified)
        elif other_mpp.has_partial_encryption():
            if other_mpp._encryption_left:
                # A block's logical width: the blocks of an A @ B.T result are lazily transposed (M-MP-03)
                col_end = other_mpp._encryption_left.actual_shape[-1]
                _encryption_left = elem_wise_op(mpc, self._slice_cols(0, col_end), other_mpp._encryption_left)
            assert other_mpp.has_local_data(), "ndarray: MPP must have local data if it has partial encryption"
            col_start = col_end
            col_end = col_start + other_mpp._local_data.shape[-1]
            _local_data = elem_wise_op(mpc, self._slice_cols(col_start, col_end), other_mpp._local_data)
            if other_mpp._encryption_right:
                col_start = col_end
                _encryption_right = elem_wise_op(mpc, self._slice_cols(col_start, self.shape[-1]), other_mpp._encryption_right)
        else:
            raise ValueError("ndarray: invalid MPP partition")

        return (_local_data, _encryption_left, _encryption_right, _encryption_unified)

    def matmul_cost(self, other: MPP) -> float:
        raise NotImplementedError("ndarray: matmul with MPP")


@extend
class int:
    def __add__[S, dtype](self, other: MPP[S, dtype]) -> MPP[S, dtype]:
        return other + self

    def __sub__[S, dtype](self, other: MPP[S, dtype]) -> MPP[S, dtype]:
        return -other + self

    def __mul__[S, dtype](self, other: MPP[S, dtype]) -> MPP[S, dtype]:
        return other * self

    def __truediv__[S, dtype](self, other: MPP[S, dtype]) -> MPP[S, dtype]:
        raise NotImplementedError("Cannot divide by secure value without IR passes enabled.")
