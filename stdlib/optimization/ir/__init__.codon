# Run-time helpers of the Sequre plugin's IR optimizations (ir/analysis/cipher_opt.cpp finds them in this module).
# `sequre` star-imports this module, so the names imported here stay importable from `sequre`, as they were.
#
# BOSTAN (Shechi, section 8.2: aggregation and encoding optimization on a secure expression tree) is kept here as
# reference, neither imported nor built: bostan.codon (the plugin's run-time entry points), bet.codon (the run-time
# tree), metadata.codon (partitioning and encoding metadata and their propagation), cost_estimator.codon, and the
# plugin's ir/helpers/bet.{h,cpp}, all from the ir-opt branch (6508b9a, "MPP-opt: EOD"), where the plugin's wiring
# (applyBostan in ir/mhe.cpp, the matmul hook in ir/expr.cpp) and MPU._matmul's aggregation_strategy are too. They
# target the MPU and Ciphertensor APIs of April 2024 and await a port.
import time

import internal.static as static
import secure_operator

from sequre.stdlib.numpy.ndarray import ndarray

from sequre.constants import (
    DEBUG, IR_OPT_ENCODING_OPT_NAME_BRUTE_FORCE,
    IR_OPT_ENCODING_ROW_WISE_ENUM,
    IR_OPT_ENCODING_COL_WISE_ENUM,
    ENC_ROW, ENC_DIAG)
from sequre.types.ciphertensor import Ciphertensor
from sequre.lattiseq.ckks import Ciphertext

from matmul_reorder import evaluate_in_order, order_cost, cheapest_order


def matmul_chain(mpc, mats, written):
    # A chain of `@` of Sharetensors that @mhe_cipher_opt hands over: its operands and the order as written (for each
    # product, the index of its left operand in the list of operands and products as it shrinks). It runs in the order
    # of least rows x inner x columns (Sharetensor's cost model) when that is strictly cheaper than the written one, and
    # as written otherwise (a tie, a vector, shapes that do not chain). Shapes are the same at every party.
    ms = [m for m in mats]
    order = [o for o in written]
    dims = List[int]()
    for i in range(len(ms)):
        if ms[i].ndim != 2 or (i > 0 and ms[i].shape[0] != dims[i]):
            return evaluate_in_order(mpc, ms, order)
        if i == 0:
            dims.append(ms[i].shape[0])
        dims.append(ms[i].shape[1])
    
    best = cheapest_order(dims)
    if order_cost(dims, best) < order_cost(dims, order):
        order = best
    return evaluate_in_order(mpc, ms, order)


def fp_agree(ts, conds) -> bool:
    # Whether each addition of two Sharetensors in an expression @mhe_cipher_opt rewrote adds two fixed-point values or
    # two integer ones (Sequre refuses one of each): the rewritten expression runs only then, the expression as written
    # otherwise. conds holds four ints per addition: for each side, a bit mask over ts (the side is fixed point when
    # one of those is) and whether it is fixed point anyway (a product with a float).
    flags = 0
    for i in static.range(static.len(ts)):
        if ts[i].fp:
            flags |= 1 << i
    cs = [c for c in conds]
    for k in range(0, len(cs), 4):
        left = (flags & cs[k]) != 0 or cs[k + 1] != 0
        right = (flags & cs[k + 2]) != 0 or cs[k + 3] != 0
        if left != right:
            return False
    return True
