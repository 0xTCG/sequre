import secure_operator


def evaluate_in_order(mpc, mats, order):
    # Each step multiplies the operand at the step's index by the next one
    for o in order:
        mats[o] = secure_operator.matmul(mpc, mats[o], mats[o + 1])
        del mats[o + 1]
    
    return mats[0]


def order_cost(dims: List[int], order: List[int]) -> int:
    # Rows x inner x columns summed over the products of a chain of matrices dims[i] x dims[i + 1] evaluated in the
    # given order (each step: the index of a product's left operand in the list of operands as it shrinks)
    ds = [d for d in dims]
    cost = 0
    for o in order:
        cost += ds[o] * ds[o + 1] * ds[o + 2]
        del ds[o + 1]
    
    return cost


def _add_steps(split: List[List[int]], i: int, j: int, starts: List[int], order: List[int]):
    # The products of operands i..j in evaluation order: each as the index of its left side among the sides left
    if i == j:
        return
    
    k = split[i][j]
    _add_steps(split, i, k, starts, order)
    _add_steps(split, k + 1, j, starts, order)
    idx = starts.index(i)
    order.append(idx)
    del starts[idx + 1]


def cheapest_order(dims: List[int]) -> List[int]:
    # The order of least order_cost (the matrix-chain dynamic program; of equal ones, the first split found)
    n = len(dims) - 1
    best = [[0 for _ in range(n)] for _ in range(n)]
    split = [[0 for _ in range(n)] for _ in range(n)]
    for length in range(2, n + 1):
        for i in range(n - length + 1):
            j = i + length - 1
            best[i][j] = -1
            for k in range(i, j):
                cost = best[i][k] + best[k + 1][j] + dims[i] * dims[k + 1] * dims[j + 1]
                if best[i][j] < 0 or cost < best[i][j]:
                    best[i][j] = cost
                    split[i][j] = k
    
    order = List[int]()
    starts = [i for i in range(n)]
    _add_steps(split, 0, n - 1, starts, order)
    return order
