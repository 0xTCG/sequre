"""
Known answers for the integer and multi-precision arithmetic Sequre computes itself (scripts/smoke_test.sh builds and
runs it on every platform): the limb division at several widths and shapes, with the long division's add-back, two
corrections and an oversized estimate, the reciprocal step's second correction (one-limb and longer divisors) and the
power-of-two shortcuts; the operators on integers wider than 128 bits and the floor quotient and non-negative
remainder; the MPC field's product at 128, 192 and 256 bits (any operands below 2^N, products that are multiples of p)
and the build's field operators; Lattiseq's CRT reconstruction on both of its paths and a decode above level 0;
BigFloat's operations (Go's math/big.Float answers: ties, denormals and halves, signed zeros, results that only the bits
below the window decide), a digest of the exact encoder's roots of unity and bootstrapping's sine polynomial (Lattigo's
coefficients). One process, no parties. Prints one line per check and a final count; exits 1 if one failed or did not
run.

    sequre build scripts/smoke_arithmetic.codon -o arith && ./arith
"""
import sys

import limbs
import sequre.lattiseq.ckks as ckks
import sequre.lattiseq.params as ckks_params
import sequre.lattiseq.ring as ring

from sequre.constants import (
    MPC_INT_SIZE, MPC_FIELD_SIZE, LATTISEQ_EXACT_INT_SIZE, mpc_uint, lattiseq_uint, lattiseq_int)
from sequre.settings import DEBUG
from sequre.lattiseq.bigfloat import BigFloat
from sequre.lattiseq.cosine_approx import approximate_cos, PI_STR
from sequre.lattiseq.exact_encoder import _exact_roots

