ROOT_DIGESTS = {256: "ccfe6636a113faba", 512: "918f5b6e49cb5ab6"}  # the exact encoder's roots for m = 2^14
CRT_DIGESTS = ("77d3e9b4d6d85547", "e9f9b250402bd068")  # PN14QP438 at its top level, plain and centered
CRT_WIDE_DIGESTS = ("17327dc1a8824138", "a595bf7a0f96932a")  # PN15QP880 at level 11: the sum in the wider integer

checks = [0, 0]


def check(name: str, ok: bool, detail: str = ""):
    checks[0] += 1
    if ok:
        print(f"ok    {name}")
    else:
        checks[1] += 1
        print(f"FAIL  {name}: {detail}")
    sys.stdout.flush()


def hex64(b: u64) -> str:
    s = ''
    for k in range(15, -1, -1):
        s += '0123456789abcdef'[int((b >> u64(4 * k)) & u64(15))]
    return s


def low64(x) -> u64:
    return u64(int(x & type(x)(0xFFFFFFFF))) | (u64(int((x >> type(x)(32)) & type(x)(0xFFFFFFFF))) << u64(32))


def mix(acc: u64, v: u64) -> u64:
    acc = (acc ^ v) * u64(0x9E3779B97F4A7C15)
    return acc ^ (acc >> u64(31))


def divisions_at(N: Literal[int]):
    for w, a, b, q, r in DIVISIONS:
        if w != N: continue
        x, y = UInt[N](a), UInt[N](b)
        qq, rr = limbs.udivrem(x, y)
        check(f"division at {N} bits ({len(a)}- by {len(b)}-digit operands)", str(qq) == q and str(rr) == r and str(x // y) == q and str(x % y) == r, f"got {qq} {rr}")


def signed_at(N: Literal[int]):
    for w, a, b, q, r, fq, nr in SIGNED:
        if w != N: continue
        x, y = Int[N](a), Int[N](b)
        ok = str(x // y) == q and str(x % y) == r and str(x.div_floor(y)) == fq and str(x.mod_nonneg(y)) == nr
        check(f"signed division at {N} bits (signs {'-' if a[0] == '-' else '+'}{'-' if b[0] == '-' else '+'})", ok, f"got {x // y} {x % y} {x.div_floor(y)} {x.mod_nonneg(y)}")


def field_kernel_at(N: Literal[int], L: Literal[int], C: Literal[int]):
    # the generic kernel at every width, whatever this build's is
    for w, a, b, ab, k, ak, amk in FIELD:
        if w != N: continue
        x, y = UInt[N](a), UInt[N](b)
        kk = int(k)
        got = (str(limbs.pm_mul(x, y, L, C)), str(limbs.pm_mul_u64(x, u64(kk), L, C)), str(limbs.pm_mul_int(x, -kk, L, C)))
        check(f"field kernel at {N} bits (2^{L} - {C})", got == (ab, ak, amk), f"got {got}")


def field_operators():
    # this build's field through UInt.mul_mod and %; a negative int factor only where DEBUG does not refuse it
    for w, a, b, ab, k, ak, amk in FIELD:
        if w != MPC_INT_SIZE: continue
        x, y = mpc_uint(a), mpc_uint(b)
        kk = int(k)
        ok = str(x.mul_mod(y, MPC_FIELD_SIZE)) == ab and str(x.mul_mod(u64(kk), MPC_FIELD_SIZE)) == ak
        ok = ok and (DEBUG or str(x.mul_mod(-kk, MPC_FIELD_SIZE)) == amk)
        ok = ok and str((x * y) % MPC_FIELD_SIZE) == str(limbs.umod(x * y, MPC_FIELD_SIZE))
        check(f"field operators at {MPC_INT_SIZE} bits", ok, f"got {x.mul_mod(y, MPC_FIELD_SIZE)}")


def crt_digests(params, level: int) -> Tuple[str, str]:
    # the plain and centered reconstructions of a fixed polynomial (random residues, q - 1 every fifth), digested
    ring_q = params.ring_q
    p = ring.new_poly(ring_q.n, level)
    x = u64(88172645463325252)
    for k in range(level + 1):
        qk = ring_q.modulus[k]
        for j in range(ring_q.n):
            x ^= x << u64(13)
            x ^= x >> u64(7)
            x ^= x << u64(17)
            p._buf_coeffs[k][j] = qk - u64(1) if j % 5 == 0 else x % qk
    plain = [lattiseq_uint(0) for _ in range(ring_q.n)]
    ring_q.poly_to_bigint_lvl(level, p._buf_coeffs, 1, plain)
    centered = [lattiseq_int(0) for _ in range(ring_q.n)]
    ring_q.poly_to_bigint_centered_lvl(level, p, 1, centered)
    d1, d2 = u64(0), u64(0)
    for j in range(ring_q.n):
        d1 = mix(d1, low64(plain[j]))
        d2 = mix(d2, low64(centered[j]))
    return hex64(d1), hex64(d2)


def crt_checks():
    params = ckks.new_parameters_from_literal(ckks_params.PN14QP438)
    level = min(len(params.ring_q.modulus_at_level) - 1, params.max_level())
    got = crt_digests(params, level)
    check(f"CRT reconstruction (PN14QP438, level {level}, plain and centered)", got == CRT_DIGESTS, f"got {got}")
    wide = ckks.new_parameters_from_literal(ckks_params.PN15QP880)
    got = crt_digests(wide, 11)
    check(f"CRT reconstruction in the wider integer (PN15QP880, level 11, plain and centered)", got == CRT_WIDE_DIGESTS and not wide.ring_q._crt_sum_fits(11), f"got {got}")
    # a decode above level 0 (the CRT path): the encoded values back within the encoding's rounding
    encoder = ckks.new_encoder_complex(params)
    values = [complex(float(i % 17) - 8.25, float(i % 5) * 0.5 - 1.0) for i in range(params.slots())]
    pt = ckks.new_plaintext(params, params.max_level(), params.default_scale)
    encoder.encode(values, pt, params.log_slots)
    back = encoder.decode(pt, params.log_slots)
    err = 0.0
    for i in range(len(values)):
        err = max(err, abs(back[i] - values[i]))
    check(f"decode at level {pt.level()} (PN14QP438): the encoded values back (largest error {err:.1e})", err < 1e-6, f"largest error {err}")


def _hexval(c: str) -> int:
    o = ord(c)
    if 48 <= o <= 57: return o - 48
    if 97 <= o <= 102: return o - 87
    return o - 55


def from_p(prec: int, t: str) -> BigFloat:
    x = BigFloat(prec)
    neg = t.startswith('-')
    if neg: t = t[1:]
    if t == '0':
        x._set_zero(neg)
        return x
    pp = t.index('p')
    digits = t[3:pp]
    e = int(t[pp + 1:])
    nl = (4 * len(digits) + 63) // 64 + 1
    h = Ptr[u64](nl)
    limbs.zero(h, nl)
    for c in digits:
        limbs.lshift(h, h, nl, 4)
        h[0] |= u64(_hexval(c))
    x._round_from(h, nl, e - 4 * len(digits), False, neg)
    return x


def to_p(x: BigFloat) -> str:
    if x._zero:
        return '-0' if x._neg else '0'
    s = ''
    for i in range(x._n - 1, -1, -1):
        w = x._mant[i]
        for k in range(15, -1, -1):
            s += '0123456789abcdef'[int((w >> u64(4 * k)) & u64(15))]
    e = x._exp
    return ('-' if x._neg else '') + '0x.' + s.rstrip('0') + 'p' + ('+' if e >= 0 else '') + str(e)


def bigfloat_checks():
    for line in BIGFLOAT:
        lhs, want = line.split(' -> ')
        w = lhs.split(' ')
        op = w[0]
        got = ''
        if op in ('add', 'sub', 'mul', 'quo'):
            x, y = from_p(int(w[2]), w[3]), from_p(int(w[4]), w[5])
            z = BigFloat(int(w[1]))
            if op == 'add': z.add(x, y)
            elif op == 'sub': z.sub(x, y)
            elif op == 'mul': z.mul(x, y)
            else: z.quo(x, y)
            got = to_p(z)
        elif op == 'setstr':
            got = to_p(BigFloat(int(w[1])).set_string(PI_STR if w[2] == 'pi' else w[2]))
        elif op == 'float64':
            f = from_p(int(w[2]), w[3]).float64()
            got = hex64(Ptr[u64](__ptr__(f).as_byte())[0])
        elif op == 'tofixed':
            bits = int(w[4])
            x = from_p(int(w[2]), w[3])
            got = str(x.to_fixed(bits, 256)) if bits <= 254 else str(x.to_fixed(bits, 512))
        check(f"BigFloat {op} at {w[1]} bits", got == want, f"got {got}")


def root_and_cosine_checks():
    re, im = _exact_roots(1 << 14)
    acc = u64(0)
    for i in range(len(re)):
        acc = mix(mix(acc, low64(re[i])), low64(im[i]))
    check(f"exact encoder roots of unity (m = 2^14, {LATTISEQ_EXACT_INT_SIZE}-bit fixed point)", hex64(acc) == ROOT_DIGESTS[LATTISEQ_EXACT_INT_SIZE], f"got {hex64(acc)}")
    coeffs = approximate_cos(16, 30, 256.0, 3)
    got = List[str]()
    for c in coeffs:
        v = c.real
        got.append(hex64(Ptr[u64](__ptr__(v).as_byte())[0]))
    check("cosine approximation (K 16, degree 30): Lattigo's coefficients", got == COSINE, f"{sum(1 for i in range(min(len(got), len(COSINE))) if got[i] != COSINE[i])} differ")


divisions_at(192)
divisions_at(256)
divisions_at(512)
divisions_at(640)
divisions_at(1024)
signed_at(192)
signed_at(512)
field_kernel_at(128, 127, 1)
field_kernel_at(192, 174, 3)
field_kernel_at(256, 251, 9)
field_operators()
crt_checks()
bigfloat_checks()
root_and_cosine_checks()
# every check ran: the tables' entries (the field's twice at this build's width) and the five fixed ones
expected = (len(DIVISIONS) + len(SIGNED) + len(FIELD) + sum(1 for e in FIELD if e[0] == MPC_INT_SIZE) + 3 + len(BIGFLOAT) + 2)
print(f"arithmetic: {checks[0]} checks, {checks[1]} failed (expected {expected} checks)")
if checks[1] or checks[0] != expected:
    sys.exit(1)
