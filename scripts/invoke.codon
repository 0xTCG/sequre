import sys
import time

from sequre.runtime import client, fork_parties
from sequre.constants import (
    RUN_TOGGLES, NUMBER_OF_PARTIES,
    MPC_RING_SIZE, MPC_FIELD_SIZE)

from ..tests.tests import tests, TEST_SELECTORS
from ..tests.benchmark import benchmark, BENCHMARK_SELECTORS


def invoke(protocol_func, pid, control_toggles, local, modulus):
    if local:
        fork_parties(0, NUMBER_OF_PARTIES - 1, protocol_func, control_toggles, modulus, control_toggles, modulus)
    else:
        s = time.time()
        client(pid, protocol_func, control_toggles, local, modulus, control_toggles, modulus)
        e = time.time()
        print(f'Total client runtime: {e - s}s')


RUNTIME_FLAGS = [RUN_TOGGLES.LOCAL_SETUP_FLAG, RUN_TOGGLES.USE_RING_FLAG, RUN_TOGGLES.MHE_SETUP_SKIP_FLAG]
# (command, its selectors). Each runner declares the selectors it handles next to its dispatch code.
COMMANDS = [('run-tests', TEST_SELECTORS), ('run-benchmarks', BENCHMARK_SELECTORS)]
DESCRIPTIONS = {
    RUN_TOGGLES.LOCAL_SETUP_FLAG: "Run all parties as forked processes on this machine (UNIX sockets)",
    RUN_TOGGLES.USE_RING_FLAG: "Use ring modulus instead of field modulus",
    RUN_TOGGLES.MHE_SETUP_SKIP_FLAG: "Skip the MHE key-generation setup phase",
    RUN_TOGGLES.RUN_ALL_FLAG: "Everything this command runs",
    RUN_TOGGLES.UNIT_TEST_FLAG: "All unit tests except --bootstrapping",
    RUN_TOGGLES.E2E_TEST_FLAG: "All end-to-end tests",
    RUN_TOGGLES.HELPERS_TEST_FLAG: "Helper utilities",
    RUN_TOGGLES.PRIMITIVES_TEST_FLAG: "MPC primitives",
    RUN_TOGGLES.HE_TEST_FLAG: "Homomorphic encryption",
    RUN_TOGGLES.BOOTSTRAPPING_TEST_FLAG: "CKKS bootstrapping (about two minutes; in --all but not in --unit)",
    RUN_TOGGLES.MPC_TEST_FLAG: "MPC protocols",
    RUN_TOGGLES.MHE_FLAG: "Multiparty HE protocols",
    RUN_TOGGLES.SHARETENSOR_TEST_FLAG: "Sharetensor operations",
    RUN_TOGGLES.CIPHERTENSOR_TEST_FLAG: "Ciphertensor operations",
    RUN_TOGGLES.MPP_TEST_FLAG: "MPP operations",
    RUN_TOGGLES.MPA_TEST_FLAG: "MPA operations",
    RUN_TOGGLES.MPU_TEST_FLAG: "MPU operations",
    RUN_TOGGLES.IR_PASSES_TEST_FLAG: "Compiler IR pass tests",
    RUN_TOGGLES.STDLIB_BUILTIN_TEST_FLAG: "Secure stdlib built-in functions",
    RUN_TOGGLES.BITWISE_TEST_FLAG: "Bitwise (XOR) MPC, ring sign test and normalizer, Decor division, public operands",
    RUN_TOGGLES.DECOR_TEST_FLAG: "Decor nonlinear functions, Fourier, Taylor and Chebyshev evaluation",
    RUN_TOGGLES.NONLINEAR_TEST_FLAG: "One nonlinear API (sequre.stdlib.nonlinear) over plaintext and every secure type",
    RUN_TOGGLES.ACTIVATIONS_TEST_FLAG: "Neural-net activations and their derivatives (ndarray, Sharetensor, MPU; Decor and Chebyshev)",
    RUN_TOGGLES.LATTISEQ_FLAG: "Lattiseq CKKS engine",
    RUN_TOGGLES.LATTISEQ_MULT3_FLAG: "Lattiseq 3-way multiplication",
    RUN_TOGGLES.LIN_ALG_FLAG: "Secure linear algebra",
    RUN_TOGGLES.LIN_REG_FLAG: "Secure linear regression",
    RUN_TOGGLES.LOG_REG_FLAG: "Secure logistic regression",
    RUN_TOGGLES.LSVM_FLAG: "Secure linear SVM",
    RUN_TOGGLES.NN_FLAG: "Secure neural network",
    RUN_TOGGLES.MI_FLAG: "Secure multiple imputation",
    RUN_TOGGLES.PCA_FLAG: "Secure PCA",
    RUN_TOGGLES.KING_FLAG: "Secure KING kinship",
    RUN_TOGGLES.CREDIT_SCORE_FLAG: "Credit score application",
    RUN_TOGGLES.GWAS_FLAG: "GWAS",
    RUN_TOGGLES.GWAS_W_NORM_FLAG: "GWAS with normalization",
    RUN_TOGGLES.GWAS_WO_NORM_FLAG: "GWAS without normalization",
    RUN_TOGGLES.DTI_FLAG: "Drug-target interaction",
    RUN_TOGGLES.SIREN_FLAG: "SIREN on a synthetic image (Decor; Chebyshev on the default interval, and on the reduced interval on the ring)",
    RUN_TOGGLES.GWAS_LOGREG_FLAG: "GWAS by logistic association on simulated data (Decor and Chebyshev)",
    RUN_TOGGLES.GENOTYPE_IMPUTATION_FLAG: "Genotype imputation",
    RUN_TOGGLES.MNIST_FLAG: "MNIST digit classification",
    RUN_TOGGLES.ABLATIONS_FLAG: "Ablation studies"}


def selectors_of(command: str) -> List[str]:
    for name, selectors in COMMANDS:
        if name == command:
            return selectors
    return List[str]()


def print_flag(flag: str, out):
    print(f"  {flag.ljust(24)} {DESCRIPTIONS.get(flag, '')}", file=out)


def usage(out):
    print("Sequre test/benchmark runner\n", file=out)
    print("Usage: sequre run scripts/invoke.codon <command> [flags] [<cpid>]", file=out)
    print("       (<cpid> only in distributed runs, i.e. without --local)\n", file=out)
    print("Commands:", file=out)
    print("  run-tests                Run the test suite", file=out)
    print("  run-benchmarks           Run the benchmark suite\n", file=out)
    print("Runtime flags:", file=out)
    for flag in RUNTIME_FLAGS:
        print_flag(flag, out)
    for command, selectors in COMMANDS:
        print(f"\n{command} selectors (give at least one):", file=out)
        for flag in selectors:
            print_flag(flag, out)
    print("\nExamples:", file=out)
    print("  sequre run scripts/invoke.codon run-tests --local --all", file=out)
    print("  sequre run scripts/invoke.codon run-tests --local --sharetensor --mpc", file=out)
    print("  sequre run scripts/invoke.codon run-benchmarks --local --king", file=out)


def check_command_line(command_args: List[str]):
    # Rejects, before any party starts, a command line that would run nothing or not what it names.
    flags = [arg for arg in command_args if arg.startswith('-')]
    args = [arg for arg in command_args if not arg.startswith('-')]
    problems = List[str]()
    if not args or not selectors_of(args[0]):
        problems.append(f"expected a command first: {' or '.join(name for name, _ in COMMANDS)}")
    else:
        command = args[0]
        selectors = selectors_of(command)
        for flag in flags:
            if flag in RUNTIME_FLAGS or flag in selectors:
                continue
            elsewhere = [name for name, other in COMMANDS if name != command and flag in other]
            if elsewhere:
                problems.append(f"{flag} is not a {command} selector; {elsewhere[0]} runs it")
            elif flag in list(RUN_TOGGLES):
                problems.append(f"{flag} has no runner at the moment")
            else:
                problems.append(f"unknown flag {flag}")
        if not any(flag in selectors for flag in flags):
            problems.append(f"no {command} selector given, so nothing would run")
        positional = len(args) - 1
        if RUN_TOGGLES.LOCAL_SETUP_FLAG in flags and positional:
            problems.append(f"unexpected argument {args[1]} (a CP ID is only given without --local)")
        if RUN_TOGGLES.LOCAL_SETUP_FLAG not in flags and positional != 1:
            problems.append("a distributed run (without --local) takes exactly one CP ID after the flags")
    if problems:
        for problem in problems:
            print(f"invoke.codon: {problem}", file=sys.stderr)
        print("Run with --help to list the commands and flags.", file=sys.stderr)
        sys.exit(2)


command_args = sys.argv[1:]
if '--help' in command_args or '-h' in command_args:
    usage(sys.stdout)
    sys.exit(0)
check_command_line(command_args)

flags = [arg for arg in command_args if arg.startswith('-')]
args = [arg for arg in command_args if not arg.startswith('-')]
toggles = {toggle: toggle in flags for toggle in RUN_TOGGLES}
local = toggles[RUN_TOGGLES.LOCAL_SETUP_FLAG]
modulus = MPC_RING_SIZE if toggles[RUN_TOGGLES.USE_RING_FLAG] else MPC_FIELD_SIZE

pid = 0 if local else int(args[1])
if args[0] == 'run-tests':
    invoke(tests, pid, toggles, local, modulus)
else:
    invoke(benchmark, pid, toggles, local, modulus)
