# Dockerfile for local sequre builds with cached Codon/LLVM (ARM64, Codon v0.19.6).
# Versions mirror the release build in .github/actions/build-manylinux.
FROM quay.io/pypa/manylinux_2_28_aarch64

# Install Codon
RUN mkdir -p /root/.sequre && \
    cd /root/.sequre && \
    curl -L https://github.com/exaloop/codon/releases/download/v0.19.6/codon-linux-aarch64.tar.gz | tar zxvf - --strip-components=1

# Install LLVM-codon (20.1.7). The tarball may be rooted at opt/ or at
# llvm-codon/; extract so it lands at /opt/llvm-codon either way.
RUN curl -L https://github.com/exaloop/llvm-project/releases/download/codon-20.1.7/llvm-codon-20.1.7-linux-aarch64.tar.bz2 -o /tmp/llvm.tar.bz2 && \
    LLVM_TOP=$(tar -tjf /tmp/llvm.tar.bz2 | head -1 | cut -d/ -f1) && \
    if [ "$LLVM_TOP" = "opt" ]; then tar -jxf /tmp/llvm.tar.bz2 -C /; else mkdir -p /opt && tar -jxf /tmp/llvm.tar.bz2 -C /opt; fi && \
    rm -f /tmp/llvm.tar.bz2

# Install seq plugin
RUN curl -L https://github.com/exaloop/seq/releases/download/v0.11.3/seq-linux-aarch64.tar.gz | tar zxvf - -C /root/.sequre/lib/codon/plugins

# Point the LLVM-codon clang at the manylinux_2_28 gcc-toolset so it can find
# libstdc++ / the C++20 headers when building the plugin (matches CI).
RUN if [ -f /opt/llvm-codon/bin/clang ]; then \
      GCC_INSTALL_DIR=$(ls -d /opt/rh/gcc-toolset-*/root/usr/lib/gcc/*/* 2>/dev/null | sort -V | tail -1); \
      if [ -n "$GCC_INSTALL_DIR" ]; then \
        echo "--gcc-install-dir=$GCC_INSTALL_DIR" > /opt/llvm-codon/bin/clang.cfg; \
        echo "--gcc-install-dir=$GCC_INSTALL_DIR" > /opt/llvm-codon/bin/clang++.cfg; \
      fi; \
    fi

# Set compiler paths
ENV CC=/opt/llvm-codon/bin/clang
ENV CXX=/opt/llvm-codon/bin/clang++

WORKDIR /build

# Build script that only compiles sequre (Codon/LLVM/seq already installed)
COPY build-sequre.sh /build-sequre.sh
RUN chmod +x /build-sequre.sh

ENTRYPOINT ["/build-sequre.sh"]
