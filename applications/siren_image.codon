""" Loading a real image for the SIREN application (applications/siren.codon) through Python.

load_image needs the Python packages numpy and Pillow, and importing this module starts the Python interpreter (its
@python function is defined at import time): keep it out of programs that need neither.
"""


@python
def load_image(path: str, side: int) -> List[List[float]]:
    # Grayscale pixels of the image at path, resized to side x side and scaled to [-1, 1], row-major (side^2 x 1): the
    # same order as synthetic_image(side)'s coordinates (applications/siren.codon), which serve as the model's input
    import numpy as np
    from PIL import Image
    img = Image.open(path).convert("L").resize((side, side))
    values = np.asarray(img, dtype=np.float64) / 127.5 - 1.0
    return [[float(v)] for v in values.reshape(-1)]
