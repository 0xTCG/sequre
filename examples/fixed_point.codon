from sequre import main, sequre, Sharetensor as Stensor


# Fixed-point protocols on the default MPC modulus (the ring; `--use-field` for the field): a product (and its
# truncation), a comparison, an equality test and a division. Each compute party prints the revealed results.
@sequre
def product(mpc, x, y):
    return x * y


@sequre
def greater(mpc, x, y):
    return x > y


@sequre
def differ(mpc, x, y):
    return x != y


@sequre
def quotient(mpc, x, y):
    return x / y


def show(mpc, name: str, values):
    if mpc.pid:
        print(f"CP{mpc.pid}:\t{name}: {[round(float(v), 4) for v in values]}")


@main
def run(mpc, xs: List[float], ys: List[float]):
    x = Stensor.enc(mpc, xs)
    y = Stensor.enc(mpc, ys)

    show(mpc, "product", product(mpc, x, y).reveal(mpc))
    show(mpc, "greater", greater(mpc, x, y).reveal(mpc))
    show(mpc, "differ", differ(mpc, x, y).reveal(mpc))
    show(mpc, "quotient", quotient(mpc, x, y).reveal(mpc))


if __name__ == "__main__":
    run([1.5, -2.25, 3.0, 0.125], [2.0, 4.0, 3.0, -0.5])
